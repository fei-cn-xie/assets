+    def test_registered_hybrid_buffer_recovers_arena_base_behind_descriptor_offset(self):
+        """DeepSeek-V4 SFA puts a later spec bucket at a non-zero descriptor offset.
+
+        vLLM assigns every KV cache group a descriptor per distinct spec and
+        stacks them inside one shared arena, so the second bucket's layer views
+        begin at ``descriptor.offset`` instead of the arena base. The offset is
+        ``indexer_page_bytes * num_blocks`` in the DSV4 SFA layout and is not
+        2 MiB aligned, which must not change the registered allocation.
+        """
+        alignment = 2 * 1024 * 1024
+        arena_size = 8 * alignment
+        indexer_page_bytes = 16640  # 128 tokens * (128 int8 K + 1 fp16 scale)
+        layer_name = "model.layers.0.indexer.k_cache"
+        # 911360 is the remainder observed on the prefill node with 5096 blocks.
+        offsets = [indexer_page_bytes * 64, 911360, alignment + 4096]
+
+        raw_tensor = torch.empty(arena_size + alignment, dtype=torch.uint8)
+        aligned_offset = (-raw_tensor.data_ptr()) % alignment
+        arena = raw_tensor[aligned_offset : aligned_offset + arena_size]
+
+        worker = MooncakeConnectorWorker.__new__(MooncakeConnectorWorker)
+        worker.kv_cache_config = types.SimpleNamespace(
+            kv_cache_tensors=[make_mock_kv_cache_tensor(arena_size, [layer_name])]
+        )
+
+        self.assertEqual(arena.data_ptr() % alignment, 0)
+        for descriptor_offset in offsets:
+            with self.subTest(descriptor_offset=descriptor_offset):
+                view = arena[descriptor_offset:]
+                self.assertNotEqual(view.data_ptr() % alignment, 0)
+
+                ptrs, lengths = worker._get_registered_kv_tensor_buffers({layer_name: (view, view[128:])})
+
+                self.assertEqual(ptrs, [arena.data_ptr()])
+                self.assertEqual(lengths, [arena_size])
+
     @MOONCAKE_STORAGE_REGISTRATION_FIX
     def test_registered_mtp_buffer_ignores_aligned_stale_group_padding(self):
         alignment = 2 * 1024 * 1024
