+    def _get_local_group_block_size(self, kv_cache_group_id: int) -> int:
+        groups = self.kv_cache_config.kv_cache_groups
+        if 0 <= kv_cache_group_id < len(groups):
+            block_size = getattr(groups[kv_cache_group_id].kv_cache_spec, "block_size", None)
+            if isinstance(block_size, int) and block_size > 0:
+                return block_size
+        return self.block_size
+
+    def _get_remote_group_block_size(self, meta: ReqMeta, kv_cache_group_id: int, local_block_size: int) -> int:
+        remote_block_sizes = getattr(meta, "remote_block_sizes", ())
+        if remote_block_sizes:
+            if kv_cache_group_id >= len(remote_block_sizes):
+                raise ValueError(
+                    f"Missing remote block size for KV cache group {kv_cache_group_id}: "
+                    f"received {len(remote_block_sizes)} group sizes."
+                )
+            remote_block_size = remote_block_sizes[kv_cache_group_id]
+            if not isinstance(remote_block_size, int) or remote_block_size <= 0:
+                raise ValueError(f"Invalid remote block size {remote_block_size} for KV cache group {kv_cache_group_id}.")
+            return remote_block_size
+        return meta.remote_block_size or local_block_size
+
