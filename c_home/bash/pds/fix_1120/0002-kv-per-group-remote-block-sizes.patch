+    def test_get_kernel_block_ids_uses_per_group_remote_block_sizes(self):
+        """DSV4 hybrid groups must not share the scheduler's minimum block size."""
+        worker = self._build_non_cp_worker()
+        block_sizes = [512, 16384, 128, 128, 8, 32]
+        worker.block_size = 128
+        worker.block_size_scale = [[1] for _ in block_sizes]
+        worker.kv_cache_config = types.SimpleNamespace(
+            kv_cache_groups=[
+                types.SimpleNamespace(kv_cache_spec=types.SimpleNamespace(block_size=block_size))
+                for block_size in block_sizes
+            ]
+        )
+        meta = types.SimpleNamespace(
+            # EngineCore sets the scalar to min(group block sizes). It cannot
+            # describe the 128-token attention groups alongside the 8/32-token
+            # compressor state groups.
+            remote_block_size=8,
+            remote_block_sizes=block_sizes,
+            local_block_ids=([1], [2], [3], [4], [5], [6, 7, 8]),
+            remote_block_ids=([1], [2], [3], [4], [15], [17, 18, 19]),
+            num_computed_tokens=0,
+        )
+
+        for group_idx, block_size in enumerate(block_sizes):
+            with self.subTest(group_idx=group_idx, block_size=block_size):
+                group_spec = {
+                    "kv_cache_spec_type": "AscendMLAAttentionSpec",
+                    "kv_cache_spec": {"block_size": block_size},
+                }
+                local_ids, remote_ids = worker._get_kernel_block_ids([group_idx], meta, group_idx, group_spec)
+                self.assertEqual(local_ids, meta.local_block_ids[group_idx])
+                self.assertEqual(remote_ids, meta.remote_block_ids[group_idx])
+
+        # A transfer-group index is not necessarily the manager-group index used
+        # by the P-published block-size list.
+        local_ids, remote_ids = worker._get_kernel_block_ids(
+            [5],
+            meta,
+            99,
+            {
+                "kv_cache_group_id": 5,
+                "kv_cache_spec_type": "AscendMLAAttentionSpec",
+                "kv_cache_spec": {"block_size": 32},
+            },
+        )
+        self.assertEqual(local_ids, [6, 7, 8])
+        self.assertEqual(remote_ids, [17, 18, 19])
+
+    def test_get_kernel_block_ids_sliding_uses_missing_window_suffix(self):
+        """A windowed P list is relative to its tail, not the whole prompt."""
+        worker = self._build_non_cp_worker()
+        worker.block_size = 8
+        worker.block_size_scale = [[1]]
+        worker.kv_cache_config = types.SimpleNamespace(
+            kv_cache_groups=[types.SimpleNamespace(kv_cache_spec=types.SimpleNamespace(block_size=8))]
+        )
+        meta = types.SimpleNamespace(
+            remote_block_size=8,
+            remote_block_sizes=[8],
+            local_block_ids=([5],),
+            remote_block_ids=([10, 11],),
+            num_computed_tokens=16,
+            num_external_tokens=8,
+        )
+        group_spec = {
+            "kv_cache_spec_type": "AscendSlidingWindowMLASpec",
+            "kv_cache_spec": {"block_size": 8, "sliding_window": 16},
+        }
+
+        local_ids, remote_ids = worker._get_kernel_block_ids([0], meta, 0, group_spec)
+
+        self.assertEqual(local_ids, [5])
+        self.assertEqual(remote_ids, [11])
