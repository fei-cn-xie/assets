style=&quot;color: #4ec9b0;&quot;&gt;Request&lt;/span&gt;) -&amp;gt; &lt;span style=&quot;color: #569cd6;&quot;&gt;None&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c586c0;&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color: #c9d1d9;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #d2a8ff;&quot;&gt;_is_blocked_waiting_status&lt;/span&gt;(&lt;span style=&quot;color: #ffa657;&quot;&gt;request&lt;/span&gt;.&lt;span style=&quot;color: #c9d1d9;&quot;&gt;status&lt;/span&gt;):&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c9d1d9;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #c9d1d9;&quot;&gt;skipped_waiting&lt;/span&gt;.&lt;span style=&quot;color: #d2a8ff;&quot;&gt;add_request&lt;/span&gt;(&lt;span style=&quot;color: #ffa657;&quot;&gt;request&lt;/span&gt;)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c586c0;&quot;&gt;else&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c9d1d9;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #c9d1d9;&quot;&gt;waiting&lt;/span&gt;.&lt;span style=&quot;color: #d2a8ff;&quot;&gt;add_request&lt;/span&gt;(&lt;span style=&quot;color: #ffa657;&quot;&gt;request&lt;/span&gt;)&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
