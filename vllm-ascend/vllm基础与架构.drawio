;color: #c586c0;&quot;&gt;try&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c9d1d9;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #d2a8ff;&quot;&gt;_lwd_setup_zmq&lt;/span&gt;()&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c586c0;&quot;&gt;except&lt;/span&gt; &lt;span style=&quot;color: #4ec9b0;&quot;&gt;Exception&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c9d1d9;&quot;&gt;logger&lt;/span&gt;.&lt;span style=&quot;color: #d2a8ff;&quot;&gt;exception&lt;/span&gt;(&lt;span style=&quot;color: #a5d6ff;&quot;&gt;&quot;[Lwd] cloud PRE_OUT setup failed&quot;&lt;/span&gt;)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c9d1d9;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #c9d1d9;&quot;&gt;input_queue&lt;/span&gt;.&lt;span style=&quot;color: #d2a8ff;&quot;&gt;put_nowait&lt;/span&gt;((&lt;span style=&quot;color: #4ec9b0;&quot;&gt;EngineCoreRequestType&lt;/span&gt;.&lt;span style=&quot;color: #79c0ff;&quot;&gt;EXECUTOR_FAILED&lt;/span&gt;, &lt;span style=&quot;color: #ff7b72;&quot;&gt;b&lt;/span&gt;&lt;span style=&quot;color: #a5d6ff;&quot;&gt;&quot;&quot;&lt;/span&gt;))&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c586c0;&quot;&gt;return&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c586c0;&quot;&gt;while&lt;/span&gt; &lt;span style=&quot;color: #569cd6;&quot;&gt;True&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c9d1d9;&quot;&gt;msg&lt;/span&gt; &lt;span style=&quot;color: #d4d4d4;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #c9d1d9;&quot;&gt;self&