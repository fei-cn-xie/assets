asyncio&lt;/span&gt;.&lt;span style=&quot;color: #4ec9b0;&quot;&gt;CancelledError&lt;/span&gt;, &lt;span style=&quot;color: #4ec9b0;&quot;&gt;GeneratorExit&lt;/span&gt;):&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c586c0;&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color: #c9d1d9;&quot;&gt;q&lt;/span&gt; &lt;span style=&quot;color: #569cd6;&quot;&gt;is&lt;/span&gt; &lt;span style=&quot;color: #569cd6;&quot;&gt;not&lt;/span&gt; &lt;span style=&quot;color: #569cd6;&quot;&gt;None&lt;/span&gt;:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #c586c0;&quot;&gt;await&lt;/span&gt; &lt;span style=&quot;color: #c9d1d9;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #d2a8ff;&quot;&gt;abort&lt;/span&gt;(&lt;span style=&quot;color: #c9d1d9;&quot;&gt;q&lt;/span&gt;.&lt;span style=&quot;color: #c9d1d9;&quot;&gt;request_id&lt;/span&gt;, &lt;span style=&quot;color: #ffa657;&quot;&gt;internal&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;True&lt;/span&gt;)&lt;/div&gt;&lt;div&gt;...&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
