 &lt;span style=&quot;color: rgb(78, 201, 176);&quot;&gt;int&lt;/span&gt; &lt;span style=&quot;color: rgb(212, 212, 212);&quot;&gt;|&lt;/span&gt; &lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;None&lt;/span&gt; &lt;span style=&quot;color: rgb(212, 212, 212);&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;None&lt;/span&gt;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: rgb(255, 166, 87);&quot;&gt;reasoning_ended&lt;/span&gt;: &lt;span style=&quot;color: rgb(78, 201, 176);&quot;&gt;bool&lt;/span&gt; &lt;span style=&quot;color: rgb(212, 212, 212);&quot;&gt;|&lt;/span&gt; &lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;None&lt;/span&gt; &lt;span style=&quot;color: rgb(212, 212, 212);&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;None&lt;/span&gt;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: rgb(255, 166, 87);&quot;&gt;reasoning_parser_kwargs&lt;/span&gt;: &lt;span style=&quot;color: rgb(78, 201, 176);&quot;&gt;dict&lt;/span&gt;[&lt;span style=&quot;color: rgb(78, 201, 176);&quot;&gt;str&lt;/span&gt;, &lt;span style=&quot;color: rgb(78, 201, 176);&quot;&gt;Any&lt;/span&gt;] &lt;span style=&quot;color: rgb(212, 212, 212);&quot;&gt;|&lt;/span&gt; &lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;None&lt;/span&gt; &lt;span style=&quot;color: rgb(212, 212, 212);&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;None&lt;/span&gt;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ) -&amp;gt; &lt;span style=&quot;color: rgb(78, 201, 176);&quot;&gt;AsyncGenerator&lt;/span&gt;[&lt;span style=&quot;color: rgb(78, 201, 176);&quot;&gt;RequestOutput&lt;/span&gt;, &lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;None&lt;/span&gt;]:&lt;/div&gt;&lt;div&gt;...&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;