        <mxCell id="n81" value="&lt;b&gt;`sample_tokens`：`_lwd_collect_down_payload` → rank 编码 + valid 掩码&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;只传「token 在 logits 里的名次」，边端用本地 logits 复现同一个 token&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;lwd_cloud_model_runner.py:1352-1399,1408-1613 · lwd_token_rank.py:13&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1784" y="2243" width="314" height="98" as="geometry" />
        </mxCell>
        <mxCell id="e82" value="DOWN：hidden 帧" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
