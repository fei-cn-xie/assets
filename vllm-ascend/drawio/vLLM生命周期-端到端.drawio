        <mxCell id="n44" value="&lt;font color=&quot;#999999&quot;&gt;② 信封与选路：HTTP 一路，控制面一路，并行推进&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
