        <mxCell id="e83" value="ZMQ：`LwdC2eNotify`(seqno / valid_ranges / ranks / final_g / finish)" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
