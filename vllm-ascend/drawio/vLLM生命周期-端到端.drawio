        <mxCell id="n65" value="&lt;b&gt;装 tid2eid 表 + 固定 UP layout + 跳过 warmup/capture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;0 层拓扑跑完整前向会在 final norm 解包失败，故整段跳过&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;lwd_edge_model_runner.py:84-105 · lwd_edge_worker.py:62-71&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="442" y="1727" width="364" height="57" as="geometry" />
        </mxCell>
        <mxCell id="n66" value="&lt;b&gt;层数/首末层日志 + eager（--enforce-eager）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;MTP drafter 就位；无 KV 传输导出前的状态&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;lwd_cloud_worker.py:161-182 · cloud_p.sh:26&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="840" y="1727" width="364" height="57" as="geometry" />
        </mxCell>
        <mxCell id="n67" value="&lt;b&gt;同 P + FULL_DECODE_ONLY 图捕获&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;decode 段用 cudagraph，prefill 段不用&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;cloud_d.sh:31&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1238" y="1727" width="364" height="57" as="geometry" />
        </mxCell>
        <mxCell id="n68" value="&lt;font color=&quot;#999999&quot;&gt;⑥ KV 规格：边端在源头就断了&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1800" width="1574" height="18" as="geometry" />
        </mxCell>
        <mxCell id="e69" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="36" y="1794" as="sourcePoint" />
            <mxPoint x="1610" y="1794" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n70" value="&lt;b&gt;get_kv_cache_spec() 汇总 → has_kv_cache 判定&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;spec 为空的角色连 determine_available_memory 都不会调用&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/engine/core.py:261-312 · model_runner_v1.py:6314&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="44" y="1822" width="364" height="57" as="geometry" />
        </mxCell>
        <mxCell id="n71" value="&lt;b&gt;返回 {} → num_gpu_blocks=0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;无块池、无图、无 native 步进（详见 P5）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;lwd_edge_model_runner.py:138-140&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="442" y="1889" width="364" height="57" as="geometry" />
        </mxCell>
        <mxCell id="n72" value="&lt;b&gt;native spec（FullAttentionSpec/MLA/SWA…）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;→ 显存画像 + 块池（P5 展开）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;attention.py:604&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="840" y="1889" width="364" height="57" as="geometry" />
        </mxCell>
        <mxCell id="n73" value="&lt;b&gt;同 P&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;P/D 各自一套独立块池（同机不同卡）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;同上&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1238" y="1889" width="364" height="57" as="geometry" />
        </mxCell>
        <mxCell id="n74" value="&lt;b&gt;读这张图的三个要点&lt;/b&gt;：① ①~④ 三端跑的是同一份代码，差异全部由 lwd_config.role 注入；② 真正的分叉只有三处：worker/runner 类、模块归属表、KV spec；③ 边端的「少」不是裁剪掉，而是构造期用 PPMissingLayer 占位 + 装载期跳读盘，所以 forward 签名与参数契约一致。" style="shape=note;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;size=11;" vertex="1" parent="1">
          <mxGeometry x="44" y="1966" width="1558" height="31" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
