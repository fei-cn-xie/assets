            <mxPoint x="36" y="763" as="sourcePoint" />
            <mxPoint x="1908" y="763" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n46" value="&lt;b&gt;`_validate_handoff`：version / rid / attempt / fingerprint / n_tokens / plan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;校验不过直接拒绝，不建执行 Request&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;pd/cloud_runtime.py:292-325&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1178" y="791" width="344" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n47" value="&lt;b&gt;`get_num_new_matched_tokens` → (i_end, True) → `_reqs_need_recv`&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;do_remote_prefill=True：告诉调度器「这段前缀由外部供给」&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;mooncake_connector.py:1914-1983&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1178" y="873" width="344" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="&lt;b&gt;`allocate_slots(delay_cache_blocks=True)` → 状态 `WAITING_FOR_REMOTE_KVS`&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;本轮 forward token 数 = 0，请求不参与计费式调度&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/core/sched/scheduler.py:1273-1303（:1276）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1178" y="955" width="344" height="72" as="geometry" />
        </mxCell>
        <mxCell id="e49" value="start_load_kv → kv_recv_thread.add_request → 发起块级 pull" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
