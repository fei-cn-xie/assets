        <mxCell id="e50" value="RDMA / memcpy 读 KV blocks（+ conv/recurrent 状态组）" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="972" y="1100" as="sourcePoint" />
            <mxPoint x="594" y="1100" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n51" value="&lt;b&gt;读失败/部分 rank 失败 → 不置 KV_READY，汇总后回收引用&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;LWD 保持报错策略，不返回 `stop_reason=recomputed` 触发文本拼接重算&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;pd/cloud_scheduler.py:118-130&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="800" y="1129" width="344" height="57" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="&lt;b&gt;`get_finished` → promote → **KV_READY：num_computed_tokens == r_pos**&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;r_pos = N−1：D 只重算最后一行（普通 attention）；状态模型 N&amp;gt;1 则 p_end=i_end=N−1&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;scheduler.py:2983-3041 · pd/cloud_scheduler.py:121-130&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1178" y="1196" width="344" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n53" value="&lt;font color=&quot;#999999&quot;&gt;④ 并行：真实尾输入（1 帧 1 行）&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1297" width="1872" height="18" as="geometry" />
        </mxCell>
        <mxCell id="e54" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="36" y="1291" as="sourcePoint" />
            <mxPoint x="1908" y="1291" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e55" value="ZMQ：LwdRangeNotify（seqno, 1 行 tail）" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1728" y="1336" as="sourcePoint" />
            <mxPoint x="1350" y="1336" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e56" value="UP：tail 帧（1 行 Embedding + 辅助输入）" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1728" y="1382" as="sourcePoint" />
            <mxPoint x="1350" y="1382" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n57" value="&lt;b&gt;硬校验「恰好最后一行」→ `_lwd_buffer_received_tails` → LwdTailBuffer.put&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;D 只保留自己真正要算的那一行，绝不保留整段 UP 视图&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;lwd_cloud_worker.py:448-464 · :647-674 · lwd_tail_buffer.py:42&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1178" y="1411" width="344" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n58" value="&lt;b&gt;**联合就绪**：kv_ready ∧ output_quota&amp;gt;0 ∧ tail_ready ∧ ¬tail_inflight&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;四条件缺一不可；满足后扣配额、标 tail_inflight、安排 forward&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;pd/cloud_scheduler.py:106-149&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1178" y="1493" width="344" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n59" value="&lt;font color=&quot;#999999&quot;&gt;⑤ 生成、回执与解 pin&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1581" width="1872" height="18" as="geometry" />
        </mxCell>
        <mxCell id="e60" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="36" y="1575" as="sourcePoint" />
            <mxPoint x="1908" y="1575" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n61" value="&lt;b&gt;tail forward → 采样 → DOWN hidden（每步 1 帧）+ C2e 元数据&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;rank 编码：只传 token 在 logits 里的名次，边端本地复现（lwd_token_rank.py:13）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;lwd_cloud_model_runner.py:1351-1399 · lwd_cloud_worker.py:676-750&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1178" y="1603" width="344" height="98" as="geometry" />
        </mxCell>
        <mxCell id="e62" value="DONE_RECVING_MSG（本导出已读完）" style="endArrow=block;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#d6b656;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1350" y="1728" as="sourcePoint" />
            <mxPoint x="972" y="1728" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e63" value="转发完成回执" style="endArrow=block;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#d6b656;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="972" y="1774" as="sourcePoint" />
            <mxPoint x="594" y="1774" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n64" value="&lt;b&gt;`finished_sending` → `_free_blocks`（此时块才真正回到空闲队列）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;超时兜底 `Force freed expired request`（:232-253）；D 掉线时会挂 pin 到超时&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;scheduler.py:3086-3089 · mooncake_connector.py:213-224&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="422" y="1803" width="344" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n65" value="&lt;b&gt;结果闭环：G（D 记账）与 K（边 detokenizer 记账）→ usage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;usage.completion_tokens = K；K≤G；complete ⇒ K==G&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;pd/results.py:94-135 · output_processor.py:505&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1178" y="1898" width="344" height="57" as="geometry" />
        </mxCell>
        <mxCell id="n66" value="&lt;b&gt;为什么 P 要 pin&lt;/b&gt;：KV 在 P 的块池里，D 的读是异步网络操作。若 P 先释放，块可能已被别的请求复写。所以 P 用 delay_free_blocks 把块从「可分配」降为「只读引用」，直到 D 显式回执才真正释放。" style="shape=note;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;size=11;" vertex="1" parent="1">
          <mxGeometry x="422" y="1971" width="1100" height="31" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
