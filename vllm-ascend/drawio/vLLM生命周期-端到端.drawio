          </mxGeometry>
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;P 收到 HTTP 登记 → Bind → RequestNotify 认领 → 分块 prefill&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;输入是边端 UP 上来的 embedding（不是 token id）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;pd/cloud_runtime.py:138-255 · lwd_cloud_scheduler.py:115-143&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="422" y="202" width="344" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n35" value="&lt;b&gt;末次 forward 后内部采样 a（max_tokens=1 → FINISHED_LENGTH_CAPPED）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;a 不进用户输出、不进 D 历史、不占用户预算&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;cloud_runtime.py:340 · vllm/v1/core/sched/utils.py:114&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="422" y="284" width="344" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n36" value="&lt;b&gt;`request_finished` → kv_transfer_params + `lwd_handoff`&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;关键字段：p_end / i_end / r_pos / hit_tokens / export_id&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;mooncake_connector.py:2014-2076 · pd/cloud_runtime.py:679-699&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="422" y="366" width="344" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n37" value="&lt;b&gt;**pin 住块**：delay_free_blocks=True&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;调度器跳过 _free_blocks，块进 delayed_free_requests 账本&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;mooncake_connector.py:2056-2059 · scheduler.py:2648-2650&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="422" y="448" width="344" height="57" as="geometry" />
        </mxCell>
        <mxCell id="e38" value="ZMQ：LwdPdStageDoneNotify(export_id, ok)" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="594" y="532" as="sourcePoint" />
            <mxPoint x="1728" y="532" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e39" value="HTTP 200 JSON：顶层 kv_transfer_params" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
