            <mxPoint x="1908" y="607" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n42" value="&lt;b&gt;选 P → 拿到 exported → 组 D 的 body（整块塞回 kv_transfer_params）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;P 侧剥掉、D 侧塞入；proxy 不参与 ZMQ、不进 NPU world&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;pd/proxy.py:167-211&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="44" y="635" width="344" height="72" as="geometry" />
        </mxCell>
        <mxCell id="e43" value="POST :8101/v1/chat/completions（stream=true）" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="216" y="734" as="sourcePoint" />
            <mxPoint x="1350" y="734" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n44" value="&lt;font color=&quot;#999999&quot;&gt;③ D 侧：导入 KV（与 ④ 尾输入并行）&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
