        <mxCell id="n32" value="&lt;b&gt;`get_kv_cache_spec()`：逐层算 spec&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;FullAttentionSpec(block_size, num_kv_heads, head_size, dtype…)：block 字节数 = 2 × kv_heads × head_size × BS × dtype&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/model_executor/layers/attention/attention.py:604 · vllm_ascend/worker/model_runner_v1.py:6314&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="860" y="269" width="374" height="83" as="geometry" />
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;边端在这里就分叉&lt;/b&gt;：LwdEdgeModelRunner.get_kv_cache_spec() 直接 return {} （lwd_edge_model_runner.py:138-140）—— 边侧没有 attention/transformer 层，不需要 KV。" style="shape=note;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;size=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="44" y="362" width="374" height="61" as="geometry" />
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;`has_kv_cache` 判定 + resolve_kv_cache_layout&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;没有 spec → available_gpu_memory = [0]×N，**连访存画像都不调用**&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;core.py:289-312&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="44" y="433" width="374" height="57" as="geometry" />
        </mxCell>
        <mxCell id="n35" value="&lt;b&gt;`determine_available_memory`：request_memory = 整卡 × 0.90&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;--gpu-memory-utilization 0.90 的乘法只在这里；基数是整卡总显存&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm_ascend/worker/worker.py:567 · vllm/v1/worker/utils.py:534-554&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="860" y="500" width="374" height="57" as="geometry" />
        </mxCell>
        <mxCell id="n36" value="&lt;b&gt;`profile_run()` → `_dummy_run(max_num_tokens=8192)`&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;按 max_num_batched_tokens/max_num_seqs 造一次真实形状的峰值&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm_ascend/worker/model_runner_v1.py:4328 · gpu_model_runner.py:6537&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="860" y="567" width="374" height="57" as="geometry" />
        </mxCell>
        <mxCell id="n37" value="&lt;b&gt;峰值回收：del + gc.collect() + empty_cache()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;画像跑完必须把临时激活还回去，否则块池会算小&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;gpu_model_runner.py:6548-6550 · vllm/utils/mem_utils.py:298-301&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="860" y="634" width="374" height="57" as="geometry" />
        </mxCell>
        <mxCell id="n38" value="&lt;b&gt;available = requested − non_kv_cache_memory&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;日志锚点 `Available KV cache memory: … GiB`&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm_ascend/worker/worker.py:615-634&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="44" y="701" width="374" height="57" as="geometry" />
        </mxCell>
        <mxCell id="n39" value="&lt;font color=&quot;#999999&quot;&gt;② 块池建立（一次，启动期）&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="774" width="1614" height="18" as="geometry" />
        </mxCell>
        <mxCell id="e40" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="36" y="768" as="sourcePoint" />
            <mxPoint x="1650" y="768" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n41" value="&lt;b&gt;`get_kv_cache_configs`：num_blocks = available // bytes_per_block&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;余数丢弃；写回 cache_config.num_gpu_blocks / block_size / capacity&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/core/kv_cache_utils.py:2617 → :1747-1752&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="44" y="796" width="374" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n42" value="&lt;b&gt;`KVCacheManager` → `KVCacheCoordinator` → `BlockPool(n)`&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;manager 管策略（前缀命中/引用），pool 管空闲队列（O(1) 分配）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/core/sched/scheduler.py:300 · kv_cache_manager.py:171 · kv_cache_coordinator.py:98&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="452" y="878" width="374" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n43" value="&lt;b&gt;`initialize_from_config` → `ensure_kv_transfer_initialized`&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;connector 必须先于张量分配建好，否则 register_kv_caches 无处注册&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/worker/gpu_worker.py:735-759（:752 connector 先建）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="860" y="958" width="374" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n44" value="&lt;b&gt;`initialize_kv_cache_tensors`：单块 int8 backing + per-layer view&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;有 kv_transfer_config 时多分配 alignment 再按 2MiB 对齐（RDMA 注册需要）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm_ascend/worker/model_runner_v1.py:4583 · :5006 · :4928-4949&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="860" y="1040" width="374" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n45" value="&lt;b&gt;`bind_kv_cache` + `register_kv_caches(connector)`&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;forward_context[layer].bind_kv_cache 之后，每层前向才能拿到自己的 KV 张量&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/worker/utils.py:591 · model_runner_v1.py:4683&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="860" y="1122" width="374" height="57" as="geometry" />
        </mxCell>
        <mxCell id="n46" value="边端对照：spec 为空 → kv_cache_tensors=[] → num_blocks=1（只剩 null_block）（kv_cache_utils.py:1664-1674 · block_pool.py:193-194）。边侧「块池」是个空壳。" style="shape=note;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;size=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="44" y="1189" width="782" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n47" value="&lt;font color=&quot;#999999&quot;&gt;③ 请求级：分配 → 块表 → 写入&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1251" width="1614" height="18" as="geometry" />
        </mxCell>
        <mxCell id="e48" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="36" y="1245" as="sourcePoint" />
            <mxPoint x="1650" y="1245" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n49" value="&lt;b&gt;`allocate_slots`（新请求与 append 同一入口）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;三段式：腾空间 → 算 need + 准入 → 分配 + cache_blocks（前缀命中在此复用块）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/core/kv_cache_manager.py:402 · 调用点 scheduler.py:1217&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="452" y="1273" width="374" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="&lt;b&gt;block 表 → `compute_slot_mapping`：slot = blk×BS + off&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;slot 是「每 token 写到哪一行」，物理块可以离散&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/worker/block_table.py:474 · 调用 gpu_model_runner.py:2205&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="452" y="1353" width="374" height="57" as="geometry" />
        </mxCell>
        <mxCell id="n51" value="&lt;b&gt;forward 写 `attn_layer.kv_cache[slot]`&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;写 KV 与取 KV 都通过 reshape_and_cache / paged attention kernel&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/model_executor/layers/attention/attention.py:716-737&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="860" y="1420" width="374" height="57" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="&lt;font color=&quot;#999999&quot;&gt;④ 释放与回收&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1493" width="1614" height="18" as="geometry" />
        </mxCell>
        <mxCell id="e53" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="36" y="1487" as="sourcePoint" />
            <mxPoint x="1650" y="1487" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n54" value="&lt;b&gt;`request_finished` → `_free_request` → `free_blocks`&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;connector 可以返回 delay_free_blocks=True 来延迟释放（PD 就靠这个 pin 块）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/core/sched/scheduler.py:2625-2652 · block_pool.py:789&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="452" y="1515" width="374" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n55" value="&lt;b&gt;抢占（preemption）：num_computed_tokens=0 + 回 waiting 队头&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;PD 抢占一律 fail-fast：`PD preemption recovery is unsupported`（pd/cloud_scheduler.py:115-117）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;scheduler.py:1541-1582 · LWD 最小重算 lwd_cloud_model_runner.py:575&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="452" y="1595" width="374" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n56" value="&lt;font color=&quot;#999999&quot;&gt;⑤ PD 交接：P 侧 pin → D 侧 pull → 回执解 pin&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1696" width="1614" height="18" as="geometry" />
        </mxCell>
        <mxCell id="e57" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="36" y="1690" as="sourcePoint" />
            <mxPoint x="1650" y="1690" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n58" value="&lt;b&gt;P：`request_finished` 产出 kv_transfer_params + **pin 块**&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;delay_free_blocks=True（:2056-2059）→ 调度器跳过 _free_blocks（scheduler.py:2648）→ KVCacheTaskTracker.delayed_free_requests 记账&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm_ascend/distributed/kv_transfer/kv_p2p/mooncake_connector.py:2014-2076&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="44" y="1718" width="374" height="83" as="geometry" />
        </mxCell>
        <mxCell id="e59" value="P 导出：块级 pull 源地址 + lwd_handoff(p_end / i_end / r_pos / hit)" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="231" y="1828" as="sourcePoint" />
            <mxPoint x="1455" y="1828" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n60" value="&lt;b&gt;D 发起块级 pull（RDMA / memcpy），非 layerwise&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;三个 layerwise 钩子 wait_for_layer_load/save_kv_layer/wait_for_save 全是 pass（:1691/:1695/:1701）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;mooncake_connector.py:3831-3932（recv 线程 :420 · :568）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1268" y="1857" width="374" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n61" value="&lt;b&gt;D：`get_num_new_matched_tokens` → (i_end, True) → 进 `WAITING_FOR_REMOTE_KVS`&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;本轮该请求 forward token 数 = 0；allocate_slots 带 delay_cache_blocks=True&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;mooncake_connector.py:1914-1983 · scheduler.py:1273-1303（:1276）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="44" y="1937" width="374" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n62" value="&lt;b&gt;D：KV_READY 判定 = `num_computed_tokens == r_pos`&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;不满足直接 PD fail（`PD remote KV import failed`），不重算、不降级&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/lwd_control/pd/cloud_scheduler.py:121-130&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="44" y="2032" width="374" height="57" as="geometry" />
        </mxCell>
        <mxCell id="e63" value="D → P：DONE_RECVING_MSG（读完了）" style="endArrow=block;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#82b366;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="231" y="2116" as="sourcePoint" />
            <mxPoint x="1455" y="2116" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n64" value="&lt;b&gt;P：`finished_sending` → `_free_blocks`（真正释放）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;超时兜底：`Force freed expired request`（:232-253）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/core/sched/scheduler.py:3086-3089 · mooncake_connector.py:213-224&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="44" y="2145" width="374" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n65" value="&lt;b&gt;三方 KV 归属&lt;/b&gt;：edge = 无块池（num_blocks=1 空壳，但保留 hash 链给云端命中）；P = 真实块池 + producer（写自己算的 KV，pin 到 D 读完）；D = 真实块池 + consumer（导入 P 的 KV 作为 num_computed 前缀，自己只写 1 行 tail）。易混点：拓扑里的 up/down_buffer_size 是 host UCX 帧块（MB），与 KV 无关；KV 走 kv_port 14579/14580 的 Mooncake 通道。" style="shape=note;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;size=11;" vertex="1" parent="1">
          <mxGeometry x="44" y="2233" width="1598" height="46" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
