            <mxPoint x="2454" y="2725" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n90" value="&lt;b&gt;detokenize → 文本 stop 判定 → SSE 给客户端&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;stop 与计数按 token ID 记，不按可见文本/SSE 帧数&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;output_processor.py:726-777 · serving.py:450&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="392" y="2753" width="314" height="57" as="geometry" />
        </mxCell>
        <mxCell id="e91" value="SSE 增量内容" style="endArrow=block;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#d6b656;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="549" y="2837" as="sourcePoint" />
            <mxPoint x="201" y="2837" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n92" value="&lt;b&gt;冻结 K = detokenizer 输出 token 数 → `lwd_pd_finalize`&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;K 是「前端实际接纳的连续前缀」，正常完成时 K==G&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;output_processor.py:487-509 · lwd_frontend_result.py:105-137&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="392" y="2866" width="314" height="85" as="geometry" />
        </mxCell>
        <mxCell id="e93" value="ZMQ：`LwdPdResultCommit`(K, reason)（每 1s 重发直到回执）" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="897" y="2978" as="sourcePoint" />
            <mxPoint x="1941" y="2978" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n94" value="&lt;b&gt;ledger.commit(K) → 合并 G/K → 形成 usage（N, K, N+K）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;校验 K≤G；complete ⇒ K==G；冲突即 fail&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;pd/results.py:111-135 · pd/cloud_runtime.py:790-823&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1784" y="3007" width="314" height="72" as="geometry" />
        </mxCell>
        <mxCell id="e95" value="ZMQ：`LwdPdResultReceipt`（+ HTTP 侧 SSE data:[DONE]）" style="endArrow=block;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1941" y="3106" as="sourcePoint" />
            <mxPoint x="897" y="3106" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n96" value="&lt;b&gt;三方一致性校验（HTTP 结果 vs 回执）→ `runtime.release(rid)`&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;边侧不重新算 usage，只校验 D 给的结果与 HTTP 路一致&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;pd/edge_runtime.py:492-522,462-467&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="740" y="3135" width="314" height="72" as="geometry" />
        </mxCell>
        <mxCell id="e97" value="SSE 收尾 → 边 `tick()` 取 done 队列" style="endArrow=block;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#d6b656;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1245" y="3234" as="sourcePoint" />
            <mxPoint x="897" y="3234" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
