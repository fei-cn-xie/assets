        <mxCell id="t2" value="这张图与 LWD 无关，是理解 P3~P7 的地基：EngineCore 主线程只做「收包 → 调度 → 执行 → 回包」。LWD 的边/云引擎只是把 scheduler 与 runner 换成自己的实现。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="44" width="1800" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;① 进程骨架：EngineCore 主线程&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="88" width="560" height="22" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="`run_busy_loop()`：只要 has_work 就转&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/engine/core.py:1465-1476&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="40" y="116" width="560" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="`_process_input_queue()`：从 input_queue 取命令&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;core.py:1491-1520&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="560" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="命令分发：ADD / ABORT / WAKEUP / UTILITY&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;core.py:1594-1628&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
