        <mxCell id="n79" value="&lt;font color=&quot;#999999&quot;&gt;⑦ 有效生成 → DOWN → 边侧恢复 token&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="2221" width="2418" height="18" as="geometry" />
