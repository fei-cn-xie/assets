        <mxCell id="n88" value="&lt;font color=&quot;#999999&quot;&gt;⑧ 输出与计量闭环（K 在边、G 在 D）&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
