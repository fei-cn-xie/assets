        <mxCell id="n17" value="`executor.execute_model(scheduler_output)`&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;广播到各 worker：unicast RPC（mp）或直接调用（uni）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/executor/*.py&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="700" y="290" width="620" height="57" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="worker：`execute_model` → `_prepare_inputs` → forward → `sample_tokens`&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;slot_mapping 决定 KV 写到哪一行；采样得到 token&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/worker/gpu_model_runner.py · vllm_ascend/worker/model_runner_v1.py:2227&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
