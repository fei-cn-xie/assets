            <mxPoint x="897" y="2414" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n84" value="&lt;b&gt;`_lwd_schedule_unembed` → authorize_frame → UNEMBED 批&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;校验身份/几何/seqno 连续，防重放与乱序&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;lwd_edge_scheduler.py:457-470,1221-1247 · pd/edge_runtime.py:337-383&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="740" y="2443" width="314" height="85" as="geometry" />
        </mxCell>
        <mxCell id="e85" value="hidden 张量到边 → compute_logits → select_token_batch" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2289" y="2555" as="sourcePoint" />
            <mxPoint x="897" y="2555" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n86" value="&lt;b&gt;`update_from_output` → `_lwd_deliver_unembed` → 追加 token / finish&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;先吃 lwd_up_send_watermarks（释放 pending batch），再交付有效行&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;lwd_edge_scheduler.py:472-512,539-666&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="740" y="2584" width="314" height="85" as="geometry" />
        </mxCell>
        <mxCell id="e87" value="EngineCoreOutputs" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
