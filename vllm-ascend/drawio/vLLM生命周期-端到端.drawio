        <mxCell id="n31" value="&lt;b&gt;`python -m vllm.entrypoints.cli.main serve` → ServeSubcommand.cmd&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;LWD 钩子 serve.py:81 lwd_dispatch_attach_frontend；本形态无 --api-server-* → 返回 False&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/entrypoints/cli/main.py:111 · vllm/entrypoints/cli/serve.py:52&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
