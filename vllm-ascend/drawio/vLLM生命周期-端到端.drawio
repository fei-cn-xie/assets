            <mxPoint x="216" y="578" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n40" value="&lt;font color=&quot;#999999&quot;&gt;② Proxy：只做 HTTP 转交，不看内容&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="613" width="1872" height="18" as="geometry" />
