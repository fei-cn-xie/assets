        <mxCell id="e53" value="ZMQ：`LwdPdBindNotify`(stage=prefill, hit/p_end/i_end/r_pos, 窗口额度)" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
