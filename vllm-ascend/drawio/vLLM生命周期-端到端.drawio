        </mxCell>
        <mxCell id="n57" value="&lt;b&gt;load_model（→ P3 / P4 展开）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;云侧额外 enable_prompt_embeds=True（必须能吃外部 embedding）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm_ascend/worker/model_runner_v1.py:4372 · vllm/model_executor/model_loader/default_loader.py&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="968" y="1645" width="274" height="83" as="geometry" />
        </mxCell>
        <mxCell id="n58" value="&lt;font color=&quot;#999999&quot;&gt;④ sidecar 传输 daemon（每机一个，首个引擎进程拉起）&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1744" width="1830" height="18" as="geometry" />
        </mxCell>
        <mxCell id="e59" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="36" y="1738" as="sourcePoint" />
            <mxPoint x="1866" y="1738" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e60" value="首次 open_transport(mode=&quot;daemon&quot;)：connect → 失败则 flock 后 spawn" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1105" y="1783" as="sourcePoint" />
            <mxPoint x="1413" y="1783" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n61" value="&lt;b&gt;serve_forever：accept ctl → ATTACH/DETACH/PING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;ATTACH 时用 SCM_RIGHTS 回传 3 个 fd（memfd 段 + 两对 pipe）；空闲 30s 自杀&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/lwd_comm/data_comm/ucx_daemon.py:371 · :456-491&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="1276" y="1812" width="274" height="98" as="geometry" />
        </mxCell>
        <mxCell id="n62" value="&lt;font color=&quot;#999999&quot;&gt;⑤ 控制面握手（ZMQ ROUTER/DEALER）&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1926" width="1830" height="18" as="geometry" />
        </mxCell>
        <mxCell id="e63" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="36" y="1920" as="sourcePoint" />
            <mxPoint x="1866" y="1920" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n64" value="&lt;b&gt;_lwd_start_control_plane：ROUTER bind ctrl_port&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;边端 bind（连 6100/6101 的两条链路），云端按拓扑 bind 自己的 ctrl_port&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;lwd_edge_engine.py:126 · vllm/v1/lwd_control/lwd_comm/lwd_control_plane.py&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="660" y="1948" width="274" height="98" as="geometry" />
        </mxCell>
        <mxCell id="e65" value="HELLO + CloudParams（并发上限 / hash block / stage_role / pd_version）" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="797" y="2073" as="sourcePoint" />
            <mxPoint x="1721" y="2073" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e66" value="参数回执 → wait_until_ready(handshake_timeout)" style="endArrow=block;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1721" y="2119" as="sourcePoint" />
            <mxPoint x="797" y="2119" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n67" value="&lt;b&gt;PD 校验：必须同时存在 prefill + decode 且 hash block 一致&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/lwd_control/pd/edge_runtime.py:74-88&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="660" y="2148" width="274" height="59" as="geometry" />
        </mxCell>
        <mxCell id="n68" value="&lt;font color=&quot;#999999&quot;&gt;⑥ 数据面建链（只有边端阻塞等）&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="2223" width="1830" height="18" as="geometry" />
        </mxCell>
        <mxCell id="e69" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="36" y="2217" as="sourcePoint" />
            <mxPoint x="1866" y="2217" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n70" value="&lt;b&gt;lwd_init_host_channels：身份驱动建链 + UP 块定尺 + 内存预算闸&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;UP 块按 hidden_size / hash 层 / max_num_batched_tokens 推导并 32MiB 对齐；预算 12GiB/rank&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm-ascend/.../host/lwd_host_channels.py:219-375&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="968" y="2245" width="274" height="85" as="geometry" />
        </mxCell>
        <mxCell id="e71" value="wait_ready（边端 → 云：单条 605s，最坏 4 条）" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1105" y="2357" as="sourcePoint" />
            <mxPoint x="1721" y="2357" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n72" value="边端启动会静默等链路、进展日志是 WARNING 级；云端只 bind/connect 不等。这也是 README 要求「边端最后启动」的原因。" style="shape=note;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;size=11;" vertex="1" parent="1">
          <mxGeometry x="352" y="2386" width="582" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n73" value="&lt;font color=&quot;#999999&quot;&gt;⑦ KV cache 分配与 warmup（→ P5 展开）&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="2448" width="1830" height="18" as="geometry" />
        </mxCell>
        <mxCell id="e74" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="36" y="2442" as="sourcePoint" />
            <mxPoint x="1866" y="2442" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n75" value="&lt;b&gt;_initialize_kv_caches：spec → 显存画像 → 块池 → initialize_from_config&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;边端 get_kv_cache_spec 返回 {} → 走 else 分支，连 determine_available_memory 都不调用&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/engine/core.py:254-383&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="660" y="2470" width="274" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n76" value="&lt;b&gt;compile_or_warm_up_model（P: eager · D: FULL_DECODE_ONLY）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;边端整段跳过：LwdEdgeWorker.compile_or_warm_up_model 直接返回 0&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/engine/core.py:356&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="660" y="2565" width="274" height="85" as="geometry" />
        </mxCell>
        <mxCell id="e77" value="uvicorn 起服 · /health 200 · 对端握手完成 → ready" style="endArrow=block;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="489" y="2677" as="sourcePoint" />
            <mxPoint x="1721" y="2677" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n78" value="读法：本页讲的是&lt;b&gt;进程骨架&lt;/b&gt;，与具体角色无关，所以方框一律中立色；只有橙/绿两块是真正角色专属的步骤（云端的 coord server、PD 校验）。箭头颜色表示平面：紫=控制面 ZMQ，黄=数据面 UCX，灰=HTTP/进程创建。" style="shape=note;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;size=11;" vertex="1" parent="1">
          <mxGeometry x="44" y="2724" width="1814" height="31" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
