  <diagram id="pg7" name="⑧ MTP 训练与推理">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1278" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑧ MTP 的头：训练期学「往后看几步」，推理期当「便宜的起草者」" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：MTP 头在训练时被一个&lt;b&gt;额外的预测损失&lt;/b&gt;训练出来；训练完之后，它的用途变成&lt;b&gt;推理时的 draft&lt;/b&gt;。所以「MTP」既是训练概念，也是推理概念——本页把两半接起来。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：MTP 层的结构（这些&lt;b&gt;全都能在仓里查到&lt;/b&gt;）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;输入&lt;/b&gt;：① 上一层（或上一个深度）的 hidden states；② 下一个位置的 token embedding&lt;br&gt;&lt;b&gt;处理&lt;/b&gt;：两份各自过一层归一化 → 拼接（维度翻倍）→ 一个线性层压回 hidden 维度&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;：走&lt;b&gt;共享的 lm_head&lt;/b&gt;（与主模型同一个输出头）得到词表分布&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;关键点：它&lt;b&gt;不复制&lt;/b&gt; embedding 与 lm_head，而是复用主模型的——所以额外参数很少（这是「MTP 省显存」的根本原因）。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="1424" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;第二步：同一个头，训练与推理两个用途&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="286" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="318" width="700" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t7" value="&lt;b&gt;训练期：多 token 预测（多一个损失）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="326" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;font style=&quot;font-size:10px&quot;&gt;主模型照常预测下一个词（第 1 个）；MTP 头被训练去预测「再往后一个」（第 2 个）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以它的损失是「用它算的 log 概率，对正确答案取负」，再乘一个权重加到总损失上。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;这个权重字段就在 config 里，注释明写：&lt;b&gt;训练期用、推理期不用&lt;/b&gt;。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;font color=&quot;#c0392b&quot;&gt;（具体的目标函数形式与常见权重取值属通用知识；仓内只证明「存在这样一个权重字段」，不实现这个损失。）&lt;/font&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="352" width="680" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="318" width="664" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t10" value="&lt;b&gt;推理期：当 draft（投机解码的起草者）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="326" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;font style=&quot;font-size:10px&quot;&gt;权重冻结后，MTP 头就变成一个「便宜的下一步预测器」：&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;吃主模型的 hidden，猜出接下来 K 个 token；主模型再一次前向验证。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;此时它&lt;b&gt;不再产生损失&lt;/b&gt;，只产生候选。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 这就是 MTP 套 ⑧ 讲的「draft 走 eager、target 走图」。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="352" width="644" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;b&gt;第三步：一个很实用的细节——MTP 头在权重文件里长什么样&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="516" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:10px&quot;&gt;· 有的 checkpoint 把它写成独立的 &lt;b&gt;mtp.{i}.*&lt;/b&gt; 前缀；有的写成 &lt;b&gt;model.layers.{总层数+i}.*&lt;/b&gt;（假装它是主干之后的第几层）。&lt;br&gt;· 加载器因此要做两件事：&lt;b&gt;①&lt;/b&gt; 把 `mtp.` 重映射到「主干层号之后」；&lt;b&gt;②&lt;/b&gt; 让&lt;b&gt;主模型&lt;/b&gt;在加载时主动&lt;b&gt;跳过&lt;/b&gt;这些层（否则会报「意外的权重」）。&lt;br&gt;· 仓内把「映射到 None 就表示丢弃这个键」作为通用机制——所以主模型对 `mtp.` 的处理就是一句「前缀→None」。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;这也解释了为什么有些模型目录里「多出来一堆 mtp 权重」却能正常加载。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="548" width="1424" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;为什么「训练期的损失权重」在推理侧完全用不到&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;那个权重只决定「训练时 MTP 的误差对总梯度的贡献有多大」，而推理时不更新任何参数 → 与它无关。它在 config 里被保留下来，只是因为 config.json 是&lt;b&gt;一份跨阶段共享的文件&lt;/b&gt;：训练写进去，推理读进来但忽略。&lt;font color=&quot;#c0392b&quot;&gt;这也是「训练期字段被带进推理配置」的典型例子。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="706" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：MTP 的两半接上了。下一步（⑨）回到加载器视角——看它如何在同一个目录里只挑它要的文件。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="842" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;MTP 层结构（enorm/hnorm/eh_proj/共享 lm_head）：vllm/model_executor/models/deepseek_mtp.py:80-124、:136-147&lt;br&gt;「训练期字段、推理不用」原文：vllm/transformers_utils/configs/hy_v4.py:53-54；默认值 :130-131&lt;br&gt;另一处同类字段（MoE 的辅助损失开关）：vllm/transformers_utils/configs/hy_v3.py:84-87&lt;br&gt;checkpoint 键名重映射 mtp.{i}.* → model.layers.{N+i}.*：vllm/models/deepseek_v4/nvidia/mtp.py:392-398；识别与跳过 vllm/model_executor/models/utils.py:543-568、:571-587&lt;br&gt;主模型对 mtp. 前缀的丢弃：vllm/model_executor/models/qwen3_next.py:810 等（WeightsMapper(orig_to_new_prefix={'mtp.': None})）&lt;br&gt;WeightsMapper 的「映射成 None 即忽略」机制：vllm/model_executor/models/utils.py:46-57&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="918" width="1424" height="136" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;MTP 头 = 训练期多学一个「往后看」的目标、推理期当便宜的起草者；它的损失权重只影响训练，而它的权重在文件里可能写成 `mtp.*` 或「主干之后的层」——&lt;b&gt;加载器靠「映射成 None 就丢弃」把两半分开。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1088" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1180" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1177" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1177" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1177" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1177" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1177" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1177" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1177" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="训练期语义（多为通用知识）" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1177" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e27" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1226" as="sourcePoint"/>
            <mxPoint x="204" y="1226" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t28" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1214" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e29" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1226" as="sourcePoint"/>
            <mxPoint x="454" y="1226" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t30" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1214" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e31" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1226" as="sourcePoint"/>
            <mxPoint x="704" y="1226" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t32" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
