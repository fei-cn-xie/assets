<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" pages="10">
  <diagram id="pg0" name="① 训练与推理的边界">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1066" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="① 先划清边界：vLLM 不做训练，但它和训练共享三样东西" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：vLLM 是&lt;b&gt;推理引擎&lt;/b&gt;——它没有反向传播、没有优化器、没有损失函数；但它的&lt;b&gt;模型定义、权重文件格式、配置约定&lt;/b&gt;与训练侧是同一套。搞清这一点，才不会在仓里白找训练代码。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：一条完整的「造模型」流水线（vLLM 只站在最右端）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;数据&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;清洗 / 去重 / 配比&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="274" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;训练&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;前向 + 损失 + 反向 + 更新&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="320" y="150" width="274" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="311" y="193" as="sourcePoint"/>
            <mxPoint x="319" y="193" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;产出&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;checkpoint（权重 + 优化器状态）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="604" y="150" width="274" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="595" y="193" as="sourcePoint"/>
            <mxPoint x="603" y="193" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;转换&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;合并分片 / 格式转换 / 量化&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="888" y="150" width="274" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="879" y="193" as="sourcePoint"/>
            <mxPoint x="887" y="193" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;部署&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;vLLM 加载并服务&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1172" y="150" width="274" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1163" y="193" as="sourcePoint"/>
            <mxPoint x="1171" y="193" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t13" value="&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;本仓两份材料的分工：① 训练侧（本套）只在“产出 → 转换”这一段；② 其余八套讲最右边的“部署”以及它与前面各段的接口。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="246" width="1424" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;b&gt;第二步：训练与推理共享的三样东西（这才是本套的意义）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="258" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="290" width="460" height="186" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;b&gt;① 模型结构定义&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="298" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;font style=&quot;font-size:10px&quot;&gt;同一个 `deepseek_mtp` / `qwen` 类既描述了「训练时怎么算」，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;也描述了「推理时怎么算」——只是推理不挂 backward。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以读 vLLM 的 models/ 目录，本质上是在读训练代码的 forward 部分。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="324" width="440" height="144" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="518" y="290" width="460" height="186" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;b&gt;② 权重文件格式&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="298" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;font style=&quot;font-size:10px&quot;&gt;训练输出 safetensors 分片 + index.json；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;推理按同一份 index 只读权重，忽略优化器/训练状态文件。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;名字、形状、分片约定必须完全一致，否则加载报形状不匹配。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="324" width="440" height="144" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="290" width="460" height="186" as="geometry"/>
        </mxCell>
        <mxCell id="t22" value="&lt;b&gt;③ 配置约定&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="298" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;font style=&quot;font-size:10px&quot;&gt;`config.json` 里的层数、头数、隐藏维度既决定训练参数量，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;也决定推理的显存与并行切分。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;还有像 `num_nextn_predict_layers` 这种「训练期定义、推理期复用」的字段。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="324" width="440" height="144" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;第三步：在 vLLM 仓里找不到的四样东西（省下你的搜索时间）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;反向传播&lt;/b&gt;（全仓 0 处 `loss.backward`）；② &lt;b&gt;优化器&lt;/b&gt;（0 处 `AdamW`/梯度清零）；③ &lt;b&gt;数据加载&lt;/b&gt;（包内 0 处 `DataLoader`）；④ &lt;b&gt;训练循环&lt;/b&gt;（0 处 `model.train()`，只有 `model.eval()`）。&lt;br&gt;但它&lt;b&gt;确实有一块与训练打交道的代码&lt;/b&gt;：一套跑在&lt;b&gt;训练进程侧&lt;/b&gt;的「权重同步客户端」（把新权重推给正在服务的推理引擎），这是为强化学习准备的——详见第 ⑩ 页。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;它多出来的是训练侧没有的东西：&lt;b&gt;调度器、KV cache、批量管理与图捕获&lt;/b&gt;——因为只有推理才需要「持续服务很多长短不一的请求」。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="516" width="1424" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：边界划清了。下一步（②）把训练那一格展开——一次训练 step 到底在算什么，以及它和推理的那一步差在哪。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="664" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vLLM 的自我定位（serving）：vllm/README.md:1&lt;br&gt;模型定义被推理复用：vllm/model_executor/models/（每个模型一个 forward）&lt;br&gt;权重加载只吃权重、忽略训练状态：vllm/model_executor/model_loader/weight_utils.py:1002、:1253-1271&lt;br&gt;训练期定义但推理期不用的字段示例：vllm/transformers_utils/configs/hy_v4.py:53-54（mtp_loss_factor 注释写明 unused at inference）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="740" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;vLLM 不做训练，但它与训练共享&lt;b&gt;模型结构、权重格式、配置&lt;/b&gt;；所以「理解训练」的价值不是去改 vLLM，而是&lt;b&gt;理解那些权重数字是怎么来的、哪些字段只在训练期有意义&lt;/b&gt;。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="876" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="968" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="965" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="965" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="965" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="965" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="965" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="965" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="965" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e36" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1014" as="sourcePoint"/>
            <mxPoint x="204" y="1014" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t37" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1002" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e38" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1014" as="sourcePoint"/>
            <mxPoint x="454" y="1014" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t39" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1002" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e40" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1014" as="sourcePoint"/>
            <mxPoint x="704" y="1014" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t41" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1002" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg1" name="② 训练 step 数据流">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1066" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="② 一次训练 step：九步数据流，其中只有四步会出现在推理里" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：训练一步 = &lt;b&gt;切 token → 前向 → 算损失 → 反向 → 更新&lt;/b&gt;；推理只保留「切 token → 前向 → 采样」，把中间三步全砍掉——这就是为什么推理能省下大半显存。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：九步（蓝＝训练独有，绿＝推理也有）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;①&lt;/b&gt; 取一条文本&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;数据集采样 → 一段字符串&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="148" width="156" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;②&lt;/b&gt; 分词&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;字符串 → token id 序列&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="198" y="148" width="156" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="193" y="200" as="sourcePoint"/>
            <mxPoint x="197" y="200" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;③&lt;/b&gt; 拼成 batch&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;多条序列补齐或打包（二维/一维）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="148" width="156" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="355" y="200" as="sourcePoint"/>
            <mxPoint x="359" y="200" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;④&lt;/b&gt; 前向 forward&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;逐层算 → 每个位置的 logits&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="522" y="148" width="156" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="517" y="200" as="sourcePoint"/>
            <mxPoint x="521" y="200" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;⑤&lt;/b&gt; 算损失 loss&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;与「下一个词」比对 → 一个标量&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="684" y="148" width="156" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="679" y="200" as="sourcePoint"/>
            <mxPoint x="683" y="200" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;⑥&lt;/b&gt; 反向 backward&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;从 loss 回传 → 每个参数的梯度&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="846" y="148" width="156" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="e14" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="841" y="200" as="sourcePoint"/>
            <mxPoint x="845" y="200" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;⑦&lt;/b&gt; 更新参数&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;优化器按梯度走一小步&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1008" y="148" width="156" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="e16" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1003" y="200" as="sourcePoint"/>
            <mxPoint x="1007" y="200" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n17" value="&lt;b&gt;⑧&lt;/b&gt; 清梯度&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;梯度清零，进入下一步&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1170" y="148" width="156" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="e18" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1165" y="200" as="sourcePoint"/>
            <mxPoint x="1169" y="200" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n19" value="&lt;b&gt;⑨&lt;/b&gt; 周期存档&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;checkpoint：权重 + 优化器状态&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1332" y="148" width="156" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="e20" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1327" y="200" as="sourcePoint"/>
            <mxPoint x="1331" y="200" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t21" value="&lt;b&gt;第二步：推理把 ④ 之后换成什么（砍掉 ⑤~⑧，加上采样）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="260" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:10px&quot;&gt;推理：① 文本 → ② 分词 → ③ 组批 → ④ &lt;b&gt;前向&lt;/b&gt; → &lt;b&gt;⑤′ 取最后一个位置的 logits → 采样一个 token&lt;/b&gt; → 把它接回输入，重复。&lt;br&gt;区别的关键：&lt;b&gt;训练要「每个位置」的 logits&lt;/b&gt;（因为要跟每个位置的正确下一个词比对），而&lt;b&gt;推理只要「最后一个位置」的 logits&lt;/b&gt;（因为只需要下一个词）。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;注意 ⑤′ 之后没有损失、没有梯度、没有更新——权重从加载那一刻起就不变了（唯一的例外是图捕获时的格式重排）。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="292" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;b&gt;第三步：三处「名字一样、语义不一样」的地方（最容易混）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="416" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="448" width="460" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t25" value="&lt;b&gt;batch 的含义&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="456" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t26" value="&lt;font style=&quot;font-size:10px&quot;&gt;训练：为了「梯度更稳、算力更满」把样本堆起来；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;推理：为了「吞吐」把不同请求拼一起，但会牺牲单请求延迟。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 训练 batch 越大越好；推理 batch 是个权衡（入门套 ⑥）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="482" width="440" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="518" y="448" width="460" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;b&gt;序列长度的处理&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="456" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t29" value="&lt;font style=&quot;font-size:10px&quot;&gt;训练：整条样本一次算完（长度固定后 padding）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;推理：先算 prompt（一次），再逐 token 续写 —— 这就是 prefill/decode 之分。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 同一个 forward，被切成两种形态调用（入门套 ④）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="482" width="440" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1000" y="448" width="460" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t31" value="&lt;b&gt;精度&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="456" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t32" value="&lt;font style=&quot;font-size:10px&quot;&gt;训练：前向用低精度、但主权重与梯度累加常保持高精度（数值稳定）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;推理：整份权重就是低精度（甚至量化），因为不需要数值稳定性。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 这是「量化」在推理侧能成立的前提（见 ⑧）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="482" width="440" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：九步里最关键的一步是 ⑤ 算损失——它定义「模型在学什么」。下一步（③）把损失与 logits 讲清：为什么它就是一个词表上的概率分布。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="664" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;推理侧的 logits 计算与采样：vllm/v1/sample/sampler.py:21（Sampler）、:73（forward）&lt;br&gt;词表维度的分布：vllm/model_executor/layers/logits_processor.py（按 vocab 维算）&lt;br&gt;「只取最后一个位置」的体现：gpu_model_runner 里 logits_indices 的构造（vllm/v1/worker/gpu_model_runner.py:4478-4499 附近）&lt;br&gt;训练侧的五步（损失/反向/更新/清梯度/存档）在 vLLM 仓内&lt;b&gt;不存在&lt;/b&gt;：见 ① 页的说明&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="740" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;训练一步九步、推理一步四步；差别集中在「要不要对每个位置算损失、要不要保留中间激活」——&lt;b&gt;这两件事决定了显存里有没有梯度与激活这两块。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="876" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t36" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="968" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="965" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="965" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="965" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="965" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="965" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="965" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="965" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="训练独有" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1044" y="965" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e45" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1014" as="sourcePoint"/>
            <mxPoint x="204" y="1014" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t46" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1002" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e47" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1014" as="sourcePoint"/>
            <mxPoint x="454" y="1014" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t48" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1002" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e49" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1014" as="sourcePoint"/>
            <mxPoint x="704" y="1014" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t50" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1002" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg2" name="③ 损失与 logits">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1310" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="③ 损失与 logits：模型输出其实是一个「词表上的分布」" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：一次前向的产物是 &lt;b&gt;[token 数, 词表大小]&lt;/b&gt; 的分数矩阵；推理拿它&lt;b&gt;挑一个&lt;/b&gt;（采样），训练拿它&lt;b&gt;打分&lt;/b&gt;（−log p(正确词)，即交叉熵）。同一个量，两种用法。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：一条链（前四步仓内都能查到，最后一步是训练侧用法）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;hidden&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;每层输出的隐藏向量&lt;br&gt;[token 数, hidden]&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="270" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;lm_head&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;乘到词表维度&lt;br&gt;[token 数, 词表大小]&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="317" y="150" width="270" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="308" y="198" as="sourcePoint"/>
            <mxPoint x="316" y="198" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;log_softmax&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;取对数概率&lt;br&gt;仍是 [token 数, 词表大小]&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="598" y="150" width="270" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="589" y="198" as="sourcePoint"/>
            <mxPoint x="597" y="198" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;推理：挑一个&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;argmax / 按概率采样&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="879" y="150" width="270" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="870" y="198" as="sourcePoint"/>
            <mxPoint x="878" y="198" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;训练：−log p(y)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;取正确词那一列取负 → 一个标量&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1160" y="150" width="270" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1151" y="198" as="sourcePoint"/>
            <mxPoint x="1159" y="198" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t13" value="&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;前四步（含 log_softmax）在仓内有实现；最右一格是训练侧独有的用法，仓内没有它的代码——它只出现在训练框架里。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="256" width="1424" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;b&gt;第二步：为什么叫「分布」（三个必须理解的细节）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="266" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="298" width="460" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;b&gt;① 词表有多大&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="306" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;font style=&quot;font-size:10px&quot;&gt;每一行都是「下一个词是词表里第 i 个词」的分数。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;词表通常几万到十几万 → 这个矩阵很宽。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以 lm_head 是全模型里「输出维度最大」的那一层。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="332" width="440" height="138" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="518" y="298" width="460" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;b&gt;② 为什么要 log_softmax 而不是 softmax&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="306" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;font style=&quot;font-size:10px&quot;&gt;概率连乘会下溢，取对数后变成相加，数值稳定；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;而且 log 概率单调 → 排序不变（仓内注释明说这一点）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;仓内 softmax/log_softmax 一律用 fp32 算，避免精度问题。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="332" width="440" height="138" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1000" y="298" width="460" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="t22" value="&lt;b&gt;③ 训练要「每个位置」，推理只要「最后一个」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="306" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;font style=&quot;font-size:10px&quot;&gt;训练：每个位置都有一个「正确的下一个词」，所以每个位置都算损失；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;推理：只关心接下来那一个词，所以只取最后一个位置的分布。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 这就是「推理比训练省一大截」的第一层原因。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="332" width="440" height="138" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;第三步：交叉熵到底在算什么（一句话 + 一个直觉）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;交叉熵 = &lt;b&gt;−log p(正确词)&lt;/b&gt;：模型给正确词的概率越高，损失越小；给得越低，损失越大。&lt;br&gt;直觉：它衡量的不是「答案对不对」，而是「模型有多确信正确答案」——所以哪怕 argmax 对了，只要概率很低，损失依然大，梯度依然会推着它变得更确信。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;这一步在 vLLM 仓里&lt;b&gt;不存在&lt;/b&gt;：vLLM 只把 log 概率算出来（用于返回 logprobs），不拿它跟标签比。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="518" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t25" value="&lt;b&gt;第四步：推理会在「分布」上再做四件事（训练侧不做或做法不同）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="642" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;加工&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="674" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;怎么做&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="336" y="674" width="560" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;b&gt;目的&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="896" y="674" width="564" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;温度 temperature&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="710" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;把 logits 除以 T 再 softmax&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="710" width="560" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;T→0 变贪心，T 大更随机&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="896" y="710" width="564" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;top-k / top-p&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="746" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:11px&quot;&gt;只保留前 k 个 / 累计概率到 p 的词&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="746" width="560" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:11px&quot;&gt;裁掉长尾，避免抽到离谱词&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="896" y="746" width="564" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;font style=&quot;font-size:11px&quot;&gt;罚分（重复/存在/频率）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="782" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;font style=&quot;font-size:11px&quot;&gt;对已出现过的词降分&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="782" width="560" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;font style=&quot;font-size:11px&quot;&gt;抑制复读&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="896" y="782" width="564" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;font style=&quot;font-size:11px&quot;&gt;logprobs 输出&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="818" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;font style=&quot;font-size:11px&quot;&gt;把 log 概率返回给调用方&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="818" width="560" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;font style=&quot;font-size:11px&quot;&gt;用于打分、置信度、RL 训练信号&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="896" y="818" width="564" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：logits 这条链解释了「训练的损失从哪来」。下一步（④）算显存账：训练为什么要多存三份东西，推理为什么不用。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="890" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;logits 的产生：vllm/model_executor/layers/logits_processor.py:108；fp32 输出 :163-170&lt;br&gt;softmax 求概率：vllm/v1/sample/ops/topk_topp_sampler.py:168&lt;br&gt;log_softmax（logprobs）：vllm/v1/sample/sampler.py:306-307；fp32 注释 :96-97；单调性注释 :213-214&lt;br&gt;形状文档：vllm/docs/design/logits_processors.md:13（（num_requests) × (vocab_size)）&lt;br&gt;「只算采样位」的切片：vllm/v1/worker/gpu/model_runner.py:915&lt;br&gt;仓内明说没有反向：vllm/third_party/flash_linear_attention/ops/layernorm_guard.py:514-516&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="966" width="1424" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;模型输出是「词表上的分数」；推理&lt;b&gt;挑一个&lt;/b&gt;、训练&lt;b&gt;用正确答案给它打分&lt;/b&gt;。理解这一点，才能理解为什么训练要每个位置的分布、推理只要最后一个。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1120" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t44" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1212" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1209" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1209" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1209" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1209" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1209" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1209" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1209" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="训练侧用法（仓内无实现）" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1209" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e53" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1258" as="sourcePoint"/>
            <mxPoint x="204" y="1258" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t54" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1246" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e55" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1258" as="sourcePoint"/>
            <mxPoint x="454" y="1258" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t56" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1246" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e57" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1258" as="sourcePoint"/>
            <mxPoint x="704" y="1258" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t58" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1246" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg3" name="④ 显存账对照">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1386" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="④ 显存账：训练要存四份东西，推理只存三份（且其中一份是「峰值」）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：训练显存 = &lt;b&gt;权重 + 梯度 + 优化器状态 + 激活&lt;/b&gt;；推理显存 = &lt;b&gt;权重 + KV cache + 激活峰值&lt;/b&gt;。前者「梯度、优化器」两份在推理里根本不存在——这就是同样一张卡推理能扛更多并发的根本原因。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：六项对照（右列带锚点＝本仓可查；标「通用知识」＝仓内无依据）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;项&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="148" width="150" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;训练&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="186" y="148" width="520" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;推理&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="706" y="148" width="460" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;结论&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1166" y="148" width="294" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;font style=&quot;font-size:11px&quot;&gt;权重&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="190" width="150" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;font style=&quot;font-size:11px&quot;&gt;1× 参数量（通用知识）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="186" y="190" width="520" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;font style=&quot;font-size:11px&quot;&gt;1× 参数量（仓内日志明确统计）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="706" y="190" width="460" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:11px&quot;&gt;两边都有&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1166" y="190" width="294" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;梯度&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="232" width="150" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;≈1× 参数量（通用知识）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="186" y="232" width="520" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;没有&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="706" y="232" width="460" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;推理不反向&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1166" y="232" width="294" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;优化器状态&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="274" width="150" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;Adam 一阶+二阶 ≈2×，混合精度再加 1× fp32 主权重（通用知识）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="186" y="274" width="520" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;没有&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="706" y="274" width="460" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;推理不更新&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1166" y="274" width="294" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;激活&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="316" width="150" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;要留到反向用，∝ 层数×batch×序列（通用知识）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="186" y="316" width="520" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;只要峰值&lt;/b&gt;，算完即释放&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="706" y="316" width="460" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;推理不留账本&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1166" y="316" width="294" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;KV cache&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="358" width="150" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;不存在（整段并行算，不缓存）（通用知识）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="186" y="358" width="520" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;推理独有，随 token 线性增长&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="706" y="358" width="460" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;推理独有&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1166" y="358" width="294" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;经验比例&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="400" width="150" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;混合精度 Adam 常按 权重:梯度:优化器 ≈ 1:1:2（通用知识）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="186" y="400" width="520" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;权重 + 激活峰值 + KV（仓内会计口径）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="706" y="400" width="460" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;差一个量级&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1166" y="400" width="294" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="t32" value="&lt;b&gt;第二步：推理侧的会计口径（这是仓内真的在跑的一段代码）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="450" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;非 KV 显存 = 权重 + 非 torch 占用 + 激活峰值 + 图显存&lt;/b&gt;&lt;br&gt;&lt;b&gt;KV 可用 = 显存上限 − 非 KV 显存 − 一小块冗余&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;日志会把这四项分开打印（权重、峰值激活、图显存各多少 GiB），所以「为什么 KV 只剩这么点」是&lt;b&gt;可以直接查&lt;/b&gt;的，不用猜。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="482" width="1424" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="t34" value="&lt;b&gt;第三步：由这张表能推出的三个实践结论&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="598" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="630" width="460" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t36" value="&lt;b&gt;① 同样一张卡，推理能扛更多并发&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="638" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t37" value="&lt;font style=&quot;font-size:10px&quot;&gt;训练要花 3~4 倍参数量的显存在梯度与优化器上；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;推理把这两份全省下来 → 全部可以给 KV。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;这就是「部署 7B 模型单卡能跑几十并发」的算术基础。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="664" width="440" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="518" y="630" width="460" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t39" value="&lt;b&gt;② 训练用「重算」换显存，推理用「缓存」换算力&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="638" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t40" value="&lt;font style=&quot;font-size:10px&quot;&gt;训练显存紧张 → 重算激活（checkpointing）、切分到多卡；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;推理算力闲着 → 把历史 K/V 缓存下来（KV cache），&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;拿显存换算力——两者方向相反，因为瓶颈不同。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="664" width="440" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1000" y="630" width="460" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t42" value="&lt;b&gt;③ 推理多了「激活峰值」这个必须量的东西&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="638" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t43" value="&lt;font style=&quot;font-size:10px&quot;&gt;训练不需要精确知道激活峰值（反正都要存）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;推理必须先空跑一遍量出峰值，才能算出「还剩多少给 KV」。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 这就是启动时那次 profile_run 存在的唯一理由。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="664" width="440" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="&lt;b&gt;一句话把训练与推理的显存哲学分开&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;训练：&lt;b&gt;显存换正确性&lt;/b&gt;——存下中间结果，才能算梯度、才能更新。&lt;br&gt;推理：&lt;b&gt;显存换并发&lt;/b&gt;——不存梯度，改成存 KV，让更多请求同时在跑。&lt;br&gt;于是同一份权重，在两种场景下的「最优显存布局」完全相反。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="838" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：四项里最容易被低估的是「激活」。下一步（⑤）专门讲它——包括一个从 288 MB 涨到 6 GB 的真实算术。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="974" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;推理的会计口径（非 KV = 权重+非torch+激活峰值+图）：vllm/v1/worker/gpu_worker.py:850-854；日志文案 :873-877&lt;br&gt;加权算例（权重 2 GiB + 激活峰值 2 GiB + 非 torch 1 GiB）：vllm/utils/mem_utils.py:242-273&lt;br&gt;推理只用推理模式（不建梯度图）：vllm/v1/worker/gpu/model_runner.py:773 等 @torch.inference_mode()&lt;br&gt;「vLLM 是推理专用、没有反向」的原文：vllm/third_party/flash_linear_attention/ops/layernorm_guard.py:514-516&lt;br&gt;训练侧四项系数与 1:1:2 比例：通用知识（仓内无依据）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1050" width="1424" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;训练显存 = 权重 + 梯度 + 优化器 + 激活账本；推理显存 = 权重 + KV + 激活峰值。&lt;b&gt;少掉的是「为了更新参数而付的钱」，多出来的是「为了服务并发而付的钱」。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1196" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t48" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1288" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1285" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1285" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1285" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1285" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n53" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1285" width="120" height="26" as="geometry"/>
