  </diagram>
  <diagram id="pg9" name="⑩ RL 后端接口">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1528" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑩ 真实接口：训练框架把 vLLM 当成「会改权重的推理后端」" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：强化学习需要「&lt;b&gt;用当前策略采样 → 训练 → 更新策略 → 再采样&lt;/b&gt;」，而采样这一步就是推理。于是 vLLM 提供了&lt;b&gt;权重同步、暂停/继续、逐层热更新、休眠让卡&lt;/b&gt;这些为训练准备的能力——这是训练与推理唯一真实的耦合面。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：RL 训练的一个回合（vLLM 在「采样」这一格）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;① 采样&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;用当前权重跑推理，生成回答并记录概率&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="148" width="274" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;② 打分&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;奖励模型 / 规则给每个回答打分&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="321" y="148" width="274" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="312" y="194" as="sourcePoint"/>
            <mxPoint x="320" y="194" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;③ 训练&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;按优势算策略梯度，更新权重&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="606" y="148" width="274" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="597" y="194" as="sourcePoint"/>
            <mxPoint x="605" y="194" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;④ 同步&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;把新权重推给正在服务的推理引擎&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="891" y="148" width="274" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="882" y="194" as="sourcePoint"/>
            <mxPoint x="890" y="194" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;⑤ 回到 ①&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;下一回合用新权重继续采样&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1176" y="148" width="274" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1167" y="194" as="sourcePoint"/>
            <mxPoint x="1175" y="194" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t13" value="&lt;b&gt;第二步：为此 vLLM 提供了四件东西（都在仓里能查到）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="248" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="280" width="460" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;b&gt;① 权重同步通道&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="288" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;font style=&quot;font-size:10px&quot;&gt;训练进程侧有一个「发送端」引擎，推理侧有一个「接收端」；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;中间可以走 NCCL、共享内存、分片传输等多种后端。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;还配了一组 HTTP 控制路由（暂停采样 / 初始化 / 开始更新 / 结束）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="314" width="440" height="154" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="518" y="280" width="460" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;b&gt;② 暂停 / 继续&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="288" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;font style=&quot;font-size:10px&quot;&gt;更新权重时不能让引擎正在生成 → 先暂停（把在跑的请求收尾），&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;更新完再继续。这样训练与推理可以共用同一批卡。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="314" width="440" height="154" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1000" y="280" width="460" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;b&gt;③ 逐层热更新&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="288" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t22" value="&lt;font style=&quot;font-size:10px&quot;&gt;更细的做法：按层加载新权重，不重启引擎。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;并且&lt;b&gt;保持张量地址不变&lt;/b&gt;——否则已捕获的图会失效（图捕获 ④ 的约束二）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;代价：更新期间该层算出的结果可能新旧混用，所以必须暂停。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="314" width="440" height="154" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;b&gt;第三步：两个很容易被忽略、但对 RL 很关键的能力&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="484" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="516" width="700" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="t25" value="&lt;b&gt;休眠（让出显存给训练）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="524" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t26" value="&lt;font style=&quot;font-size:10px&quot;&gt;训练要占大量显存（梯度+优化器），与推理抢卡；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以推理引擎支持「睡下去」把显存还回去，训练完再「醒来」。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;可以只回权重（保留 KV 结构）或全放。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="550" width="680" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="516" width="664" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;b&gt;采样掩码 / 路由复现（一致性）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="524" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t29" value="&lt;font style=&quot;font-size:10px&quot;&gt;RL 要保证「推理时算的概率」与「训练时假设的概率」一致：&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① 把 top-k/top-p 实际保留下来的词集合返回给训练侧；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;② 把 MoE 的路由选择也返回；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;③ 输出头用 fp32 算（⑥ 页那条）——三者都是为同一件事。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="550" width="644" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="t30" value="&lt;b&gt;第四步：这条链上「谁负责什么」（避免把它们当成同一个东西）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="694" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;角色&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="726" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;职责&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="556" y="726" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;在哪&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1076" y="726" width="384" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:11px&quot;&gt;训练框架（verl / TRL / OpenRLHF …）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="762" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;font style=&quot;font-size:11px&quot;&gt;算策略梯度、决定权重怎么变&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="556" y="762" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;font style=&quot;font-size:11px&quot;&gt;仓外&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="762" width="384" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;font style=&quot;font-size:11px&quot;&gt;训练进程侧的同步客户端&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="798" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;font style=&quot;font-size:11px&quot;&gt;把新权重推过去、发暂停/更新指令&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="556" y="798" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;仓内&lt;/b&gt;（不在训练循环里）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="798" width="384" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;font style=&quot;font-size:11px&quot;&gt;vLLM 引擎&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="834" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;font style=&quot;font-size:11px&quot;&gt;用当前权重采样、返回概率与统计&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="556" y="834" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;仓内&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="834" width="384" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="&lt;font style=&quot;font-size:11px&quot;&gt;训练脚本&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="870" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="&lt;font style=&quot;font-size:11px&quot;&gt;决定 K、温度、批次等采样参数&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="556" y="870" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="&lt;font style=&quot;font-size:11px&quot;&gt;仓外&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="870" width="384" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="&lt;b&gt;三句话总结本套&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;训练&lt;/b&gt;：靠梯度改权重，显存花在梯度/优化器/激活上，产出 checkpoint。&lt;br&gt;② &lt;b&gt;推理&lt;/b&gt;：只读权重，显存花在 KV 上，靠调度/图/量化/投机把每个 token 变便宜。&lt;br&gt;③ &lt;b&gt;两者的接口只有三处&lt;/b&gt;：权重文件（含量化描述）、配置字段（训练期字段被忽略）、以及 RL 场景下的运行时权重同步。&lt;font color=&quot;#c0392b&quot;&gt;除此之外它们几乎不重叠——这就是为什么读 vLLM 时找不到训练代码，却处处能看到「为训练准备」的开关。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="940" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：训练侧到此闭合。回到 `学习地图.md`，这一套应插在「Transformer 与模型文件结构」之后、「入门」之前读——它解释的是「权重从哪来」，而入门套解释的是「系统为什么这么设计」。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1076" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;权重同步配置（文档串明写 RL training）：vllm/config/weight_transfer.py:8-15&lt;br&gt;训练侧引擎「跑在训练进程里」：vllm/distributed/weight_transfer/base.py:554-583&lt;br&gt;推理侧引擎与初始化时机：同文件 :465-479、:528-535&lt;br&gt;四种同步后端注册表：vllm/distributed/weight_transfer/factory.py:244-266&lt;br&gt;RLHF HTTP 控制路由（暂停/初始化/开始/结束/更新）：vllm/entrypoints/serve/dev/rlhf/api_router.py:29、:157、:175、:187、:205&lt;br&gt;「给 RL 训练用」的推理开关：vllm/config/model.py:1965-1978（head_dtype fp32，原文 required for RL training-inference consistency）、:250-253（return_sampling_mask / routed_experts）&lt;br&gt;休眠/唤醒：vllm/docs/features/sleep_mode.md:3、:60-64&lt;br&gt;仓内 verl 的痕迹：vllm/distributed/parallel_state.py:2075-2077（注释提到 verl integration）&lt;br&gt;训练生态清单：vllm/docs/training/rlhf.md:5-17&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1152" width="1424" height="152" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;训练与推理的运行时接口只在 RL 场景显形——「采样用 vLLM，训练完把权重同步回来」；&lt;b&gt;那套同步/暂停/热更新/休眠的代码就在 vLLM 仓里，但它本身仍然不是训练框架。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1338" width="1424" height="58" as="geometry"/>
        </mxCell>
