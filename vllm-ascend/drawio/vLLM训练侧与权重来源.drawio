  </diagram>
  <diagram id="pg8" name="⑨ 加载器挑文件">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1332" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑨ 训练目录 → 推理加载：五个文件被明确丢弃" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：训练产出的目录里通常有&lt;b&gt;权重 + 优化器状态 + 调度器状态 + 缩放器状态 + 训练参数&lt;/b&gt;；推理只吃权重，其余五个在加载时被&lt;b&gt;按文件名直接过滤掉&lt;/b&gt;——这一条在仓里写得很清楚。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：一个训练产出的目录（左：推理要的；右：推理丢的）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;推理要的&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· &lt;b&gt;model-*.safetensors&lt;/b&gt;（分片权重）&lt;br&gt;· &lt;b&gt;*.safetensors.index.json&lt;/b&gt;（哪个张量在哪个分片）&lt;br&gt;· &lt;b&gt;config.json&lt;/b&gt;（结构参数）&lt;br&gt;· &lt;b&gt;tokenizer 相关文件&lt;/b&gt;（分词器与模板）&lt;br&gt;· （若量化）&lt;b&gt;量化描述文件&lt;/b&gt;：每层用哪个量化方案&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="148" width="690" height="208" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;推理明确丢弃的五个&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· &lt;b&gt;optimizer.bin / optimizer.pt&lt;/b&gt;（Adam 动量与方差）&lt;br&gt;· &lt;b&gt;scheduler.pt&lt;/b&gt;（学习率调度状态）&lt;br&gt;· &lt;b&gt;scaler.pt&lt;/b&gt;（fp16 梯度缩放器状态）&lt;br&gt;· &lt;b&gt;training_args.bin&lt;/b&gt;（训练参数快照）&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;仓内有一份&lt;b&gt;黑名单函数&lt;/b&gt;，就按这五个文件名过滤——这是「推理不关心训练状态」最直接的代码证据。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="766" y="148" width="694" height="208" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;b&gt;第二步：加载器只挑权重时的六步&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="364" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;① 过滤文件&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;黑名单剔掉五个训练文件&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="396" width="224" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;② 按扩展名白名单&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;只取 safetensors / bin&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="272" y="396" width="224" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="262" y="440" as="sourcePoint"/>
            <mxPoint x="270" y="440" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;③ 校验分片完整&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;索引里列的文件必须都在&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="508" y="396" width="224" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="e11" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="498" y="440" as="sourcePoint"/>
            <mxPoint x="506" y="440" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;④ 逐张量读盘&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;读成 CPU 张量，不占设备显存&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="744" y="396" width="224" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="e13" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="734" y="440" as="sourcePoint"/>
            <mxPoint x="742" y="440" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;⑤ 名字映射&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;改名 / 合并（q,k,v → qkv）/ 丢弃（None）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="980" y="396" width="224" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="e15" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="970" y="440" as="sourcePoint"/>
            <mxPoint x="978" y="440" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;⑥ 写进参数&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;按 TP 切片后 copy_ 到设备&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1216" y="396" width="224" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="e17" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1206" y="440" as="sourcePoint"/>
            <mxPoint x="1214" y="440" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t18" value="&lt;b&gt;第三步：第 ⑤ 步里的三种操作（第三种是本套反复出现的关键机制）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="492" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;b&gt;操作&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="524" width="160" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;b&gt;什么时候用&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="196" y="524" width="500" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;怎么实现&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="696" y="524" width="420" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;备注&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1116" y="524" width="344" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;改名&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="560" width="160" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;文件里的名字与代码里的名字不同（例如加前缀）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="196" y="560" width="500" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;一张「旧名 → 新名」的映射表&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="696" y="560" width="420" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;普通过滤&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1116" y="560" width="344" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;合并&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="596" width="160" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;文件里 q/k/v 三个权重，代码里是一个融合层&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="196" y="596" width="500" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;把三份拼成一份&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="696" y="596" width="420" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;形状变化&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1116" y="596" width="344" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;丢弃&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="632" width="160" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;映射成「空」（None）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="196" y="632" width="500" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;这个键直接不加载&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="696" y="632" width="420" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:11px&quot;&gt;MTP 层、训练遗留张量都靠它&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1116" y="632" width="344" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="704" width="700" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="t36" value="&lt;b&gt;① 训练框架遗留的张量也会被丢掉&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="712" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t37" value="&lt;font style=&quot;font-size:10px&quot;&gt;有些早期训练框架（或某些量化工具）会在权重文件里多写几个旋转位置编码的缓存张量，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;推理根本不用它们 → 仓内用同一套「映射成 None」的机制丢弃。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;否则会报「意外的键」。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="738" width="680" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="796" y="704" width="664" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="t39" value="&lt;b&gt;② 训练中期就能热更新权重&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="712" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t40" value="&lt;font style=&quot;font-size:10px&quot;&gt;仓内支持「按层热加载」：不重启引擎，把新权重逐层换进去；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;并且特意保持张量地址不变——因为图捕获记录的是地址，换地址会让图失效。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 这是给强化学习训练循环用的（见 ⑩）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="738" width="644" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：加载器告诉我们「推理只吃权重」。反过来问：训练真的一直在改权重，那推理怎么跟上？下一步（⑩）就是这个接口。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="904" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;五个被丢弃的文件（黑名单函数原文）：vllm/model_executor/model_loader/weight_utils.py:639-655；调用点 default_loader.py:254&lt;br&gt;扩展名白名单（allow_patterns）：vllm/model_executor/model_loader/default_loader.py:184-208&lt;br&gt;索引与分片校验：vllm/model_executor/model_loader/weight_utils.py:625-635&lt;br&gt;名字映射与「映射成 None 即丢弃」：vllm/model_executor/models/utils.py:46-57；训练遗留张量的丢弃 :215-224&lt;br&gt;逐张量加载与 TP 切片：weight_utils.py:1253-1271（default_weight_loader）&lt;br&gt;按层热加载：vllm/model_executor/model_loader/reload/layerwise.py:84；保地址的原因 vllm/model_executor/utils.py:94-99（图捕获需要地址不变）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="980" width="1424" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;加载器只挑权重：五个训练状态文件按文件名丢弃、多余的键按「映射成空」丢弃、分片按索引校验；&lt;b&gt;它唯一在意的兼容性是「名字对得上、形状对得上、地址能稳定」。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1142" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t44" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1234" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1231" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1231" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1231" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1231" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1231" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1231" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1231" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="被丢弃的训练状态" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1231" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e53" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1280" as="sourcePoint"/>
            <mxPoint x="204" y="1280" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t54" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1268" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e55" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1280" as="sourcePoint"/>
            <mxPoint x="454" y="1280" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t56" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1268" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e57" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1280" as="sourcePoint"/>
            <mxPoint x="704" y="1280" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t58" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
