        <mxCell id="n56" value="推理独有 / 可利用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1285" width="240" height="26" as="geometry"/>
