  <diagram id="pg4" name="⑤ 激活与 workspace">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1286" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑤ 激活：训练要留「账本」，推理只要「峰值」" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：每一层的中间结果（激活）在训练时要&lt;b&gt;留到反向他用&lt;/b&gt;，在推理时&lt;b&gt;算完立刻可以扔&lt;/b&gt;——所以推理只关心「同时活着的那一批有多大」，这个量必须实测（profile），而它随 token 数线性膨胀。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：同一层、同一个中间结果，两种命运&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="700" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;训练：留下来（账本）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="158" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;font style=&quot;font-size:10px&quot;&gt;反向传播要用「这个算子的输入」去算梯度，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以 autograd 默认把前向的中间结果全部驻留。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;层数 × batch × 序列长度 × 隐藏维度 → 很容易成为显存第一大户。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;缓解手段：重算（checkpointing）、FlashAttention 式的重算注意力。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="184" width="680" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="150" width="664" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;推理：算完就扔（峰值）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="158" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;font style=&quot;font-size:10px&quot;&gt;没有反向 → 中间结果用完立刻可释放；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以只需要知道「某一时刻最多同时有多少」= 峰值。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;这个峰值是&lt;b&gt;实测&lt;/b&gt;出来的：启动时用最大 batch 空跑一遍。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;然后才能算「还剩多少显存给 KV」。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="184" width="644" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="t10" value="&lt;b&gt;第二步：为什么峰值不能忽略（一个从 288 MB 涨到 6 GB 的真实算术）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="326" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:10px&quot;&gt;昇腾 attention 的 chunked-prefill workspace 是「按 token 上限 × 头维度」分配的。仓内注释给了两个数：&lt;br&gt;· 按 576 的头维度、fp16 算 → 约 &lt;b&gt;288 MB&lt;/b&gt;；&lt;br&gt;· 换成 192 的 QK 头维度 × 128 个头 → 同一套公式就变成 &lt;b&gt;约 6 GB&lt;/b&gt;。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;同一份代码、同一个 token 上限，只因为头配置不同就差 20 倍——所以「激活峰值」必须实测，不能按经验拍。&lt;/font&gt;仓内另有一处注释直接写「workspace 显存随这个 token 上限线性增长」。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="358" width="1424" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;b&gt;第三步：由「峰值」推出的三个实践结论&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="494" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="526" width="460" height="156" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;b&gt;① profile_run 存在的唯一理由&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="534" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;font style=&quot;font-size:10px&quot;&gt;启动时用「最大 batch」空跑一遍前向，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;记录这一刻的显存峰值，再从可用显存里扣掉。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;没有这一步，KV 预算就只能猜。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="560" width="440" height="114" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="518" y="526" width="460" height="156" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;b&gt;② 为什么调大 batched tokens 会挤掉 KV&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="534" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;font style=&quot;font-size:10px&quot;&gt;一步能装的 token 越多，workspace / 激活峰值越大，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;扣掉之后留给 KV 的就越少。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以「吞吐」与「并发」并不总能同时调高。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="560" width="440" height="114" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1000" y="526" width="460" height="156" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;b&gt;③ 为什么 MoE 还要两块 scratch&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="534" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;font style=&quot;font-size:10px&quot;&gt;MoE 前向需要一块放 GEMM 输出、一块放激活函数的中间结果，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;形状按「token 数 × max(N, K)」分配。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;这也算在峰值里，且随 token 数线性涨。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="560" width="440" height="114" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;一句话把两边分开&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;训练：&lt;b&gt;激活 = 账本&lt;/b&gt;，为了算梯度必须留着，显存不够就重算或切分。&lt;br&gt;推理：&lt;b&gt;激活 = 峰值&lt;/b&gt;，只要知道最大值并留出余量，剩下的显存全给 KV cache。&lt;br&gt;所以「推理为什么能开很多并发」的答案之一就藏在这句话里。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="722" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：激活讲完，显存四项就齐了。下一步（⑥）讲精度——为什么推理能整份用低精度，而训练必须留一份高精度。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="858" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;推理只量峰值：vllm/v1/worker/gpu_worker.py:850-854（non_kv = 权重+非torch+激活峰值+图）；算例 vllm/utils/mem_utils.py:242-273&lt;br&gt;workspace 算术（288 MB → 6 GB）：vllm-ascend/vllm_ascend/attention/utils.py:256-281（注释 :261-273）&lt;br&gt;workspace 随 token 上限线性增长：vllm-ascend/vllm_ascend/ascend_config.py:590-597&lt;br&gt;MoE 两块 scratch：vllm/model_executor/layers/fused_moe/modular_kernel.py:960-963&lt;br&gt;显存不够先牺牲 workspace 的实例：vllm-ascend/vllm_ascend/_310p/worker_310p.py:130、:150（日志 halved for workspace）&lt;br&gt;训练侧「留到反向他用」：通用知识（仓内仅有 activation checkpointing 的说明性文档串，phi4mm_audio.py:114-124）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="934" width="1424" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;推理只关心激活的&lt;b&gt;峰值&lt;/b&gt;，且这个峰值随 token 上限线性涨；它先被扣掉、剩下的才是 KV；&lt;b&gt;所以「调大吞吐参数」和「调高并发」经常是互相拆台的。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1096" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t26" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1188" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1185" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1185" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1185" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1185" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1185" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1185" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1185" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="推理可释放的中间结果" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1185" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e35" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1234" as="sourcePoint"/>
            <mxPoint x="204" y="1234" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t36" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1222" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e37" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1234" as="sourcePoint"/>
            <mxPoint x="454" y="1234" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t38" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1222" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e39" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1234" as="sourcePoint"/>
            <mxPoint x="704" y="1234" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t40" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1222" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
