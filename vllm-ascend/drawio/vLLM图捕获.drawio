          <mxGeometry x="236" y="574" width="560" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="&lt;font style=&quot;font-size:11px&quot;&gt;P/D 分离里 decode 实例的标准配置&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="796" y="574" width="420" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="&lt;font style=&quot;font-size:11px&quot;&gt;本仓 D 侧脚本就是这么配的&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1216" y="574" width="260" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="&lt;font style=&quot;font-size:11px&quot;&gt;FULL_AND_PIECEWISE&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="612" width="200" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="&lt;font style=&quot;font-size:11px&quot;&gt;decode 用 FULL，其它用 PIECEWISE&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="612" width="560" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="&lt;font style=&quot;font-size:11px&quot;&gt;默认（O2）；兼顾两类流量，显存与启动开销最大&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="796" y="612" width="420" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="&lt;font style=&quot;font-size:11px&quot;&gt;vLLM 默认&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1216" y="612" width="260" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n53" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="686" width="700" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t54" value="&lt;b&gt;为什么 PIECEWISE 要把 attention 挖出去&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="694" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t55" value="&lt;font style=&quot;font-size:10px&quot;&gt;attention 是不透明的 custom op，且它的形状随「KV 长度」变化——&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;而 KV 长度每个请求都不同、每步都在变，无法在捕获时固定。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以编译时在 attention 处「打个断点」：前面进图、attention eager、后面再进图。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;这也解释了为什么 PIECEWISE 的图段数 ≈ 层数 ×2。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="720" width="680" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n56" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="796" y="686" width="664" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t57" value="&lt;b&gt;那 FULL 凭什么能把 attention 也放进去&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="694" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t58" value="&lt;font style=&quot;font-size:10px&quot;&gt;因为 decode 阶段的形状是「整齐」的：每请求 1 个 query token（spec decode 时 1+N），batch 大小又被 padding 到固定的桶。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;此时 attention 的 dynamic 部分只剩「KV 长度数组」，而它可以像别的输入一样被 copy_ 进固定 buffer。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以 FULL 只对「uniform decode」开放——这行判断在 dispatcher 里。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="720" width="644" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n59" value="&lt;b&gt;怎么选（实用建议）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① 想最快跑通/调试 → &lt;b&gt;NONE&lt;/b&gt;（--enforce-eager）：启动最快、报错最直白。&lt;br&gt;② 单机混跑 prefill+decode → 默认 &lt;b&gt;FULL_AND_PIECEWISE&lt;/b&gt;（O2）。&lt;br&gt;③ P/D 分离 → P 侧 &lt;b&gt;NONE 或 PIECEWISE&lt;/b&gt;、D 侧 &lt;b&gt;FULL_DECODE_ONLY&lt;/b&gt;（本仓部署脚本正是这样：P 与 edge 加 --enforce-eager，D 配 FULL_DECODE_ONLY）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="894" width="1424" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n60" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;模式枚举与语义：vllm/config/compilation.py:53-110、:614-649&lt;br&gt;默认值来自 -O 级别：vllm/config/vllm.py:277（O0→NONE）、:300（O1→PIECEWISE）、:323/:346（O2/O3→FULL_AND_PIECEWISE）、:447（默认 O2）&lt;br&gt;PIECEWISE 的切点 = attention 类 op：vllm/config/compilation.py:772-790、:1169（set_splitting_ops_for_v1）&lt;br&gt;attention 是「捕获期要打断」的 custom op：vllm/model_executor/layers/attention/attention.py:758-794（eager_break_during_capture）&lt;br&gt;两种 wrapper 的嵌套：vllm/v1/worker/gpu_model_runner.py:5453-5493&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1020" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n61" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;PIECEWISE＝把 attention 挖空的「分段图」，形状宽松、段数多；FULL＝整张图，最快但只吃「整齐的 decode」；vLLM 默认两种都抓，运行时按 batch 形状挑一种。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1156" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t62" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1248" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n63" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1245" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n64" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1245" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n65" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1245" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n66" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1245" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n67" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1245" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n68" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1245" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n69" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1245" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n70" value="FULL 的图范围" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1245" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e71" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1294" as="sourcePoint"/>
            <mxPoint x="204" y="1294" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t72" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1282" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e73" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1294" as="sourcePoint"/>
            <mxPoint x="454" y="1294" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t74" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1282" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e75" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1294" as="sourcePoint"/>
            <mxPoint x="704" y="1294" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t76" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1282" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e77" value="" style="endArrow=open;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#a1887f;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="898" y="1294" as="sourcePoint"/>
            <mxPoint x="954" y="1294" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t78" value="虚线/灰 = 仍在 eager 执行" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="960" y="1282" width="200" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg5" name="⑥ 桶与 dispatch">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1306" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑥ 形状桶与 dispatch：这一步到底用哪张图" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：启动时按「桶」抓了一批图；运行时先把本步的 batch 形状&lt;b&gt;向上取整到某个桶&lt;/b&gt;，再按 (token 数, 是否整齐 decode, LoRA 数) 去查表 —— 查不到就用 eager。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：桶不是连续的，是一串阶梯（本仓默认栅格）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="120" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;font style=&quot;font-size:10px&quot;&gt;默认栅格 = &lt;b&gt;1, 2, 4&lt;/b&gt; + &lt;b&gt;8, 16, 24, …, 248&lt;/b&gt;（步长 8）+ &lt;b&gt;256, 272, …, 上限&lt;/b&gt;（步长 16），上限默认 &lt;b&gt;512&lt;/b&gt;（Blackwell 1024），且不超过 max_num_batched_tokens。&lt;br&gt;还会补上 max_num_batched_tokens 本身；开 spec decode 时按 uniform_decode_query_len 的倍数补桶。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;含义：batch 越小越「细」，越大越「粗」——因为小 batch 的延迟最敏感。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;第二步：一个 5 个请求、共 5 个 token 的 decode step 会发生什么&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="250" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="282" width="700" height="158" as="geometry"/>
        </mxCell>
        <mxCell id="t7" value="&lt;b&gt;① 先算本步形状&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="290" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;font style=&quot;font-size:10px&quot;&gt;num_tokens = 5（5 个请求各 1 个新 token）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;uniform_decode = True（大家都只算 1 个 token）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;查表：5 → 落到桶 8（向上取整）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="316" width="680" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="282" width="664" height="158" as="geometry"/>
        </mxCell>
        <mxCell id="t10" value="&lt;b&gt;② 把形状 padding 到 8&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="290" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;font style=&quot;font-size:10px&quot;&gt;多出来的 3 个位置填占位：&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· block_table 填 NULL_BLOCK_ID（不指向真实块）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· slot_mapping 填 -1（跳过写 KV）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· seq_lens / query_start_loc 补成合法值&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;输出只取前 5 个位置的结果（其余丢弃）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="316" width="644" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;b&gt;第三步：dispatch 的查表顺序（三条路，最后一条是保底）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="448" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;① 先查 FULL 的精确键&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;(padded num_tokens, uniform, 活跃 LoRA 数) 完全匹配&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="480" width="430" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;② 再查 PIECEWISE 的放宽键&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;PIECEWISE 不关心 num_reqs / uniform，键更宽松&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="506" y="480" width="460" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;③ 都不中 → 返回 NONE（eager）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#c0392b&quot;&gt;⚠ 这一步&lt;b&gt;没有任何日志&lt;/b&gt;，是最隐蔽的「图没了」&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="996" y="480" width="464" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="e16" value="没中" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n13" target="n14">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e17" value="没中" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n14" target="n15">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;四个「提前退出、直接 eager」的条件（都会让图静默失效）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① 模式是 NONE（本来就没图）；② 桶还没初始化（还没捕获完）；③ &lt;b&gt;num_tokens 超过最大桶&lt;/b&gt;（并发突然变高最容易踩）；④ 只允许 NONE 的特殊场景（例如某些 attention 后端 / encoder-decoder 不支持 FULL）。&lt;br&gt;排查手法：看 KV cache usage 与 Running 请求数是否刚好越过了最大桶；或者直接开 &lt;font style=&quot;font-size:9px&quot;&gt;--cudagraph-metrics&lt;/font&gt; 看命中率。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="612" width="1424" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;b&gt;第四步：桶的上下界怎么被卡住（三个数决定）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="732" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;b&gt;参数&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="764" width="320" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;管什么&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="356" y="764" width="460" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;对桶的影响&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="816" y="764" width="600" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;max_num_seqs&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="798" width="320" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;同时跑的请求数上限&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="356" y="798" width="460" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;决定「最大桶大约多大」&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="816" y="798" width="600" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;max_num_batched_tokens&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="832" width="320" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;一步的 token 预算&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="356" y="832" width="460" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;再给一个上界（chunked prefill 会打到这里）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="816" y="832" width="600" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;max_cudagraph_capture_size&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="866" width="320" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;显式上限（默认 512 / Blackwell 1024）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="356" y="866" width="460" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;超过就一律 eager&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="816" y="866" width="600" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;--cudagraph-capture-sizes&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="900" width="320" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:11px&quot;&gt;手工指定桶列表&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="356" y="900" width="460" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:11px&quot;&gt;想省显存就缩小它（如 [1,2,4,8,16]）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="816" y="900" width="600" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;栅格与上限推导：vllm/config/vllm.py:2196-2463（:2262-2269 上限、:2376-2388 栅格、:2348-2349 取 min、:2398-2400 spec 倍数）&lt;br&gt;桶键 BatchDescriptor：vllm/forward_context.py:29-58；bs→padded 映射 vllm/v1/cudagraph_dispatcher.py:72-91&lt;br&gt;注册桶：cudagraph_dispatcher.py:166-233；dispatch 决策与四条早退：:235-324（早退 :274-281、回落 NONE :320-324）&lt;br&gt;padding 落点：vllm/v1/worker/gpu_model_runner.py:2353-2355（NULL_BLOCK_ID）、:4150-4152（slot_mapping=-1）&lt;br&gt;按 attention 后端降级：vllm/config/compilation.py:1382-1545&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="970" width="1424" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;桶是一串「阶梯」，运行时向上取整 + padding；dispatch 先查 FULL 精确键、再查 PIECEWISE 放宽键、都不中就静默回 eager。&lt;b&gt;「并发一高就变慢」十有八九是越过了最大桶。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1116" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t37" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1208" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1205" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1205" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1205" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1205" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1205" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1205" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1205" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e45" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1254" as="sourcePoint"/>
            <mxPoint x="204" y="1254" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t46" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1242" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e47" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1254" as="sourcePoint"/>
            <mxPoint x="454" y="1254" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t48" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1242" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e49" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1254" as="sourcePoint"/>
            <mxPoint x="704" y="1254" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t50" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1242" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg6" name="⑦ 启动期捕获流程">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1296" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑦ 启动期的捕获流程：它排在「权重 → profile → KV」之后" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：&lt;b&gt;加载权重 → profile 量激活峰值 → 切 KV 块池 → 估算图显存 → 逐桶捕获&lt;/b&gt;。所以启动日志里「Graph capturing finished」永远出现在「Available KV cache memory」之后。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：启动时间线（前四步都是「为图做准备的账」）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="124" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;① 加载权重&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;权重先吃掉显存&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="156" width="224" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;② profile 空跑&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;eager 跑一遍，量激活峰值&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="272" y="156" width="224" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="262" y="195" as="sourcePoint"/>
            <mxPoint x="270" y="195" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;③ 切 KV 块池&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;剩余显存才给 KV&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="508" y="156" width="224" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="498" y="195" as="sourcePoint"/>
            <mxPoint x="506" y="195" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;④ 估算图显存&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;可选；失败不影响正确性&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="744" y="156" width="224" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="734" y="195" as="sourcePoint"/>
            <mxPoint x="742" y="195" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;⑤ 逐桶捕获&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;从大到小真跑一遍&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="980" y="156" width="224" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="970" y="195" as="sourcePoint"/>
            <mxPoint x="978" y="195" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;⑥ 锁 workspace&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;回放期不许改尺寸&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1216" y="156" width="224" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="e14" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1206" y="195" as="sourcePoint"/>
            <mxPoint x="1214" y="195" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t15" value="&lt;b&gt;第二步：四个容易搞错的点&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="242" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="274" width="700" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;b&gt;①　捕获必须在 profile 与 KV 之后&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="282" width="676" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;font style=&quot;font-size:9px&quot;&gt;因为图本身要占显存（进程级图池），且要用这个池去估算。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;先抓图再算 KV，会把 KV 预算算错、甚至启动 OOM。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="48" y="306" width="676" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="796" y="274" width="664" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;b&gt;②　图池是「进程级」的，不是每桶一份&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="808" y="282" width="640" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;font style=&quot;font-size:9px&quot;&gt;所有桶共用一块池，占用 ≈ 各桶峰值的最大值。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;所以必须&lt;b&gt;从大到小&lt;/b&gt;捕获：大桶先占下够用的池，小桶复用它。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="808" y="306" width="640" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="446" width="700" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;b&gt;③　每个桶都要 warmup 几遍再录&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="454" width="676" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t24" value="&lt;font style=&quot;font-size:9px&quot;&gt;warmup 会触发算子库/通信库的 lazy 初始化；不 warmup 直接录，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;图里会混进「第一次才发生」的初始化动作，回放时行为不一致。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="48" y="478" width="676" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="446" width="664" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t26" value="&lt;b&gt;④　启动成本是可量化的&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="808" y="454" width="640" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t27" value="&lt;font style=&quot;font-size:9px&quot;&gt;日志会打「Graph capturing finished in N secs, took X GiB」，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;还会同时打印「估算 vs 实际」的图显存对比，方便判断要不要缩桶。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="808" y="478" width="640" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;b&gt;第三步：这份「启动保险」的价格&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="586" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;b&gt;项&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="618" width="220" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;b&gt;本仓口径&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="256" y="618" width="760" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;应对&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1016" y="618" width="420" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;启动时间&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="654" width="220" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:11px&quot;&gt;典型 5~20 秒（随桶数与模型深度增长）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="654" width="760" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:11px&quot;&gt;桶越多、层越深越慢&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1016" y="654" width="420" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;font style=&quot;font-size:11px&quot;&gt;显存&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="690" width="220" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;font style=&quot;font-size:11px&quot;&gt;进程级图池 ≈ 各桶峰值取 max（不是相加）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="690" width="760" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;font style=&quot;font-size:11px&quot;&gt;可从 KV 预算里扣掉这部分&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1016" y="690" width="420" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;font style=&quot;font-size:11px&quot;&gt;显存不够时&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="726" width="220" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;font style=&quot;font-size:11px&quot;&gt;捕获段&lt;b&gt;没有 try/except 回退&lt;/b&gt;，OOM 直接失败启动&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="726" width="760" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;font style=&quot;font-size:11px&quot;&gt;所以先调小桶或降 gpu-memory-utilization&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1016" y="726" width="420" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;font style=&quot;font-size:11px&quot;&gt;稳态收益&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="762" width="220" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="&lt;font style=&quot;font-size:11px&quot;&gt;decode 每步少发上千次命令 → TPOT 下降&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="762" width="760" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="&lt;font style=&quot;font-size:11px&quot;&gt;prefill 大 batch 基本不受益&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1016" y="762" width="420" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="&lt;b&gt;想省这笔钱，有三个旋钮（按代价从小到大）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;缩小桶列表&lt;/b&gt;：&lt;font style=&quot;font-size:9px&quot;&gt;--cudagraph-capture-sizes [1,2,4,8,16]&lt;/font&gt;——桶少了，池变小、启动变快，代价是更多请求落到 eager。&lt;br&gt;② &lt;b&gt;降模式&lt;/b&gt;：只留 decode 的图（FULL_DECODE_ONLY），别抓 mixed 的 PIECEWISE。&lt;br&gt;③ &lt;b&gt;关掉&lt;/b&gt;：--enforce-eager / -O0——启动最快，稳态 decode 变慢。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="834" width="1424" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;启动顺序（profile→KV→编译/捕获）：vllm/v1/engine/core.py:254、:308、:354、:356；vllm/v1/worker/gpu_worker.py:773-816&lt;br&gt;图显存估算：vllm/v1/worker/gpu_worker.py:580-592；vllm/v1/worker/gpu_model_runner.py:6674-6710&lt;br&gt;捕获主循环（从大到小、逐桶 warmup）：vllm/v1/worker/gpu_model_runner.py:6905-6914、:6949-6995&lt;br&gt;锁 workspace：vllm/v1/worker/gpu_model_runner.py:6934-6936&lt;br&gt;耗时与显存日志：vllm/v1/worker/gpu_model_runner.py:6942-6946；估算 vs 实际 vllm/v1/worker/gpu_worker.py:818-832&lt;br&gt;缩桶的两个开关：vllm/engine/arg_utils.py:1660-1665（--cudagraph-capture-sizes）、vllm/docs/configuration/conserving_memory.md:48-65&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="960" width="1424" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;捕获排在「权重 → profile → KV」之后；图池是进程级共用、必须从大到小抓；桶越多启动越慢、显存越多；想省就缩桶或降模式，别指望它自己回退。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1106" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t47" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1198" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1195" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1195" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1195" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1195" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1195" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n53" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1195" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n54" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1195" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e55" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1244" as="sourcePoint"/>
            <mxPoint x="204" y="1244" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t56" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1232" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e57" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1244" as="sourcePoint"/>
            <mxPoint x="454" y="1244" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t58" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1232" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e59" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1244" as="sourcePoint"/>
            <mxPoint x="704" y="1244" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t60" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1232" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg7" name="⑧ 回放路径">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1222" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑧ 回放期：一次 decode step 从 scheduler 到 replay 再到吐 token" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：&lt;b&gt;图只覆盖「模型 forward」这一段&lt;/b&gt;；进图前要备好静态输入，出图后还要算 logits、采样、回收——这些都在图外。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;把一次 step 从头走到尾，标出「图内 / 图外」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="124" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;①　调度器出计划&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;SchedulerOutput：每请求算几个 token + 新块的 block_ids。&lt;font color=&quot;#666666&quot;&gt;（图外，EngineCore 主线程）&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="156" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;②　决定这一步用哪个桶 / 哪张图&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;按 padded num_tokens + uniform + LoRA 数查表 → 得到 cudagraph_mode 与 batch_descriptor。&lt;b&gt;查不到就是 NONE（eager）&lt;/b&gt;。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="228" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;③　备好静态输入（图外）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;把本步的 input_ids / positions / slot_mapping / seq_lens 用 copy_ 写进持久 buffer 的前 N 个位置；slot_mapping 按 padded 长度补齐。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="300" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;④　进 forward context（图外）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;set_forward_context(attn_metadata, ..., num_tokens=num_tokens_padded, cudagraph_runtime_mode=&lt;mode&gt;, batch_descriptor=&lt;desc&gt;)——把「本步用哪张图」写进上下文，wrapper 在 forward 里读它。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="372" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;⑤　命中图 → replay()（图内只这一下）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;显存里已有这张图 → 一条 &lt;b&gt;graph.replay()&lt;/b&gt;；CPU 只提交一次，设备按录好的顺序跑完整个 forward。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="444" width="1424" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;⑥　取输出（图外，且输出是「池子里那块静态显存」）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;写 right 的是捕获期就定好的输出 buffer（弱引用）；再用它算 logits——注意 logits 与采样&lt;b&gt;不在图里&lt;/b&gt;。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="522" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;⑦　采样 + 回收 + 回 CPU（图外）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;选 token、判结束、把结果搬回 CPU、写进 EngineCoreOutputs 发给前端。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="594" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;⑧　KV 真正写进去的时机&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;写 KV 发生在 attention 自己的 op 里（图内），但&lt;b&gt;写到哪&lt;/b&gt;由进图前算好的 slot_mapping 决定；padding 的位置填 -1，等于跳过。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="666" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;为什么「采样 / logits」一定要留在图外（三个理由）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;形状不定&lt;/b&gt;：这一步要采几个 token 取决于 batch 里各请求的状态，而且 spec decode 还要按 draft 结果变；&lt;br&gt;② &lt;b&gt;要问 CPU&lt;/b&gt;：判结束、算 stop 条件、生成输出事件都是 CPU 逻辑，进了图就再也问不了；&lt;br&gt;③ &lt;b&gt;要回主机&lt;/b&gt;：把 sampled token 搬回 CPU 是同步操作，图里禁止。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="744" width="1424" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;execute_model 与选路：vllm/v1/worker/gpu_model_runner.py:4188、:4289-4310、:3954-4066&lt;br&gt;进 forward context：同文件 :4446-4457；命中后 replay：vllm/compilation/cuda_graph.py:242-246、:258-265、:362&lt;br&gt;V2 的显式 replay（FULL 连输入都不传）：vllm/v1/worker/gpu/model_runner.py:1901-1909；vllm/v1/worker/gpu/cudagraph_utils.py:529-542&lt;br&gt;图外算 logits / 采样：gpu_model_runner.py:4478-4499（logits）、:4567（sample_tokens）、:3690（回 CPU 记账）&lt;br&gt;KV 写入与 slot_mapping：:4388-4397、:4455；vllm/model_executor/layers/attention/attention.py:750-794&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="886" width="1424" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;图只包住「模型 forward」；进图前备好静态输入并告诉上下文用哪张图，出图后算 logits / 采样 / 回 CPU。所以图能省的只是&lt;b&gt;forward 内部的下发次数&lt;/b&gt;，省不了采样与调度。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1032" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1124" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
