<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" pages="10">
  <diagram id="pg0" name="① 为什么需要图捕获">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1090" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="① 为什么需要图捕获：CPU 在「下发」，NPU 在「等」" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：推理的每一步都要把整层的成百上千个算子&lt;b&gt;逐个提交&lt;/b&gt;给设备。decode 时每步只算很少的 token，于是&lt;b&gt;提交的时间开始和计算的时间同一个量级&lt;/b&gt;——图捕获就是把「逐个提交」压成「一次提交」。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：先看清一步推理里其实有两条时间线&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="122" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t4" value="&lt;b&gt;普通执行（eager / 逐算子下发）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="156" width="700" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;font style=&quot;font-size:10px&quot;&gt;CPU：&lt;b&gt;算子1&lt;/b&gt; 提交 → &lt;b&gt;算子2&lt;/b&gt; 提交 → &lt;b&gt;算子3&lt;/b&gt; 提交 → …（每层几十个，几十层）&lt;br&gt;NPU：　　　　　　　执行1　　　　　执行2　　　　　执行3 …&lt;br&gt;&lt;br&gt;两条线在&lt;b&gt;同一个流&lt;/b&gt;上交替：CPU 提交一个，NPU 才能算一个。当「执行」很短（decode 只算 1 个 token）时，&lt;b&gt;NPU 有大量时间在等 CPU 提交下一个算子&lt;/b&gt;。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="186" width="700" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;b&gt;图捕获之后（回放）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="796" y="156" width="664" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;font style=&quot;font-size:10px&quot;&gt;CPU：&lt;b&gt;replay()&lt;/b&gt; —— 只提交一次&lt;br&gt;NPU：　　▷ 整段计算连着跑（中间不再等 CPU）&lt;br&gt;&lt;br&gt;整张图的算子序列、依赖、参数在&lt;b&gt;启动时就录好了&lt;/b&gt;；回放时 CPU 只发一条命令，剩下的交给驱动/硬件按录好的顺序跑。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="186" width="664" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="捕获这一步做完之后" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="386" y="346" as="sourcePoint"/>
            <mxPoint x="1128" y="346" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t9" value="&lt;b&gt;第二步：为什么 decode 阶段最吃亏（prefill 反而还好）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="362" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="396" width="700" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;prefill（一次算整段 prompt）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="404" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;font style=&quot;font-size:10px&quot;&gt;一次要算 N 个 token（几百到几万），矩阵很「宽」。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;device 上的计算时间长 → 提交开销被摊薄，CPU 追得上。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以 prefill 不做整图捕获也影响不大。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="430" width="680" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="796" y="396" width="664" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;b&gt;decode（一次只算新生成的 1 个 token）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="404" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;font style=&quot;font-size:10px&quot;&gt;每请求 1 个 query token（spec decode 时是 1+N）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;计算量极小 → 每步的时间几乎由「下发次数」决定。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;而层数 × 每层算子数 一个都不能少 → 提交开销成为主导。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以「图」几乎只为 decode 而生。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="430" width="644" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;代价与收益（本仓文档的原话）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;收益&lt;/b&gt;：把 host 侧的上千次下发压成一次，换来的是「稳态 decode 性能」（vllm/docs/configuration/optimization.md:25 原文：跳过图捕获可以最快启动，&lt;b&gt;代价是稳态 decode 性能&lt;/b&gt;）。&lt;br&gt;② &lt;b&gt;代价&lt;/b&gt;：启动变慢（要真跑一遍来录）+ 显存变多（每张图要占一份内存池），而且形状必须固定（见 ④ 的三条硬约束）。&lt;br&gt;③ Ascend 侧的设计目标与 CUDA 一致：&lt;font style=&quot;font-size:9px&quot;&gt;reduce host launch overhead for small and medium runtime shapes&lt;/font&gt;（vllm-ascend/docs/.../ACL_Graph.md:7）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="612" width="1424" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;收益/代价的定性描述：vllm/docs/configuration/optimization.md:25、vllm/docs/design/cuda_graphs.md:43-46、vllm/docs/configuration/conserving_memory.md:48-65&lt;br&gt;decode 每请求只有 1 个 query token：vllm/config/vllm.py:661-679&lt;br&gt;「uniform decode」判定：vllm/v1/cudagraph_dispatcher.py:37、vllm/v1/worker/gpu_model_runner.py:3888-3907&lt;br&gt;host 侧同步被当作热路径敌人：vllm/envs.py:635-643（VLLM_GPU_SYNC_CHECK）、vllm/utils/gpu_sync_debug.py:3&lt;br&gt;Ascend 的设计目标原文：vllm-ascend/docs/source/developer_guide/Design_Documents/ACL_Graph.md:7&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="764" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;图捕获不是「让算子变快」，而是&lt;b&gt;把下发的次数变少&lt;/b&gt;——prefill 计算量大、摊得开；decode 每步只有 1 个 token，省下的 CPU 提交时间直接变成端到端的 token 间隔（TPOT）。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="900" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="992" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="989" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="989" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="989" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="989" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="989" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="989" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="989" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e27" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1038" as="sourcePoint"/>
            <mxPoint x="204" y="1038" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t28" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1026" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e29" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1038" as="sourcePoint"/>
            <mxPoint x="454" y="1038" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t30" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1026" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e31" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1038" as="sourcePoint"/>
            <mxPoint x="704" y="1038" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t32" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1026" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg1" name="② 捕获与回放">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1086" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="② 什么是图：把「跑一遍」录下来，以后一次「播」" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：&lt;b&gt;捕获&lt;/b&gt;＝在专用 stream 上真正跑一遍 forward，同时把设备上发生的算子序列与地址关系录成图；&lt;b&gt;回放&lt;/b&gt;＝一条命令重放整张图，CPU 不再逐个提交。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：三步看清它到底「录」了什么&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="120" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="154" width="466" height="214" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;① 普通执行：每次都重来一遍&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="162" width="446" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;font style=&quot;font-size:10px&quot;&gt;Python 每步重新执行一遍模型代码：&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 读当前的输入张量&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 逐个调用算子（kernel/launch）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· CPU 把每个算子提交给设备&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;没有记忆：第 100 步和第 1 步做的事情完全一样，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;但 CPU 还是要把这上千次提交再做一遍。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="188" width="446" height="172" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="526" y="154" width="466" height="214" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;② 捕获：真跑一遍，同时录下来&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="536" y="162" width="446" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;font style=&quot;font-size:10px&quot;&gt;在专用 stream 上放 &lt;b&gt;torch.cuda.graph(...)&lt;/b&gt;（昇腾是 torch.npu.graph）：&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 里面真的把 forward 跑了一次&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 设备上发生的算子、依赖、地址，被录成一张图&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 输入张量的&lt;b&gt;地址&lt;/b&gt;也被记下（回放时必须一样）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;代价：这一步要真花钱（时间 + 一份内存池）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="536" y="188" width="446" height="172" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1016" y="154" width="444" height="214" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;③ 回放：一句 replay()&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1026" y="162" width="424" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;font style=&quot;font-size:10px&quot;&gt;以后每步只做：&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 把新输入 &lt;b&gt;copy_&lt;/b&gt; 到捕获时那几块固定 buffer 里&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 调一次 &lt;b&gt;graph.replay()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 从固定输出 buffer 里读结果&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CPU 只提交一次；设备按录好的顺序连着跑。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;注意：Python 代码&lt;b&gt;不会再执行&lt;/b&gt;。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1026" y="188" width="424" height="172" as="geometry"/>
        </mxCell>
        <mxCell id="e13" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="272" y="388" as="sourcePoint"/>
            <mxPoint x="759" y="388" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e14" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="762" y="388" as="sourcePoint"/>
            <mxPoint x="1238" y="388" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;最关键的一条性质：录进去的只有「设备操作」，Python 逻辑不再执行&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本仓文档原话：这段代码在捕获期间执行，&lt;b&gt;只有它发出的 GPU 操作会被记录并在回放时执行，它的 Python 本体不会再跑一遍&lt;/b&gt;（vllm/docs/design/model_runner_v2.md:198）。&lt;br&gt;推论 1：图里的 &lt;b&gt;if / for&lt;/b&gt; 只在捕获时决定一次，回放时不会重新判断——所以形状、分支、循环次数都必须固定。&lt;br&gt;推论 2：图里的 &lt;b&gt;.item() / print / 分配内存&lt;/b&gt; 也只会发生一次，值会被「烤」进图里（后面 ④ 会讲这条坑）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="428" width="1424" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;b&gt;第二步：一个类比（记住这个就够了）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="536" width="1000" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="570" width="700" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;b&gt;像「宏」（macro）/ 像「录屏回放」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="578" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;font style=&quot;font-size:10px&quot;&gt;· 普通执行 = 每一步都手工点一遍菜单；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 捕获 = 手工点一次，把动作序列录成一个宏；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 回放 = 以后按一下宏的快捷键，它把整串动作重放。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;宏能成立的前提：&lt;b&gt;每次点的位置必须一样&lt;/b&gt;（＝地址固定）、&lt;b&gt;菜单结构不能变&lt;/b&gt;（＝形状固定）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="604" width="680" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="796" y="570" width="664" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;b&gt;它「不是」什么（三个常见误解）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="578" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t22" value="&lt;font style=&quot;font-size:10px&quot;&gt;· 不是「把模型编译成更快的算子」——那是 torch.compile 干的事；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 不是「缓存计算结果」——它不省计算，只省「提交」；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 不是「自动加速一切」——形状一变就要换一张图，没有对应图就退回普通执行。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="604" width="644" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;捕获的真实代码（跑一遍并录）：vllm/compilation/cuda_graph.py:315-321（with torch.cuda.graph(...): output = self.runnable(...)）&lt;br&gt;回放就一行：vllm/compilation/cuda_graph.py:362（entry.cudagraph.replay()）&lt;br&gt;「只录 GPU 操作、Python 不再跑」：vllm/docs/design/model_runner_v2.md:198&lt;br&gt;录下来的产物是「零参可调用列表」：vllm/compilation/breakable_cudagraph.py:3-21&lt;br&gt;Ascend 上的对应实现：vllm-ascend/vllm_ascend/compilation/acl_graph.py（捕获与回放各一处）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="760" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;捕获 = 「真跑一遍顺便录下来」，回放 = 「一条命令重放」；它省的是 CPU 的提交次数，不是计算量——所以前提是「形状固定、地址固定、图里不能有 CPU 同步」。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="896" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t25" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="988" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="985" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="985" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="985" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="985" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="985" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="985" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="985" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e33" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1034" as="sourcePoint"/>
            <mxPoint x="204" y="1034" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t34" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1022" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e35" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1034" as="sourcePoint"/>
            <mxPoint x="454" y="1034" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t36" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1022" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e37" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1034" as="sourcePoint"/>
            <mxPoint x="704" y="1034" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t38" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1022" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg2" name="③ 捕获内部 10 步">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1424" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="③ 一次捕获里发生了什么（10 步，按代码顺序）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：&lt;b&gt;包一层 wrapper → 开闸门 → 切到侧流 → 从大到小逐个桶：warmup 几遍 → 同步 → 在 torch.cuda.graph 里真跑一遍&lt;/b&gt; → 关闸门、锁 workspace。注意：捕获是在「profile 量完显存、KV 块池也建好」之后才做的。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;左列：准备阶段（1-5）　右列：逐桶录制（6-10）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="126" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="158" width="690" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;①　包 wrapper（决定「图从哪开始到哪结束」）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="166" width="670" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;FULL：在整模型外面包一层 CUDAGraphWrapper。&lt;br&gt;PIECEWISE：由编译后端给&lt;b&gt;每个子图&lt;/b&gt;各包一层（每个 attention 之间一段）。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;这一步决定了图的粒度，也决定了 attention 在不在图里。&lt;/font&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="190" width="670" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="306" width="690" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;②　开「捕获闸门」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="314" width="670" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;全局标志位打开：此刻允许捕获。若在别的时候触发捕获，会直接抛 &lt;font style=&quot;font-size:9px&quot;&gt;CUDA graph capturing detected at an inappropriate time&lt;/font&gt;。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="338" width="670" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="454" width="690" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;③　切到侧流 + 冻住 GC + 清缓存量基线&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="462" width="670" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;必须在&lt;b&gt;非默认 stream&lt;/b&gt; 上捕获，这样只录到本次的算子（不然会把别人的也录进去）。&lt;br&gt;然后 synchronize + empty_cache，记下此刻的空闲显存 → 用来事后算「图占了多少钱」。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="486" width="670" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="616" width="690" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;b&gt;④　拿到「进程级」的 graph 显存池&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="624" width="670" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;整个进程只有一个 pool（不是每张图一个）。所以多张图共用一块池，占用≈各桶峰值的最大值。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="648" width="670" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="764" width="690" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;b&gt;⑤　排好捕获顺序：从大到小&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="772" width="670" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;代码注释写得很直白：先抓大形状，小形状可以复用大形状已经分配过的池内存。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;反过来（先小后大）会多占显存，甚至 OOM。&lt;/font&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="796" width="670" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="778" y="158" width="682" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;b&gt;⑥　每个桶先 warmup 几遍&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="788" y="166" width="662" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;在&lt;b&gt;无图模式&lt;/b&gt;下把这一步空跑 N 遍（cudagraph_num_of_warmups，V1 默认 1）。目的是让算子库/通信库把 lazy 初始化都做完。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="788" y="190" width="662" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="778" y="306" width="682" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;b&gt;⑦　warmup 完必须同步一次&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="788" y="314" width="662" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t24" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;注释原因：warmup 可能在辅助流上跑，不等它完成就开始捕获，会录到一半。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="788" y="338" width="662" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="778" y="454" width="682" height="146" as="geometry"/>
        </mxCell>
        <mxCell id="t26" value="&lt;b&gt;⑧　把输入「钉」到固定地址（dummy run 里做）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="788" y="462" width="662" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t27" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;input_ids / positions / slot_mapping / attn_metadata 全部取&lt;b&gt;预先分配好的持久 buffer 的切片&lt;/b&gt;；&lt;br&gt;捕获时 slot_mapping 全填 -1（跳过真正写 KV），attn_metadata 用 for_cudagraph_capture 专用构造。&lt;br&gt;这就是「地址固定」约束的落地方式。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="788" y="486" width="662" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="778" y="630" width="682" height="146" as="geometry"/>
        </mxCell>
        <mxCell id="t29" value="&lt;b&gt;⑨　真正的录制：在 torch.cuda.graph 里跑一遍 forward&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="788" y="638" width="662" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t30" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;with torch.cuda.graph(cudagraph, pool=全局pool, stream=当前侧流): output = self.runnable(...)&lt;/font&gt;&lt;br&gt;这一跑被录成图；output 只留&lt;b&gt;弱引用&lt;/b&gt;（省显存，因为它是池里的同一块）。&lt;br&gt;昇腾侧对应 &lt;font style=&quot;font-size:9px&quot;&gt;torch.npu.graph(...)&lt;/font&gt;。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="788" y="662" width="662" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="778" y="806" width="682" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="t32" value="&lt;b&gt;⑩　收尾：关闸门、锁 workspace、打日志&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="788" y="814" width="662" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t33" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;关掉捕获闸门；把通信 workspace 的尺寸&lt;b&gt;锁死&lt;/b&gt;（回放期间改尺寸会让图里的指针失效）；打印 &lt;font style=&quot;font-size:9px&quot;&gt;Graph capturing finished in N secs, took X GiB&lt;/font&gt;。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="788" y="838" width="662" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;它在启动流程里的位置（很容易记错）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;正确的顺序是：&lt;b&gt;加载权重 → profile（eager 空跑一遍量激活峰值）→ 按剩余显存切 KV 块池 → 然后才捕获图&lt;/b&gt;。&lt;br&gt;原因：捕获本身也要占显存，而且要用「图显存池」去估；所以必须先把权重和 KV 的账算清，才知道还能不能抓图、抓多大。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="958" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;捕获入口（V1）：vllm/v1/worker/gpu_model_runner.py:6843 → :6997 → :6949 → :5851&lt;br&gt;捕获入口（V2，本分支默认）：vllm/v1/worker/gpu/model_runner.py:998-1071 → vllm/v1/worker/gpu/cudagraph_utils.py:398-488&lt;br&gt;启动时序（profile→KV→捕获）：vllm/v1/engine/core.py:254、:308、:354、:356；vllm/v1/worker/gpu_worker.py:773-816&lt;br&gt;闸门：vllm/compilation/monitor.py:87-104；侧流：vllm/distributed/parallel_state.py:1637-1666&lt;br&gt;全局 pool：vllm/compilation/cuda_graph.py:200、:305-308；平台单例 vllm/platforms/interface.py:1174-1181&lt;br&gt;录制那一行：vllm/compilation/cuda_graph.py:315-321；从大到小：vllm/v1/worker/gpu_model_runner.py:6858-6860、vllm/v1/cudagraph_dispatcher.py:326-350&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1088" width="1424" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;捕获 = 开闸门 + 侧流 + 逐桶（warmup → 同步 → 在 graph 上下文里真跑一遍）」；输入必须来自预分配的持久 buffer；顺序必须从大到小；结束要锁 workspace。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1234" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t37" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1326" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1323" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1323" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1323" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1323" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1323" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1323" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1323" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e45" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1372" as="sourcePoint"/>
            <mxPoint x="204" y="1372" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t46" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1360" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e47" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1372" as="sourcePoint"/>
            <mxPoint x="454" y="1372" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t48" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1360" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e49" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1372" as="sourcePoint"/>
            <mxPoint x="704" y="1372" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t50" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1360" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg3" name="④ 三个硬约束">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1258" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="④ 三个硬约束：图为什么「挑食」" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：录下来的图里记的是&lt;b&gt;具体的地址和具体的形状&lt;/b&gt;，所以回放时必须一模一样；图里也不能有「回头问 CPU」的操作。三条约束各自对应一类常见故障。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;约束一：形状固定 —— 所以要「按桶捕获 + padding」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="120" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="700" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;为什么必须固定&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="160" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;font style=&quot;font-size:10px&quot;&gt;图里的循环次数、reshape、kernel 的 grid 大小都由形状决定。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;形状变了 = 图里那些数都对不上 → 只能换一张图。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;而形状在真实流量里千变万化（1 个请求 / 7 个请求 / 44 个 token…），不可能每个都抓。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="186" width="680" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="152" width="664" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;本仓怎么解决：有限个桶 + 向上取整&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="160" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;font style=&quot;font-size:10px&quot;&gt;只抓有限的一组尺寸（cudagraph_capture_sizes，如 1,2,4,8,16,…,512）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;运行时的 batch 先「对齐到最近的桶」＝ padding（多出来的位置填占位）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;padding 的具体落点：block_table 填 NULL_BLOCK_ID、slot_mapping 填 -1。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;副作用：padding 带来的空算力，也算在图的开销里（有 num_paddings 统计）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="186" width="644" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="t10" value="&lt;b&gt;约束二：地址固定 —— 所以要用「持久 buffer + copy_」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="328" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="360" width="700" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;b&gt;为什么必须固定&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="368" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t13" value="&lt;font style=&quot;font-size:10px&quot;&gt;图里记的是张量的&lt;b&gt;显存地址&lt;/b&gt;，不是「第几个参数」。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;回放时如果输入换了一块新显存，图还是往老地址读 → 读到的是垃圾。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以每次进图前必须把新数据写进&lt;b&gt;捕获时那几块地址&lt;/b&gt;。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="394" width="680" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="360" width="664" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;b&gt;本仓怎么解决：预分配 + 每步 copy_&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="368" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;font style=&quot;font-size:10px&quot;&gt;input_ids / positions / query_start_loc / seq_lens 等一次性按最大长度分配好（持久 buffer）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;每步只做 copy_ 覆写这些 buffer 的前 N 个位置。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;代码里甚至有开关：debug 模式下会比对「捕获期与回放期的输入地址是否一致」，不一致直接抛 &lt;font style=&quot;font-size:9px&quot;&gt;Input addresses for cudagraphs are different during replay&lt;/font&gt;。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="394" width="644" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;b&gt;约束三：图里不能有「回头问 CPU」的操作&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="544" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="576" width="700" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;b&gt;为什么&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="584" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;font style=&quot;font-size:10px&quot;&gt;回放时 CPU 只发一条命令，之后不再参与。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以图里任何需要「读回一个值再决定下一步」的操作都没法工作：.item() / print / 动态分配 / 条件分支里的 Python 判断。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;更糟的是它们不会报错——&lt;b&gt;只会把捕获那一刻的值「烤」进图里&lt;/b&gt;，于是你拿到一个永远算出旧结果、但一点也不报错的图。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="610" width="680" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="576" width="664" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t22" value="&lt;b&gt;本仓的对应处理&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="584" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;font style=&quot;font-size:10px&quot;&gt;捕获闸门：在非捕获窗口触发捕获会直接抛&lt;font style=&quot;font-size:9px&quot;&gt;CUDA graph capturing detected at an inappropriate time&lt;/font&gt;。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;捕获期禁止重新分配：attention 后端看 forward_context.capturing 决定「只登记任务、不申请 workspace」。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;一次性准备全在图外：dummy run 里把 metadata 都构造好再进图。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="610" width="644" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;三张「故障 → 原因」速查（对得上就是这三条之一）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① 输出全是重复/错乱的旧结果 → 某处 .item() 或分支被烤进图（约束三）。&lt;br&gt;② 报 Input addresses ... different during replay → 有代码在回放时换了输入张量（约束二）。&lt;br&gt;③ 并发一上来反而变慢、图「没了」→ 形状超了最大桶，静默回落 eager（约束一）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="792" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;桶与 padding：vllm/config/compilation.py:655-658（capture_sizes）、vllm/forward_context.py:29-58（BatchDescriptor）、vllm/v1/worker/gpu_model_runner.py:2353-2355 / :4150-4152（padding 落点）&lt;br&gt;持久 buffer 与 copy_：vllm/v1/worker/gpu/input_batch.py:19-40、vllm/v1/worker/gpu_model_runner.py:4435、:1815&lt;br&gt;地址校验断言：vllm/compilation/cuda_graph.py:348-357；breakable_cudagraph.py:422&lt;br&gt;闸门与捕获期禁止分配：vllm/compilation/monitor.py:87-104；vllm-ascend/vllm_ascend/ascend_forward_context.py:177（capturing 标志）&lt;br&gt;「.item() 被烤进图」的仓内注释：vllm/model_executor/models/cohere_compass.py:1633、vllm/v1/attention/backends/rocm_aiter_fa.py:778&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="922" width="1424" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;形状固定 → 按桶捕获 + padding；地址固定 → 持久 buffer + copy_；不能问 CPU → 一切动态准备都放在图外。三条里破一条，要么报错、要么静默算错、要么悄悄退回 eager。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
