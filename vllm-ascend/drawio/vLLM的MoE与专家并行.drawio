<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" pages="10">
  <diagram id="pg0" name="① 什么是 MoE">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1280" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="① 什么是 MoE：把一层 FFN 换成「很多个 FFN + 一个门卫」" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：dense 模型每层只有一个 FFN，所有 token 都走它；MoE 把这一层换成 &lt;b&gt;N 个 FFN（专家）+ 一个路由器（门卫）&lt;/b&gt;，每个 token 只被送进其中 &lt;b&gt;top-k 个&lt;/b&gt;。于是&lt;b&gt;总参数变多，但每个 token 的计算量几乎不变&lt;/b&gt;。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：一张对照图（左边 dense，右边 MoE）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;dense 层&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;　　输入 x（每个 token 一个向量）&lt;br&gt;　　　　↓&lt;br&gt;　　升维 → 非线性 → 降维（一个大 FFN）&lt;br&gt;　　　　↓&lt;br&gt;　　输出 y&lt;br&gt;&lt;br&gt;&lt;b&gt;所有 token 都走同一条路&lt;/b&gt;；参数量 = 这一个 FFN 的大小。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="690" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;MoE 层&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;　　输入 x&lt;br&gt;　　　　↓&lt;br&gt;　　&lt;b&gt;门卫&lt;/b&gt;：算出「该去哪些专家」+「权重多少」&lt;br&gt;　　　　↓&lt;br&gt;　　只把 x 送进 top-k 个专家（其余专家这一步不参与）&lt;br&gt;　　　　↓&lt;br&gt;　　把 k 个结果按门卫给的权重&lt;b&gt;加权相加&lt;/b&gt; → y&lt;br&gt;&lt;br&gt;&lt;b&gt;不同 token 走不同专家&lt;/b&gt;；参数量 = 全部专家之和。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="766" y="150" width="694" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;b&gt;第二步：三个必须分清的量（MoE 全部反直觉都来自这里）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="326" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="358" width="460" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;总参数量&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="368" width="440" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;font style=&quot;font-size:10px&quot;&gt;N 个专家之和&lt;br&gt;（模型“看起来很大”）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="394" width="440" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="508" y="358" width="460" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;激活参数量&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="518" y="368" width="440" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;font style=&quot;font-size:10px&quot;&gt;每 token 只走 k 个&lt;br&gt;（计算量“其实不大”）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="518" y="394" width="440" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="980" y="358" width="460" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;b&gt;显存占用&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="990" y="368" width="440" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;font style=&quot;font-size:10px&quot;&gt;全部专家都要驻留&lt;br&gt;（推理端最痛的一条）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="990" y="394" width="440" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;第三步：一个算例（用相对量级，不做绝对参数承诺）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;设 dense 模型某层 FFN 的参数为 &lt;b&gt;1 份&lt;/b&gt;。换成 &lt;b&gt;64 个专家、每 token 走 2 个&lt;/b&gt;：&lt;br&gt;· &lt;b&gt;总参数&lt;/b&gt; ≈ 64 份 → 模型“看起来”大了 64 倍；&lt;br&gt;· &lt;b&gt;每 token 的计算量&lt;/b&gt; ≈ 2 份 → 只比原来多 1 倍（而不是 64 倍）；&lt;br&gt;· &lt;b&gt;显存&lt;/b&gt; 仍要放下 64 份 → 所以 MoE 是「&lt;b&gt;用显存换参数量&lt;/b&gt;」的一条路。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;这就是为什么 MoE 模型的「参数量」与「能跑多快」几乎无关，而和「显存够不够」强相关。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="514" width="1424" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="686" width="700" height="152" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;b&gt;它解决了什么&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="694" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;font style=&quot;font-size:10px&quot;&gt;在参数总量不变的前提下，想让模型「知道得更多」→ 加专家；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;在计算量不变的前提下，想让推理「不变慢」→ 每 token 只走 k 个。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以 MoE 是「容量/算力比」最高的一种结构（这也是它在大模型上流行的原因）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="720" width="680" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="796" y="686" width="664" height="152" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;b&gt;它带来了什么新问题&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="694" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t22" value="&lt;font style=&quot;font-size:10px&quot;&gt;① 显存：全部专家都要驻留 → 单卡放不下 → 要切（专家并行）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;② 通信：token 要去别的卡上的专家 → 要搬 token（all-to-all）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;③ 负载：热门专家忙死、冷门专家闲着 → 要均衡（训练期辅助损失、推理期换位）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;后面 9 页就是把这三个问题逐个讲清。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="720" width="644" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：MoE 的结构说清了。下一步（②）跟着一个 token 走一遍——它在一层 MoE 里到底被怎么处理。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="878" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;MoE 层的实现入口：vllm/model_executor/layers/fused_moe/layer.py（FusedMoE 类）&lt;br&gt;配置字段（专家数 / top-k / 中间维度）：见 ② 页与 moe-math 页汇总；本仓模型的 config.json 里对应 n_routed_experts / num_experts_per_tok / moe_intermediate_size&lt;br&gt;「dense FFN vs MoE」在模型代码里的分叉：各模型文件按 config 决定用 MLP 还是 FusedMoE（例如 deepseek 系模型文件）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="954" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;MoE = 很多专家 + 一个门卫 + 每 token 只走 top-k；&lt;b&gt;总参数按「专家数」涨，计算量按「top-k」涨，显存也按「专家数」涨&lt;/b&gt;——后两条就是推理侧所有麻烦的来源。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1090" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t26" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1182" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1179" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1179" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1179" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1179" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1179" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1179" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1179" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e34" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1228" as="sourcePoint"/>
            <mxPoint x="204" y="1228" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t35" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1216" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e36" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1228" as="sourcePoint"/>
            <mxPoint x="454" y="1228" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t37" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1216" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e38" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1228" as="sourcePoint"/>
            <mxPoint x="704" y="1228" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t39" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1216" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg1" name="② token 的 MoE 之旅">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1298" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="② 一个 token 走完一层 MoE：六步" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：&lt;b&gt;门卫打分 → 取 top-k → 按专家把 token 重排到一起 → 每个专家各算一段 → 散射回原位 → 按门卫权重加权求和&lt;/b&gt;；再和「共享专家」的输出相加。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：六步（前三步决定「去哪」，后三步是真正的计算）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;① 门卫打分&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;hidden → N 个分数&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="146" width="224" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;② 取 top-k&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;只留分数最高的 k 个&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="272" y="146" width="224" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="262" y="192" as="sourcePoint"/>
            <mxPoint x="270" y="192" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;③ 重排&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;按专家把 token 聚到一起&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="508" y="146" width="224" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="498" y="192" as="sourcePoint"/>
            <mxPoint x="506" y="192" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;④ 分组矩阵乘&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;每个专家各算自己那段&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="744" y="146" width="224" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="734" y="192" as="sourcePoint"/>
            <mxPoint x="742" y="192" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;⑤ 散射回原位&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;把结果还原到 token 顺序&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="980" y="146" width="224" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="970" y="192" as="sourcePoint"/>
            <mxPoint x="978" y="192" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;⑥ 加权求和&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;k 个结果按门卫权重相加&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1216" y="146" width="224" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="e14" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1206" y="192" as="sourcePoint"/>
            <mxPoint x="1214" y="192" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t15" value="&lt;b&gt;第二步：为什么非要「重排」（这一步是 MoE 实现里最关键的设计）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="248" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;不重排会怎样&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;假设有 5 个 token、8 个专家，每个 token 要去 2 个。于是有 10 个「(token, 专家)」对，但它们散落在不同位置。&lt;br&gt;如果按 token 顺序一个个调专家函数：&lt;br&gt;· 每次只有 1 行输入 → 矩阵乘退化成向量乘，算力极度浪费；&lt;br&gt;· 相邻两个 token 可能用同一个专家，却要再调一次。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;结果：同一个专家被调用很多次，每次只算很少的行。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="278" width="700" height="188" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;b&gt;重排之后&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;把所有「要去专家 i」的行&lt;b&gt;搬到一起、连续存放&lt;/b&gt;，形成一张 &lt;b&gt;token 数 × k&lt;/b&gt; 行的密集表。&lt;br&gt;然后&lt;b&gt;每个专家只调一次&lt;/b&gt;，输入是「连续的一段行」。&lt;br&gt;· 每段的行数 = 这个专家分到多少 token（各段不同）；&lt;br&gt;· 这就是「分组矩阵乘」：一次提交里，每个专家各有一段自己的 M/N/K。&lt;br&gt;&lt;font color=&quot;#1c7c54&quot;&gt;算完再散射回原来的位置，保证输出顺序与输入一致。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="766" y="278" width="694" height="188" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;b&gt;第三步：两个容易混的细节&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="476" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="506" width="700" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;b&gt;① 「行数」是 token 数 × k，不是 token 数&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="514" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;font style=&quot;font-size:10px&quot;&gt;重排后的总行数 = token 数 × k（每个 token 在 k 个专家各占一行）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;推理侧这里&lt;b&gt;不按「容量因子」截断&lt;/b&gt;（不做 token drop）——&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以行数就是 token×k，不会有 token 被丢弃。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;（容量因子/token drop 是训练期的概念，见 ⑦ 页的说明。）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="540" width="680" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="796" y="506" width="664" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;b&gt;② 加权求和用的权重来自门卫&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="514" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t24" value="&lt;font style=&quot;font-size:10px&quot;&gt;门卫给出的 k 个分数，通常会归一化后再作为权重。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以「同一个 token 在不同专家里的结果」是&lt;b&gt;加权&lt;/b&gt;相加，不是简单平均。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;这也是「为什么叫混合专家」的字面含义。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="540" width="644" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;第四步：和 dense FFN 的差别只在「多了门卫与重排」，但代价全在这两处&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;dense：一次 MLP，输入是「全部 token」的连续矩阵。&lt;br&gt;MoE：先算一次小的线性层（门卫，hidden→N），再做两次数据搬运（重排/散射），最后才是 k 段 GEMM。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;所以 MoE 在&lt;b&gt;大 batch&lt;/b&gt;（prefill）时很划算——GEMM 喂满了；而&lt;b&gt;小 batch&lt;/b&gt;（decode）时，搬运与固定开销占比被放大，这正是 ③ 页要算的账。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="714" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：结构清楚了。下一步（③）算三个账——显存、通信、负载，看看 MoE 到底「贵」在哪。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="870" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;门卫（router）：一个 hidden→N 的线性层，输出 router_logits（token, N）：vllm/model_executor/models/hy_v3.py:155-162、:211&lt;br&gt;MoE 层装配（专家数 / top-k / 中间维）：同文件 :183-201&lt;br&gt;重排与散射的昇腾实现：vllm-ascend/vllm_ascend/ops/fused_moe/token_dispatcher.py:592（permute）、:430-433 与 :715-719（unpermute）、:217-227（两者分工的注释）&lt;br&gt;重排行数 = token×top_k：同文件 :406（active_num=num_tokens*top_k）、:616-620（num_out_tokens = topk_ids.numel()，无容量截断）&lt;br&gt;分组矩阵乘的 shape 语义：vllm/_custom_ops.py:1094（problem_sizes 每专家一组 M,N,K）&lt;br&gt;每专家权重形状：vllm/model_executor/layers/fused_moe/experts/nvfp4_emulation_moe.py:438-439&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="946" width="1424" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;MoE 一层的计算其实只有「一次小线性 + k 段 GEMM」，但中间夹了两次数据搬运（重排 / 散射）——&lt;b&gt;批大时搬运摊薄、批小时搬运变主成本&lt;/b&gt;，这是 MoE 推理好坏的枢纽。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1108" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t29" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1200" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1197" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1197" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1197" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1197" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1197" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1197" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1197" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="数据搬运（重排/散射）" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1197" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e38" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1246" as="sourcePoint"/>
            <mxPoint x="204" y="1246" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t39" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1234" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e40" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1246" as="sourcePoint"/>
            <mxPoint x="454" y="1246" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t41" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1234" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e42" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1246" as="sourcePoint"/>
            <mxPoint x="704" y="1246" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t43" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1234" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg2" name="③ MoE 三本账">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1396" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="③ MoE 推理的三本账：显存、通信、负载——以及 decode 为什么更吃亏" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：MoE 把 compute 省下来了，代价转移到了&lt;b&gt;三处&lt;/b&gt;：全部专家都要驻留显存、token 要跨卡搬（all-to-all）、热门专家会把某个卡拖成瓶颈。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：三本账（每本都有本仓可查的数字或注释）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="146" width="460" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;账一：显存&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="154" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;font style=&quot;font-size:10px&quot;&gt;全部专家都要驻留——切到多卡只是「摊开」，总量不降。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本仓有一个很硬的说法：&lt;b&gt;专家约占权重字节的 85~90%&lt;/b&gt;。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以 MoE 模型的显存几乎全花在专家上；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;而 KV cache 只能吃剩下的零头（与入门套 ⑦ 的显存账一致）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="180" width="440" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="518" y="146" width="460" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;账二：通信&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="154" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;font style=&quot;font-size:10px&quot;&gt;专家切到多卡后，token 要去别的卡上的专家 → 专家计算&lt;b&gt;前后各一次 all-to-all&lt;/b&gt;。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;搬的内容 = 「token 数 × k」行 hidden。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;关键：接收缓冲按&lt;b&gt;最坏情况&lt;/b&gt;分配（每卡最大批 × EP 规模），&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以&lt;b&gt;小 batch 也要付满额开销&lt;/b&gt;。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="180" width="440" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1000" y="146" width="460" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;账三：负载&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="154" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;font style=&quot;font-size:10px&quot;&gt;热门专家忙死、冷门专家闲着——本仓文档原文说实际分布可能&lt;b&gt;高度偏斜&lt;/b&gt;。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;后果：某个 EP rank 成了瓶颈，其他 rank 在等它。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;性能模型里甚至留了个注释：&lt;font style=&quot;font-size:9px&quot;&gt;FIXME: Assume perfect load balancing for now&lt;/font&gt;——即「目前只能假设负载均衡」。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="180" width="440" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t13" value="&lt;b&gt;第二步：decode 为什么比 prefill 更吃亏（四条，逐条给依据）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="366" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;要读的专家权重数量随批大小变化&lt;/b&gt;：本仓性能模型里，dense 每步读「整份 FFN 权重」（与 token 数无关）；MoE 每步读的是 &lt;b&gt;min(token 数 × k, 专家总数)&lt;/b&gt; 份。批大时摊薄，批小时反而读得零碎。&lt;br&gt;② &lt;b&gt;访存不连续&lt;/b&gt;：专家权重是分散的多块，单次能读到的有效行少，带宽利用率低。&lt;br&gt;③ &lt;b&gt;两次 all-to-all 的固定开销&lt;/b&gt;：小 batch 时通信延迟盖过计算时间。&lt;br&gt;④ &lt;b&gt;共享专家不受稀疏保护&lt;/b&gt;：它是 dense 的，每个 token 必走、每步必读（见 ④ 页）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="396" width="1424" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;第三步：纠正一个常见推论（这条很重要）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;常见说法：「MoE 每 token 只走 k 个专家，所以 decode 一定比 dense 省」。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;这个推论不成立。&lt;/font&gt;因为 &lt;b&gt;专家总参数量远大于 dense FFN&lt;/b&gt;（本仓默认配置里专家中间维与 dense 宽度差近 9 倍，总专家数上百），而 decode 的批很小 —— &lt;b&gt;min(批 × k, 专家数) 往往仍远大于 1&lt;/b&gt;，加上 attention 与共享专家照样要读，实际读权重总量通常&lt;b&gt;仍显著高于&lt;/b&gt;同 hidden 的 dense 层。&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;（前半句的依据是本仓性能模型公式；「通常仍高于 dense」是通用结论，图上标为推导。）&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="576" width="1424" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;b&gt;第四步：三本账各自对应的解法（后面几页逐个展开）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="714" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;b&gt;问题&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="744" width="220" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;手段&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="256" y="744" width="820" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;b&gt;在哪页&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1076" y="744" width="384" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;显存紧&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="780" width="220" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;把专家切到多卡（EP）；量化压专家权重&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="780" width="820" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;⑤ 页、⑥ 页&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="780" width="384" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;通信贵&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="816" width="220" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;按阶段选通信实现（prefill 走高吞吐、decode 走低延迟）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="816" width="820" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;⑥ 页&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="816" width="384" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;负载偏斜&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="852" width="220" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;训练期加辅助损失 / 路由偏置；推理期换位 + 冗余专家（EPLB）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="852" width="820" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;⑦ 页&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="852" width="384" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;共享专家太贵&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="888" width="220" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;减小共享专家宽度&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="888" width="820" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;④ 页&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="888" width="384" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：三本账讲完。下一步（④）先把「共享专家」这个反直觉的东西讲清——它让 MoE 更像 dense，而不是更像 MoE。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="960" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;专家占权重 85~90%：vllm/model_executor/model_loader/ep_weight_filter.py:1-9（原文）&lt;br&gt;dense vs MoE 每步读权重的公式：vllm/v1/metrics/perf.py:1289-1347（MoE 用 num_activated_experts = min(T*E, num_experts) :1311；假设均衡的 FIXME 注释 :1310）&lt;br&gt;专家计算前后两次 all-to-all：vllm-ascend/.../fused_moe/moe_comm_method.py:263-271（原文）&lt;br&gt;接收缓冲按最坏情况分配：同文件 :416-422（num_max_tokens_per_rank × ep_world_size × min(topk, …)）&lt;br&gt;「小 batch 也付满额开销」：token_dispatcher.py:126-133（global_bs = max_bs_per_rank × ep_world_size）&lt;br&gt;实际分布高度偏斜（原文）：vllm/docs/serving/expert_parallel_deployment.md:138&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1036" width="1424" height="136" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;MoE 省的是「算」，付出的是「显存 + 通信 + 负载不均」；而这笔交易在 &lt;b&gt;prefill（大批）时划算、在 decode（小批）时要还回去&lt;/b&gt;——所以 MoE 的调优几乎都围绕这三本账。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1206" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t35" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1298" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1295" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
