  </diagram>
  <diagram id="pg8" name="⑨ 部署与拓扑">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1454" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑨ 回到部署：本仓只有一套包用 MoE，也只有它开了 EP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：十套部署包里九套是 dense 模型（Qwen3.6-27B），&lt;b&gt;只有 DeepSeek 那套是 MoE 并开了 EP&lt;/b&gt;；而 EP 与 TP 在 MoE 层里是&lt;b&gt;互斥&lt;/b&gt;的——开 EP 就等于把 TP 关掉。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：先记住这条互斥关系（它解释了本仓为什么这么配）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;开 EP 后，MoE 层把「专家」按卡切分 → 每张卡拥有&lt;b&gt;完整的一份专家&lt;/b&gt; → 这一层不再需要 TP 切分&lt;/b&gt;。&lt;br&gt;代码里的表现：EP 打开时，MoE 层自己的 TP 规模被写成 &lt;b&gt;1&lt;/b&gt;、EP 规模 = &lt;b&gt;DP × PCP × TP&lt;/b&gt; 的乘积；EP 关闭时反过来（EP=1、TP=乘积）。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;所以「EP + TP 混合」是不支持的：你只能选「每卡几个专家」或「每卡整层切一半」，不能又切层又切专家。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="146" width="1424" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;第二步：十套包的实际配置（脚本实测）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="288" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;模型&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="318" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;结构&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="456" y="318" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;--enable-expert-parallel&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="876" y="318" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;并行&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1196" y="318" width="264" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;font style=&quot;font-size:11px&quot;&gt;Qwen3.6-27B（九套包）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="362" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:11px&quot;&gt;dense，没有专家可切&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="456" y="362" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;无&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="876" y="362" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;TP 1~2&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1196" y="362" width="264" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;DeepSeek-V4-Flash-w8a8-mtp（fix_1120）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="406" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;MoE + 量化 + MTP&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="456" y="406" width="420" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;有（P/D 两侧都开）&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="876" y="406" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;TP=8 / PP=1&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1196" y="406" width="264" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;读法&lt;/b&gt;：dense 模型开 EP 是无效的（代码会先判「是不是 MoE」，不是就直接走无搬运路径），所以九套包不开也无所谓。&lt;br&gt;而 DeepSeek 那套 &lt;b&gt;单机 8 卡 TP=8 再开 EP&lt;/b&gt;，实际含义是：把 8 张卡当成&lt;b&gt;专家池&lt;/b&gt;，每个 routed 专家只有一份、按卡分布 —— 这样每卡不需要放「全部专家」，&lt;b&gt;单卡显存才放得下&lt;/b&gt;。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;注意：脚本里没有写任何「专家数」参数，专家数与 top-k 全部来自模型目录的 config.json。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="466" width="1424" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;b&gt;第三步：MoE 与 MTP / PD 的关系（三个容易搞错的点）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="584" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="614" width="460" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;b&gt;① MTP 层本身就是 MoE 层&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="622" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t22" value="&lt;font style=&quot;font-size:10px&quot;&gt;投机解码的草稿层不是「一个小 dense 层」，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;它内部&lt;b&gt;同样含一个完整的 MoE 层&lt;/b&gt;（路由专家 + 共享专家）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以开了 MTP 之后，MoE 的层数变多了——&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;这也是「开 MTP 会让显存变紧」的原因之一。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="648" width="440" height="154" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="518" y="614" width="460" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="t24" value="&lt;b&gt;② KV 传输与专家无关&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="622" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t25" value="&lt;font style=&quot;font-size:10px&quot;&gt;KV cache 只挂在 attention 层，&lt;b&gt;MoE 层不产生 KV&lt;/b&gt;。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以「专家怎么切」不影响 PD 分离要搬多少 KV。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;（那句「MTP 各层共用同一份 KV 层、只传一次」讲的是 MTP 内部复用，与 MoE 无关。）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="648" width="440" height="154" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1000" y="614" width="460" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="t27" value="&lt;b&gt;③ PD 与 EP 的真实耦合点是「专家 ID 表」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="622" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;font style=&quot;font-size:10px&quot;&gt;某些 MoE 模型（带 Hash 路由的那类）需要一张「token → 专家」的查表，由边侧算好、随上行载荷送到云端。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;而&lt;b&gt;通信方式一变（all-gather ↔ 按需分发），这张表的对齐方式也要跟着变&lt;/b&gt;；对不齐会直接报错。这是 PD + EP 组合时最需要验证的一处。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="648" width="440" height="154" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;b&gt;第四步：本仓为什么没有开 EPLB（如实说明）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;十套包的启动参数里&lt;b&gt;从未出现&lt;/b&gt; EPLB 相关字段（冗余专家数、负载均衡配置等）。可能原因：单机 TP=8 的专家池很小（每卡专家数不多），负载倾斜影响有限；且 EPLB 会额外占显存（冗余专家）——那套包本来显存就紧（还开着 MTP 与量化）。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;这属于「能开但权衡后没开」，不是「不能开」。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="850" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：最后一步（⑩）把术语、wave 协调（为什么 MoE 才需要）与排障清单收在一起。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="994" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;EP 与 TP 互斥（EP 开 → MoE 层 tp_size=1、ep_size=dp*pcp*tp）：vllm/model_executor/layers/fused_moe/config.py:1212-1215、:1244-1259（原文注释 :1242-1243）&lt;br&gt;专家按卡切分（linear / round_robin，非本卡 -1）：expert_map_manager.py:22-113&lt;br&gt;EP 要求模型是 MoE：vllm/config/model.py:1373-1378（verify_with_parallel_config:1433 调用）&lt;br&gt;本仓开 EP 的两处：assets/c_home/bash/pds/fix_1120/prefill.sh:112、decode.sh:112；模型路径 :13（DeepSeek-V4-Flash-w8a8-mtp）；TP=8 :102&lt;br&gt;MTP 层含 MoE 层：vllm/model_executor/models/deepseek_mtp.py:235、:249-263（set_moe_parameters 逐个收集 MoE 层）&lt;br&gt;KV 只在 attention 层、与专家无关：MoE 层不参与 KV 分配（见 生命周期套 ⑤）&lt;br&gt;MTP 各层共用同一份 KV 层（与 MoE 无关）：vllm-ascend/.../kv_p2p/mooncake_connector.py:554-558&lt;br&gt;LWD 的专家 ID 表：边侧 lwd_edge_model_runner.py:284-294 → 云端 lwd_cloud_model_runner.py:814、:1250-1267 → 路由消费 router/fused_topk_router.py:165-216（按通信类型 all_gather / split）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1070" width="1424" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;本仓只有 MoE 那套包开 EP，而 EP 一旦打开就把 MoE 层的 TP 关掉；MTP 层也是 MoE 层、KV 与专家无关、PD 与 EP 的真实耦合点是那张「token→专家」表。&lt;b&gt;EPLB 是「能开但本仓权衡后没开」。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1264" width="1424" height="58" as="geometry"/>
        </mxCell>
