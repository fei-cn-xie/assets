  <diagram id="pg3" name="④ 共享专家">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1472" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="④ 共享专家：让 MoE 里有一条「谁都要走」的 dense 旁路" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：DeepSeek 风格 MoE 除了 N 个路由专家，还有一个&lt;b&gt;所有 token 都必走&lt;/b&gt;的共享专家（权重固定 1）。它承担「通用能力」，让路由专家可以真正特化——&lt;b&gt;代价是它不受稀疏保护，每步都要读&lt;/b&gt;。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：一层 MoE 的完整结构（路由专家 + 共享专家）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;font style=&quot;font-size:10px&quot;&gt;　　　　　　　　　　x（token）&lt;br&gt;　　　　　　┌──────────┴──────────┐&lt;br&gt;　　　　&lt;b&gt;门卫&lt;/b&gt;（打分 + top-k）　　　&lt;b&gt;共享专家&lt;/b&gt;（必走，权重 = 1.0）&lt;br&gt;　　　　　　↓　　　　　　　　　　　　↓&lt;br&gt;　　　k 个路由专家的加权结果　　＋　　固定一路结果&lt;br&gt;　　　　　　└──────────┬──────────┘&lt;br&gt;　　　　　　　　　　　 ↓　输出 y&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="148" width="1424" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;第二步：它解决什么问题（三个理由，按重要性排）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="298" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="328" width="460" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t7" value="&lt;b&gt;① 给通用能力一条「固定容量」的路&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="336" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;font style=&quot;font-size:10px&quot;&gt;路由专家每 token 只碰 k 个，容量有限且被热门专家挤占；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;语法、常见搭配这类「所有 token 都需要」的知识，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;如果也靠路由专家学，会被反复争抢、学不稳。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;共享专家给它们一条永远可用的通道。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="362" width="440" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="518" y="328" width="460" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t10" value="&lt;b&gt;② 让路由专家可以真正特化&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="336" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;font style=&quot;font-size:10px&quot;&gt;有了兜底的通用通路，N 个路由专家就能分工更细、各自更窄。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;这也解释了为什么 MoE 模型的「每专家中间维」通常比 dense 的 FFN 宽度小很多。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="362" width="440" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1000" y="328" width="460" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t13" value="&lt;b&gt;③ 训练更稳&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="336" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;font style=&quot;font-size:10px&quot;&gt;路由是离散选择（top-k），梯度稀疏、容易震荡；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;共享专家的梯度对每个 token 都存在，相当于给优化过程一个稳定的锚。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="362" width="440" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;b&gt;第三步：实现上的三个细节（都能在仓里查到）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="528" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;不是一个「独立的专家」，而是一条更宽的 dense MLP&lt;/b&gt;：多个共享专家被合并成 &lt;b&gt;一个&lt;/b&gt; 宽度 = 每专家宽 × 共享数 的 FFN。&lt;br&gt;② &lt;b&gt;计算量按「token 数」算，不按「token × k」&lt;/b&gt;：本仓性能模型里，路由专家的 FLOPs 用 token×k，共享专家用 token —— 这就是「它不受稀疏保护」的定量表达。&lt;br&gt;③ &lt;b&gt;它不参与负载均衡&lt;/b&gt;：EPLB 计算专家放置时会先把共享专家从总数里减掉，最后单独追加——因为它天然在所有卡上都存在一份（或按 dense 切分）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="558" width="1424" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;b&gt;第四步：代价——它让 MoE「更像 dense」&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;共享专家是 dense 的：&lt;b&gt;每个 token 都走、每一步都要读它的权重&lt;/b&gt;。所以共享专家越宽，MoE 的 decode 就越接近 dense（稀疏性带来的节省被吃回去）。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;推论：&lt;b&gt;共享专家宽度是一个「用 decode 速度换模型质量」的旋钮&lt;/b&gt;——本仓配置里它通常是 1 个共享专家，而路由专家有上百个。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="730" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;b&gt;第五步：本仓两类 MoE 模型的默认结构（来自仓内自带的 config 定义）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="856" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="886" width="700" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;b&gt;DeepSeek-V3 风格（仓内默认）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="894" width="676" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;font style=&quot;font-size:10px&quot;&gt;专家 &lt;b&gt;192&lt;/b&gt; 个　·　top-k &lt;b&gt;8&lt;/b&gt;　·　共享专家 &lt;b&gt;1&lt;/b&gt; 个&lt;br&gt;每专家宽 &lt;b&gt;1536&lt;/b&gt;　·　dense FFN 宽 &lt;b&gt;13312&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="48" y="920" width="676" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="760" y="886" width="700" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;b&gt;GLM-5-Next 风格&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="772" y="894" width="676" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t24" value="&lt;font style=&quot;font-size:10px&quot;&gt;专家 &lt;b&gt;288&lt;/b&gt; 个　·　top-k &lt;b&gt;7&lt;/b&gt;　·　共享专家 &lt;b&gt;1&lt;/b&gt; 个&lt;br&gt;每专家宽 &lt;b&gt;2048&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="772" y="920" width="676" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t25" value="&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;读法：专家数很多但每专家很窄（1536 vs dense 的 13312）；top-k 只有 8 → 每 token 激活约 8/192 ≈ 4.2% 的专家参数。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="990" width="1424" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：结构齐了。下一步（⑤）讲「专家怎么切到多张卡」——这就是专家并行（EP）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1036" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;共享专家的构造（宽度 = 每专家宽 × 共享数）：vllm/model_executor/models/hy_v3.py:164-175&lt;br&gt;「所有 token 都走」的定量证据（FLOPs 用 token 而非 token×k）：vllm/v1/metrics/perf.py:1253-1255（注释原文 all shared experts run for every token）&lt;br&gt;融合放置时把共享专家补进 top-k、权重恒 1：vllm-ascend/vllm_ascend/ops/fused_moe/routed_experts.py:665-680&lt;br&gt;EPLB 计算时先减掉共享专家：vllm-ascend/vllm_ascend/eplb/core/eplb_utils.py:51-55、:72-74&lt;br&gt;默认配置字段：vllm/transformers_utils/configs/hy_v3.py:62-71、:124-135（num_experts=192 / per_tok=8 / shared=1 / expert_hidden_dim=1536 / dense 13312 / first_k_dense_replace=1）&lt;br&gt;GLM-5-Next：vllm-ascend/vllm_ascend/models/glm5next/config.py:30-35（288 专家 / top-7 / 1 共享 / 2048）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1112" width="1424" height="136" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;共享专家 = 一条所有 token 必走的 dense 旁路，作用是「兜通用能力 + 让路由专家能特化 + 训练更稳」；&lt;b&gt;代价是它不受稀疏保护，越宽 MoE 越像 dense。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1282" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t29" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1374" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1371" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1371" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1371" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1371" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1371" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1371" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1371" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="共享专家（必走）" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1371" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e38" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1420" as="sourcePoint"/>
            <mxPoint x="204" y="1420" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t39" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1408" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e40" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1420" as="sourcePoint"/>
            <mxPoint x="454" y="1420" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t41" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1408" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e42" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1420" as="sourcePoint"/>
            <mxPoint x="704" y="1420" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t43" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1408" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg4" name="⑤ 专家并行">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1452" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑤ 专家并行（EP）：把「很多专家」切到多张卡，但总量一点没少" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：EP 就是把 N 个专家&lt;b&gt;按卡切分&lt;/b&gt;，每卡只放 N/ep 个；省的是「单卡必须放下全部专家」，&lt;b&gt;不省总显存&lt;/b&gt;——代价是 token 得跨卡去找自己的专家。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：8 个专家切到 2 张卡（每卡 4 个）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;不切（每卡都放全部专家）&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;卡 0：专家 0 1 2 3 4 5 6 7&lt;br&gt;卡 1：专家 0 1 2 3 4 5 6 7&lt;br&gt;&lt;br&gt;每张卡都要放下全部专家 → 单卡显存压力最大；&lt;br&gt;但每卡都能本地算，&lt;b&gt;不需要搬 token&lt;/b&gt;。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="148" width="690" height="172" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;切分（每卡一半专家）&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;卡 0：专家 0 1 2 3&lt;br&gt;卡 1：专家 4 5 6 7&lt;br&gt;&lt;br&gt;单卡显存压力减半；&lt;br&gt;但 token 若被分到「别人家的专家」，就必须&lt;b&gt;跨卡送过去&lt;/b&gt;（见 ⑥）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="766" y="148" width="694" height="172" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;第二步：必须澄清的一点——EP 不减少总显存&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;切分只是把「一批专家」摊到多张卡上：&lt;b&gt;全部专家仍然要在整个集群里驻留一份&lt;/b&gt;。所以 EP 解决的是「&lt;b&gt;单卡放不下&lt;/b&gt;」，不是「&lt;b&gt;总共太多&lt;/b&gt;」。&lt;br&gt;本仓代码里能直接看到这一点：每张卡维护一张「全局专家 → 本卡槽位」的映射，非本卡的专家映射为 &lt;b&gt;−1&lt;/b&gt;（表示「这个专家不在我这」）。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;推论：EP 之后「可用 KV 显存」并不会因为切分而变多——它和「专家数 × 每专家大小」一起，仍然是显存账里的第一大户（占权重 85~90%）。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="360" width="1424" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="t7" value="&lt;b&gt;第三步：EP 和 TP / DP 的关系（三个容易混的概念）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="490" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;概念&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="520" width="200" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;切什么&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="236" y="520" width="340" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;通信代价&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="576" y="520" width="460" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;谁能用&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1036" y="520" width="424" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;TP（张量并行）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="558" width="200" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;切「一层内的矩阵」&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="558" width="340" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;每层都要通信（all_reduce）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="576" y="558" width="460" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;dense 与 MoE 都用&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1036" y="558" width="424" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;EP（专家并行）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="596" width="200" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;切「专家」&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="596" width="340" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;token 跨卡搬（前后各一次）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="576" y="596" width="460" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;只有 MoE 才有&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1036" y="596" width="424" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;DP（数据并行）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="634" width="200" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;复制整模型，各跑各的请求&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="634" width="340" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;推理时几乎不通信&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="576" y="634" width="460" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;两者都能用&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1036" y="634" width="424" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:10px&quot;&gt;本仓文档给的换算是 &lt;b&gt;EP 规模 = TP 规模 × DP 规模&lt;/b&gt;——也就是说：单机 8 卡 TP=8 时开 EP，等于把这 8 张卡都当成「专家池」；而 DP=2 时，两个副本的卡也会计入 EP 池。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;所以开关只有一句 &lt;font style=&quot;font-size:9px&quot;&gt;--enable-expert-parallel&lt;/font&gt;，但实际拓扑由 TP/DP 一起决定。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="688" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="t25" value="&lt;b&gt;第四步：切分后为什么需要「逻辑专家 → 物理专家」两层映射&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="794" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="824" width="700" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t27" value="&lt;b&gt;原因：专家的位置可能被「搬动」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="832" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;font style=&quot;font-size:10px&quot;&gt;模型里定义的专家编号（逻辑）与「它此刻在哪张卡、哪个槽位」（物理）是两回事。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;因为 ⑦ 页要讲的负载均衡会把热门专家复制几份、挪到别的卡上。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以路由算完之后，还要过一次「逻辑 → 物理」映射表。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="858" width="680" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="824" width="664" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t30" value="&lt;b&gt;本仓的实现&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="832" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t31" value="&lt;font style=&quot;font-size:10px&quot;&gt;有一张映射表把逻辑专家号映射到物理专家号；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;未启用负载均衡时，它基本是恒等映射（第 i 个专家就在第 i 个槽位）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;启用之后，同一个逻辑专家可能对应多个物理副本。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="858" width="644" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：切了专家就要搬 token。下一步（⑥）看搬的三种实现——注意本仓默认&lt;b&gt;不是&lt;/b&gt; all-to-all。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1032" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;每卡只放 global_num_experts // ep_size 个、非本卡映射为 −1：vllm/model_executor/layers/fused_moe/expert_map_manager.py:22-69&lt;br&gt;EP 规模 = TP × DP（本仓文档原文）：vllm/docs/serving/expert_parallel_deployment.md:36-40&lt;br&gt;逻辑→物理映射与负载记录：vllm-ascend/vllm_ascend/ops/fused_moe/eplb.py:10、:37、:87、:99&lt;br&gt;专家占权重字节 85~90%：vllm/model_executor/model_loader/ep_weight_filter.py:1-9&lt;br&gt;EP 开关在代码里改变什么：`--enable-expert-parallel` 传导到 MoE 通信方法选择，见 ⑥ 页的选择链（ascend_forward_context.py:373-425）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1108" width="1424" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;EP = 把专家切到多卡，省的是「单卡放得下」，不省总显存；代价是把「本地计算」换成「跨卡搬 token」，并且多出一层「逻辑专家 → 物理专家」的映射。&lt;b&gt;没有 MoE 就没有 EP。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1262" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t35" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1354" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1351" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1351" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1351" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1351" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1351" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1351" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1351" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="映射表/数据面" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1351" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e44" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1400" as="sourcePoint"/>
            <mxPoint x="204" y="1400" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t45" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1388" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e46" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1400" as="sourcePoint"/>
            <mxPoint x="454" y="1400" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t47" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1388" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e48" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1400" as="sourcePoint"/>
            <mxPoint x="704" y="1400" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t49" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1388" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg5" name="⑥ 三种通信实现">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1462" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑥ 搬 token 的三种实现——注意：EP 不必然走 all-to-all" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：专家切到多卡后 token 要跨卡，本仓有&lt;b&gt;三条&lt;/b&gt;实现可选：&lt;b&gt;all-gather（默认）&lt;/b&gt;、&lt;b&gt;MC2（通信与计算融合）&lt;/b&gt;、&lt;b&gt;all-to-all&lt;/b&gt;；选哪条由「是否开 EP、硬件型号、专家密度」共同决定，&lt;b&gt;不开 EP 时根本不用搬&lt;/b&gt;。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：选择链（按顺序判，先命中先用）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;① 不是 MoE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;不涉及&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="146" width="300" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;② 没开 EP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;all-gather&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="352" y="146" width="300" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="338" y="184" as="sourcePoint"/>
            <mxPoint x="350" y="184" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;③ 开了 EP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;再按下面判&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="668" y="146" width="300" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="654" y="184" as="sourcePoint"/>
            <mxPoint x="666" y="184" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;④ 开了 EP 且用了 LoRA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;→ all-to-all（融合算子插不进 LoRA）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="984" y="146" width="476" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;第二步（开了 EP、没用 LoRA）继续分岔：看硬件策略与专家密度&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 某些硬件：当「每卡专家数 ≤ 24 且 EP 规模 ≥ 16」才启用 MC2（融合算子），&lt;b&gt;否则回落到 all-gather&lt;/b&gt;；&lt;br&gt;· 另一些硬件：当「EP 规模 ≤ top-k」时也回落 all-gather（因为每卡能拿到的专家很少，融合不划算）；&lt;br&gt;· 结论：&lt;b&gt;「开了 EP 就走 all-to-all」是错的&lt;/b&gt;——本仓最常见的路径其实是 all-gather。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="252" width="1424" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;第四步：三条实现各自在干什么（这是本页的核心）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="370" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="400" width="460" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="t13" value="&lt;b&gt;all-gather（默认）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="408" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;font style=&quot;font-size:10px&quot;&gt;把&lt;b&gt;所有卡上的 token&lt;/b&gt;都收集到每张卡上（每卡都拿到全量 token），&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;然后每卡只用「本地专家」筛出属于自己的那部分行来算。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;优点：实现简单、不需要复杂的收发配对。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;缺点：搬的是「全量 token」而不是「该去别卡的那些」——&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;EP 规模越大越浪费&lt;/b&gt;。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="434" width="440" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="518" y="400" width="460" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;b&gt;all-to-all（按需送）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="408" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;font style=&quot;font-size:10px&quot;&gt;只把「要去别卡专家」的 token 送过去，接收方也只收自己需要的。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;优点：搬的量与「真正跨卡的 token 数」成正比，EP 大时更省。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;缺点：要按份数切分/拼装（收发元数据复杂），&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;且小 batch 时延迟盖过收益；另有实现限制（例如不支持 bias）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="434" width="440" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1000" y="400" width="460" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;b&gt;MC2（融合）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="408" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;font style=&quot;font-size:10px&quot;&gt;把「重排 + 通信 + 分组矩阵乘」&lt;b&gt;压进一个融合算子&lt;/b&gt;，通信与计算重叠。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;优点：省掉中间搬运、减少一次落盘到显存。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;缺点：只支持特定量化组合与特定硬件；专家太少时不划算；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;且在&lt;b&gt;未开 EP 时会直接报错&lt;/b&gt;（它本身就是为 EP 场景写的）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="434" width="440" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;第四步：为什么小 batch（decode）时这三条都不便宜&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;通信缓冲要按&lt;b&gt;最坏情况&lt;/b&gt;分配：&lt;b&gt;每卡最大批 × EP 规模 × min(top-k, 每卡专家数)&lt;/b&gt;——这个式子与「本次实际有多少 token」无关。&lt;br&gt;所以 decode 这种「每步只有几十个 token」的场景，仍要付「为最大批准备的开销」（元数据、屏障、缓冲清零等固定成本）。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;这就是本文档反复强调「MoE 在 decode 阶段更吃亏」的机制之一（另一条是要读的专家权重零碎）。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="650" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t22" value="&lt;b&gt;第五步：一张速查（怎么判断当前用的是哪条）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="776" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;b&gt;看哪&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="806" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;条件&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="236" y="806" width="720" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;结论&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="956" y="806" width="504" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;启动参数&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="840" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;没开 --enable-expert-parallel&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="840" width="720" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;→ all-gather（或不用搬）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="956" y="840" width="504" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;启动参数&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="874" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;开了 EP + LoRA&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="874" width="720" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;→ all-to-all&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="956" y="874" width="504" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;硬件+常量&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="908" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:11px&quot;&gt;EP 规模、每卡专家数、top-k 满足条件&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="908" width="720" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:11px&quot;&gt;→ MC2&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="956" y="908" width="504" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;font style=&quot;font-size:11px&quot;&gt;日志&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="942" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;font style=&quot;font-size:11px&quot;&gt;看「选择哪种 MoE 通信方法」的启动日志（关键字见锚点）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="942" width="720" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;font style=&quot;font-size:11px&quot;&gt;→ 直接确认&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="956" y="942" width="504" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：通信选好了，但「谁被送到哪个专家」本身也可能极不均衡。下一步（⑦）讲负载均衡——训练期靠损失/偏置，推理期靠换位与冗余副本。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1010" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;选择链（非 MoE→不涉及；未开 EP 或 ep_world==1→ALLGATHER；EP+LoRA→ALLTOALL；否则按硬件策略）：vllm-ascend/vllm_ascend/ascend_forward_context.py:373-425&lt;br&gt;A2 策略：每卡专家 ≤24 且 EP≥16 才 MC2，否则回落 ALLGATHER：同文件 :304-315&lt;br&gt;A5 策略：EP 规模 ≤ top-k 时回落 ALLGATHER：同文件 :361-362&lt;br&gt;MC2 要求 enable_expert_parallel=True（原文）：vllm-ascend/.../fused_moe/moe_comm_method.py:243-245、:291-293&lt;br&gt;all-to-all 的实现（torch.distributed.all_to_all_single，group=EP 组）：vllm-ascend/.../fused_moe/moe_utils.py:63-99&lt;br&gt;MC2 单算子收发：token_dispatcher.py:232、:331（npu_moe_distribute_dispatch_v2/combine_v2）&lt;br&gt;all-gather 路径只保留本地专家：token_dispatcher.py:396-413（active_expert_range）&lt;br&gt;all-to-all 路径不支持 bias（原文）：token_dispatcher.py:328、:560&lt;br&gt;缓冲按最坏情况分配：moe_comm_method.py:416-422；token_dispatcher.py:126-133&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1086" width="1424" height="152" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;搬 token 有三条路：&lt;b&gt;all-gather（默认、简单但搬全量）&lt;/b&gt;、&lt;b&gt;all-to-all（按需、省量但复杂）&lt;/b&gt;、&lt;b&gt;MC2（融合、最快但挑硬件与量化）&lt;/b&gt;；选哪条由「是否开 EP + 硬件 + 专家密度」决定，&lt;b&gt;不开 EP 就不需要搬&lt;/b&gt;。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1272" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t41" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1364" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1361" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1361" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1361" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1361" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1361" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1361" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1361" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="按需搬运（all-to-all）" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1361" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e50" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1410" as="sourcePoint"/>
            <mxPoint x="204" y="1410" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t51" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1398" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e52" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1410" as="sourcePoint"/>
            <mxPoint x="454" y="1410" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t53" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1398" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e54" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1410" as="sourcePoint"/>
            <mxPoint x="704" y="1410" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t55" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1398" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg6" name="⑦ 负载均衡">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1702" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑦ 负载均衡：为什么总有「热门专家」，以及两种治它的办法" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：路由是「谁分高谁上」，于是热门专家会越来越热、冷门专家越来越闲；&lt;b&gt;训练期&lt;/b&gt;用辅助损失或路由偏置压制，&lt;b&gt;推理期&lt;/b&gt;用「把专家搬/复制到空闲卡」（EPLB）削峰。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：现象（本仓文档原文：实际分布可能高度偏斜）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;font style=&quot;font-size:10px&quot;&gt;MoE 训练时通常会让各专家分到的 token 数接近，但 &lt;b&gt;线上真实流量的分布可能与训练分布不一致&lt;/b&gt;：某些专家接到远超平均的 token，另一些几乎闲着。&lt;br&gt;后果：专家被切到不同卡之后，&lt;b&gt;「热门专家所在的那张卡」成了瓶颈&lt;/b&gt;——它算不完，其他卡在等它（因为每层结束都要同步）。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;注意：这不是 bug，是「稀疏路由 + 按卡切分 + 每层同步」这套结构的必然副作用。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="146" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;第二步：怎么量化「有多不均衡」（本仓有两个现成口径）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="272" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="302" width="700" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="t7" value="&lt;b&gt;口径一：均衡度 balancedness&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="310" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;font style=&quot;font-size:10px&quot;&gt;= 每专家平均 token 数 ÷ 每专家最大 token 数。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;取值 0~1，&lt;b&gt;越接近 1 越均衡&lt;/b&gt;；0.5 意味着最忙的专家比平均忙一倍。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="336" width="680" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="302" width="664" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="t10" value="&lt;b&gt;口径二：rank 负载比（EPLB 日志）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="310" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;font style=&quot;font-size:10px&quot;&gt;看「各卡负载的最大值 ÷ 平均值」，同时报均值与 p95。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;日志里的说法是「越低越好」——它衡量的是&lt;b&gt;卡的&lt;/b&gt;不均衡，而不是专家的。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="336" width="644" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;b&gt;第三步：训练期的两种手段（本仓配置里都能看到字段）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="442" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="472" width="700" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;b&gt;手段一：辅助负载均衡损失（aux loss）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="480" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;font style=&quot;font-size:10px&quot;&gt;在总损失里加一项，惩罚「专家分到的 token 不均」。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本仓配置里对应的开关是把「每层路由 logits 输出出来」——&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;注释原文写明：这是&lt;b&gt;为了训练期计算辅助负载均衡损失&lt;/b&gt;用的，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;推理期默认关闭以省显存。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="506" width="680" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="796" y="472" width="664" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;b&gt;手段二：路由偏置（不用改损失）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="480" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;font style=&quot;font-size:10px&quot;&gt;给每个专家一个可学习的偏置，加到路由分数上，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;把冷门专家「抬」一点、热门专家「压」一点。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;好处：不动主损失，实现简单；本仓配置里默认是开启的。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;（这是 DeepSeek 系的做法：用偏置代替辅助损失。）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="506" width="644" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;b&gt;第四步：推理期的 EPLB（把「换座位」做成一个子系统）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="658" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;三段式&lt;/b&gt;：① &lt;b&gt;控制面&lt;/b&gt;——按窗口统计各专家实际负载；② &lt;b&gt;决策面&lt;/b&gt;——重算「哪个专家该放哪张卡」，必要时给热门专家&lt;b&gt;复制副本&lt;/b&gt;（冗余专家）；③ &lt;b&gt;搬运面&lt;/b&gt;——把专家权重真的搬过去。&lt;br&gt;&lt;b&gt;为什么能削峰&lt;/b&gt;：热门专家不再只有一份，而是分散在多张卡上，于是那几张卡可以并行消化它的流量。&lt;br&gt;&lt;b&gt;代价&lt;/b&gt;：冗余副本要占额外显存（本仓文档给了 DeepSeek-V3 的量级：&lt;b&gt;每卡多一个冗余专家约 2.4 GB&lt;/b&gt;），并且会挤占 KV cache。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="688" width="1424" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;b&gt;第五步：昇腾侧的三条硬限制（都会直接拒绝或强制改写）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="830" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;组合&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="860" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;b&gt;限制&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="456" y="860" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;表现&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1076" y="860" width="384" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;同步式 EPLB&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="894" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;不支持 → 强制改成异步&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="456" y="894" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;启动期就改写&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="894" width="384" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;EPLB + 弹性 EP&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="928" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;不支持组合&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="456" y="928" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;拒绝&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="928" width="384" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;EPLB 走哪个通信库&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="962" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;必须是 gloo 或 hixl&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="456" y="962" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:11px&quot;&gt;拒绝&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="962" width="384" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:11px&quot;&gt;EPLB 与 ModelRunner 版本&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="996" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;font style=&quot;font-size:11px&quot;&gt;昇腾上只有 v2 runner 支持上游 EPLB&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="456" y="996" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;font style=&quot;font-size:11px&quot;&gt;拒绝/降级&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="996" width="384" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;font style=&quot;font-size:11px&quot;&gt;量化 MoE + 动态 EPLB&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1030" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;font style=&quot;font-size:11px&quot;&gt;部分组合不支持（如 LoRA、per-expert 张量列表）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="456" y="1030" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;font style=&quot;font-size:11px&quot;&gt;拒绝&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="1030" width="384" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;b&gt;第六步：四件事别混（本页最想让你带走的区分）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;辅助损失&lt;/b&gt;：训练期改梯度，从源头让分布均匀；② &lt;b&gt;路由偏置&lt;/b&gt;：训练期改分数，同样从源头；③ &lt;b&gt;EPLB&lt;/b&gt;：推理期搬位置/加副本，&lt;b&gt;不改模型、只改放置&lt;/b&gt;；④ &lt;b&gt;容量因子 / token drop&lt;/b&gt;：训练期概念，本仓推理路径&lt;b&gt;不做截断&lt;/b&gt;（重排行数就是 token×k，不会有 token 被丢）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1098" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：负载这块讲完了。下一步（⑧）把昇腾侧的主链拼起来——从路由算子到分组矩阵乘，以及共享专家怎么和多流重叠。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1242" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;「实际分布可能高度偏斜」原文：vllm/docs/serving/expert_parallel_deployment.md:138&lt;br&gt;辅助损失开关与原文（训练期用、推理期关闭以省显存）：vllm/transformers_utils/configs/hy_v3.py:84-87&lt;br&gt;路由偏置（无损失均衡，默认开启）：同文件 :70-71；落到模型 vllm/model_executor/models/hy_v3.py:177-181、:198&lt;br&gt;EPLB 三段式与「重算放置 + 搬专家权重」：vllm-ascend/docs/source/developer_guide/Design_Documents/model_runner_v2_eplb.md:3-8、:103-114&lt;br&gt;负载比口径（mean / p95 max-to-average，越低越好）：同文件 :204-207；balancedness 定义 vllm/docs/serving/expert_parallel_deployment.md:154&lt;br&gt;冗余专家显存公式与 ≈2.4 GB（DeepSeek-V3）：expert_parallel_deployment.md:184-189&lt;br&gt;EPLB 策略实现（含冗余专家部署）：vllm-ascend/.../eplb/core/policy/policy_default_eplb.py:298&lt;br&gt;昇腾限制（同步 EPLB 不支持、弹性 EP 不兼容、需 gloo/hixl、只 MRv2）：vllm-ascend/vllm_ascend/platform.py:996-1017&lt;br&gt;推理路径不做容量截断：token_dispatcher.py:616-620&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1318" width="1424" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;不均衡来自「谁分高谁上」，会把某张卡拖成瓶颈；治它分两层——&lt;b&gt;训练期改源头&lt;/b&gt;（辅助损失 / 路由偏置），&lt;b&gt;推理期改放置&lt;/b&gt;（EPLB 换位 + 冗余副本，代价是显存）。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1512" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t44" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1604" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1601" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1601" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1601" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1601" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1601" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1601" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1601" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="放置/搬运面" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1601" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e53" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1650" as="sourcePoint"/>
            <mxPoint x="204" y="1650" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t54" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1638" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e55" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1650" as="sourcePoint"/>
            <mxPoint x="454" y="1650" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t56" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1638" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e57" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1650" as="sourcePoint"/>
            <mxPoint x="704" y="1650" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t58" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
