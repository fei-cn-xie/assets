  </diagram>
  <diagram id="pg7" name="⑧ 昇腾 MoE 主链">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1330" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑧ 昇腾侧：一条被「融合算子」串起来的主链" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：昇腾把「路由 → 重排 → 分组矩阵乘 → 散射」几乎全压成了 &lt;b&gt;NPU 专用算子&lt;/b&gt;，还额外提供「重排时顺便量化」和「共享专家与专家计算并行」两个优化。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：主链（每一步对应一个或一组昇腾算子）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;① 门卫&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;gating top-k 融合算子&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="146" width="224" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;② 重排+量化&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;init_routing（顺带动态量化）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="272" y="146" width="224" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="262" y="188" as="sourcePoint"/>
            <mxPoint x="270" y="188" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;③ 第一段 GEMM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;grouped matmul（gate+up）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="508" y="146" width="224" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="498" y="188" as="sourcePoint"/>
            <mxPoint x="506" y="188" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;④ 激活&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;可与量化融合成单算子&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="744" y="146" width="224" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="734" y="188" as="sourcePoint"/>
            <mxPoint x="742" y="188" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;⑤ 第二段 GEMM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;grouped matmul（down）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="980" y="146" width="224" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="970" y="188" as="sourcePoint"/>
            <mxPoint x="978" y="188" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;⑥ 散射+加权&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;token unpermute（带权重）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1216" y="146" width="224" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e14" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1206" y="188" as="sourcePoint"/>
            <mxPoint x="1214" y="188" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t15" value="&lt;b&gt;第二步：三个昇腾特有的优化（这是本页的重点）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="240" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="270" width="460" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;b&gt;① 重排时顺便量化&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="278" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;font style=&quot;font-size:10px&quot;&gt;普通做法：重排（搬一次数据）→ 量化（再搬一次）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;昇腾把量化塞进重排算子：&lt;b&gt;一次搬运完成两件事&lt;/b&gt;。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;省的是「多搬一遍 token」的带宽——在小 batch 时很值钱。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="304" width="440" height="158" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="518" y="270" width="460" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;b&gt;② 融合 kernel：两段 GEMM + 激活&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="278" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;font style=&quot;font-size:10px&quot;&gt;「gate/up 段 → 激活 → down 段」可以压成&lt;b&gt;一个融合算子&lt;/b&gt;，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;中间结果不落显存（少一次写+读）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;代价：融合算子对&lt;b&gt;量化组合与硬件型号&lt;/b&gt;有要求，不满足就回退到分步。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="304" width="440" height="158" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1000" y="270" width="460" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;b&gt;③ 共享专家与专家计算「并行」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="278" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t24" value="&lt;font style=&quot;font-size:10px&quot;&gt;共享专家是 dense 的，和路由专家的计算互不依赖 → 可以&lt;b&gt;放另一条流同时跑&lt;/b&gt;。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;实现上还用「里程碑/事件」对齐两段之间的依赖（例如激活前必须等到某一段）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本仓还有一致性校验：&lt;b&gt;拆开算的结果必须等于整体算的结果&lt;/b&gt;，不等直接报错。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="304" width="440" height="158" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;第三步：一个 EP 下的易错点（阅读代码时会遇到）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;开 EP 后，MoE 层自己的「TP 规模」被改写成了 1（因为专家已经是「每卡一份」），&lt;b&gt;但共享专家的权重仍然按 TP 切分&lt;/b&gt;。&lt;br&gt;所以判断共享专家布局时，不能看 MoE 层那个被改写过的值，而要看&lt;b&gt;真正的 TP 组规模&lt;/b&gt;——代码里专门为此写了注释，踩了这个坑会看到「共享专家形状对不上」或「结果不一致」。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="510" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t26" value="&lt;b&gt;第四步：vLLM 侧与昇腾侧的分工（避免读代码时迷路）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="636" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;在哪&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="666" width="240" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;b&gt;负责什么&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="276" y="666" width="780" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;b&gt;看哪里&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1056" y="666" width="404" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;vLLM 侧（框架）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="704" width="240" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;装配 MoE 层、路由策略、专家权重容器、EPLB 状态机、wave 协调&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="276" y="704" width="780" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;fused_moe/layer.py、runner/moe_runner.py、distributed/eplb/&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1056" y="704" width="404" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:11px&quot;&gt;昇腾侧（后端）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="742" width="240" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:11px&quot;&gt;把每一步换成 NPU 算子、选通信实现、管理流与事件、量化实现&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="276" y="742" width="780" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;font style=&quot;font-size:11px&quot;&gt;vllm_ascend/ops/fused_moe/*&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1056" y="742" width="404" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;font style=&quot;font-size:11px&quot;&gt;两侧的契约&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="780" width="240" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;font style=&quot;font-size:11px&quot;&gt;「准备/执行/收尾」三段 + 专家权重命名 w13/w2 + 量化 scheme 接口&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="276" y="780" width="780" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;font style=&quot;font-size:11px&quot;&gt;见 ⑩ 页的锚点清单&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1056" y="780" width="404" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：主链清楚了。下一步（⑨）回到部署侧——本仓到底哪套包用了 MoE、为什么只有它开 EP，以及 MoE 与 PD/MTP 的耦合点。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="854" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;昇腾 MoE 总装：vllm-ascend/vllm_ascend/ops/fused_moe/fused_moe.py:85（AscendMoERunner）、:161（forward）、:498（_forward_impl）&lt;br&gt;路由：gate_linear.py:27；融合 gating 走 npu_moe_gating_top_k（device/device_op.py:1225，经 router/fused_topk_router.py:267）；回落纯 torch：router/grouped_topk_router.py:11、:59&lt;br&gt;重排/散射：token_dispatcher.py:402（init_routing，带 active_expert_range）、:430（unpermute）、:592（permute）&lt;br&gt;分组矩阵乘：routed_experts.py:231（gmm1）、:294（gmm2）；融合版 grouped_matmul_swiglu_quant（w8a8_dynamic.py:420/429、w4a8.py:495）&lt;br&gt;「重排时顺便量化」：token_dispatcher.py:377-383（quant_mode 1/3/9）&lt;br&gt;共享专家多流 + 里程碑：shared_experts.py:99、:358、:743/761；拆算一致性校验 :152-192（不等即 ValueError :188）&lt;br&gt;EP 下 MoE 层 tp 被改写为 1 但共享专家按真实 TP 布局：shared_experts.py:219-238（注释 :221-224）&lt;br&gt;MoE 层总装的 vLLM 侧：vllm/model_executor/layers/fused_moe/layer.py:88（FusedMoEFactory）、runner/moe_runner.py:681（forward）&lt;br&gt;四段流水线原文：[Router]→[Quantize-Dispatch]→[Permute-Experts-Unpermute]→[Combine]：vllm/model_executor/layers/fused_moe/modular_kernel.py:48-83&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="930" width="1424" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;昇腾把 MoE 主链压成了「融合算子串」——重排顺带量化、两段 GEMM 与激活融合、共享专家放另一条流并行；&lt;b&gt;代价是这些融合对硬件与量化组合有要求，不满足就回退分步&lt;/b&gt;（回退了也正确，只是慢）。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1140" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t42" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1232" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1229" width="120" height="26" as="geometry"/>
