  <diagram id="pg5" name="⑥ connector 结构">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1098" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑥ MooncakeConnector 里都有谁（一张图看清分层）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：vLLM 只在固定时刻调几个方法（上层），connector 里分「调度侧」和「worker 侧」，真正的搬运发生在后台线程 + 传输引擎（底层）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第 1 层 · vLLM 核心只认「钩子」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="800" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;调度器 scheduler（决定谁跑、跑多少 token）&lt;/b&gt;&lt;br&gt;它会在固定时刻调用 connector 的&lt;b&gt;调度侧方法&lt;/b&gt;：问「能省多少」、登记块号、打包工单。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;对应方法名见下一页（⑤ 钩子表）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="148" width="690" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;worker（真正跑模型的进程）&lt;/b&gt;&lt;br&gt;它会在固定时刻调用 connector 的&lt;b&gt;worker 侧方法&lt;/b&gt;：注册显存、下发工单、取「这一轮谁完成了」。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;worker 侧才有 NPU 句柄，所以搬运动作只能发生在这一侧&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="766" y="148" width="694" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;b&gt;第 2 层 · MooncakeConnector（门面，按 role 分派）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="256" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;MooncakeConnector&lt;/b&gt;　&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;mooncake_connector.py:1608 · 对外注册名 MooncakeConnectorV1&lt;/font&gt;&lt;br&gt;它自己不干活：把调用转给 scheduler 侧或 worker 侧的两套实现。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="288" width="1424" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;第 3 层 · 两侧各管一段（这是读代码时最容易迷路的地方）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="372" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;调度侧 MooncakeConnectorScheduler&lt;/b&gt;&lt;br&gt;&lt;br&gt;① &lt;b&gt;get_num_new_matched_tokens&lt;/b&gt;：我能省掉多少重复计算？→ 返回 (数量, True)&lt;br&gt;② &lt;b&gt;update_state_after_alloc&lt;/b&gt;：登记「我这些本地块要去远端拉」&lt;br&gt;③ &lt;b&gt;build_connector_meta&lt;/b&gt;：把这些登记打包成工单&lt;br&gt;④ &lt;b&gt;request_finished&lt;/b&gt;（P 侧）：算交接清单 + &lt;b&gt;钉住块&lt;/b&gt;（delay_free_blocks=True）&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;锚点：:1916 / :1958 / :1987 / :2016&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="404" width="690" height="214" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;worker 侧 MooncakeConnectorWorker&lt;/b&gt;&lt;br&gt;&lt;br&gt;① &lt;b&gt;register_kv_caches&lt;/b&gt;：把 KV 显存注册给传输引擎，并起后台线程&lt;br&gt;② &lt;b&gt;start_load_kv&lt;/b&gt;：D 侧入口，排班后把工单丢进队列&lt;br&gt;③ &lt;b&gt;get_finished&lt;/b&gt;：回报「谁发完了 / 谁收完了」，交给核心去释放块&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;锚点：:2627 / :3835 / :2767-2787&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="766" y="404" width="694" height="214" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;第 4 层 · 后台线程与传输引擎（真正搬东西的人）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="634" width="1000" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;KVCacheSendingThread（P 侧的「挂号窗口」）&lt;/b&gt;&lt;br&gt;名字叫 Sending，但它&lt;b&gt;不搬 KV&lt;/b&gt;：&lt;br&gt;只做两件事：① 回「仓库地址表」；② 收「我收完了」并回 ACK。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#c0392b&quot;&gt;名字误导：这是本套实现最容易被读错的地方&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="666" width="466" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;KVCacheRecvingThread（D 侧的「搬运工」）&lt;/b&gt;&lt;br&gt;32 线程池；按「对端 host:port」分桶；每桶每轮最多处理 5 个请求就换人（防止一个忙 P 独占）。&lt;br&gt;所有 KV 数据都由它发起的 &lt;b&gt;RDMA read&lt;/b&gt; 拉过来。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="536" y="666" width="460" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;global_te（TransferEngine 单例）&lt;/b&gt;&lt;br&gt;全进程一个：&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;initialize(host, &quot;P2PHANDSHAKE&quot;, &quot;ascend&quot;, device)&lt;/font&gt;&lt;br&gt;向下直接调网卡/驱动（RDMA），向上只暴露「注册内存 / 读 / 写」三种动作。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;锚点：utils/mooncake_transfer_engine.py:4-43&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1030" y="666" width="430" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="e15" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="381" y="240" as="sourcePoint"/>
            <mxPoint x="381" y="288" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e16" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1113" y="240" as="sourcePoint"/>
            <mxPoint x="1113" y="288" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e17" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="381" y="358" as="sourcePoint"/>
            <mxPoint x="381" y="404" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e18" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1113" y="358" as="sourcePoint"/>
            <mxPoint x="1113" y="404" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e19" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n9" target="n12">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e20" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n10" target="n13">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e21" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1" source="n13" target="n14">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;读这套代码时最容易踩的三点&lt;/b&gt;&lt;br&gt;① &lt;b&gt;箭头方向 ≠ 数据方向&lt;/b&gt;：P 侧线程只回元数据和 ACK，KV 数据是 D 主动&lt;b&gt;读&lt;/b&gt;过去的（pull），P 从不 push。&lt;br&gt;② &lt;b&gt;不是逐层的&lt;/b&gt;：&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;wait_for_layer_load / save_kv_layer / wait_for_save 三个钩子实现就是 pass（:1691-1703）&lt;/font&gt;；逐层版在另一个文件 mooncake_layerwise_connector.py。&lt;br&gt;③ &lt;b&gt;没有 pin API&lt;/b&gt;：「钉住块」是通过 request_finished 返回 delay_free_blocks=True 让核心延迟释放，不是 connector 自己加锁。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="870" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1000" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="997" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="997" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
