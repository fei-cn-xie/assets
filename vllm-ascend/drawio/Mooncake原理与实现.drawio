        </mxCell>
        <mxCell id="n49" value="&lt;b&gt;算搬运单：src / dst / length 三个等长列表&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;三层循环（组 → 层 → 缓存），连续块会被合并成一段&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;mooncake_connector.py:877-1030&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="960" y="879" width="424" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="e50" value="RDMA read：把 KV 从 P 的显存读到 D 的显存&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;mooncake_connector.py:1042-1049 · batch_transfer_sync_read&lt;/font&gt;" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1172" y="957" as="sourcePoint"/>
            <mxPoint x="714" y="957" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n51" value="&lt;b&gt;拼装：P 的 TP 比 D 大时，把分片 cat 回完整 head 维&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;mooncake_connector.py:1083-1165&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="960" y="986" width="424" height="39" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="&lt;font color=&quot;#999999&quot;&gt;④ 收尾：回执、解钉、失败兜底&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;fillColor=#e7e0d4;strokeColor=#b3a89c;" vertex="1" parent="1">
          <mxGeometry x="36" y="1041" width="1814" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="e53" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="36" y="1035" as="sourcePoint"/>
            <mxPoint x="1850" y="1035" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e54" value="DONE_RECVING：我收完了&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;无论成功失败都发：不发会让对端内存泄漏&lt;/font&gt;" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1172" y="1080" as="sourcePoint"/>
            <mxPoint x="714" y="1080" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e55" value="ACK" style="endArrow=block;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="714" y="1126" as="sourcePoint"/>
            <mxPoint x="1172" y="1126" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n56" value="&lt;b&gt;按端口累计回执，达到 D 声明的片数才算这一单完成&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;mooncake_connector.py:373-397&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="502" y="1155" width="424" height="39" as="geometry"/>
        </mxCell>
        <mxCell id="n57" value="&lt;b&gt;get_finished() → done_sending → 真正释放那些块&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;至此「钉住」解除，P 的显存才回来&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;mooncake_connector.py:2767-2787, 213-224&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="44" y="1204" width="424" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="n58" value="兜底：480 秒还没人来拿 → 强制释放并打 error（VLLM_MOONCAKE_ABORT_REQUEST_TIMEOUT，vllm/envs.py:260）" style="shape=note;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;size=11;fillColor=#efe9dd;strokeColor=#a1887f;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="502" y="1265" width="882" height="27" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg7" name="⑧ 成功判定与兜底">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1424" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑧ 什么时候算「成功」：块 / 请求 / 链路 三层判定与失败兜底" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：发出去了不算成功——要对端回执、要计数器归零、要块表里真的写进去了，才算这一单办完。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一层：块的状态（最底层，决定显存能不能回收）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;空闲 / 已分配&lt;/b&gt;&lt;br&gt;块在自己的池子里，可用或正在被某个请求用着。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="460" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;被钉住（delay_free_blocks）&lt;/b&gt;&lt;br&gt;请求结束了但&lt;b&gt;还不能回收&lt;/b&gt;：P 侧用 &lt;font style=&quot;font-size:9px&quot;&gt;request_finished&lt;/font&gt; 返回 True 把它钉住，等 D 来拿。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="536" y="150" width="460" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;真正释放&lt;/b&gt;&lt;br&gt;D 回执到达、P 侧计数器归零后，&lt;font style=&quot;font-size:9px&quot;&gt;get_finished&lt;/font&gt; 报给核芯，块才回到池子。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1036" y="150" width="460" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="请求结束" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="回执齐了" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n5" target="n6">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="t9" value="&lt;b&gt;第二层：请求的状态（调度器视角，决定「现在能不能算」）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="284" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;等 KV（WAITING）&lt;/b&gt;&lt;br&gt;D 侧已经知道「有 KV 在别人机器上」，调度器把它挂在等待队列，&lt;b&gt;先去跑别的请求&lt;/b&gt;。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;这就是 get_num_new_matched_tokens 返回第二个值 True 的含义&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="318" width="700" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;可以算（RUNNING）&lt;/b&gt;&lt;br&gt;KV 到齐后，请求进入正常解码；此后每生成一个 token 都用到刚搬来的那段 KV。&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#c0392b&quot;&gt;搬失败时&lt;b&gt;分两种口径&lt;/b&gt;：原生路径把坏块记进 invalid_block_ids 让核心&lt;b&gt;重算&lt;/b&gt;；而 &lt;b&gt;LWD PD 路径被强制成 fail-closed&lt;/b&gt;（recompute_kv_load_failures=False）——直接终止请求，不重算、不换机器。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="776" y="318" width="684" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="KV 到齐" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n10" target="n11">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="t13" value="&lt;b&gt;第三层：整条链路的「办完了」信号（谁说完成、谁相信）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="474" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;D 侧：我收完了（DONE_RECVING）&lt;/b&gt;&lt;br&gt;搬完之后 D 主动发一条完成消息给 P；&lt;b&gt;无论成功还是失败都要发&lt;/b&gt;——&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#c0392b&quot;&gt;代码注释写明：不发会导致对端内存泄漏（P 的块永远钉着）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="508" width="690" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;P 侧：回执核销（ACK）&lt;/b&gt;&lt;br&gt;P 按「端口 + 片数」累计回执，达到 D 声明的片数才算这一单完成，然后回 ACK。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;注意：完成判定靠&lt;b&gt;计数器 + 轮询&lt;/b&gt;，不是每个传输一个回调对象&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="766" y="508" width="694" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="e16" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1" source="n14" target="n15">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="t17" value="&lt;b&gt;失败之后会怎样（四类兜底，按严重程度排）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="686" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;KV 导入失败（LWD PD）&lt;/b&gt;　→　&lt;font style=&quot;font-size:10px&quot;&gt;fail-closed：直接终止请求（日志 PD remote KV import failed），&lt;b&gt;不重算、不换 P/D&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="720" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;b&gt;传输返回码 &lt; 0&lt;/b&gt;　→　&lt;font style=&quot;font-size:10px&quot;&gt;抛 RuntimeError → 该请求标记失败 → 原生路径下这些块重算&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="790" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;b&gt;等不到 ACK&lt;/b&gt;　→　&lt;font style=&quot;font-size:10px&quot;&gt;打 error 日志后&lt;b&gt;吞掉异常&lt;/b&gt;（不重试、不上抛）——所以别指望它自愈&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="860" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;对端根本不来拿&lt;/b&gt;　→　&lt;font style=&quot;font-size:10px&quot;&gt;480 秒后强制释放并打 error：Force freed expired request&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="930" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;后台线程起不来&lt;/b&gt;　→　&lt;font style=&quot;font-size:10px&quot;&gt;启动时 5 分钟没 ready → RuntimeError 直接失败&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="1000" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;b&gt;这一页的代码锚点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;钉住 / 延迟释放：kv_p2p/mooncake_connector.py:2058-2061（返回 delay_free_blocks）· :232-253（480 秒强制释放）&lt;br&gt;完成计数与轮询：:177（KVCacheTaskTracker）· :213-224 · :609（get_and_clear_finished_requests）&lt;br&gt;回执与 ACK：:373-397（P 侧核销）· :1502-1527（D 侧发 DONE_RECVING 并等 ACK）&lt;br&gt;失败 → 重算：:738-741、:628-631、:2789-2792（invalid_block_ids）&lt;br&gt;超时来源：vllm/vllm/envs.py:260（VLLM_MOONCAKE_ABORT_REQUEST_TIMEOUT，默认 480 s）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1094" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;「成功」= 数据落到对端显存 + 对端回了回执 + 计数器归零 + 块真正释放。四件事差一件，都会变成显存泄漏或算错。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1232" width="1424" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="t25" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1326" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1323" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1323" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1323" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1323" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1323" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1323" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1323" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e33" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1372" as="sourcePoint"/>
            <mxPoint x="204" y="1372" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t34" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1360" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e35" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1372" as="sourcePoint"/>
            <mxPoint x="454" y="1372" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t36" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1360" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e37" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1372" as="sourcePoint"/>
            <mxPoint x="704" y="1372" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t38" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1360" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg8" name="⑨ 误解与性能账">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1134" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑨ 五个常见误解 ＋ 一本性能账" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="这一页是前八页的「体检」：每条误解都给出正确的说法和代码位置。看完能自己回答「为什么这么设计」。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;误解清单（★ = 最容易被读错的一个）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;★ 误解 1：P 算完会主动把 KV 推给 D&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;实际：&lt;b&gt;D 主动去 P 读（pull）&lt;/b&gt;。P 的「Sending」线程只回地址表、收完成信号，一字节 KV 都不推。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;mooncake_connector.py:333-417（只回元数据）vs :1042（D 端读）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="148" width="1424" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;误解 2：Mooncake 是逐层搬运的&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;实际：本项目&lt;b&gt;整请求块级批量&lt;/b&gt;——一个请求的所有层、所有块，一次 batch_transfer_sync_read 搬完。三个 layerwise 钩子实现就是 pass。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;:1691-1703（三个 pass）；逐层版在 mooncake_layerwise_connector.py&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="250" width="1424" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;误解 3：KV 会先写进 Mooncake 的存储池&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;实际：&lt;b&gt;点对点直接搬&lt;/b&gt;，KV 不进任何公共池。Store 模式是另一套连接器（AscendStoreConnector），本 PD 场景不用。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;kv_transfer/__init__.py:46,57,74,80,87（五个连接器并列）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="352" width="1424" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;误解 4：up_buffer_size / down_buffer_size 是 KV 容量&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;实际：这是&lt;b&gt;另一个平面&lt;/b&gt;的东西——host 数据面（UCX/共享内存）的帧块大小，跟 KV 传输无关。KV 走的是 kv_port。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;启动脚本 --kv-transfer-config 的 kv_port；数据面见 lwd_comm/data_comm/&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="454" width="1424" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;误解 5：显存地址随便给，反正引擎会自己找&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;实际：① 必须&lt;b&gt;先注册再搬&lt;/b&gt;，且每进程最多 256 段；② 某些路径（逐层版）要求&lt;b&gt;起始地址 2 MiB 对齐&lt;/b&gt;，不对齐直接抛错。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;kv_transfer/utils/utils.py:15,455-472（段数上限）；:2556,2610（对齐断言）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="556" width="1424" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;b&gt;一本性能账：决定「搬一次值不值」的几个量&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="644" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;一次搬的量&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;该请求&lt;b&gt;所有层 × 所有块&lt;/b&gt;的 KV&lt;br&gt;（例：4K token、128 KB/token ≈ 512 MB）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="678" width="278" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;搬运的并行度&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;D 侧 32 线程池，按「对端 host:port」分桶；&lt;br&gt;每个对端每轮最多 5 个请求就换人&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="322" y="678" width="278" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;什么时候搬更划算&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;prompt 长、输出短时最赚（K 值钱、搬一次用一次）；&lt;br&gt;prompt 极短、输出极长时搬运占比反而高&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="608" y="678" width="278" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;超时窗口&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;对端 480 秒不来拿就强制释放；&lt;br&gt;传输超时由 ASCEND_TRANSFER_TIMEOUT 决定&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="894" y="678" width="278" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;并发窗口&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;两侧用「有多少片要回执」来对账；&lt;br&gt;P 的 TP 比 D 大时要分片拉、搬完再拼装&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1180" y="678" width="278" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;数量级提示：cross-machine 带宽远低于显存带宽，所以「搬一次」的代价通常比「重算一遍 prefill」小得多——这正是 P/D 分离成立的经济学前提。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="856" width="1424" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;这套实现的核心事实只有三条——①&lt;b&gt;D 拉、P 不推&lt;/b&gt;；②&lt;b&gt;整请求块级批量，不逐层&lt;/b&gt;；③&lt;b&gt;点对点，不进池&lt;/b&gt;。其余细节（分片、拼装、对齐、超时）都是为这三条服务的。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="914" width="1424" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1036" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1033" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1033" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1033" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1033" width="120" height="26" as="geometry"/>
