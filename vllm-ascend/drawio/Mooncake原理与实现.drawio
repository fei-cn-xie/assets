<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" pages="10">
  <diagram id="pg0" name="① 为什么需要搬 KV">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="988" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="① 为什么要把 KV Cache 搬到另一台机器上（从 attention 说起）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="看懂本页只需要两件事：attention 里的 K / V 是什么；矩阵乘法的量级大概怎么估。其余概念本页现场解释，不预设你懂推理框架。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一件事：attention 里的 K / V 是什么&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;Q / K / V 都是矩阵乘法的产物&lt;/b&gt;&lt;br&gt;每个 token 的隐向量 x，乘三个权重矩阵 W_Q / W_K / W_V，得到它的 query / key / value。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;Attention(Q, K, V) = softmax(QKᵀ / √d) · V&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="470" height="124" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;关键观察：K / V 只由「已经见过的 token」决定&lt;/b&gt;&lt;br&gt;第 t 步算 attention 时，前 t 个 token 的 K / V &lt;b&gt;已经算过、之后不再变&lt;/b&gt;（它们的输入没变）。&lt;br&gt;只有 Q 是新的：最新那个 token 要发问。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="548" y="152" width="470" height="124" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;所以：把 K / V 存下来，别每次重算&lt;/b&gt;&lt;br&gt;这张「历史 token 的 K / V 记账表」就是 &lt;b&gt;KV Cache&lt;/b&gt;。&lt;br&gt;代价是占显存；换来的是省掉重复的矩阵乘法。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1060" y="152" width="470" height="124" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="因为不变" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="所以能存" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n5" target="n6">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="t9" value="&lt;b&gt;第二件事：这张表在显存里有多大（会算这个就够了）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="302" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;形状：一张 4 维的表&lt;/b&gt;&lt;br&gt;层数 × token 位置 × {K, V} × (KV 头数 × 每头维度)&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;层 0 → token 0..t 的 K 、token 0..t 的 V&lt;br&gt;层 1 → …&lt;br&gt;层 31 → …&lt;/font&gt;&lt;br&gt;&lt;br&gt;每个格子里是一个 fp16 数，占 2 字节。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="338" width="470" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;算一笔账（假设 32 层、8 个 KV 头、每头 128 维）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="552" y="338" width="462" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;项目&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="552" y="372" width="176" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;数量&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="728" y="372" width="290" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;单个 token 的 KV&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="552" y="412" width="176" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;32×2×8×128×2 B ≈ &lt;b&gt;128 KB&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="728" y="412" width="290" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;一条 4K token 的请求&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="552" y="452" width="176" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;4096 × 128 KB ≈ &lt;b&gt;512 MB&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="728" y="452" width="290" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;128 条并发请求&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="552" y="492" width="176" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;128 × 512 MB ≈ &lt;b&gt;64 GB&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="728" y="492" width="290" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;一张 64 GB 的卡&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="552" y="532" width="176" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;权重占 ~40 GB，只剩 20 多 GB&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="728" y="532" width="290" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;结论：显存是硬约束&lt;/b&gt;&lt;br&gt;同一张卡上，&lt;b&gt;模型权重&lt;/b&gt;和 &lt;b&gt;KV cache&lt;/b&gt; 抢同一块显存。并发一多、上下文一长，KV 就把它吃光。&lt;br&gt;&lt;br&gt;→ 于是把 &lt;b&gt;prefill（算 KV）&lt;/b&gt; 和 &lt;b&gt;decode（用 KV）&lt;/b&gt; 拆到两拨机器上。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1060" y="338" width="470" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;b&gt;第三件事：机器拆开后，KV 就躺在「别人的显存」里&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="552" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;P 机（prefill）&lt;/b&gt;&lt;br&gt;拿到整段 prompt，一次算完，所以&lt;b&gt;它显存里有一段对话的完整 KV&lt;/b&gt;。&lt;br&gt;算完它其实就没事了：后面每生成一个字都不需要它再算什么。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="588" width="470" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;于是必须「搬 KV」&lt;/b&gt;&lt;br&gt;把 P 机显存里那几十/几百 MB，经网卡搬到 D 机显存里。&lt;br&gt;&lt;br&gt;&lt;b&gt;这件事就是本仓用 Mooncake 干的活。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="548" y="588" width="470" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;D 机（decode）&lt;/b&gt;&lt;br&gt;一个字一个字往外蹦，每个字都要用&lt;b&gt;完整历史 KV&lt;/b&gt;。&lt;br&gt;但它手里没有那段 prompt 的 KV——除非有人搬给它。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1060" y="588" width="470" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="e27" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1" source="n24" target="n25">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e28" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1" source="n25" target="n26">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="n29" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;K / V 算一次就不变 → 值得存（KV cache）→ 它很占显存 → 所以把 prefill / decode 拆到两拨机器 → 于是 KV 必须&lt;b&gt;跨机搬&lt;/b&gt; → 搬它的工具就是 Mooncake。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="794" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="t30" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="890" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="887" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="887" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="887" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="887" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="887" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="887" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="887" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="数据面 = 搬 KV 的通道" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1044" y="887" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e39" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="936" as="sourcePoint"/>
            <mxPoint x="204" y="936" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t40" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="924" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e41" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="936" as="sourcePoint"/>
            <mxPoint x="454" y="936" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t42" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="924" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e43" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="936" as="sourcePoint"/>
            <mxPoint x="704" y="936" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t44" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="924" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg1" name="② Mooncake 是什么">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="② 一句话认识 Mooncake：把 KV 当成「可搬的货物」" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="Mooncake 是月之暗面（Moonshot）开源的一套「以 KV 为中心」的推理基础设施。本页只讲清它由哪两块组成、我们把哪一块用在什么地方。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：认清这条链路上的三个角色&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="800" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;P = Producer（生产者）&lt;/b&gt;&lt;br&gt;prefill 机器。它算出了 KV，手上有一批「货」要交给别人。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;代码里：prefill 实例 / 角色 role=cloud-P / 日志里的 P 侧&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="470" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;D = Consumer（消费者）&lt;/b&gt;&lt;br&gt;decode 机器。它需要这批货才能继续生成下一个字。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;代码里：decode 实例 / 角色 role=cloud-D / 日志里的 D 侧&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="546" y="150" width="470" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;搬运通道 = Transfer Engine&lt;/b&gt;&lt;br&gt;连接两台机器的「卡车」：只负责&lt;b&gt;把一段内存从 A 搬到 B&lt;/b&gt;，不关心里面装的是什么。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;这才是本仓真正用到的那一块&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1056" y="150" width="470" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="KV 从 P 交到 D" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;第二步：用「寄快递」把这个过程整体类比一遍&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="306" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;寄快递时……&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="340" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;Mooncake 里对应发生什么&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="336" y="340" width="620" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;代码里的名字&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="956" y="340" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;寄件人打包 → 告诉快递公司包裹放哪&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="376" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;把显存里那块 KV 的&lt;b&gt;地址和长度&lt;/b&gt;注册给传输引擎&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="376" width="620" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;register_memory&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="956" y="376" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;快递公司知道收件人地址&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="412" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;两台机器&lt;b&gt;交换&lt;/b&gt;各自的内存段信息（谁在哪、多大）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="412" width="620" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;握手 / 建链&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="956" y="412" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;下单发货&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="448" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;发起一次&lt;b&gt;传输请求&lt;/b&gt;：从我这的 X 地址，搬 N 字节到你的 Y 地址&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="448" width="620" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;transfer / write / read&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="956" y="448" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;收件人签收&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="484" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;传完之后对方收到&lt;b&gt;回执&lt;/b&gt;，才敢认为「KV 到了」&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="484" width="620" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;完成通知 / 轮询&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="956" y="484" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;包裹没到怎么办&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="520" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;超时 → 放弃等待、报错（本项目&lt;b&gt;重算或直接失败&lt;/b&gt;，不静默降级）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="520" width="620" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;timeout / fail&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="956" y="520" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="t27" value="&lt;b&gt;第三步：Mooncake 其实有两个部件，别混为一谈&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="556" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;b&gt;① Transfer Engine（传输引擎）&lt;/b&gt;&lt;br&gt;纯搬运：注册内存 → 建连接 → 读/写一段字节。&lt;br&gt;它&lt;b&gt;不认识 KV&lt;/b&gt;，你让它搬什么它就搬什么。&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;类比：货运公司。你说是沙发还是服务器，它不管。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="590" width="470" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;b&gt;② Store / KV 池（以存换算）&lt;/b&gt;&lt;br&gt;把很多机器的显存+内存+SSD 组成一个大仓库，KV 可以&lt;b&gt;存进去、以后按 key 取出来&lt;/b&gt;（跨请求复用）。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;类比：公共仓库。东西存在那，谁需要谁去取。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="546" y="590" width="470" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;b&gt;本仓用的是哪个？&lt;/b&gt;&lt;br&gt;只用 &lt;b&gt;① Transfer Engine&lt;/b&gt;：P 与 D 直接点对点搬，KV 不进公共仓库。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#c0392b&quot;&gt;常见的误解：以为「KV 会先写进 Mooncake 池、再读出来」——本项目不是。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1056" y="590" width="470" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;Mooncake = 「一个只会搬字节的传输引擎（本仓在用）」＋「一个可选的 KV 大仓库（本仓不用）」。P/D 分离里我们只用前者，把 KV 从 P 机显存直接搬到 D 机显存。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="820" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t32" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="912" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="909" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="909" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="909" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="909" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="909" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="909" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="909" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="数据面 = 搬运通道" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1044" y="909" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e41" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="958" as="sourcePoint"/>
            <mxPoint x="204" y="958" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t42" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="946" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e43" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="958" as="sourcePoint"/>
            <mxPoint x="454" y="958" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t44" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="946" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e45" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="958" as="sourcePoint"/>
            <mxPoint x="704" y="958" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t46" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="946" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg2" name="③ 块与块表">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1124" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="③ KV Cache 在显存里长什么样：为什么按「块」管理" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：显存被切成固定大小的小格子（块），每个块放固定数量 token 的 K/V；一张块表记录「逻辑第几块 → 物理第几块」。跨机搬 KV 就是以块为单位的。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：先把显存想成一排小格子&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="114" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;块（block）= 固定大小的格子&lt;/b&gt;&lt;br&gt;一个块装 &lt;b&gt;block_size&lt;/b&gt; 个 token 的 K/V（本项目常见 16 或 128，见启动参数）。&lt;br&gt;不管请求多长，都按整块分配。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="470" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;为什么按块、不按「一整个请求」分&lt;/b&gt;&lt;br&gt;① 每个请求长度不同，整段分会产生大量碎片；&lt;br&gt;② 不同请求的&lt;b&gt;相同前缀&lt;/b&gt;可以指到同一块（省显存）；&lt;br&gt;③ 按块好搬：每块地址固定、长度固定，一次搬一块很干脆。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="548" y="150" width="470" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;块表（block table）= 逻辑 → 物理 的映射&lt;/b&gt;&lt;br&gt;请求自己的第 0、1、2… 块，分别对应显存里哪个物理块。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/worker/block_table.py:57（BlockTable）· :119（slot_mapping）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1060" y="150" width="470" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="所以按块分" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="再用块表记账" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n5" target="n6">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="t9" value="&lt;b&gt;第二步：一个 40 token 的请求，实际占了 3 个 16-token 的块&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="310" width="1000" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t10" value="请求自己的逻辑块（块表的上半部分）↓" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="346" width="460" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;逻辑块 0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;token 0..15&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="372" width="150" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;逻辑块 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;token 16..31&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="194" y="372" width="150" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;逻辑块 2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;token 32..47&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="352" y="372" width="150" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;最后一块只用了 8/16 格：40 = 16 + 16 + 8&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="434" width="470" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="块表把它翻译成显存里的物理块 ↓" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="474" width="460" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;物理块 #7&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;显存里真实位置&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="500" width="150" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;b&gt;物理块 #12&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;显存里真实位置&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="194" y="500" width="150" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;物理块 #31&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;显存里真实位置&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="352" y="500" width="150" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="e19" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n11" target="n16">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e20" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n12" target="n17">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e21" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n13" target="n18">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="t22" value="&lt;b&gt;第三步：这条「块」的规则，直接决定了跨机搬 KV 的样子&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="608" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;b&gt;搬的单位是「块」，不是「整段对话」&lt;/b&gt;&lt;br&gt;P 机算完 prefill 后，它手上是若干个&lt;b&gt;已经填满的物理块&lt;/b&gt;；D 机要的是「我这 3 个逻辑块的内容」。&lt;br&gt;于是 D 机说：请把 #7/#12/#31 这三块的内容给我 —— 这就是&lt;b&gt;块级 pull&lt;/b&gt;。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="638" width="700" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;也因为按块，P 和 D 必须能对上「哪块是哪块」&lt;/b&gt;&lt;br&gt;P 把自己那三块的&lt;b&gt;地址与长度&lt;/b&gt;打包成一个「KV 交接单」交给 D；D 拿着单子逐块去取。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;这张单子在代码里叫 kv_transfer_params（下一页会看到它长什么样）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="776" y="638" width="684" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="e25" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n23" target="n24">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;这一页的代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;块的容量与规格：vllm/v1/core/kv_cache_utils.py:668-690（resolve_dcp_kv_block_size / block_size 解析）&lt;br&gt;空闲块的分配与回收：vllm/v1/core/block_pool.py:143（BlockPool）、:683（get_new_blocks）、:789（free_blocks）&lt;br&gt;按请求分配块：vllm/v1/core/kv_cache_manager.py:402（allocate_slots）&lt;br&gt;逻辑块 → 物理块 + 写 KV 的槽位：vllm/v1/worker/block_table.py:57、:119（slot_mapping）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="804" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;显存按「块」切分，块表记录「逻辑块 → 物理块」；所以跨机搬 KV 是&lt;b&gt;按块搬&lt;/b&gt;（块级 pull），P 只要把「哪几块、在哪」告诉 D 就够了。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="934" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1026" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1023" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1023" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1023" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1023" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1023" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1023" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1023" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e36" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1072" as="sourcePoint"/>
            <mxPoint x="204" y="1072" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t37" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1060" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e38" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1072" as="sourcePoint"/>
            <mxPoint x="454" y="1072" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t39" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1060" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e40" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1072" as="sourcePoint"/>
            <mxPoint x="704" y="1072" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t41" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1060" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg3" name="④ 传输引擎三步曲">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1086" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="④ 传输引擎怎么搬字节：注册 → 认路 → 下单（三步曲）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：传输引擎只认三件事——这块内存我登记过、对方是谁、从哪搬到哪搬多少。它不知道 KV 是什么，也不关心里面装的是什么。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;三步曲：任何一次搬运都长这样&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;① 注册内存&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="470" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;font style=&quot;font-size:10px&quot;&gt;把你的显存&lt;b&gt;登记&lt;/b&gt;给引擎：&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;register_memory(ptr, size)&lt;/font&gt;&lt;br&gt;&lt;br&gt;登记之前，引擎不许碰这块内存（驱动要求）。&lt;br&gt;&lt;br&gt;&lt;font style=&quot;color:#c0392b&quot;&gt;注意：返回值是「成功/失败」，&lt;b&gt;不是地址&lt;/b&gt;。地址要自己算：&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;地址 = 层基址 + 块号 × 块步长&lt;/font&gt;&lt;br&gt;&lt;br&gt;一笔显存会被切很多段登记，本项目上限 256 段（相邻 4096 B 以内的会先合并）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="186" width="450" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;② 认路（认对方是谁）&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="548" y="150" width="470" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="t7" value="&lt;font style=&quot;font-size:10px&quot;&gt;传输要一个 &lt;b&gt;session&lt;/b&gt; 标识，本项目里就是：&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;session = &quot;对端IP : 对端引擎的 rpc 端口&quot;&lt;/font&gt;&lt;br&gt;&lt;br&gt;启动时只做「握手」（换地址表），&lt;b&gt;真正的链路在第一次传输时才建立&lt;/b&gt;。&lt;br&gt;&lt;br&gt;&lt;font style=&quot;color:#c0392b&quot;&gt;初学常见困惑：这里没有独立的 metadata server。&lt;/font&gt;&lt;br&gt;初始化时传的字面量 &lt;font style=&quot;font-size:9px&quot;&gt;metadata_server=&quot;P2PHANDSHAKE&quot;&lt;/font&gt; 表示「点对点自己握手」。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="558" y="186" width="450" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;③ 下单搬运&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1060" y="150" width="470" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;font style=&quot;font-size:10px&quot;&gt;一次调用给三张&lt;b&gt;平行列表&lt;/b&gt;：&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;batch_transfer_sync_read(session,&lt;br&gt;&amp;nbsp;&amp;nbsp;src=[…], dst=[…], length=[…])&lt;/font&gt;&lt;br&gt;&lt;br&gt;读 = 把对方的字节&lt;b&gt;拉到我这儿&lt;/b&gt;；&lt;br&gt;写 = 把我这儿的字节&lt;b&gt;推到对方&lt;/b&gt;。&lt;br&gt;&lt;br&gt;名字里的 sync 指「函数返回时这批已经搬完」，&lt;b&gt;但它跑在后台线程里&lt;/b&gt;，不会卡住推理主循环。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1070" y="186" width="450" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="登记过才能搬" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n4" target="n6">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" value="知道对方在哪" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n6" target="n8">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="t12" value="&lt;b&gt;同一个引擎，三种玩法——本仓三套代码都在，别混着读&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="384" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;玩法&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="418" width="240" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;数据怎么流&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="276" y="418" width="600" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;关键 API / 特征&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="876" y="418" width="560" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;① 块级 pull（本项目默认）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="470" width="240" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;D 主动去 P &lt;b&gt;读&lt;/b&gt;整个请求的所有层&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="276" y="470" width="600" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;一次 batch_transfer_sync_read；P 侧线程只回元数据&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="876" y="470" width="560" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;② 逐层 push（layerwise 版）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="522" width="240" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;P 每算完一层就&lt;b&gt;写&lt;/b&gt;给对方&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="276" y="522" width="600" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;batch_transfer_sync_write；TP 不对等时先用 128 B 预热建链&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="876" y="522" width="560" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;③ Store 池（另一种连接器）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="574" width="240" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;KV 先变成「对象」存进大仓库，谁要谁去取&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="276" y="574" width="600" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;需要 metadata/master 服务 + 内存池；本 PD 场景不用&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="876" y="574" width="560" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;三个最容易卡住的地方（都在代码里能看到）&lt;/b&gt;&lt;br&gt;① &lt;b&gt;协议不是 rdma / tcp&lt;/b&gt;：昇腾版传的是 &lt;font style=&quot;font-size:9px&quot;&gt;initialize(ip, &quot;P2PHANDSHAKE&quot;, &quot;ascend&quot;, device)&lt;/font&gt;——第三个参数是 &lt;b&gt;ascend&lt;/b&gt;。&lt;br&gt;② &lt;b&gt;地址不是「引擎给你的」&lt;/b&gt;：登记只标记「这段可以搬」，搬运时用的是你自己算出来的 &lt;font style=&quot;font-size:9px&quot;&gt;base + block_id × stride&lt;/font&gt;。&lt;br&gt;③ &lt;b&gt;完成不是回调&lt;/b&gt;：没有 per-transfer 的回调对象，靠&lt;b&gt;计数器 + 轮询&lt;/b&gt;（搬完的请求进队列，主循环定期取）。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="628" width="1424" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;这一页的代码锚点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;单例初始化：vllm-ascend/.../kv_transfer/utils/mooncake_transfer_engine.py:11-43（initialize / register_memory / global_te）&lt;br&gt;注册 KV 显存：.../kv_p2p/mooncake_connector.py:2687-2690（先 395-452 合并区间，再逐段 register_memory）&lt;br&gt;真正搬运：同文件 :1042（batch_transfer_sync_read）· :825（session_id 拼法）&lt;br&gt;逐层版对照：.../kv_p2p/mooncake_layerwise_connector.py:557、:2115-2120&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="780" width="1424" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;传输引擎眼里没有 KV，只有「登记过的内存段 + 对端 session + 从哪到哪多长」；三步走完，一次搬运就结束了。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="894" width="1424" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="988" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="985" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="985" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="985" width="120" height="26" as="geometry"/>
