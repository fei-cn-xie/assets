          </mxGeometry>
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;prompt 前向算完，KV 已经写进本机显存块&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;本文件的 hook 不参与前向，只在前向之后接管&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
