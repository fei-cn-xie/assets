  <diagram id="pg4" name="⑤ connector 钩子表">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1264" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑤ vLLM 给 connector 留的「插头」：钩子表与调用时机" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：vLLM 不认识 Mooncake，它只在一个固定的时刻表里调用几个固定名字的方法。谁想搬 KV，就去实现这些方法。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;调度侧（在 scheduler 进程里）：决定「要不要搬、搬哪些块」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="700" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;on_new_request（仅 P 侧）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;截：prompt 可能先丢掉最后一个 token&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;让 D 自己重算最后一个 token，保证 tail 一定对得上&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="700" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;get_num_new_matched_tokens&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;问：这批 KV 能省掉多少重复计算？&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;返回 (数量, 是否异步)。返回 &gt;0 表示「有 KV 可以等」&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="246" width="700" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;update_state_after_alloc&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;记：我这些本地块要去远端拉&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;把「本地块号 / 需要多少外部 token」登记下来&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="342" width="700" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;build_connector_meta&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;打包：把登记变成给 worker 的工单&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;这一步之后才轮到 worker 侧真正搬&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="438" width="700" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;request_finished（两侧都调）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;交：这一单怎么收尾&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;P 返回 (True, 交接清单)＝块先别还；D 返回 (False, None)＝立刻还&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="534" width="700" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;b&gt;worker 侧（在跑模型的进程里）：真正动显存&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="816" y="116" width="640" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;register_kv_caches&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;注册：把我的 KV 显存登记给传输引擎&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;顺便起后台线程（回元数据 / 收完成信号）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="816" y="150" width="644" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;bind_connector_metadata&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;喂料：把调度侧的工单交给 worker 侧&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;每次执行模型前调一次，用完即清&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="816" y="246" width="644" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;start_load_kv&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;下发：把工单交给后台搬运线程&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;D 侧入口：切分片、挑端口、按对端分桶&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="816" y="342" width="644" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;get_finished / get_transfer_results&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;汇报：这一轮谁发完 / 谁收完&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;核心拿到后才会真正释放块（解除「钉住」）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="816" y="438" width="644" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;get_block_ids_with_load_errors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;报错：哪些块没搬成功&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;原生路径会对这些块&lt;b&gt;重算&lt;/b&gt;；LWD PD 路径直接失败&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="816" y="534" width="644" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;还有三个钩子，本项目里是「躺平」的（实现就是 pass）&lt;/b&gt;&lt;br&gt;wait_for_layer_load　/　save_kv_layer　/　wait_for_save&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;它们的存在是为了「逐层搬运」这种玩法：每算完一层就搬一层，早搬早省显存。本项目没用这个玩法——整请求算完再一次性块级 pull。逐层版在另一个文件（mooncake_layerwise_connector.py），别看混。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="660" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;b&gt;把钩子按时间顺序串起来（一次请求的一生）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="766" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="请求进来" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="800" width="160" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="get_num_new_matched_tokens" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="210" y="800" width="160" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="e19" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="198" y="833" as="sourcePoint"/>
