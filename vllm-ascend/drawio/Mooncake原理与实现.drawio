        <mxCell id="n33" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="985" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="985" width="120" height="26" as="geometry"/>
