        </mxCell>
        <mxCell id="e25" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="720" y="833" as="sourcePoint"/>
            <mxPoint x="730" y="833" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n26" value="前向计算 / 生成 token" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
