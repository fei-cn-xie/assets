  <diagram id="pg9" name="⑩ 术语表与阅读路径">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1426" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑩ 术语表与三条阅读路径" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="这一页是工具页：卡在某个词就查表；想动手就按三条路径之一走。锚点按本仓当前检出分支（fix/lwd-multidp-dense-pd）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;术语表（左列是你会听到的词，右列是它的意思）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="114" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;术语&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="146" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;大白话解释&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="286" y="146" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;font style=&quot;font-size:11px&quot;&gt;KV cache&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="180" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;font style=&quot;font-size:11px&quot;&gt;历史 token 的 K/V 缓存，省掉重复的矩阵乘法&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="180" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;font style=&quot;font-size:11px&quot;&gt;prefill / decode&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="214" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;font style=&quot;font-size:11px&quot;&gt;一次算完整段 prompt / 一个字一个字生成&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="214" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;font style=&quot;font-size:11px&quot;&gt;P / D&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="248" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:11px&quot;&gt;prefill 机器（生产 KV）/ decode 机器（消费 KV）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="248" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;块（block）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="282" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;显存里固定大小的格子，放固定数量 token 的 KV&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="282" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;块表（block table）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="316" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;「逻辑第几块 → 物理第几块」的映射&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="316" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;块级 pull&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="350" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;D 按块向 P 拉取 KV，一次拉一整个请求的所有层&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="350" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;钉住（delay_free_blocks）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="384" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;P 请求结束后先不回收块，等 D 来拿（不是 pin API）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="384" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;回执（DONE_RECVING / ACK）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="418" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;D 说「我收完了」、P 说「收到，可以放块了」&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="418" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;KV_READY（LWD 层）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="452" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;D 侧判定「KV 已到位」：收完块 + 计算起点对齐到 R&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="452" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;Transfer Engine&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="486" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;Mooncake 的搬运引擎，只认「已注册内存 + session + 地址长度」&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="486" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;session&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="520" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;对端标识，本项目里是「对端 IP : 对端引擎 rpc 端口」&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="520" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;register_memory&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="554" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;把一段内存登记给引擎（返回成功/失败，不返回地址）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="554" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;RDMA read&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="588" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;网卡直接读对方显存，CPU 不参与搬数据&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="588" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;P2PHANDSHAKE&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="622" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:11px&quot;&gt;初始化时的 metadata_server 字面量：点对点自己握手，无需元数据服务&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="622" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:11px&quot;&gt;fail-closed&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="656" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;font style=&quot;font-size:11px&quot;&gt;出问题就终止，不猜测、不降级（LWD PD 的口径）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="656" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;font style=&quot;font-size:11px&quot;&gt;MTP / tail&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="690" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;font style=&quot;font-size:11px&quot;&gt;多 token 预测；tail 指 D 需要自己补算的那几个 token&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="690" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="t38" value="&lt;b&gt;三条阅读路径：按你的目的选一条，别从第一行读到最后一行&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="718" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;b&gt;路径 A：只想搞懂原理（不看代码）&lt;/b&gt;&lt;br&gt;&lt;br&gt;读 ① → ② → ③ → ⑦&lt;br&gt;&lt;br&gt;读完能讲清：&lt;br&gt;· 为什么要有 KV cache&lt;br&gt;· 为什么要跨机搬&lt;br&gt;· 一次交接的四个阶段&lt;br&gt;· 谁在等谁" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="750" width="466" height="208" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;b&gt;路径 B：想改/调 connector&lt;/b&gt;&lt;br&gt;&lt;br&gt;读 ⑤ → ⑥ → ⑦ → ⑧&lt;br&gt;&lt;br&gt;重点看：&lt;br&gt;· 钩子契约（base.py）&lt;br&gt;· 调度侧 / worker 侧分工&lt;br&gt;· 完成与失败判定&lt;br&gt;· 改完先跑通「单请求」再谈性能" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="536" y="750" width="460" height="208" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;b&gt;路径 C：只想查/调性能&lt;/b&gt;&lt;br&gt;&lt;br&gt;读 ④ → ⑨ → ⑦&lt;br&gt;&lt;br&gt;关注：&lt;br&gt;· 一次搬多少 MB&lt;br&gt;· 对端分桶与线程池&lt;br&gt;· 超时窗口（480 s / 传输超时）&lt;br&gt;· 2 MiB 对齐与 256 段上限" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1030" y="750" width="430" height="208" as="geometry"/>
        </mxCell>
        <mxCell id="t42" value="&lt;b&gt;自己动手：几条能直接抄的 grep（在 vllm-ascend 仓根目录跑）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="986" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;&lt;b&gt;# 谁在搬运（三套玩法都在这一层）&lt;/b&gt;&lt;br&gt;grep -rn &quot;batch_transfer_sync_read&quot; vllm_ascend/distributed/kv_transfer/&lt;br&gt;grep -rn &quot;batch_transfer_sync_write&quot; vllm_ascend/distributed/kv_transfer/&lt;br&gt;&lt;br&gt;&lt;b&gt;# 注册显存与引擎初始化&lt;/b&gt;&lt;br&gt;grep -rn &quot;register_memory\|global_te&quot; vllm_ascend/distributed/kv_transfer/&lt;br&gt;&lt;br&gt;&lt;b&gt;# 端口是怎么算出来的（同一行里有 dp/tp/pp/pcp 四个因子）&lt;/b&gt;&lt;br&gt;grep -n &quot;handshake_port\|side_channel_port&quot; vllm_ascend/distributed/kv_transfer/kv_p2p/mooncake_connector.py&lt;br&gt;&lt;br&gt;&lt;b&gt;# LWD 层的 KV_READY 判定&lt;/b&gt;&lt;br&gt;grep -n &quot;finished_recving_kv_req_ids\|tail_start&quot; vllm/v1/lwd_control/pd/cloud_scheduler.py&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1018" width="1424" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="&lt;b&gt;最后一句：&lt;/b&gt;Mooncake 在本项目里干的是一件非常朴素的事——把 P 机显存里的几块字节，按 D 的请求搬到 D 的显存里，然后双方各自对账。所有复杂的东西（分片、拼装、对齐、超时、回执）都是为了让这件朴素的事&lt;b&gt;不出错、不漏显存、不阻塞调度&lt;/b&gt;。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1218" width="1424" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="t45" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1328" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1325" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1325" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1325" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1325" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1325" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1325" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1325" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e53" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1374" as="sourcePoint"/>
            <mxPoint x="204" y="1374" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t54" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1362" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e55" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1374" as="sourcePoint"/>
            <mxPoint x="454" y="1374" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t56" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1362" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e57" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
