        <mxCell id="n30" value="request_finished（P 侧交接）" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1254" y="800" width="160" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="e31" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1242" y="833" as="sourcePoint"/>
            <mxPoint x="1252" y="833" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;为什么要有这么一套钩子（设计意图）&lt;/b&gt;&lt;br&gt;① &lt;b&gt;解耦&lt;/b&gt;：vLLM 核心不需要知道 KV 是从网络来的、还是从磁盘来的；换 connector 就像换插头。&lt;br&gt;② &lt;b&gt;不阻塞调度&lt;/b&gt;：「异步」这个返回值的意思是——我的 KV 还在路上，调度器可以先去算别的请求，等到了再用。&lt;br&gt;③ &lt;b&gt;可回退&lt;/b&gt;：搬失败必须能报出来（get_block_ids_with_load_errors），让核心退化成「重新计算」，而不是用错的 KV 算出乱码。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="906" width="1424" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;这一页的代码锚点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;契约本体：vllm/vllm/distributed/kv_transfer/kv_connector/v1/base.py（KVConnectorBase_V1 的每个钩子都有 docstring）&lt;br&gt;本仓实现：vllm-ascend/vllm_ascend/distributed/kv_transfer/kv_p2p/mooncake_connector.py（调度侧 :1916 / :1958 / :1987 / :2016；worker 侧 :2627 / :3835 / :2767-2787）&lt;br&gt;注册表（名字 → 模块:类）：vllm-ascend/.../kv_transfer/__init__.py:46,57,74,80,87&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1058" width="1424" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="t34" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
