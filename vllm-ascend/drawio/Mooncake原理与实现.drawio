        </mxCell>
        <mxCell id="e34" value="request_finished(request, block_ids)" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="256" y="268" as="sourcePoint"/>
            <mxPoint x="714" y="268" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n35" value="&lt;b&gt;算出「真正含 prompt KV 的块」，返回延迟释放标记&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;delay_free_blocks = 块数&gt;0 → 打日志 Delaying free of %d blocks；这就是「钉住」，没有 pin API&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;mooncake_connector.py:2016,2051-2061&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="502" y="297" width="424" height="63" as="geometry"/>
        </mxCell>
        <mxCell id="e36" value="kv_transfer_params（块号 / IP 端口 / PCP·DCP 规模）" style="endArrow=block;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="714" y="387" as="sourcePoint"/>
            <mxPoint x="256" y="387" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n37" value="这张「交接单」由 vLLM 核心随请求带去 D，connector 自己不做跨进程投递（mooncake_connector.py:2063-2078）" style="shape=note;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;size=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="44" y="416" width="1798" height="27" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;font color=&quot;#999999&quot;&gt;② D 侧：拿到交接单 → 登记 → 派活&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;fillColor=#e7e0d4;strokeColor=#b3a89c;" vertex="1" parent="1">
          <mxGeometry x="36" y="459" width="1814" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="e39" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="36" y="453" as="sourcePoint"/>
            <mxPoint x="1850" y="453" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n40" value="&lt;b&gt;先问自己：这批 KV 能省掉多少重复计算？&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;返回 (count, True)：True 表示「异步拉，别阻塞调度」&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;mooncake_connector.py:1916-1956&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1418" y="481" width="424" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;b&gt;update_state_after_alloc：登记要拉的本地块号&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;同时把 do_remote_prefill 置 False，保证只触发一次&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;mooncake_connector.py:1958-1985&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1418" y="542" width="424" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="&lt;b&gt;build_connector_meta：打包成给 worker 的工单&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;mooncake_connector.py:1987-2014&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1418" y="603" width="424" height="39" as="geometry"/>
        </mxCell>
        <mxCell id="e43" value="start_load_kv(metadata)" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1630" y="669" as="sourcePoint"/>
            <mxPoint x="1172" y="669" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n44" value="&lt;b&gt;排班：切分片 → 挑要问的 P 端口 → 按 peer 分桶&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;32 线程池；每个 peer 每轮最多 5 个请求就换人（防独占）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;mooncake_connector.py:3835-3936, 3034, 3522&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="960" y="698" width="424" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="&lt;font color=&quot;#999999&quot;&gt;③ 真正搬：D 主动去 P 读（P 从不 push）&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;fillColor=#e7e0d4;strokeColor=#b3a89c;" vertex="1" parent="1">
