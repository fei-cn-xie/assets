            <mxPoint x="1850" y="759" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e47" value="GET_META_MSG：把你的「仓库地址表」给我" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1172" y="804" as="sourcePoint"/>
            <mxPoint x="714" y="804" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e48" value="MooncakeAgentMetadata（每层基址 / 块长 / 块步长 / te 端口）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;mooncake_connector.py:1466-1500&lt;/font&gt;" style="endArrow=block;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
