        <mxCell id="n92" value="&lt;font style=&quot;font-size:11px&quot;&gt;同上&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="618" width="200" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n93" value="&lt;font style=&quot;font-size:11px&quot;&gt;5×3&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="536" y="618" width="120" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n94" value="&lt;font style=&quot;font-size:11px&quot;&gt;另一套完全独立的权重&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="618" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n95" value="&lt;font style=&quot;font-size:11px&quot;&gt;拼接 [O₀ ; O₁]&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="654" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n96" value="&lt;font style=&quot;font-size:11px&quot;&gt;5×3 接 5×3&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="654" width="200" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n97" value="&lt;font style=&quot;font-size:11px&quot;&gt;5×6&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="536" y="654" width="120" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n98" value="&lt;font style=&quot;font-size:11px&quot;&gt;沿特征维接回 6 维&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="654" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n99" value="&lt;font style=&quot;font-size:11px&quot;&gt;O = 拼接·W_O&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="690" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n100" value="&lt;font style=&quot;font-size:11px&quot;&gt;5×6 · 6×4&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="690" width="200" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n101" value="&lt;font style=&quot;font-size:11px&quot;&gt;5×4&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="536" y="690" width="120" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n102" value="&lt;font style=&quot;font-size:11px&quot;&gt;输出投影（可换成任意输出维）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="690" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n103" value="&lt;b&gt;为什么必须再乘一次 W_O&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;拼接只是「把两份结果首尾接上」，没有让两个头的信息真正混合。乘 W_O（6×4）之后，每个输出维都是两个头所有维的加权和——&lt;b&gt;头与头之间才发生交互&lt;/b&gt;。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;这也是 o_proj 存在的唯一理由；省掉它，多头就等于「各自为政」。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1100" y="474" width="564" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="n104" value="&lt;b&gt;为什么多头有用（一个具体的例子）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;一句话里「小明把书给了小红，因为她明天要走」：&lt;br&gt;· 一个头可以学「代词 → 最近的女性名字」（指代消解）&lt;br&gt;· 另一个头可以学「动词 → 它的宾语」（语法结构）&lt;br&gt;· 再一个头可以学「相邻词」&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;如果只有一个头，这些关系必须挤在同一张 5×5 表里互相干扰。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="776" width="810" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n105" value="&lt;b&gt;GQA：现代模型为什么 K/V 的头数更少&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Llama-2 用 32 个头算 Q，但 K/V 也只有 32 份；Llama-3 / Qwen2.5 改成 &lt;b&gt;Q 有 32 个头，K/V 只有 8 个&lt;/b&gt;（4 个 Q 头共用一份 K/V）。&lt;br&gt;原因很实在：&lt;b&gt;K/V 要存进 KV cache&lt;/b&gt;，头数直接决定显存。减到 1/4，缓存就小到 1/4，而效果几乎不掉。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;config.json 里 num_attention_heads 与 num_key_value_heads 不相等就是 GQA（⑮）。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="866" y="776" width="798" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="n106" value="&lt;b&gt;代码锚点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;多头在实现里不是一个循环，而是&lt;b&gt;一个更大的矩阵乘&lt;/b&gt;：vllm/model_executor/layers/linear.py:995（QKVParallelLinear，一次算出所有头的 q/k/v，并按 TP 把头分到各卡）&lt;br&gt;头的切分与拼接在 attention backend 内部完成（reshape + transpose），数学上等价于本页的「拆 → 各算 → 拼」&lt;br&gt;头数与头维：vllm/model_executor/models/llama.py:165 附近读取 config 的 num_heads / num_kv_heads；输出投影 :175（o_proj）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="946" width="1628" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="t107" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1078" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n108" value="数据 / 激活" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="148" y="1075" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n109" value="权重 / 参数" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="276" y="1075" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n110" value="结果 / 新张量" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="404" y="1075" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n111" value="计算动作" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="532" y="1075" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n112" value="说明 / 结构" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="660" y="1075" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n113" value="易错点" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="788" y="1075" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e114" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1124" as="sourcePoint"/>
            <mxPoint x="204" y="1124" as="targetPoint"/>
