          <mxGeometry x="36" y="1030" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n104" value="数据 / 激活" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
