  </diagram>
  <diagram id="pg7" name="⑧ Softmax">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1704" pageHeight="1068" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑧ Softmax：把分数变成概率（一行一行算给你看）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1620" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="上一步得到 5 个分数，这一步把它们变成 5 个概率：都为正、加起来等于 1。整页只做四则运算和 exp，你会乘除就能跟下来。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1620" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;为什么不能直接拿分数当权重&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;分数可能是负数、也可能都很大（比如 19、13、23…），既不能当「比例」用，加起来也不等于 1。&lt;br&gt;Softmax 干三件事：① 全部取 exp（变成正数）；② 求和；③ 每个除以总和。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;结果一定 &amp;gt; 0 且 Σ = 1，正好可以当「把注意力分给谁多少」的权重。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="810" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;为什么先减最大值（工程细节）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;exp(13.9) 约等于 1.1e6，exp(100) 直接溢出成 inf。所以实现里先减去这一行的最大值（本行 13.9），最大项变成 exp(0)=1，其余都是小数——&lt;b&gt;数学上完全等价&lt;/b&gt;。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;这个技巧叫「数值稳定」，几乎每个 softmax 实现都有。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="866" y="150" width="798" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;第一步：取第 0 个 token 那一行（5 个分数），逐步算&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="260" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;位置&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="326" width="150" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;分数 s&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="186" y="326" width="150" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;s − max&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="336" y="326" width="150" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;exp(...)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
