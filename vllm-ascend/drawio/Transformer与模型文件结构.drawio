        <mxCell id="n41" value="结果 / 新张量" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="404" y="1343" width="120" height="26" as="geometry"/>
