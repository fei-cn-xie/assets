        <mxCell id="n64" value="0.25" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="276" y="744" width="52" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="n65" value="&lt;b&gt;P 的三个性质（后面全靠它们）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;每行和为 1&lt;/b&gt;：每行的含义是「这个 token 把注意力怎么分配」。&lt;br&gt;② &lt;b&gt;行 = 发问者，列 = 被关注者&lt;/b&gt;：所以 P 是方阵（⑦ 解释过）。&lt;br&gt;③ &lt;b&gt;全部 ≥ 0&lt;/b&gt;：注意力的权重不能为负，这让后面的加权求和变成「凸组合」（结果落在各 V 之间，不会跑到离谱的地方）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="368" y="624" width="700" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="n66" value="&lt;b&gt;代码锚点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;softmax 本体（含数值稳定做法）：vllm/model_executor/layers/... 里各 attention backend 的 softmax 实现；通用实现在 torch.nn.functional.softmax&lt;br&gt;为什么你在 vllm 里看不到完整的 P 矩阵：实际用 flash-attention 这类 fused kernel，一边算分块一边归一化，永远不把 5×5（真实是几百×几百）整块写回显存——数学等价，显存省一个数量级&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="840" width="1628" height="92" as="geometry"/>
        </mxCell>
