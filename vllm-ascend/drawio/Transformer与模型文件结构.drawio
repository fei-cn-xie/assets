  <diagram id="pg6" name="⑦ 注意力打分">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1704" pageHeight="1128" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑦ 打注意力分数：S = Q · Kᵀ（5×3 乘 3×5 得 5×5）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1620" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="这一步回答「每个 token 该看谁」。数学上就是一次矩阵乘：Q 乘 K 的转置。注意结果的 5×5 —— 全篇唯一必须用方阵的地方，本页会说清为什么。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1620" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;为什么这一步的矩阵一定是方阵（其它页都在躲方阵，这里躲不掉）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Q 有 5 行（5 个 token，每个 3 维）、K 也有 5 行。把 K &lt;b&gt;转置&lt;/b&gt;成 3×5 后相乘：&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;S = Q(5×3) · Kᵀ(3×5) → 5×5&lt;/font&gt;&lt;br&gt;结果的&lt;b&gt;行 = 发问的 token&lt;/b&gt;，&lt;b&gt;列 = 被看的 token&lt;/b&gt;。既然是「每个 token 对每个 token」，行数必然等于列数。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;所以 5×5 不是偷懒，而是语义决定的：它是一张「谁注意谁」的表。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="810" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;转置是什么意思&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;K 本来是「每行一个 token」的 5×3；Kᵀ 是它的镜像：第 i 行变第 i 列，形状反过来变成 3×5。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;代码里通常不真的转置，而是让矩阵乘的底层去处理（省一次内存搬运）。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="866" y="150" width="798" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;第一步：摆出来算（Q 与 K 来自 ⑥）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="240" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;b&gt;Q（提问）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
