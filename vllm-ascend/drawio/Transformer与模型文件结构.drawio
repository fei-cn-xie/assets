        <mxCell id="n69" value="&lt;font style=&quot;font-size:11px&quot;&gt;q:4096×4096 + k:4096×4096 + v:4096×4096 + o:4096×4096&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="878" width="700" height="34" as="geometry"/>
