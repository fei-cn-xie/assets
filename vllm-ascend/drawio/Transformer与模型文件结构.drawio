  <diagram id="pg12" name="⑬ 堆叠与采样">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1704" pageHeight="1290" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑬ 堆 32 层 + 输出头 + 采样：最后一个字是怎么被选出来的" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1620" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="前半页讲「层怎么堆」和「怎么变成词表分数」，后半页用 5 个候选词把「温度 / top-p / 贪心」的计算过程算给你看。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1620" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：32 层是怎么堆的（每层权重都不一样）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="90" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;第 1 层&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;结构相同&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="36" y="156" width="180" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;第 2 层&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;结构相同&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="246" y="156" width="180" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="189" as="sourcePoint"/>
            <mxPoint x="242" y="189" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;…&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;结构相同&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="456" y="156" width="180" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="430" y="189" as="sourcePoint"/>
            <mxPoint x="452" y="189" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;第 32 层&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;结构相同&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="666" y="156" width="180" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="640" y="189" as="sourcePoint"/>
            <mxPoint x="662" y="189" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;最后一层输出&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;仍是 5×4（形状不变）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="156" width="300" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="846" y="189" as="sourcePoint"/>
            <mxPoint x="896" y="189" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;关键&lt;/b&gt;：32 层结构完全相同，但&lt;b&gt;每层有自己的权重&lt;/b&gt;——所以参数量 = 单层 × 32。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1240" y="156" width="424" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;b&gt;第二步：最后做一次矩阵乘，把 4 维变成「词表大小」维的分数&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="200" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;5×4 · 4×32000 = 5×32000（形状最能说明问题）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;行还是 5 个 token，列变成 32000 个候选词的分数（logits）。&lt;br&gt;&lt;b&gt;只有最后一行的分数有用&lt;/b&gt;：因为我们要预测「第 5 个 token 之后是什么」，前面的行预测的是「第 1~4 个位置的下一个词」，训练时用得上，推理时不需要。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;所以 LM Head 的权重是 (4096×32000)≈1.3 亿参数，和 FFN 一层差不多——它常常和词嵌入共用同一份权重（③ 讲过）。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="266" width="810" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;为什么要「取最后一个」&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;自回归生成：前 4 个位置的下一个词是已知的（就是输入里的第 2~5 个 token），不需要预测。真正要预测的只有「第 5 个之后」。&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#c0392b&quot;&gt;工程实现里这个「取最后一个」是一次索引切片，不额外算矩阵乘——但为了批处理，通常会取出每个请求各自的最后一个位置。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="866" y="266" width="798" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;b&gt;第三步：把 5 个候选词的分数变成概率（同一组分数，三种温度）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="400" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;b&gt;候选词（真实 32000 个）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="440" width="460" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;苹果&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="466" width="90" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;香蕉&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
