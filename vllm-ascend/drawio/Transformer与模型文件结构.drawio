        <mxCell id="n65" value="10" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="570" y="438" width="40" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n66" value="22" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="612" y="438" width="40" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n67" value="17" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="654" y="438" width="40" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n68" value="21" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="696" y="438" width="40" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="t69" value="&lt;b&gt;第二步：手算 S[0][0]（第 0 个 token 看第 0 个 token 的分数）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="490" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n70" value="&lt;b&gt;「第 0 行的 Q」点乘「第 0 行的 K」&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Q 第 0 行 = [3, 3, 2]　　K 第 0 行（= Kᵀ 第 0 列）= [1, 4, 2]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;3×1 + 3×4 + 2×2 = &lt;b&gt;19&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;点积越大 → 两个向量方向越一致 → 「越相关」。这就是把「语义相关度」变成「一个数」的全部秘密。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="550" width="900" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="n71" value="&lt;b&gt;一个 token 看自己（对角线）通常分数很大&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;S 的对角线是 [19, 5, 22, 14, 21]，往往比同行其它位置大——因为「自己和自己最像」。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;所以模型很容易只关注自己；训练时靠数据把「该看别人」的情况也学出来。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="966" y="550" width="698" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="t72" value="&lt;b&gt;第三步：除以 √d（缩放）——为什么要这一步&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="650" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n73" value="&lt;b&gt;问题：维度越高，点积的数值越大&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本页 d_head = 3，√3 = 1.73。S 里的数是 5~24 的量级，除以 1.73 后变成 2.9~13.9。&lt;br&gt;真实模型 d_head = 128，√128 ≈ 11.3；如果不除，softmax 会被「特别大的分数」直接推到 0/1 的极端，梯度几乎消失。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;所以这一步不是玄学，是为了把分数&lt;b&gt;压回 softmax 舒服的区间&lt;/b&gt;。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="710" width="810" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="t74" value="&lt;b&gt;S / √3&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="668" width="220" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t75" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;5×5　现在是小数字了&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="870" y="688" width="220" height="20" as="geometry"/>
        </mxCell>
