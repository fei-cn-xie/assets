        <mxCell id="n42" value="&lt;font style=&quot;font-size:10px&quot;&gt;~10 KB&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
