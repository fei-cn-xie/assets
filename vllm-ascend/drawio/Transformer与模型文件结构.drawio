        </mxCell>
        <mxCell id="n56" value="&lt;font style=&quot;font-size:11px&quot;&gt;torch_dtype&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="566" width="300" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n57" value="&lt;font style=&quot;font-size:11px&quot;&gt;float16&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="566" width="200" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n58" value="&lt;font style=&quot;font-size:11px&quot;&gt;bfloat16&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="536" y="566" width="200" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n59" value="&lt;font style=&quot;font-size:11px&quot;&gt;权重精度（⑯⑳）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="736" y="566" width="400" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="t60" value="&lt;b&gt;三个「不写出来但一定存在」的量（必须自己算）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="584" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n61" value="&lt;b&gt;① head_dim = hidden_size / num_heads&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Llama-2-7B：4096/32 = 128。&lt;br&gt;注意有些模型（如 Qwen2 某些尺寸）会显式写 head_dim，此时它&lt;b&gt;不一定&lt;/b&gt;等于 hidden/heads——这时要以字段为准。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="644" width="520" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="n62" value="&lt;b&gt;② n_kv_groups = num_heads / num_kv_heads&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Llama-2：32/32 = 1（普通 MHA）。Qwen2.5-7B：28/4 = 7（每 7 个 Q 头共用 1 份 K/V，GQA）。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;KV cache 的显存 ∝ num_kv_heads，所以这个比值直接决定能放多少并发。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="576" y="644" width="520" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="n63" value="&lt;b&gt;③ ffn 倍数 = intermediate_size / hidden_size&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Llama-2：11008/4096 ≈ 2.69（不是整 4 倍！）。Qwen2.5：18944/3584 ≈ 5.29。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;老教程常说「FFN 是 4 倍」，那是原始 Transformer 的设置；现代模型为了对齐总参数量会取非整数倍。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1116" y="644" width="548" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="t64" value="&lt;b&gt;拿这几个数字反推参数量（手算一遍，你就懂「7B」是怎么来的）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="784" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n65" value="&lt;b&gt;项&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="844" width="260" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n66" value="&lt;b&gt;算式&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="296" y="844" width="700" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n67" value="&lt;b&gt;结果&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="996" y="844" width="180" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n68" value="&lt;font style=&quot;font-size:11px&quot;&gt;每层注意力&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="878" width="260" height="34" as="geometry"/>
