  <diagram id="pg8" name="⑨ 加权求和">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1704" pageHeight="1198" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑨ 加权求和：O = P · V（每个 token 把别人的内容按比例搬过来）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1620" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="这是注意力块的最后一步，也是一次普通矩阵乘：概率矩阵 P（5×5）乘内容矩阵 V（5×3）。结果 O 就是「这一层注意力加工后的新表示」。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1620" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;一句话：P 是「配料比例」，V 是「食材」，O 是「拌好的菜」&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;P 的第 i 行说「第 i 个 token 该按什么比例参考别人」，V 的第 j 行是「第 j 个 token 的内容」。两者相乘 = 按比例把内容混起来。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;文字描述就是这样发生的：模型想让「它」指代前面的「猫」时，只要把「猫」那一列的权重调大，内容就自动被搬进来了。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="1628" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="t4" value="&lt;b&gt;第一步：摆出来（P 来自 ⑧，V 来自 ⑥）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="198" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;P（权重）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
