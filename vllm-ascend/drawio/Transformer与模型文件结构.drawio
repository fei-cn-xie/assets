        <mxCell id="t38" value="&lt;b&gt;第三步：拿到一个新模型时的五步自检（照着念一遍就能定位问题）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="476" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;b&gt;1. 参数规模对得上吗？&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="536" width="460" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;font style=&quot;font-size:10px&quot;&gt;hidden² × 4 + hidden × ffn × 3 再乘层数 ≈ 模型名的 B 数（⑮）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="508" y="536" width="1156" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;b&gt;2. 文件总大小对得上吗？&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="596" width="460" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="&lt;font style=&quot;font-size:10px&quot;&gt;参数量 × 每参数字节（fp16=2、q4≈0.5）（⑯⑳）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="508" y="596" width="1156" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="&lt;b&gt;3. 词表对得上吗？&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="36" y="656" width="460" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="&lt;font style=&quot;font-size:10px&quot;&gt;vocab_size = 词表条目数 = embed_tokens 第 0 维（⑲）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="508" y="656" width="1156" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="&lt;b&gt;4. 头数对得上吗？&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="36" y="716" width="460" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="&lt;font style=&quot;font-size:10px&quot;&gt;num_heads × head_dim = hidden_size；GQA 时 kv 头更少（⑩⑮）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="508" y="716" width="1156" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="&lt;b&gt;5. 模板对得上吗？&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="776" width="460" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="&lt;font style=&quot;font-size:10px&quot;&gt;chat_template 里有没有 assistant 前缀；BOS/EOS 是否重复（⑲）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="508" y="776" width="1156" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="t49" value="&lt;b&gt;第四步：21 页索引（想复习哪一块就翻回去）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="806" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="&lt;b&gt;A · Transformer 怎么算&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① 总览　② 分词　③ 词嵌入　④ 位置编码 RoPE　⑤ 矩阵乘（线性层）　⑥ QKV 投影　⑦ 打分 Q·Kᵀ　⑧ softmax　⑨ 加权求和 P·V　⑩ 多头　⑪ 残差+RMSNorm　⑫ FFN/SwiGLU　⑬ 堆叠+输出头+采样&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="866" width="1628" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="&lt;b&gt;B · 模型文件结构&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;⑭ 目录全景　⑮ config.json　⑯ safetensors 字节布局　⑰ 分片与 index　⑱ 权重名→形状　⑲ tokenizer 与模板　⑳ GGUF 与量化　㉑ 本页&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="942" width="1628" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="&lt;b&gt;三个「一以贯之」的数字&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本套全程用 5 个 token × 4 维（⑩ 换成 6 维）演示；换成真实模型只需把 4 换成 4096、5 换成你的 token 数——&lt;b&gt;形状规则完全不变&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1018" width="1628" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="n53" value="&lt;b&gt;数字类型的规律&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;整数：token id、层号、形状、块号｜ 小数：权重、激活、分数、概率&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1094" width="1628" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="n54" value="&lt;b&gt;最后一句&lt;/b&gt;：Transformer 没有魔法——它只是「查表、乘矩阵、按权重求和、再乘矩阵」重复几十次；模型文件也没有魔法——它只是「一份 JSON 说明书 + 一大堆按名字排好的浮点数」。把这两句话落实到形状和字节上，你就已经超过大多数「会用但说不清」的人了。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1176" width="1628" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="t55" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1278" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n56" value="数据 / 激活" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="148" y="1275" width="120" height="26" as="geometry"/>
