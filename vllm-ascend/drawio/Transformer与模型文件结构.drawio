  <diagram id="pg19" name="⑳ GGUF 与量化">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1704" pageHeight="1296" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑳ GGUF 与量化：把 fp16 压成 4 bit，省下 3/4 的空间" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1620" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="前七页讲的都是 fp16 的 HF 权重。但你在本地跑模型时常见的是 4 GB 的 .gguf 文件——这一页讲清量化在做什么、GGUF 是什么、代价是什么。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1620" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：量化 = 用更少的比特表示同一批数（不是删参数）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="90" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;fp16：每个数 16 bit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;表示范围大、精度高，但占地方。7B 参数 × 2 字节 ≈ &lt;b&gt;14 GB&lt;/b&gt;。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;这是 HuggingFace 上的默认格式（⑯ 的 safetensors）。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="520" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;int8：每个数 8 bit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;把连续的浮点值「装进 256 个桶」，再记一个缩放系数。7B ≈ &lt;b&gt;7 GB&lt;/b&gt;，精度损失很小。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="576" y="150" width="520" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;4 bit：每个数 4 bit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;只有 16 个桶——单个数根本不够用，于是&lt;b&gt;一组数共享一个缩放系数&lt;/b&gt;（这叫 block-wise 量化）。7B ≈ &lt;b&gt;4 GB&lt;/b&gt;。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1116" y="150" width="548" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="t7" value="&lt;b&gt;第二步：一个 8 个数的分块，怎么变成 8 个 4bit 整数 + 1 个缩放系数&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="260" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;原始（fp16）&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="320" width="120" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;font style=&quot;font-size:10px&quot;&gt;0.42&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="170" y="320" width="92" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;font style=&quot;font-size:10px&quot;&gt;-0.11&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="266" y="320" width="92" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:10px&quot;&gt;0.87&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="362" y="320" width="92" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:10px&quot;&gt;0.03&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="458" y="320" width="92" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:10px&quot;&gt;-0.65&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="554" y="320" width="92" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:10px&quot;&gt;0.21&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="650" y="320" width="92" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:10px&quot;&gt;-0.02&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="746" y="320" width="92" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:10px&quot;&gt;0.55&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="842" y="320" width="92" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;b&gt;4bit 整数&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="376" width="120" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:10px&quot;&gt;+6&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="170" y="376" width="92" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:10px&quot;&gt;-2&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="266" y="376" width="92" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:10px&quot;&gt;+12&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="362" y="376" width="92" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:10px&quot;&gt;0&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="458" y="376" width="92" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:10px&quot;&gt;-9&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="554" y="376" width="92" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:10px&quot;&gt;+3&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="650" y="376" width="92" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:10px&quot;&gt;0&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="746" y="376" width="92" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:10px&quot;&gt;+8&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="842" y="376" width="92" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;缩放系数&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="432" width="120" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:10px&quot;&gt;scale = 0.07（这一组里绝对值最大的 0.87 ÷ 12 ≈ 0.07）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="170" y="432" width="764" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:10px&quot;&gt;还原：真实值 ≈ 整数 × scale&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="950" y="432" width="714" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="t29" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;8 个数 × 4 bit = 32 bit + 1 个 scale（16 bit）= 48 bit；而 fp16 需要 128 bit。压缩比约 &lt;b&gt;2.7 倍&lt;/b&gt;（分块越大越省，但精度越差——这就是 Q4_K_S / Q4_K_M 之类名字的区别）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="488" width="1628" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="t30" value="&lt;b&gt;第三步：GGUF 是「一个文件装下所有东西」的格式&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="490" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;维度&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="550" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;HF safetensors（⑯⑰）&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="236" y="550" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;GGUF&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="936" y="550" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:11px&quot;&gt;文件个数&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="590" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;font style=&quot;font-size:11px&quot;&gt;多个 safetensors + index + config + tokenizer&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="590" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;font style=&quot;font-size:11px&quot;&gt;通常 &lt;b&gt;一个 .gguf&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="936" y="590" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;font style=&quot;font-size:11px&quot;&gt;元数据&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="630" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;font style=&quot;font-size:11px&quot;&gt;散在 config.json / tokenizer_config.json 等&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="630" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;font style=&quot;font-size:11px&quot;&gt;全部塞进文件头的 KV 段（层数、头数、词表、模板…）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="936" y="630" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;font style=&quot;font-size:11px&quot;&gt;量化&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="670" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;font style=&quot;font-size:11px&quot;&gt;单独做（如 GPTQ/AWQ 的 4bit 权重 + scales 张量）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="670" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="&lt;font style=&quot;font-size:11px&quot;&gt;格式原生支持几十种量化类型，文件名就写清（Q4_K_M）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="936" y="670" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="&lt;font style=&quot;font-size:11px&quot;&gt;谁在用&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="710" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="&lt;font style=&quot;font-size:11px&quot;&gt;HuggingFace / vLLM / transformers 生态&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="710" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="&lt;font style=&quot;font-size:11px&quot;&gt;llama.cpp / Ollama 生态；vLLM 也能读（部分支持）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="936" y="710" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="&lt;font style=&quot;font-size:11px&quot;&gt;优点&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="750" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="&lt;font style=&quot;font-size:11px&quot;&gt;生态标准、加载快、可 mmap 切片&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="750" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="&lt;font style=&quot;font-size:11px&quot;&gt;单文件好分发；CPU/混合推理友好；体积小&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="936" y="750" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="&lt;font style=&quot;font-size:11px&quot;&gt;代价&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="790" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="&lt;font style=&quot;font-size:11px&quot;&gt;体积大（fp16）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="790" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="&lt;font style=&quot;font-size:11px&quot;&gt;精度有损；量化内核与硬件绑定，GPU 上未必更快&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="936" y="790" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="&lt;b&gt;量化到底损失了什么&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;数值精度&lt;/b&gt;：0.87 变成 12×0.07=0.84，误差 3%；一组里的小数值误差可能到 10%。&lt;br&gt;② &lt;b&gt;长尾词&lt;/b&gt;：罕见词、代码符号、数字推理最容易先崩——因为它们的权重本来就在分布的边角。&lt;br&gt;③ &lt;b&gt;不是线性的&lt;/b&gt;：4bit 通常只掉 1~3 分（常识问答几乎无损），但 2bit 会断崖式下降。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="866" width="810" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="n53" value="&lt;b&gt;为什么 GPU 上 4bit 不一定更快&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;量化的收益是&lt;b&gt;显存&lt;/b&gt;（能放更大模型/更长上下文）与&lt;b&gt;带宽&lt;/b&gt;（搬的字节少），不是算力。&lt;br&gt;解码前要先反量化回 fp16 才能做矩阵乘，这步有额外开销；所以小 batch 时收益明显，大 batch 时要专门的量化 kernel 才划算。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vLLM 里有专门的量化层实现（layers/quantization/ 目录下按方案分子目录）。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="866" y="866" width="798" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="n54" value="&lt;b&gt;代码锚点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;GGUF 的解析（把单文件里的元数据/tensor 信息读出来）：vllm/transformers_utils/gguf_utils.py&lt;br&gt;量化方案的实现（不同 scheme 各自的 Linear 与反量化 kernel）：vllm/model_executor/layers/quantization/ 目录（按方案名分子目录）&lt;br&gt;加载时怎么选：vllm/model_executor/model_loader/default_loader.py 会根据 config/权重的量化信息选择对应的 QuantizeMethodBase&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1066" width="1628" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="t55" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1198" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n56" value="数据 / 激活" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="148" y="1195" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n57" value="权重 / 参数" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="276" y="1195" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n58" value="结果 / 新张量" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="404" y="1195" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n59" value="计算动作" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="532" y="1195" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n60" value="说明 / 结构" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="660" y="1195" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n61" value="易错点" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="788" y="1195" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e62" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1244" as="sourcePoint"/>
            <mxPoint x="204" y="1244" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t63" value="数据流向 / 计算顺序" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1232" width="220" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e64" value="" style="endArrow=open;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="448" y="1244" as="sourcePoint"/>
            <mxPoint x="504" y="1244" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t65" value="虚线 = 形状/对照关系，不是数据" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="510" y="1232" width="300" height="24" as="geometry"/>
