        <mxCell id="n57" value="&lt;font style=&quot;font-size:11px&quot;&gt;4509 万&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1106" y="626" width="140" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n58" value="&lt;font style=&quot;font-size:11px&quot;&gt;model.layers.N.mlp.down_proj.weight&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="660" width="470" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n59" value="&lt;font style=&quot;font-size:11px&quot;&gt;[4096, 11008]&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="506" y="660" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n60" value="&lt;font style=&quot;font-size:11px&quot;&gt;down 降维（⑫）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="706" y="660" width="400" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n61" value="&lt;font style=&quot;font-size:11px&quot;&gt;4509 万&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1106" y="660" width="140" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n62" value="&lt;font style=&quot;font-size:11px&quot;&gt;model.norm.weight&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="694" width="470" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n63" value="&lt;font style=&quot;font-size:11px&quot;&gt;[4096]&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="506" y="694" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n64" value="&lt;font style=&quot;font-size:11px&quot;&gt;最后一层归一化（⑪）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="706" y="694" width="400" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n65" value="&lt;font style=&quot;font-size:11px&quot;&gt;4 千&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1106" y="694" width="140" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n66" value="&lt;font style=&quot;font-size:11px&quot;&gt;lm_head.weight&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="728" width="470" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n67" value="&lt;font style=&quot;font-size:11px&quot;&gt;[32000, 4096]&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="506" y="728" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n68" value="&lt;font style=&quot;font-size:11px&quot;&gt;输出头（⑬；与 embed 共享时不存在）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="706" y="728" width="400" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n69" value="&lt;font style=&quot;font-size:11px&quot;&gt;1.31 亿&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1106" y="728" width="140" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="t70" value="&lt;b&gt;第三步：三个几乎人人踩过的坑&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="742" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n71" value="&lt;b&gt;坑 ① 形状是 [out, in]，和公式反着&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;公式写 y = xW（W 是 in×out），但 &lt;b&gt;PyTorch 的 Linear.weight 存成 [out, in]&lt;/b&gt;——正好是转置。&lt;br&gt;所以 gate_proj.weight 是 [11008, 4096] 而不是 [4096, 11008]。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;判断方法：看那个 11008 在哪一维——它在第 0 维，就是 [out, in]。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="802" width="520" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="n72" value="&lt;b&gt;坑 ② 文件里是分着的，代码里是合并的&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;文件里 k_proj / v_proj 各自独立；vLLM 会把它们&lt;b&gt;拼成 qkv_proj&lt;/b&gt; 一次算完（⑥ 提过）。&lt;br&gt;所以你在代码里搜 qkv_proj.weight 是搜不到文件的——加载时会做名字映射与拼接。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;改模型时如果忘了这层映射，会出现「张量找不到」或「形状不匹配」。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="576" y="802" width="520" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="n73" value="&lt;b&gt;坑 ③ 量化后多出一堆 .scales / .qweight&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;4bit 权重不再是 [4096, 4096] 的 fp16，而是「打包的整数 + 每组的缩放系数」（⑳ 讲）。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;此时名字会变成 qweight / scales / qzeros 之类，形状也完全不同——看到这些名字说明这是量化模型。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1116" y="802" width="548" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="n74" value="&lt;b&gt;代码锚点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;名字映射表（把 HF 的 q_proj/k_proj/v_proj 映射成 vllm 的 qkv_proj 等）：各模型文件里的 stacked_params_mapping / WeightsMapper，见 vllm/model_executor/models/llama.py 的 load_weights 与 vllm/model_executor/models/utils.py&lt;br&gt;逐层装配：vllm/model_executor/models/llama.py:347（LlamaModel）、:251（LlamaDecoderLayer）、:165/:175（注意力）、:82/:95/:103（FFN）&lt;br&gt;权重加载器：vllm/model_executor/model_loader/default_loader.py&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1012" width="1628" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="t75" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1144" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n76" value="数据 / 激活" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="148" y="1141" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n77" value="权重 / 参数" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="276" y="1141" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n78" value="结果 / 新张量" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="404" y="1141" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n79" value="计算动作" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="532" y="1141" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n80" value="说明 / 结构" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="660" y="1141" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n81" value="易错点" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="788" y="1141" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e82" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1190" as="sourcePoint"/>
            <mxPoint x="204" y="1190" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t83" value="数据流向 / 计算顺序" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1178" width="220" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e84" value="" style="endArrow=open;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="448" y="1190" as="sourcePoint"/>
            <mxPoint x="504" y="1190" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t85" value="虚线 = 形状/对照关系，不是数据" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="510" y="1178" width="300" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg18" name="⑲ tokenizer 与模板">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1704" pageHeight="1444" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑲ tokenizer 与模板：文本侧的三个文件 + 一个模板" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1620" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="权重决定「模型懂什么」，这几个文件决定「文本怎么进去、怎么出来」。它们加起来不到 10 MB，却是最常见的踩坑来源。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1620" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：三个文件各管一件事（缺一个就跑不起来）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="90" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;① tokenizer.json（或 vocab.json + merges.txt）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;规则本体&lt;/b&gt;：词表（每行一个 token 片段）+ BPE 合并优先级表。&lt;br&gt;新版 HF 把它打包成一个 tokenizer.json；老模型（GPT-2 系）还是两个文本文件。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;它就是 ② 里「切成 token 再查 id」的那张表。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="520" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;② tokenizer_config.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;行为配置&lt;/b&gt;：用什么分词器类、大小写、特殊 token 的名字、要不要加 BOS、以及 &lt;b&gt;chat_template&lt;/b&gt;（可内嵌也可单独 .jinja）。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;这一份最容易出事：字段名改了，tokenizer 就会把文本切错。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="576" y="150" width="520" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;③ special_tokens_map.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;名字 ↔ 特殊 token 字符串&lt;/b&gt;：bos_token / eos_token / pad_token / unk_token 各是哪个字符串。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;它们的 &lt;b&gt;id&lt;/b&gt; 不在这个文件里，而在 tokenizer 本体里（查表得到）。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1116" y="150" width="548" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="t7" value="&lt;b&gt;第二步：一句话从字符串到 id 的完整过程（含特殊 token）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="250" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;原始文本&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="310" width="330" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;font style=&quot;font-size:10px&quot;&gt;「你好，帮我写首诗」&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="378" y="310" width="1286" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;套模板（chat_template）&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="374" width="330" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:10px&quot;&gt;&amp;lt;|im_start|&amp;gt;user⏎你好，帮我写首诗&amp;lt;|im_end|&amp;gt;⏎&amp;lt;|im_start|&amp;gt;assistant⏎&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="378" y="374" width="1286" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;切 token（BPE）&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="36" y="438" width="330" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:10px&quot;&gt;&amp;lt;|im_start|&amp;gt; ｜ user ｜ 你好 ｜ ， ｜ 帮我 ｜ 写 ｜ 首诗 ｜ …&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="378" y="438" width="1286" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;查词表换 id&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="502" width="330" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:10px&quot;&gt;[151644, 872, 108386, 3922, 101058, ...]&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="378" y="502" width="1286" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;加 BOS/EOS（视配置）&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="566" width="330" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:10px&quot;&gt;开头加 bos_token_id，结尾留给模型生成&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="378" y="566" width="1286" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;chat_template 为什么能改变「模型性格」&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;同一个模型权重，用不同模板拼出来的字符串不一样 → token 序列不一样 → 输出风格明显不同。&lt;br&gt;比如少写 &lt;b&gt;&amp;lt;|im_start|&amp;gt;assistant&lt;/b&gt;，模型就不知道「该轮到我说话了」，可能继续扮演用户。&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#c0392b&quot;&gt;这就是「同一个模型在 A 框架好用、在 B 框架胡说」的最常见原因。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="660" width="810" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;b&gt;generation_config.json 在这里的角色&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;它不参与分词，而是给「生成」提供默认参数：temperature、top_p、top_k、max_new_tokens、eos_token_id、repetition_penalty。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;⑬ 里那些默认值就来自它；命令行/接口传参会覆盖它。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="866" y="660" width="798" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;b&gt;第三步：和 config.json 的唯一约定——词表大小必须对得上&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="790" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;项&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="850" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;值&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="456" y="850" width="180" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;b&gt;说明&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="636" y="850" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;config.json: vocab_size&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="884" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;32000&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="456" y="884" width="180" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;网络输出头的宽度（⑬）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="636" y="884" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;tokenizer 词表实际条目数&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="918" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;32000&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="456" y="918" width="180" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;必须 ≤ vocab_size&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="636" y="918" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;embed_tokens.weight 第 0 维&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="952" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;32000&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="456" y="952" width="180" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;必须 = vocab_size（③⑱）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="636" y="952" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:11px&quot;&gt;lm_head.weight 第 0 维&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="986" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:11px&quot;&gt;32000&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="456" y="986" width="180" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;font style=&quot;font-size:11px&quot;&gt;必须 = vocab_size（若不共享）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="636" y="986" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;b&gt;对不上会怎样&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;词表比 vocab_size 大 → 分词后出现越界 id（运行时崩）；比 vocab_size 小 → 有一批 id 永远用不到（浪费显存，但不崩）。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;换 tokenizer（比如给模型加新词）时，必须同时改权重里的 embed_tokens / lm_head，这就是「词表扩充」要做的事。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="1084" width="1628" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;b&gt;代码锚点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;tokenizer 的加载与特殊 token 处理：vllm/transformers_utils/tokenizer.py（get_tokenizer / get_cached_tokenizer）&lt;br&gt;chat template 的应用：同目录 tokenizer.py 里的 apply_chat_template 相关逻辑，以及 vllm/entrypoints/openai/ 下的对话接口&lt;br&gt;GGUF 模型的 tokenizer 特殊处理：vllm/transformers_utils/gguf_utils.py（GGUF 把分词器也塞在同一个文件里，需要另走一条路，见 ⑳）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1214" width="1628" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="t38" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1346" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="数据 / 激活" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="148" y="1343" width="120" height="26" as="geometry"/>
