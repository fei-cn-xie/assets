        </mxCell>
        <mxCell id="t42" value="虚线 = 形状/对照关系，不是数据" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="510" y="982" width="300" height="24" as="geometry"/>
