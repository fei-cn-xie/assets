      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg4" name="⑤ 线性层">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1704" pageHeight="1062" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑤ 线性层（nn.Linear）：整个 Transformer 里唯一的基本运算" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1620" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="Transformer 有 99% 的浮点运算都是这一件事：y = x·W + b。学会看这一次乘法，后面的 QKV、注意力、FFN 全都是它的变形。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1620" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：先看形状怎么变（这一步比数字重要）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="92" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;形状规则：左矩阵的列数 = 右矩阵的行数，结果的形状取「左行 × 右列」&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;X（6×4）· W（4×5）= R（6×5）　　→ 中间那个 4 和 4 必须相等（否则乘不了）；结果的 6 来自左矩阵的行、5 来自右矩阵的列。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;本页故意让 &lt;b&gt;6 ≠ 5&lt;/b&gt;、也故意不用方阵——这样你能一眼看出「结果的每一维是从哪儿继承的」。真实模型里同样是长方形：X 是 (token 数 × 4096)，W 是 (4096 × 12288)，R 是 (token 数 × 12288)。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="1628" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;第二步：摆出三个矩阵（数字都是整数，方便手算）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="200" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;b&gt;X（输入）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="224" width="180" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t7" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;6×4　6 个 token × 4 维&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="244" width="220" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="1" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="40" height="30" as="geometry"/>
