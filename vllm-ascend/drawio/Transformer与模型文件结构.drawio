      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg15" name="⑯ safetensors 格式">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1704" pageHeight="1034" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑯ safetensors 文件格式：权重是怎么一个字节一个字节存起来的" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1620" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="safetensors 只有两部分：一段 JSON 目录 + 一大块裸数据。没有代码、没有 pickle，所以加载快且安全——这一页把它拆到你敢自己解析。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1620" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：整个文件只有三段（从左到右就是字节顺序）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="90" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;① 8 字节&lt;/b&gt;&lt;br&gt;头部长度 N&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;小端 uint64&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;② N 字节：JSON 头部（目录）&lt;/b&gt;&lt;br&gt;每个张量的名字、dtype、形状、&lt;b&gt;数据在文件里的起止偏移&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;纯文本 JSON，按 8 字节对齐补空格&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="252" y="150" width="700" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;③ 剩下的全部：裸数据区&lt;/b&gt;&lt;br&gt;几十亿个 fp16 紧挨着排，没有任何额外结构&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;张量的偏移都是相对这一段的开头&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="968" y="150" width="696" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="236" y="195" as="sourcePoint"/>
            <mxPoint x="252" y="195" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="952" y="195" as="sourcePoint"/>
            <mxPoint x="968" y="195" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t9" value="&lt;b&gt;第二步：那个 JSON 头部到底写了什么（真实结构，缩短过）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="210" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;font style=&quot;font-size:9px&quot; face=&quot;Courier New&quot; color=&quot;#333333&quot;&gt;{{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;model.layers.0.self_attn.q_proj.weight&quot;: {{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;dtype&quot;: &quot;F16&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;shape&quot;: [4096, 4096],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;data_offsets&quot;: [0, 33554432]&lt;br&gt;&amp;nbsp;&amp;nbsp;}},&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;model.layers.0.self_attn.o_proj.weight&quot;: {{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;dtype&quot;: &quot;F16&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;shape&quot;: [4096, 4096],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;data_offsets&quot;: [33554432, 67108864]&lt;br&gt;&amp;nbsp;&amp;nbsp;}},&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;__metadata__&quot;: {{&quot;format&quot;: &quot;pt&quot;}}&lt;br&gt;}}&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="270" width="900" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;怎么从这一段算出「读多少字节」&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;4096×4096 个 fp16 = 16,777,216 × 2 字节 = &lt;b&gt;33,554,432&lt;/b&gt; 字节，正好是 offsets 的差值（33554432−0）。&lt;br&gt;所以加载器只需要：读 JSON → 拿到 (offset, shape, dtype) → &lt;b&gt;seek 到 8+N+offset，读 length 个字节&lt;/b&gt;，直接 memcpy 到显存。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;这就是为什么 safetensors 加载快：没有解析、没有反序列化，纯内存拷贝。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="966" y="270" width="698" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;为什么它不是「一整块连续」&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;张量的顺序由保存时的遍历顺序决定，加载器&lt;b&gt;不应该假设&lt;/b&gt;任何顺序——一切以 JSON 里的 offsets 为准。&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#c0392b&quot;&gt;这也解释了为什么「把两个 safetensors 直接拼起来」不叫合并：你必须重算所有 offsets（⑰ 的分片就是这么产生的）。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="966" y="440" width="698" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="t13" value="&lt;b&gt;第三步：和老的 PyTorch .bin（pickle）比，好在哪&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="500" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;维度&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="560" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;PyTorch .bin / pickle&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="236" y="560" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;safetensors&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="656" y="560" width="560" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;加载速度&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="594" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;需要 Python 反序列化，慢&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="594" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;纯内存拷贝，快一个数量级&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="594" width="560" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;安全性&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="628" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;pickle 能执行代码，恶意模型可以拿到你的 shell&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="628" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;只有数据，没有可执行内容&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="628" width="560" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;内存峰值&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="662" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;可能先整份读进内存再转&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="662" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;可以 mmap / 流式按张量读&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="662" width="560" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;随机访问&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="696" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;要先整体反序列化&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="696" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;按 offsets 直接 seek，只读需要的张量&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="696" width="560" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;并行加载&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="730" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;难&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="730" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;按张量分给多个线程/进程（vLLM 默认就这么干）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="730" width="560" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;代码锚点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vLLM 里读 safetensors 的地方：vllm/model_executor/model_loader/weight_utils.py:26（from safetensors.torch import safe_open / load_file）→ :866（safetensors_weights_iterator，它用 safe_open 打开文件、按张量名惰性读取）&lt;br&gt;多线程/多进程预取：同文件 :1012（multi_thread_safetensors_weights_iterator）、:33-34（DEFAULT_SAFETENSORS_PREFETCH_* 两个常量）&lt;br&gt;上层装配：vllm/model_executor/model_loader/default_loader.py（拿到迭代器后逐个 load_weights）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="804" width="1628" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="t33" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
