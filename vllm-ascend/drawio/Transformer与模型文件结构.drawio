  <diagram id="pg9" name="⑩ 多头注意力">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1704" pageHeight="1176" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑩ 多头注意力：拆成几份并行算，再拼回来" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1620" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="为什么要多头？因为「一种关注方式」不够用：有的头盯语法、有的头盯指代、有的头盯标点。多头 = 把特征维切开，各自算一遍注意力，最后拼接。本页用 6 维拆成 2 个头来演示。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1620" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;先算清形状：多头不增加总维度，只是把一个空间切成几块&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;d_model = 6，n_heads = 2 → d_head = 6/2 = 3。每个头各自有一份 W_Q/W_K/W_V，形状是 &lt;b&gt;6×3&lt;/b&gt;（输入 6 维 → 输出 3 维）。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;真实模型：d_model=4096、n_heads=32 → d_head=128；每个头的 W 是 4096×128。两个头之间&lt;b&gt;不共享&lt;/b&gt;权重。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="1628" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="t4" value="&lt;b&gt;第一步：沿特征维切开（这就是「拆头」的全部动作）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="198" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;X（5×6）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="218" width="264" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;5 个 token × 6 维&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
