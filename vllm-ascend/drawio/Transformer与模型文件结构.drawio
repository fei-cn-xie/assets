  <diagram id="pg5" name="⑥ QKV 投影">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1704" pageHeight="1146" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑥ Q / K / V 投影：一份输入，三次矩阵乘" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1620" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="注意力需要的三样东西（query / key / value）不是玄学，就是同一份 X 乘三个不同的权重矩阵。这一页只做三次 ⑤ 那样的乘法，并把结果摆出来给后面两页用。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1620" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：先用一句话说清三者的分工（后面全靠这个比喻）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="90" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;Q（query，提问）&lt;/b&gt;&lt;br&gt;「我这个 token 想找什么信息？」&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;每个 token 用自己的 Q 去和别人比对&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="530" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;K（key，标签）&lt;/b&gt;&lt;br&gt;「我这里有什么信息？」&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;Q 和 K 做点积 = 相关度打分&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="586" y="150" width="530" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;V（value，内容）&lt;/b&gt;&lt;br&gt;「如果被关注，我提供什么内容？」&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;按分数加权求和的就是 V&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1136" y="150" width="528" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;图书馆类比&lt;/b&gt;：Q 是你在检索框里输入的关键词，K 是每本书的标签，V 是书的内容。检索 = 关键词和标签算相似度（⑦），取书 = 按相似度把内容加权搬回来（⑨）。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="270" width="1628" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;第二步：三次独立的矩阵乘（X 是同一份，W 不同）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="340" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;b&gt;X（上一层输出）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
