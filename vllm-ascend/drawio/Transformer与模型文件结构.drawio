<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" pages="21">
  <diagram id="pg0" name="① 总览">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1898" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="① 总览：一句话是怎么变成下一个字的（21 页的路线图）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1620" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="你只要会线性代数就能看懂：整个 Transformer 就是「查表 → 矩阵乘 → 加权求和 → 再矩阵乘」反复 32 次，最后在词表上打一个分。本页先把全程画成一条线，后面逐段展开。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1620" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;前半程：文本 → 数字矩阵&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;文本&lt;/b&gt;&lt;br&gt;「我爱吃苹果」&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;人看的东西&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="250" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;② 分词 tokenizer&lt;/b&gt;&lt;br&gt;切成 5 个 token，每个换成整数 id&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;词表里第几号&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="316" y="150" width="270" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;③ 词嵌入 + ④ 位置编码&lt;/b&gt;&lt;br&gt;每个 id 变成一行浮点数，再加位置信息&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;得到 5×4 的矩阵（真实 5×4096）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="616" y="150" width="300" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="286" y="189" as="sourcePoint"/>
            <mxPoint x="316" y="189" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="586" y="189" as="sourcePoint"/>
            <mxPoint x="616" y="189" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;⑤~⑫ 一层 Transformer&lt;/b&gt;&lt;br&gt;注意力（⑥~⑩）+ 残差/RMSNorm（⑪）+ FFN（⑫）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;形状不变：进去 5×4，出来还是 5×4&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="946" y="150" width="300" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="916" y="189" as="sourcePoint"/>
            <mxPoint x="946" y="189" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;⑬ 堆 32 层 → LM Head&lt;/b&gt;&lt;br&gt;最后一层输出 × 词表矩阵 → 每个 token 一个 32000 维分数&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;取最后一个 token 的分数做 softmax → 采样&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1276" y="150" width="388" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1246" y="189" as="sourcePoint"/>
            <mxPoint x="1276" y="189" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t13" value="&lt;b&gt;贯穿全程的一条铁律：Transformer 层不改变张量形状&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="246" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;b&gt;形状（token 数 × 特征维）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="250" width="250" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;5×4&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="276" width="48" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;5×4&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="86" y="276" width="48" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;5×4&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="136" y="276" width="48" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;5×4&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="186" y="276" width="48" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;5×4&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="276" width="48" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;font style=&quot;font-size:10px&quot;&gt;→ 于是可以一层层往上堆：&lt;b&gt;第 2 层的输入，就是第 1 层的输出&lt;/b&gt;。这就是「深度」的来源。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="298" y="276" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;为什么必须保持形状&lt;/b&gt;：只有输入输出形状一致，才能做「残差连接」——把输入直接加到输出上（x + f(x)）。这一点是 Transformer 能堆深的根本原因（⑪ 详讲）。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="298" y="320" width="1560" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="t22" value="&lt;b&gt;后半程：分数 → 下一个字&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="386" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;b&gt;logits：每个候选字的分数&lt;/b&gt;&lt;br&gt;形状 5×32000（行=位置，列=词表）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;只取最后一行：1×32000&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="420" width="300" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;softmax → 概率&lt;/b&gt;&lt;br&gt;把分数变成「加起来等于 1」的概率&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;温度 T 控制锐利程度（⑬）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="366" y="420" width="300" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;采样：掷一次骰子&lt;/b&gt;&lt;br&gt;按概率抽一个 token（top-p 先砍掉长尾）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;贪心 = 永远选最大&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="696" y="420" width="300" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;把新 token 接回输入&lt;/b&gt;&lt;br&gt;序列变成 6 个 token，再跑一遍&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;这就是「自回归」：一个字一个字生成&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1026" y="420" width="300" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;为什么叫「自」回归&lt;/b&gt;&lt;br&gt;模型的输出，变成它下一步的输入；整段对话就是这一个循环转几百次。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1356" y="420" width="308" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="e28" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n23" target="n24">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e29" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n24" target="n25">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e30" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n25" target="n26">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e31" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n26" target="n27">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="t32" value="&lt;b&gt;全套图的路线（每页只展开一个方框）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="546" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;A · Transformer 怎么算（⑵~⑬）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① 总览 → ② 分词 → ③ 词嵌入 → ④ 位置编码 → ⑤ 矩阵乘 → ⑥ QKV → ⑦ 打分 → ⑧ softmax → ⑨ 加权求和 → ⑩ 多头 → ⑪ 残差+归一化 → ⑫ FFN → ⑬ 输出与采样&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="580" width="1628" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;B · 模型文件里有什么（⑭~㉑）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;⑭ 目录全景 → ⑮ config.json → ⑯ safetensors 字节布局 → ⑰ 分片与 index → ⑱ 权重名→形状 → ⑲ tokenizer 三件套 → ⑳ GGUF 与量化 → ㉑ 从文件到推理&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="666" width="1628" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="t35" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="762" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="数据 / 激活" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="148" y="759" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="权重 / 参数" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="276" y="759" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="结果 / 新张量" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="404" y="759" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="计算动作" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="532" y="759" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="说明 / 结构" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="660" y="759" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="易错点" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="788" y="759" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e42" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="808" as="sourcePoint"/>
            <mxPoint x="204" y="808" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t43" value="数据流向 / 计算顺序" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="796" width="220" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e44" value="" style="endArrow=open;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="448" y="808" as="sourcePoint"/>
            <mxPoint x="504" y="808" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t45" value="虚线 = 形状/对照关系，不是数据" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="510" y="796" width="300" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg1" name="② 分词">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1704" pageHeight="1016" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="② 分词（tokenizer）：文本 → 整数 id" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1620" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="神经网络只会算数，不会读字。所以第一步是把文本切成「token」并查表换成整数。这一页只回答三件事：切成什么、查到什么、特殊 token 是什么。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1620" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：把文本切成 token（不一定是「字」也不一定是「词」）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;原始文本&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;「我爱吃苹果」&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;5 个汉字&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="340" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;切成 token&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;我 | 爱 | 吃 | 苹果&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;4 个 token：常见词「苹果」占一个 token&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="406" y="150" width="400" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;查词表换成 id&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;12841 | 3027 | 882 | 6132&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;每个 id 是「词表里的第几行」&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="836" y="150" width="420" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;切开方式由算法定&lt;/b&gt;&lt;br&gt;BPE（byte-pair encoding）：从单字节开始，反复把&lt;b&gt;最常一起出现&lt;/b&gt;的两段合并&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;所以 token 粒度是「统计出来的」&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1286" y="150" width="378" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="376" y="198" as="sourcePoint"/>
            <mxPoint x="406" y="198" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="806" y="198" as="sourcePoint"/>
            <mxPoint x="836" y="198" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1256" y="198" as="sourcePoint"/>
            <mxPoint x="1286" y="198" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;第二步：这串 id 就是模型的输入（注意：它是整数，不是浮点）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="266" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;b&gt;input_ids（长度 5）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="274" width="448" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;12841&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="36" y="300" width="110" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;3027&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="148" y="300" width="110" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;882&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="300" width="110" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;6132&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="372" y="300" width="110" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;b&gt;形状：5（没有第二维）&lt;/b&gt;&lt;br&gt;严格说它是一个长度 5 的整数数组；在框架里常写成 5×1 或 1×5 只是为了凑成矩阵。&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#c0392b&quot;&gt;这条很重要：&lt;b&gt;整数 id 不能直接做矩阵乘&lt;/b&gt;，必须先变成浮点向量（③ 词嵌入）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="350" width="640" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;真实规模&lt;/b&gt;：Llama-2 词表 32000；Qwen2.5 词表 152064（含大量中文字与多字节）。一句中文通常切成 1~2 字/token，英文常见词约 1 词/token，代码里的空格和符号各占 token。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;词表大小 = ⑮ config.json 的 vocab_size；词表本身 = ⑲ tokenizer 三件套里的 vocab 文件&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="716" y="350" width="948" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;b&gt;第三步：除了「字」，词表里还住着几个特殊 token&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="466" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;b&gt;&lt;s&gt; / &lt;|bos|&gt;&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="36" y="500" width="300" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;BOS：句子开头&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;告诉模型「从这里开始算」&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="350" y="500" width="420" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;&lt;/s&gt; / &lt;|eos|&gt;&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="36" y="562" width="300" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;b&gt;EOS：句子结束&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;模型生成到它就停，这是它学会「说完」的方式&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="350" y="562" width="420" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;&lt;|pad|&gt;&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="36" y="624" width="300" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;PAD：填充&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;批量推理时把短句补齐到同一长度（补的部分不参与计算）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="350" y="624" width="420" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;&lt;|im_start|&gt;&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="36" y="686" width="300" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;角色分隔（chat 模板）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;区分 system / user / assistant 三种说话人&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="350" y="686" width="420" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;b&gt;为什么特殊 token 重要&lt;/b&gt;&lt;br&gt;① &lt;b&gt;BOS/EOS&lt;/b&gt; 决定「什么时候开始/停止生成」；没学好的模型会一直说下去。&lt;br&gt;② &lt;b&gt;PAD&lt;/b&gt; 让「多条请求一起算」成为可能（批量推理的前提）。&lt;br&gt;③ &lt;b&gt;角色分隔符&lt;/b&gt;是现代 chat 模型区分说话人的唯一手段——同一个模型，模板不同，回答风格就完全不同。&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;这些 token 的 id 固定写在 tokenizer_config.json / special_tokens_map.json 里（⑲）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="784" y="500" width="880" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;b&gt;代码锚点（在 vllm 仓里能直接翻到）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;词嵌入层本体：vllm/model_executor/layers/vocab_parallel_embedding.py:205（class VocabParallelEmbedding）——它的 forward 就是「按 id 取行」&lt;br&gt;词表与 tokenizer 的加载：vllm/transformers_utils/tokenizer.py（get_tokenizer / 特殊 token 处理）&lt;br&gt;把 id 变成向量：vllm/model_executor/models/llama.py:382（self.embed_tokens = VocabParallelEmbedding(...)）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="788" width="1628" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="t30" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="918" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="数据 / 激活" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="148" y="915" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="权重 / 参数" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="276" y="915" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="结果 / 新张量" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="404" y="915" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="计算动作" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="532" y="915" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="说明 / 结构" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="660" y="915" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="易错点" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="788" y="915" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e37" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="964" as="sourcePoint"/>
            <mxPoint x="204" y="964" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t38" value="数据流向 / 计算顺序" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
