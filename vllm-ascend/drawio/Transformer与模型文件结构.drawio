  </diagram>
  <diagram id="pg16" name="⑰ 分片与索引">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1704" pageHeight="1262" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑰ 分片与 index.json：14 GB 的权重怎么拆成 4 个文件" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1620" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="单个 safetensors 文件太大会撑爆内存、也无法并行下载，所以按张量切成几片，再用一份 index.json 记录「谁在哪」。这一页讲清它和「张量并行切分」的区别。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1620" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：切成 4 片（按张量切，不切开任何一个张量）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="90" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;model-00001-of-00004.safetensors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;≈ 3.4 GB&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="280" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;model-00002-of-00004.safetensors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;≈ 3.4 GB&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="336" y="150" width="280" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;model-00003-of-00004.safetensors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;≈ 3.4 GB&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="636" y="150" width="280" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;model-00004-of-00004.safetensors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;≈ 3.4 GB&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="936" y="150" width="280" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;每条分片自己是完整的 safetensors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;各自有 8 字节长度 + JSON 头 + 数据区（⑯）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1236" y="150" width="428" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;切分规则：按张量累加，到阈值就换新文件&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;保存时按顺序累加每个张量的字节数，超过 max_shard_size（HF 默认 5 GB）就开新文件。&lt;b&gt;不会把一个张量拆到两个文件里&lt;/b&gt;。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;所以 4 片的大小不一定完全相等（3.4/3.4/3.4/3.3 之类）。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="256" width="810" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;为什么不用一个 14 GB 的文件&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① 下载/校验可以并行、断点续传；② 加载时可以只读需要的张量；③ 单个文件过大在某些文件系统/传输协议上有上限；④ 便宜：多进程能同时读不同分片。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="866" y="256" width="798" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;第二步：index.json 就是一张「张量名 → 文件」的字典&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="390" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:9px&quot; face=&quot;Courier New&quot; color=&quot;#333333&quot;&gt;{{&quot;metadata&quot;: {{&quot;total_size&quot;: 13476877312}},&lt;br&gt;&amp;nbsp;&quot;weight_map&quot;: {{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;model.embed_tokens.weight&quot;: &quot;model-00001-of-00004.safetensors&quot;,&lt;br&gt;&amp;nbsp;&quot;model.layers.0.self_attn.q_proj.weight&quot;: &quot;model-00001-of-00004.safetensors&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;...&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;model.layers.31.mlp.down_proj.weight&quot;: &quot;model-00004-of-00004.safetensors&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;lm_head.weight&quot;: &quot;model-00004-of-00004.safetensors&quot;&lt;br&gt;&amp;nbsp;}}}}&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="450" width="860" height="236" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;加载器怎么用它&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① 读 index.json 拿到 weight_map；② 按「当前层需要哪些张量」把请求分组到文件；③ 对每个文件只 seek 需要的偏移（⑯）。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;所以加载速度取决于「同时打开几个文件」和「是否顺序读」，而不是文件个数本身。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="926" y="450" width="738" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;常见误解：分片 ≠ 张量并行切分&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;分片（shard）只是&lt;b&gt;物理存储&lt;/b&gt;的切法，模型还是一份；张量并行（TP）是把同一个矩阵&lt;b&gt;按维度切开分发到多张卡&lt;/b&gt;，每张卡只持有一部分。&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#c0392b&quot;&gt;所以「4 个分片」和「4 张卡」毫无关系——一个 4 分片的模型可以在 1 张卡上跑，也可以在 8 张卡上用 TP=8 跑（这时每张卡只加载自己那份切片）。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="926" y="566" width="738" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;b&gt;第三步：两种「切」的本质区别（一张表记住）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="680" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;维度&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="740" width="220" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;b&gt;分片 shard（存储层）&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="256" y="740" width="620" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;张量并行 TP（计算层）&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="876" y="740" width="700" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;切什么&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="782" width="220" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;张量之间的边界（整块搬）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="782" width="620" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;张量内部的某一维（按行/列切）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="876" y="782" width="700" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;谁决定&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="824" width="220" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;保存模型的人（max_shard_size）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="824" width="620" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;推理/训练时的 TP 配置（tp_size=4）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="876" y="824" width="700" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;影响计算吗&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="866" width="220" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;不影响，模型完全一样&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="866" width="620" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;影响：每卡只算一部分，最后通信汇总&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="876" y="866" width="700" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;权重文件里能看到吗&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="908" width="220" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;能看到：多个 .safetensors 文件 + index.json&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="908" width="620" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;看不到：文件还是完整的，加载时才切&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="876" y="908" width="700" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;典型数字&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="950" width="220" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;7B fp16 → 4 片 × 3.4 GB&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="950" width="620" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:11px&quot;&gt;7B 在 4 卡 TP=4 → 每卡约 3.4 GB&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="876" y="950" width="700" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;代码锚点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;按 index.json 分文件迭代权重：vllm/model_executor/model_loader/weight_utils.py:866（safetensors_weights_iterator，内部用 safe_open 逐张量取）&lt;br&gt;分片感知的上层：vllm/model_executor/model_loader/default_loader.py（决定读哪些文件、什么顺序、是否多进程）&lt;br&gt;TP 的切分发生在层内：vllm/model_executor/layers/linear.py:430（ColumnParallelLinear，按输出维切）/ :1623（RowParallelLinear，按输入维切后 all-reduce）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1032" width="1628" height="96" as="geometry"/>
