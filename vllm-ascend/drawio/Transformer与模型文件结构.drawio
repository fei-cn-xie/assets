        <mxCell id="t163" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;本页所有数字都是整数（矩阵乘的结果，代码算出来的，可直接核对）。真实模型里 X/H 是浮点，W 是小浮点。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="1200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="t164" value="&lt;b&gt;第二步：现代模型不是「一上一下」，而是「两上一下」（SwiGLU）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="450" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n165" value="&lt;b&gt;X（5×4）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;每个 token 一个向量&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="36" y="516" width="300" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n166" value="&lt;b&gt;gate 分支：W_gate（4×8）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;拉宽后过 SiLU（一种平滑的开关）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="376" y="516" width="380" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n167" value="&lt;b&gt;up 分支：W_up（4×8）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;只是拉宽，不过激活&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="376" y="610" width="380" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n168" value="&lt;b&gt;逐元素相乘&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;gate ⊙ up → 5×8&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="796" y="562" width="340" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n169" value="&lt;b&gt;down：W_down（8×4）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;压回 5×4&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1176" y="562" width="300" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="e170" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n165" target="n166">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e171" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n165" target="n167">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e172" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n166" target="n168">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e173" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n167" target="n168">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e174" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n168" target="n169">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="n175" value="&lt;b&gt;为什么要 gate（这个「开关」在干嘛）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SiLU(v) = v · sigmoid(v)：&lt;b&gt;正数基本原样通过，负数被压到接近 0&lt;/b&gt;——相当于「按内容决定放行多少」。&lt;br&gt;然后与 up 分支逐元素相乘，等于「用 gate 当阀门，去调节 up 的信号」。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;实践上比单路的 ReLU 效果更好，代价是多一个矩阵。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="700" width="810" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="n176" value="&lt;b&gt;参数量对比（为什么 FFN 是大头）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;单路（老式）：W₁(4×8) + W₂(8×4) = 64 个参数。SwiGLU（现代）：W_gate + W_up + W_down = 32+32+32 = 96 个。&lt;br&gt;真实 Llama-7B：FFN 大约 &lt;b&gt;4096×11008×3 ≈ 1.35 亿&lt;/b&gt;参数/层，而注意力只有 4096×4096×4 ≈ 6700 万——&lt;b&gt;FFN 是注意力的两倍&lt;/b&gt;。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;所以权重文件里 mlp.* 的张量加起来，比 self_attn.* 大得多（⑱ 会看到形状）。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="866" y="700" width="798" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="n177" value="&lt;b&gt;代码锚点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;FFN 本体：vllm/model_executor/models/llama.py:82（class LlamaMLP）&lt;br&gt;gate 与 up 被合并成一个矩阵乘：同文件 :95（self.gate_up_proj = MergedColumnParallelLinear(...)）——两个 4×8 拼成 4×16，一次算完再切开&lt;br&gt;下投影：:103（self.down_proj = RowParallelLinear(...)）&lt;br&gt;SiLU 与「逐元素相乘」的融合实现：vllm/model_executor/layers/activation.py:116（class SiluAndMul —— 名字就说明了：先 silu 再 mul）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="830" width="1628" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="t178" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="962" width="104" height="20" as="geometry"/>
        </mxCell>
