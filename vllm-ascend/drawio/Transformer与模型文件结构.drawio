          <mxGeometry x="36" y="1048" width="260" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n84" value="&lt;font style=&quot;font-size:11px&quot;&gt;≈ 65.9 亿 → 四舍五入叫 &lt;b&gt;「7B」&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="1048" width="700" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n85" value="&lt;font style=&quot;font-size:11px&quot;&gt;≈ 6.6 B&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="996" y="1048" width="180" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n86" value="&lt;b&gt;为什么这个手算值得做&lt;/b&gt;&lt;br&gt;① 你能预测权重文件的&lt;b&gt;总大小&lt;/b&gt;：6.6 B × 2 字节（fp16）≈ 13.2 GB，正好对上下载到的 13~14 GB。&lt;br&gt;② 你能预测&lt;b&gt;显存占用&lt;/b&gt;：权重 13 GB + KV cache（随并发/上下文增长）+ 激活值。&lt;br&gt;③ 你能判断一个模型「是不是真的那么大」——市面上虚标的模型，用 config 一算就露馅。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;注意：算出来的是&lt;b&gt;参数个数&lt;/b&gt;，不是字节数；字节数还要乘精度（⑯⑳）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1122" width="1628" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="n87" value="&lt;b&gt;代码锚点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;config 的解析入口：vllm/transformers_utils/config.py（get_config）&lt;br&gt;vLLM 自己读这些字段的地方：vllm/model_executor/models/llama.py:347（LlamaModel.__init__ 里 config.hidden_size / num_hidden_layers / num_attention_heads 等）&lt;br&gt;线性层的维度就是这么来的：:165（qkv_proj 用 head 数与 head_dim 推出总输出维）、:95（gate_up_proj 用 intermediate_size）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1264" width="1628" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="t88" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1396" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n89" value="数据 / 激活" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="148" y="1393" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n90" value="权重 / 参数" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="276" y="1393" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n91" value="结果 / 新张量" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="404" y="1393" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n92" value="计算动作" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="532" y="1393" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n93" value="说明 / 结构" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="660" y="1393" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n94" value="易错点" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="788" y="1393" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e95" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1442" as="sourcePoint"/>
            <mxPoint x="204" y="1442" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t96" value="数据流向 / 计算顺序" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1430" width="220" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e97" value="" style="endArrow=open;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="448" y="1442" as="sourcePoint"/>
            <mxPoint x="504" y="1442" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t98" value="虚线 = 形状/对照关系，不是数据" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="510" y="1430" width="300" height="24" as="geometry"/>
