        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑫ 前馈网络 FFN：升维 2.75 倍再压回来（参数最多的那一块）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1620" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="注意力负责「token 之间交换信息」，FFN 负责「每个 token 自己深加工」。它先把每个 token 的向量拉宽，过一道非线性，再压回原宽度。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1620" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;形状：5×4 → 5×8 → 5×4（真实：5×4096 → 5×11008 → 5×4096）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;中间那一层叫「上投影」（up / gate），把 4 维拉到 8 维；最后叫「下投影」（down），再压回 4 维。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;Llama-7B：d_model=4096、ffn=11008（≈2.7 倍，不是 4 倍）；很多模型用 4 倍，具体值看 config.json 的 intermediate_size（⑮）。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="1628" height="59" as="geometry"/>
