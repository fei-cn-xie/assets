        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;因为&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
