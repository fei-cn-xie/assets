        <mxCell id="n40" value="权重 / 参数" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="276" y="1343" width="120" height="26" as="geometry"/>
