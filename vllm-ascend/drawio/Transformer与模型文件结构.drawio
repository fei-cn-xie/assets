          <mxGeometry x="204" y="278" width="40" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="-0.47" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="246" y="278" width="40" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="t26" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;id 12841&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="44" y="150" width="70" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="t27" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;id 3027&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="44" y="182" width="70" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;id 882&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="44" y="214" width="70" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="t29" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;id 6132&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="44" y="246" width="70" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="t30" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;…&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="44" y="278" width="70" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;这张表是「训练出来的参数」&lt;/b&gt;&lt;br&gt;一开始全是随机小数；训练就是不断微调它们，直到「语义相近的词，向量也相近」。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;表里的数字是小数（真实是高精度浮点），不像 ② 的 id 是整数&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="328" width="620" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="t32" value="&lt;b&gt;第二步：id 12841 就是「取第 12841 行」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="116" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;nn.Embedding(32000, 4096) 的 forward 只有一句话：&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;output = weight[input_ids]　　# 按行号取行，没有任何乘法&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#c0392b&quot;&gt;所以它没有矩阵乘的计算量，却占 32000×4096×2 字节 ≈ 250 MB 显存（fp16）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="720" y="150" width="944" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;为什么用「查表」而不是「乘矩阵」&lt;/b&gt;&lt;br&gt;如果一定要写成乘法：&lt;font style=&quot;font-size:9px&quot;&gt;one_hot(id) · E&lt;/font&gt; —— 也就是「一个只有一个 1 的向量」去乘 E。而 &lt;font style=&quot;font-size:9px&quot;&gt;one_hot(12841)&lt;/font&gt; 乘 E 的结果，正是 E 的第 12841 行。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;查表 = 这个乘法的特例；工程上直接按行索引，省掉 32000 次无用乘法。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="720" y="266" width="944" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;b&gt;5 个 token 的结果&lt;/b&gt;：把取出来的 5 行摞起来，得到 &lt;b&gt;5×4&lt;/b&gt; 的矩阵——这就是整个 Transformer 的输入张量（真实 5×4096）。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;行 = token 位置，列 = 特征维（d_model）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="720" y="406" width="944" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="t36" value="&lt;b&gt;一个省显存的小技巧：嵌入矩阵和输出头共用同一张表&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="516" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;b&gt;输入侧：Embedding&lt;/b&gt;&lt;br&gt;32000×4096 → 取一行得到 4096 维&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;id → 向量&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="550" width="780" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;b&gt;输出侧：LM Head&lt;/b&gt;&lt;br&gt;4096×32000 → 得到每个词的分数&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;向量 → 32000 个分数&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="876" y="550" width="788" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;b&gt;它们互为转置，可以共享同一份权重（tied embeddings）&lt;/b&gt;&lt;br&gt;省下 250 MB 显存；很多模型（Llama 系）就是这么干的。是否共享写在 config.json 的 &lt;font style=&quot;font-size:9px&quot;&gt;tie_word_embeddings&lt;/font&gt; 里（⑮）。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="702" width="1628" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="e40" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="426" y="670" as="sourcePoint"/>
            <mxPoint x="426" y="702" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e41" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1270" y="670" as="sourcePoint"/>
            <mxPoint x="1270" y="702" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n42" value="&lt;b&gt;代码锚点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;词嵌入层：vllm/model_executor/layers/vocab_parallel_embedding.py:205（class VocabParallelEmbedding；forward 就是按 id 取行，再按 TP 切分到各卡）&lt;br&gt;输出头：同文件 :569（class ParallelLMHead）——它继承自词嵌入层，因为「用 E 打分」和「用 E 查表」数学上是同一个矩阵的两种用法&lt;br&gt;装配处：vllm/model_executor/models/llama.py:382（embed_tokens）、:503（lm_head）、:510（tie_weights 共享权重）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="834" width="1628" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="&lt;b&gt;这一页要记住的&lt;/b&gt;：id 是整数、向量是小数；「变成向量」= 查表 = 按行号取值，&lt;b&gt;没有矩阵乘法&lt;/b&gt;；得到的 5×d 矩阵才是后面所有矩阵运算的起点。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="964" width="1628" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="t44" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1068" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="数据 / 激活" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="148" y="1065" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="权重 / 参数" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="276" y="1065" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="结果 / 新张量" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="404" y="1065" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="计算动作" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="532" y="1065" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="说明 / 结构" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="660" y="1065" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="易错点" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="788" y="1065" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e51" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1114" as="sourcePoint"/>
            <mxPoint x="204" y="1114" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t52" value="数据流向 / 计算顺序" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1102" width="220" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e53" value="" style="endArrow=open;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="448" y="1114" as="sourcePoint"/>
            <mxPoint x="504" y="1114" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t54" value="虚线 = 形状/对照关系，不是数据" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="510" y="1102" width="300" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg3" name="④ 位置编码 RoPE">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1704" pageHeight="1046" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="④ 位置编码（RoPE）：给每个 token 打上「我在第几位」" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1620" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="注意力天生「看不见顺序」——把 5 个 token 打乱，算出来的分数集合不变。RoPE 用「按位置旋转向量」的办法把顺序编码进去。动手算一遍就懂。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1620" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：先看清问题——注意力是「无序」的&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;注意力只算「token 之间的相似度」&lt;/b&gt;&lt;br&gt;把「我 爱 吃 苹果」里的「我」和「苹果」对调，两两相似度的&lt;b&gt;集合&lt;/b&gt;完全一样——模型分不出谁先谁后。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;所以必须额外把位置信息「掺」进向量里，而不是指望注意力自己发现&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="800" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;掺法有历史演进&lt;/b&gt;&lt;br&gt;① 绝对位置：第 0 位加向量 p0、第 1 位加 p1…（简单，但长文本外推差）&lt;br&gt;② &lt;b&gt;RoPE（现在主流）&lt;/b&gt;：不加法，而是&lt;b&gt;按位置旋转&lt;/b&gt; Q/K 向量&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;Llama / Qwen / 绝大多数开源模型都用 ②&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="866" y="150" width="798" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;b&gt;第二步：RoPE 的核心动作——把向量两两配对，各旋转一个角度&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="276" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;一个 6 维向量分成 3 对&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(x₀,x₁) &amp;nbsp;(x₂,x₃) &amp;nbsp;(x₄,x₅)&lt;/font&gt;&lt;br&gt;每一对用&lt;b&gt;同一个角度 θ&lt;/b&gt; 旋转；不同对用不同频率（第 i 对的角度是 θᵢ × 位置）。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;所以「改位置」=「换一个旋转角度」，非常连续、非常好外推&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="310" width="420" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;一对坐标的旋转（这就是全部数学）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;x' = x·cosθ − y·sinθ&lt;br&gt;y' = x·sinθ + y·cosθ&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;写成矩阵就是那个 2×2 旋转块——&lt;b&gt;它只作用在一对坐标上，不是用来教矩阵乘的&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="486" y="310" width="520" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;配对&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1036" y="306" width="110" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;旋转前 (x,y)&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1146" y="306" width="170" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;角度 θ&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1316" y="306" width="90" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;旋转后 (x',y')&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1406" y="306" width="170" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;第 1 对&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1036" y="344" width="110" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;(0.80, 0.60)&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1146" y="344" width="170" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;0°&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1316" y="344" width="90" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;(0.80, 0.60)&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1406" y="344" width="170" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;第 2 对&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1036" y="382" width="110" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;(0.60, -0.80)&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1146" y="382" width="170" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;37°&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1316" y="382" width="90" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;(0.96, 0.20)&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1406" y="382" width="170" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;第 3 对&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1036" y="420" width="110" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;(-0.28, 0.96)&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1146" y="420" width="170" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;90°&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1316" y="420" width="90" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;(-0.96, -0.28)&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1406" y="420" width="170" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="t25" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;cos37°≈0.80、sin37°≈0.60：正好是 3-4-5 勾股比，所以这里能写成 0.8/0.6 这种好算的数；真实模型的角度是查表得到的浮点（cos/sin 表，d/2 个频率）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1036" y="462" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="t26" value="&lt;b&gt;第三步：为什么只旋转 Q 和 K，不旋转 V&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="496" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;因为位置只影响「谁该注意谁」&lt;/b&gt;&lt;br&gt;注意力分数 = Q·Kᵀ。把 Q、K 各自旋转 θᵢ、θⱼ 后，它们的内积只取决于&lt;b&gt;角度差 (θᵢ−θⱼ)&lt;/b&gt;——也就是&lt;b&gt;相对距离&lt;/b&gt;。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;这就是 RoPE 的精髓：绝对位置进入，相对距离出来&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="530" width="520" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;b&gt;V 只负责「搬内容」&lt;/b&gt;&lt;br&gt;V 是被加权求和的内容，它不需要知道自己的位置；旋转 V 只会白白改变输出向量的方向。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;所以实现里只对 q、k 调用 rotary_emb（见锚点）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="586" y="530" width="520" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;b&gt;长文本外推：改的是「频率表」&lt;/b&gt;&lt;br&gt;θᵢ = 1 / (10000^(2i/d))（Llama 的 rope_theta=10000）。想支持更长上下文，就把这个底数调大（如 500000）或对角度做缩放。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;config.json 里的 rope_theta / rope_scaling 就是这个（⑮）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1136" y="530" width="528" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;b&gt;代码锚点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;构建旋转表：vllm/model_executor/models/llama.py:236（_init_rotary_emb）→ :243（self.rotary_emb = get_rope(...)）&lt;br&gt;真正施加旋转：同文件 :231（q, k = self.rotary_emb(positions, q, k)）——注意只传了 q、k，没有 v&lt;br&gt;实现细节（cos/sin 表怎么按位置切片）：vllm/model_executor/layers/fused_qk_norm_rope.py 与各 attention backend 的 rope 实现&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="706" width="1628" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;这一页要记住的&lt;/b&gt;：位置信息不是「加一个向量」，而是「按位置旋转 Q/K」；旋转后 Q·Kᵀ 只依赖角度差 → 相对距离；V 不旋转。矩阵上你只会看到 2×2 的旋转块，这是它作用的单位，不是教学用的矩阵乘。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="840" width="1628" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="t32" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="948" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="数据 / 激活" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="148" y="945" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="权重 / 参数" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="276" y="945" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="结果 / 新张量" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="404" y="945" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="计算动作" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="532" y="945" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="说明 / 结构" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="660" y="945" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="易错点" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="788" y="945" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e39" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="994" as="sourcePoint"/>
