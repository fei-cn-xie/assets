        <mxCell id="t25" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;通信：消息队列 RPC（collective_rpc → 广播队列）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
