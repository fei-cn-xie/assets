  <diagram id="pg3" name="④ EngineCore 内部">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1256" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="④ EngineCore 进程内部：一个忙循环，两个 IO 线程" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="这是整条链路里最关键的一个进程：调度、决策、下发都在这里。看明白它内部的 4 个线程，就明白「为什么 vLLM 能一边算一边收请求」。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;主线程：busy loop（唯一碰 NPU 的线程）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;run_busy_loop：一直转，直到该退出&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;_process_input_queue()&lt;/b&gt;：把排队中的命令取出来执行（ADD / ABORT / WAKEUP / UTILITY）&lt;br&gt;② &lt;b&gt;_maybe_publish_request_counts()&lt;/b&gt;：把队列长度等统计发出去&lt;br&gt;③ &lt;b&gt;_process_engine_step()&lt;/b&gt;：&lt;b&gt;跑一步&lt;/b&gt;（调度 → 执行模型 → 收集输出）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;退出条件：处理到 shutdown 命令 → 返回 False → 抛 SystemExit&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="148" width="700" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;为什么是「忙循环」而不是「事件驱动」&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;推理是&lt;b&gt;连续不停地算&lt;/b&gt;：只要有请求在跑，每一步都不能等。&lt;br&gt;所以主线程不做任何可能阻塞的事——收包、发包、等待都被赶到了两个 IO 线程里。&lt;br&gt;&lt;br&gt;代价：主线程空转时会吃满一个核（这是设计取舍，不是 bug）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="796" y="148" width="664" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="t7" value="&lt;b&gt;两个 IO 线程：存在的唯一理由就是「别让主线程等」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="306" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;input 线程（daemon）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;从 DEALER socket 收 multipart 帧 → 首帧是命令类型字节（ADD / ABORT / UTILITY…）→ msgpack 解码 → &lt;b&gt;塞进 input_queue&lt;/b&gt; 就完事。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;主线程随后从 input_queue 里取。这样「网络收包」和「前向计算」并行。&lt;br&gt;启动期如果这个线程先死，主线程会直接报 Input socket thread died during startup。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="338" width="700" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;output 线程（daemon）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;从 output_queue 取 EngineCoreOutputs → msgpack 编码 → PUSH 给前端（或多 API server 时给对应客户端）。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;编码后会复用 bytearray，用 ZeroMQ 的 MessageTracker 回收，避免反复申请内存。&lt;br&gt;收到 ENGINE_CORE_DEAD 标记时：发完最后一帧就退出。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="338" width="664" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="t10" value="&lt;b&gt;第 4 个线程：worker 进程监控（真线程，不是 Task）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="506" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;MultiprocWorkerMonitor&lt;/b&gt;　&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;（mp 后端才有：uni 时没有子进程可监控）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;它阻塞在「等 worker 进程句柄」，一旦某个 worker 死了 → 调回调 → 往 input_queue 里塞一个 &lt;b&gt;EXECUTOR_FAILED&lt;/b&gt; 命令 → 主线程下一轮取到它就 &lt;b&gt;raise RuntimeError(&quot;Executor failed.&quot;)&lt;/b&gt; → 进程 cd 收尾并发 ENGINE_CORE_DEAD 给前端。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="538" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;b&gt;一张表收尾：EngineCore 进程里的线程清单&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="650" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;线程&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="682" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;干什么&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="336" y="682" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;为什么单独开&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="856" y="682" width="380" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;MainThread&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="718" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;busy loop：取命令 → 跑一步 → 收输出&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="718" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;唯一碰 NPU；一步不能停&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="856" y="718" width="380" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;input 线程（无显式名）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="754" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;收前端命令，解包后放 input_queue&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="754" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;让收包与计算重叠&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="856" y="754" width="380" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;output 线程（无显式名）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="790" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;取输出、编码、PUSH 给前端&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="790" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;让发包与计算重叠&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="856" y="790" width="380" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;MultiprocWorkerMonitor&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="826" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;监听 worker 进程句柄，死了塞 EXECUTOR_FAILED&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="826" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;不轮询内存，靠内核句柄&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="856" y="826" width="380" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;（LWD 才有）lwd-ctrl-io-*&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="862" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;LWD 控制面收发与唤醒&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="862" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;只在 PD 场景&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="856" y="862" width="380" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;busy loop 与三个子步骤：vllm/v1/engine/core.py:1465-1476、:1491-1520、:1522-1539&lt;br&gt;两个 IO 线程的创建与「为什么」的注释：core.py:1107-1134；收包循环 :1748-1849；发包循环 :1851-1909&lt;br&gt;worker 监控：vllm/v1/executor/multiproc_executor.py:300-333；回调注册 core.py:1042-1044；EXECUTOR_FAILED 处理 :1622-1623&lt;br&gt;LWD 线程：vllm/v1/lwd_control/lwd_comm/lwd_control_plane.py:282-287&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="938" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;EngineCore = 一个不能停的忙循环（主线程）+ 两个只负责收发的 IO 线程 + 一个盯 worker 死活的监控线程；&lt;b&gt;它自己不碰权重，也不分词&lt;/b&gt;，只做调度与下发。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
