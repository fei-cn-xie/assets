        <mxCell id="t1" value="⑨ 本仓 LWD 部署的真实进程树：194 起 3 个，195 起 18 个" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="以 assets/c_home/bash/pds/30rc_1124/dp2_tp1_194_195 为例（sidecar 形态的差异见页末）。这页就是「我实际 ps 出来会看到什么」。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;主机 194：边端（TP=1, DP=1 → 走 uni 后端）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="114" width="700" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;① 主进程 = API server（uvicorn + asyncio）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;listen :8510　·　DP=1 所以不另起 API 子进程&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="146" width="680" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;② EngineCore（同进程内跑 worker）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;进程名 EngineCore_DP0　·　TP×PP×DP=1 → uni，worker 不单起进程&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="76" y="252" width="600" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;③ ucx_daemon（host 数据面 daemon）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;进程标题 lwd_host_comm · 每主机 1 个 · 首个建链引擎按需拉起&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="76" y="364" width="600" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="spawn" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="按需" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1" source="n5" target="n6">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="t9" value="&lt;b&gt;合计 3 个进程&lt;/b&gt;（边端没有 Worker 进程，也没有 DP 协调进程）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="462" width="680" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t10" value="&lt;b&gt;主机 195：云端两实例（TP=1, DP=2 → 走 mp 后端）+ proxy&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="776" y="114" width="700" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;cloud0 = P（prefill）：8 个进程&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;listen :8600（2 个 API 子进程 SO_REUSEPORT）· coord :8100/:8101 · ctrl :6100/:6101 · data :7200/:7201 · kv :14570/:14571&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="776" y="146" width="684" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;主进程&lt;/b&gt;（launcher：算进程数、拉子进程、绑 coord HTTP、绑 DP 握手）&lt;br&gt;+ &lt;b&gt;API server 子进程 ×2&lt;/b&gt;（跟 DP 数走，抢 8600）&lt;br&gt;+ &lt;b&gt;EngineCore_DP0 / EngineCore_DP1&lt;/b&gt;（每个 DP 分片一个）&lt;br&gt;+ &lt;b&gt;VllmWorker-0 ×2&lt;/b&gt;（每个 EngineCore 里 1 个）&lt;br&gt;+ &lt;b&gt;VLLM_DP_Coordinator ×1&lt;/b&gt;（DP&amp;gt;1 才有）" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="812" y="242" width="612" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;cloud1 = D（decode）：同样 8 个进程&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;listen :8601 · coord :8110/:8111 · ctrl :6110/:6111 · data :7210/:7211 · kv :14580（只连不绑）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="776" y="382" width="684" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;PD proxy：1 个进程&lt;/b&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;　uvicorn :8102，扇出到 4 个 coord 端口；无 NPU、无 UCX、无模型&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="776" y="474" width="684" height="60" as="geometry"/>
