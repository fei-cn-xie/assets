        <mxCell id="t2" value="配置：prefill 实例 dp=2/tp=4（8 卡），decode 实例 dp=2/tp=4（8 卡），edge tp=1/dp=1（1 卡），外加 1 个 PD Proxy。&lt;b&gt;dense 模型在 PD 里每个 DP rank 是独立 EngineCore&lt;/b&gt;。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1600" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;① edge（1 卡，uni 后端 → worker 与引擎同进程）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="120" width="700" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;API server（asyncio 主线程）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;收请求、发 attempt 号、最后把 token 用 SSE 吐回去&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="460" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;LwdEdgeEngineCore&lt;/b&gt; + 同进程 LwdEdgeWorker&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;PD runtime（信封、bind、claim、tick）· lwd-edge-c2e 预收线程&lt;br&gt;单 worker：只做 UNEMBED(lm_head)，不跑整模型&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="76" y="256" width="420" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="t7" value="&lt;b&gt;edge 合计 3 个进程&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="368" width="460" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;② P 实例（dp=2 × tp=4 = 8 卡，12 个进程）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
