            <mxPoint x="36" y="505" as="sourcePoint"/>
            <mxPoint x="2406" y="505" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n48" value="&lt;b&gt;coord 线程校验 target_dp 属于本进程 → 投进该 DP 的命令队列&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;每个 DP 一个 coord_port，所以 dp=2 就要 2 个端口&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;lwd_cloud_control.py:615-634；cloud_http.py:41-85&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1238" y="533" width="364" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="&lt;b&gt;engine 被唤醒取命令 → register（校验 dp_idx / TTL / handoff 计划）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;它把请求按 max_tokens=1 注册成「只算 prompt」的一次执行&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;lwd_cloud_engine.py:865-891；cloud_runtime.py:138-273&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1238" y="594" width="364" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="e50" value="BIND：这个请求归我，绑定信息给你" style="endArrow=block;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
