          <mxGeometry x="876" y="732" width="480" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="&lt;b&gt;本仓的两个特例（读 LWD 代码时会遇到）&lt;/b&gt;&lt;br&gt;① &lt;b&gt;边端 world_size=1 → uni&lt;/b&gt;：所以边端「模型加载」其实发生在 EngineCore 进程里，ps 里看不到 Worker。&lt;br&gt;② &lt;b&gt;LWD host 数据面还会换掉 executor&lt;/b&gt;：&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;host 模式 + world_size==1 时用 LwdHostUniProcExecutor（vllm/config/vllm.py:1306-1316）&lt;/font&gt;——同样是「不开子进程」，但多了 host 数据面通道的初始化。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="806" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n53" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;world_size 与后端缺省：vllm/config/parallel.py:982-1024；uni 判定 :1026-1027&lt;br&gt;uni 实现：vllm/v1/executor/uniproc_executor.py:52-68&lt;br&gt;mp 实现：vllm/v1/executor/multiproc_executor.py:190-206（spawn）、:1088-1118（worker 循环）&lt;br&gt;LWD 特例：vllm/config/vllm.py:1306-1316&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="944" width="1424" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n54" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;worker 是不是独立进程，取决于 world_size 与后端——world_size=1 就同进程（uni），多卡默认同机多进程（mp），要跨机才用 ray；所以「进程数」这件事，一半由 TP/PP/DP 决定，一半由 executor 决定。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1066" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t55" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1158" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n56" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1155" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n57" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1155" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n58" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1155" width="120" height="26" as="geometry"/>
