        </mxCell>
        <mxCell id="n54" value="&lt;font style=&quot;font-size:11px&quot;&gt;/tmp/lwd-host-comm-&amp;lt;uid&amp;gt;.sock&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="954" width="250" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n55" value="&lt;font style=&quot;font-size:11px&quot;&gt;ucx_daemon（AF_UNIX）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="954" width="380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n56" value="&lt;font style=&quot;font-size:11px&quot;&gt;各引擎进程&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="666" y="954" width="180" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n57" value="&lt;font style=&quot;font-size:11px&quot;&gt;daemon 控制面（ATTACH / 传 fd）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="846" y="954" width="400" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n58" value="&lt;b&gt;与 sidecar 形态的差别（同一台机器、同样的卡）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;sidecar 包是 TP=2 / DP=1：&lt;b&gt;没有 API 子进程&lt;/b&gt;（DP=1 → 主进程自己当 API server）、&lt;b&gt;没有 DP 协调进程&lt;/b&gt;、&lt;b&gt;没有 296xx 握手端口&lt;/b&gt;，worker 变成 2 个（TP=2）。所以云端每个实例只有 &lt;b&gt;4 个进程&lt;/b&gt;，195 上合计 ≈ 10。&lt;br&gt;另外两个「会多/会少一个进程」的开关：① 开 &lt;b&gt;EPLB&lt;/b&gt; 时每个 worker 里会多一个 planner 子进程；② vllm-ascend 把 worker 的 daemon 标志改成了 &lt;b&gt;False&lt;/b&gt;（为了让 worker 能再拉子进程），代价是父进程崩了 worker 不会自动被回收，残留必须靠 terminate/kill 链清。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1026" width="1424" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="n59" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;入口脚本与顺序：assets/c_home/bash/pds/30rc_1124/dp2_tp1_194_195/cloud_p.sh:29-43、cloud_d.sh:24-39、start_proxy.sh:13-16、edge.sh:23-34&lt;br&gt;API server 进程管理：vllm/v1/utils.py:167-224（APIServerProcessManager）&lt;br&gt;EngineCore / 协调进程：vllm/v1/engine/utils.py:1178-1210、:1279-1291&lt;br&gt;daemon 的 spawn 与去重：vllm/v1/lwd_comm/data_comm/ucx_port.py:173-242；空闲 30s 自退 ucx_daemon.py:67,389-399&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1178" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n60" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;本仓这套部署，边端 3 个进程、云端每个实例 8 个、proxy 与 daemon 各 1 个；&lt;b&gt;进程数最多的机器是云端&lt;/b&gt;，而「最容易卡住不 ready 的」却是边端——因为它要逐条等 4 条链路。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1306" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t61" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1398" width="104" height="20" as="geometry"/>
        </mxCell>
