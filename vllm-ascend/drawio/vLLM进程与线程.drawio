<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" pages="16">
  <diagram id="pg0" name="① 进程线程全景">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1676" pageHeight="1152" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="① 全景：一个 `vllm serve` 里，进程和线程是怎么分层的" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1600" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：&lt;b&gt;进程边界&lt;/b&gt;由「谁能碰 NPU」决定，&lt;b&gt;线程边界&lt;/b&gt;由「谁不能阻塞主循环」决定。看懂这两条，后面所有页都是在填细节。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1600" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;进程层：父子关系（谁 spawn 了谁）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="138" width="760" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;主进程 = API server / frontend&lt;/b&gt;　&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm serve 敲下去后第一个活下来的进程&lt;/font&gt;&lt;br&gt;它对外提供 HTTP（OpenAI 兼容接口）和 SSE 流式输出；&lt;b&gt;分词/反分词都在这个进程里&lt;/b&gt;，不在引擎里。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;过程：uvicorn 起服 → 构造 AsyncLLM → 构造时就把 EngineCore 拉起来&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="170" width="760" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;EngineCore 进程 ×（每个 DP 分片一个）&lt;/b&gt;&lt;br&gt;它才是「引擎」：跑调度器 + 主忙循环，是&lt;b&gt;唯一允许碰 NPU 的 EngineCore 侧进程&lt;/b&gt;。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;进程名 EngineCore / EngineCore_DP0…　·　与前端之间是 ZMQ 通道&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="96" y="296" width="700" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;worker 进程 ×（TP×PP 个）……或者根本没有&lt;/b&gt;&lt;br&gt;真正跑模型前向的进程。&lt;b&gt;TP×PP×DP==1 时不起新进程&lt;/b&gt;（uni 后端，worker 与 EngineCore 同进程）。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;进程名 VllmWorker-N　·　与 EngineCore 之间是消息队列 RPC&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="156" y="430" width="640" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;（可选）外部进程&lt;/b&gt;：DP 协调进程 / LWD 的 ucx_daemon / PD proxy&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;它们不参与前向，但会影响「进程总数」和「端口表」——见 ② 和 ⑨&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="156" y="564" width="640" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="构造 AsyncLLM 时 spawn" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" value="executor 决定要不要另起" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n5" target="n6">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=open;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#d6b656;fontColor=#333333;" edge="1" parent="1" source="n6" target="n7">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;线程层：每个进程内部都在忙什么&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="856" y="138" width="760" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;frontend：1 条 asyncio 事件循环承所有 HTTP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;主线程跑 uvicorn + FastAPI：每个请求都是这条 loop 上的一个协程&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;output_handler（一个 Task）：唯一「输出泵」，取引擎输出 → 反分词 → 推给请求&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;EngineCoreOutputQueueTask（一个 Task）：从 PULL socket 收引擎输出&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;MPClientEngineMonitor（真线程）：阻塞等 EngineCore 进程句柄，死了立刻知道&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;renderer 线程池（真线程）：把阻塞的分词/模板渲染甩出去，别卡 loop&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="856" y="170" width="764" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;EngineCore：1 个忙循环 + 2 个 IO 线程 + 1 个监控&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;主线程 busy loop：取命令 → 跑一步 → 收集输出（唯一碰 NPU 的线程）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;input 线程：收前端发来的 ADD/ABORT（ZMQ DEALER）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;output 线程：把引擎输出推回前端（ZMQ PUSH）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;MultiprocWorkerMonitor（真线程）：监听 worker 进程句柄&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;为什么拆 IO 线程：让「ZMQ 收发/序列化」和「NPU 前向」重叠，互不等待&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="856" y="330" width="764" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;worker：一条阻塞的 RPC 循环&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;主线程 worker_busy_loop：逐条执行 EngineCore 下发的 RPC（含 execute_model）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;ModelRunner 自己没有线程——它就是这条主线程里被调用的对象&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;torch 线程池被压到 1：避免多进程抢 CPU 自旋&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;KV connector 的后台线程（如 Mooncake 的发送/接收线程 + 32 线程池）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;通信库（HCCL/NCCL）自己的 C++ 线程：Python 侧看不到&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="856" y="500" width="764" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;两条边界，记住就不会混&lt;/b&gt;&lt;br&gt;① &lt;b&gt;进程边界 = 谁能碰 NPU&lt;/b&gt;：worker 进程才是真正调模型的；EngineCore 是调度 + 下发；frontend 只管 HTTP 和分词。所以「模型加载」发生在 worker（或 uni 时的 EngineCore），前端永远看不到权重。&lt;br&gt;② &lt;b&gt;线程边界 = 谁不能阻塞&lt;/b&gt;：前端主线程是 asyncio loop（一个阻塞调用就能卡住全站），EngineCore 主线程是忙循环（一步都不能停），所以阻塞活儿全被赶到别的线程/别的进程。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="700" width="1600" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;进程树：vllm/v1/engine/utils.py:238-244（Process 名 EngineCore/EngineCore_DPn）、vllm/config/parallel.py:982-1027（world_size 与 uni/mp 判定）&lt;br&gt;前端线程：vllm/entrypoints/launchers/launcher.py:100-111（uvicorn loop）、vllm/v1/engine/async_llm.py:841-908（output_handler）、vllm/v1/engine/core_client.py:774-801（进程监控线程）&lt;br&gt;EngineCore 线程：vllm/v1/engine/core.py:1107-1134（两个 IO 线程及注释）、:1465-1476（busy loop）&lt;br&gt;worker：vllm/v1/executor/multiproc_executor.py:1088-1118（worker_busy_loop）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="826" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;一个实例通常长这样——1 个前端进程（1 条 loop + 若干 Task + 1 个监控线程）→ N 个 EngineCore 进程（各 1 忙循环 + 2 IO 线程）→ M 个 worker 进程（各 1 条 RPC 循环 + 若干后台线程）；&lt;b&gt;其中 M 可以为 0（uni 后端，边端就是这样）&lt;/b&gt;。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="962" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1054" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1051" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1051" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1051" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1051" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1051" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1051" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1051" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="数据面/旁路进程" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1051" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e27" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1100" as="sourcePoint"/>
            <mxPoint x="204" y="1100" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t28" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1088" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e29" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1100" as="sourcePoint"/>
            <mxPoint x="454" y="1100" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t30" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1088" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e31" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1100" as="sourcePoint"/>
            <mxPoint x="704" y="1100" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t32" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1088" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg1" name="② 进程数怎么算">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1226" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="② 进程个数怎么算：参数 → 进程树的一步步推导" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：进程数不是玄学，是四个数的加法——API server 个数（跟 DP 走）+ EngineCore 个数（跟 DP 走）+ worker 个数（跟 TP×PP 走）+ 若干「因为并行才多出来」的进程。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：四个加法项（每一项都由一个具体参数决定）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="148" width="340" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;①　API server 进程&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="156" width="320" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;由 &lt;b&gt;--api-server-count&lt;/b&gt; 决定；不显式给时，内部负载均衡模式下&lt;b&gt;默认 = data_parallel_size&lt;/b&gt;。&lt;br&gt;&lt;br&gt;&amp;gt;1 时走多 API server：主进程只当「工头」，另外 fork 出 N 个子进程，用 SO_REUSEPORT 抢同一个端口。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="182" width="320" height="154" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="398" y="148" width="340" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;②　EngineCore 进程&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="408" y="156" width="320" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;由 &lt;b&gt;--data-parallel-size&lt;/b&gt; 决定：本机每个 DP 分片一个 EngineCore，进程名形如 &lt;font style=&quot;font-size:9px&quot;&gt;EngineCore_DP0&lt;/font&gt;。&lt;br&gt;&lt;br&gt;它才是「引擎」：跑调度 + 忙循环，前端通过 ZMQ 和它说话。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="408" y="182" width="320" height="154" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="760" y="148" width="340" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;③　worker 进程&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="156" width="320" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;由 &lt;b&gt;TP × PP&lt;/b&gt;（以及是否 DP&amp;gt;1）决定：&lt;br&gt;· TP×PP×DP == 1 → &lt;b&gt;uni 后端，worker 不另起进程&lt;/b&gt;（与 EngineCore 同进程）&lt;br&gt;· 否则 → mp 后端，每 rank 一个 &lt;font style=&quot;font-size:9px&quot;&gt;VllmWorker-N&lt;/font&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="770" y="182" width="320" height="154" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1122" y="148" width="340" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;b&gt;④　因为并行才多出来的&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1132" y="156" width="320" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;+ &lt;b&gt;DP 协调进程&lt;/b&gt;（DP&amp;gt;1 且 rank0 时才有，负责把请求分给各 DP）&lt;br&gt;+ &lt;b&gt;sidecar/daemon 进程&lt;/b&gt;（LWD host 数据面，每主机最多 1 个，先连后拉、flock 去重）&lt;br&gt;+ &lt;b&gt;proxy 进程&lt;/b&gt;（PD 场景的入口，与引擎无关）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1132" y="182" width="320" height="154" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;b&gt;第二步：把这四个数代进本仓四种真实形态（可直接对照 ps）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
