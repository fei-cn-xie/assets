  <diagram id="pg12" name="⑬ dp2tp4 拓扑">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1676" pageHeight="1668" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
