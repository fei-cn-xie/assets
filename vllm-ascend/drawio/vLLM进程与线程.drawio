            <mxPoint x="36" y="174" as="sourcePoint"/>
            <mxPoint x="2258" y="174" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n36" value="&lt;b&gt;先查运行库：缺 libucp.so.0 直接 exit 3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;预检放在最前，是为了避免「起了一半才报错」&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;env.sh:91-110&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="44" y="202" width="414" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;b&gt;exec 接管：把 shell 替换成 python 进程&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;所以 Ctrl-C 打在进程组上，vLLM 自己收尾（脚本里没有 pkill）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;env.sh:112-141&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="44" y="263" width="414" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;b&gt;算出这次要起几个进程&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;api_server_count 默认 = DP；EngineCore = DP；worker = TP×PP（world_size=1 时 0）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/entrypoints/cli/serve.py:118-135&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="492" y="324" width="414" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;font color=&quot;#999999&quot;&gt;② 拉子进程（顺序有讲究：先绑 listener，再拉引擎）&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;fillColor=#e7e0d4;strokeColor=#b3a89c;" vertex="1" parent="1">
          <mxGeometry x="36" y="391" width="2222" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="e40" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="36" y="385" as="sourcePoint"/>
            <mxPoint x="2258" y="385" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n41" value="&lt;b&gt;先在本进程里绑 coord HTTP listener（线程，不是进程）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;云端会打印 cloud control HTTP ready on 0.0.0.0 ports=[8100, 8101]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;lwd_cloud_control.py:639-659&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="492" y="413" width="414" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="&lt;b&gt;DP&amp;gt;1：fork 出 N 个 API server 子进程，SO_REUSEPORT 抢同一端口&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;DP=1 时没有这一步：主进程自己就是 API server&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/entrypoints/cli/serve.py:156-161, 309&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="940" y="474" width="414" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="&lt;b&gt;spawn EngineCore_DP0 … DPn-1（每分片一个进程）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vllm/v1/engine/utils.py:1279-1291&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="492" y="535" width="414" height="39" as="geometry"/>
        </mxCell>
        <mxCell id="e44" value="handshake：ROUTER bind 好，等你连" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="699" y="601" as="sourcePoint"/>
            <mxPoint x="1595" y="601" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e45" value="HELLO（我是 dp_rank=n）" style="endArrow=block;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1595" y="647" as="sourcePoint"/>
            <mxPoint x="699" y="647" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e46" value="地址表（input/output/DP 协调各自在哪）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;EngineHandshakeMetadata&lt;/font&gt;" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="699" y="693" as="sourcePoint"/>
            <mxPoint x="1595" y="693" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n47" value="&lt;font color=&quot;#999999&quot;&gt;③ 引擎握手完成 → 起 worker → 加载模型 → 分配 KV&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;fillColor=#e7e0d4;strokeColor=#b3a89c;" vertex="1" parent="1">
          <mxGeometry x="36" y="728" width="2222" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="e48" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="36" y="722" as="sourcePoint"/>
            <mxPoint x="2258" y="722" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e49" value="READY（握手完成）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;超时 5 分钟；失败则实例起不来&lt;/font&gt;" style="endArrow=block;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1595" y="767" as="sourcePoint"/>
            <mxPoint x="699" y="767" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n50" value="&lt;b&gt;mp 后端：spawn VllmWorker-0…N&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;uni 后端：这一步不存在，worker 就在本进程内&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;multiproc_executor.py:190-206&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1388" y="796" width="414" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="&lt;b&gt;init_device → 加载权重 → 注册 KV 显存&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;权重只加载到 worker（uni 时是 EngineCore）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;gpu_worker.py · model_runner_v1.py:4684&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1836" y="796" width="414" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="worker 回 RPC 后，EngineCore 才认为「模型可用」；此期间前端已经在听端口，但请求会排队" style="shape=note;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;size=11;fillColor=#efe9dd;strokeColor=#a1887f;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1388" y="857" width="862" height="27" as="geometry"/>
        </mxCell>
        <mxCell id="n53" value="&lt;font color=&quot;#999999&quot;&gt;④ 就绪与开服（云端 vs 边端差别最大的一段）&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;fillColor=#e7e0d4;strokeColor=#b3a89c;" vertex="1" parent="1">
          <mxGeometry x="36" y="900" width="2222" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="e54" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="36" y="894" as="sourcePoint"/>
            <mxPoint x="2258" y="894" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n55" value="&lt;b&gt;uvicorn 开始接请求（此时集群可能还没全好）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;所以「服务能连上」≠「整条 PD 链路可用」&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;launcher.py:100-111&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="940" y="922" width="414" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="n56" value="&lt;b&gt;云端：报「listener ready，异步等 edge」就结束&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;云端不阻塞，所以启动很快；日志里是 waiting for N edge link(s) asynchronously&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;lwd_host_channels.py:364-374&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="492" y="983" width="414" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="n57" value="&lt;b&gt;边端：逐条等链路 ready，605 秒/条 × 4 条&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;最坏 ~40 分钟；失败日志 [LWD][handshake] host link not ready&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;host/ucx_io.py:63；lwd_host_channels.py:391-419&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="492" y="1044" width="414" height="51" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg6" name="⑦ 死亡检测">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1328" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑦ 进程生命周期与死亡检测：四条独立路径" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：进程死了**不靠超时轮询**去发现，而是靠四条「谁盯着谁」的独立机制；看清这四条，就知道为什么有时报 EngineDeadError、有时却只是「请求永远不返回」。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;四条路径：每条由一个「盯着谁」的角色负责&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="114" width="1000" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;路径&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="146" width="150" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;谁在盯&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="186" y="146" width="300" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;怎么发现&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="486" y="146" width="560" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;特点&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1046" y="146" width="240" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;锚点&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1286" y="146" width="200" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;font style=&quot;font-size:11px&quot;&gt;① 协议帧&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="198" width="150" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;font style=&quot;font-size:11px&quot;&gt;EngineCore 自己&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="186" y="198" width="300" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:11px&quot;&gt;捕获到异常 → 往输出队列塞一帧 ENGINE_CORE_DEAD → 前端读到即抛 EngineDeadError&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="486" y="198" width="560" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;有报错、能立刻知道&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1046" y="198" width="240" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;core.py:1426-1432, 1692-1699&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1286" y="198" width="200" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;② 进程句柄&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="250" width="150" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;前端 MPClientEngineMonitor 线程&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="186" y="250" width="300" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;阻塞等 EngineCore 进程句柄（sentinel）→ 返回即认为死了，置 engine_dead&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="486" y="250" width="560" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;被 OOM/kill -9 时这是唯一信号&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1046" y="250" width="240" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;core_client.py:774-801&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1286" y="250" width="200" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;③ worker 回调&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="302" width="150" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;EngineCore 的 MultiprocWorkerMonitor 线程&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="186" y="302" width="300" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;worker 死了 → 回调 → 往 input_queue 塞 EXECUTOR_FAILED → 主线程 RuntimeError&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="486" y="302" width="560" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;从 worker 死到引擎死有延迟&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1046" y="302" width="240" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;multiproc_executor.py:300-333；core.py:1622-1623&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1286" y="302" width="200" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;④ 前端看门狗&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="354" width="150" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;frontend 的 watchdog_task（协程）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
