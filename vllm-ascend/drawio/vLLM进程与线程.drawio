  <diagram id="pg4" name="⑤ 三条 ZMQ 通道">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1346" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑤ 前端与引擎之间的三条 ZMQ 通道（谁 bind、谁 connect）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：前端**统一 bind**、引擎**统一 connect**——所以前端可以先起、引擎后起也能接上。三条通道各管一件事：换地址（握手）、发命令（下行）、收结果（上行）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：把三条通道画成三条箭头（注意 socket 类型与方向）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1000" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;前端进程（API server）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① handshake：&lt;b&gt;ROUTER bind&lt;/b&gt;&lt;br&gt;② input：&lt;b&gt;ROUTER bind&lt;/b&gt;&lt;br&gt;③ output：&lt;b&gt;PULL bind&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;三条全是 bind —— 前端是「服务端」角色&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="76" y="150" width="380" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;EngineCore 进程&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① handshake：&lt;b&gt;DEALER connect&lt;/b&gt;&lt;br&gt;② input：&lt;b&gt;DEALER connect&lt;/b&gt;&lt;br&gt;③ output：&lt;b&gt;PUSH connect&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;identity = dp_rank，所以前端能定向到某个 DP 分片&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1016" y="150" width="400" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="① 握手：我是哪个 DP、我的地址是什么" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="456" y="194" as="sourcePoint"/>
            <mxPoint x="1016" y="194" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="② 下行：ADD / ABORT / UTILITY" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
