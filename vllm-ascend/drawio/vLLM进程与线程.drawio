        <mxCell id="e66" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1204" as="sourcePoint"/>
            <mxPoint x="454" y="1204" as="targetPoint"/>
