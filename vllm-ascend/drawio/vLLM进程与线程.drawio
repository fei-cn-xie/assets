            <mxPoint x="2406" y="370" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n44" value="&lt;b&gt;按 (tenant,edge,rid,attempt) 去重，round-robin 选 target_dp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;两个独立计数器：P 一个、D 一个 → (dp_P, dp_D) 是自由组合&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;pd/proxy.py:131-174（选择 :159-162）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="840" y="398" width="364" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="e45" value="POST 到 P 的 coord 端口（带 target_dp、stage_role=prefill）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;max_tokens=1，剥掉 kv 参数&lt;/font&gt;" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1022" y="476" as="sourcePoint"/>
            <mxPoint x="1420" y="476" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n46" value="&lt;font color=&quot;#999999&quot;&gt;③ P 注册：校验这个 DP 归我管 → 回 BIND&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;fillColor=#e7e0d4;strokeColor=#b3a89c;" vertex="1" parent="1">
          <mxGeometry x="36" y="511" width="2370" height="18" as="geometry"/>
