  <diagram id="pg7" name="⑧ worker 线程">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1142" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑧ worker 进程内部：一条阻塞循环 + 三种后台线程" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：worker 主线程只做一件事——阻塞等 RPC、执行、回复；其它活儿（拷输出、盯父进程、搬 KV、通信库内部）都在后台线程。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;主线程：worker_busy_loop（模型前向就发生在这里）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;worker_busy_loop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;阻塞在「从广播队列取 RPC」→ 取到就同步执行 `worker.&amp;lt;method&amp;gt;(...)` → 把结果放回响应队列 → 继续等。&lt;br&gt;`execute_model` 也只是其中一种 RPC。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#c0392b&quot;&gt;常见误解：以为 ModelRunner 有自己的线程池——&lt;b&gt;它没有&lt;/b&gt;，它就是这条主线程里被调用的对象。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="148" width="700" height="138" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;为什么这里可以「阻塞等」&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;因为 worker 不需要同时做别的事：一次只有一个「执行计划」要跑，跑完回结果，等下一个。&lt;br&gt;&lt;br&gt;对比前端：那里一条 loop 要伺候成千上万个连接，所以绝不能阻塞——&lt;b&gt;同一个「不能阻塞」的道理，在两处的解法完全相反。&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="796" y="148" width="664" height="138" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="t7" value="&lt;b&gt;后台线程：分三类（哪类出现取决于启动参数与连接器）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="294" width="1000" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;① 框架自带&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· &lt;b&gt;WorkerAsyncOutputCopy&lt;/b&gt;（仅 --async-scheduling）：把「拷贝 worker 输出」拆出去，不和主循环抢&lt;br&gt;· &lt;b&gt;DeathPipeMonitor&lt;/b&gt;：盯着父进程的死亡管道，父死就通知收尾&lt;br&gt;· &lt;b&gt;torch 线程池压到 1&lt;/b&gt;：避免多进程互相抢 CPU（这是主动做的，不是限制）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="326" width="460" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;② KV 连接器自带&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;以本仓 Mooncake 为例：&lt;br&gt;· KVCacheSendingThread（P 侧「挂号窗口」）&lt;br&gt;· KVCacheRecvingThread（D 侧搬运工）&lt;br&gt;· 它内部的 32 线程池（按对端分桶）&lt;br&gt;&lt;b&gt;这些线程在 register_kv_caches 之后启动并等 ready&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="518" y="326" width="460" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;③ 通信库内部（HCCL/NCCL）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;集合通信、RDMA 收发、超时重试都在 C++ 层，Python 里看不到线程名。&lt;br&gt;&lt;br&gt;这类线程出问题时的表现：&lt;br&gt;主线程卡在 allreduce / 进程 hang 住不退出——&lt;b&gt;日志里通常只有一行超时&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1000" y="326" width="460" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;一张表：worker 进程里可能有哪些线程&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="502" width="1000" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;线程&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="534" width="420" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;干什么&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="456" y="534" width="560" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;什么时候有&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1016" y="534" width="360" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;MainThread&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
