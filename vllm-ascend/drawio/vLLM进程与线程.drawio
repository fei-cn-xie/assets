        <mxCell id="t1" value="⑬ dp=2 × tp=4 的边云 PD 分离：一共 27 个进程，谁和谁通信" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1600" height="26" as="geometry"/>
