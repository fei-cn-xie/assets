        <mxCell id="n34" value="&lt;font color=&quot;#999999&quot;&gt;① 预检与算进程数（失败就直接退，不是等）&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;fillColor=#e7e0d4;strokeColor=#b3a89c;" vertex="1" parent="1">
