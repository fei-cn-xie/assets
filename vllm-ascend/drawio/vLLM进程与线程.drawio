        <mxCell id="n9" value="&lt;b&gt;API server 主进程&lt;/b&gt;　+ 每 DP 一个 coord listener 线程（2 个 coord_port）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;lwd-cloud-ctrl · lwd-ctrl-dispatch&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
