  <diagram id="pg2" name="③ 三种 executor">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1256" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="③ 三种 executor：worker 到底是不是独立进程，由它决定" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：`--distributed-executor-backend`（以及 world_size 大小）决定 worker 跑在哪——同进程、同机多进程、还是远端 ray 集群。**边端之所以只有 3 个进程，就是因为走了 uni**。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：它怎么被选中（一条判定链）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;world_size = TP × PP × DP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;先算出这次要用几张卡（跨 DP 一起算）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="148" width="340" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;= 1 → uni 后端&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;只有一张卡：worker 直接与 EngineCore 同进程&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="398" y="148" width="340" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;&amp;gt; 1 且没指定后端 → mp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;本机多进程：每 rank 一个 VllmWorker 进程&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="760" y="148" width="340" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;跨机 / 显式指定 → ray&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;每个 rank 一个 ray actor（远端进程）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1122" y="148" width="338" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" value="大于 1" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n5" target="n6">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" value="要跨机" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n6" target="n7">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="t11" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;本仓部署里：edge TP=1/DP=1 → world_size=1 → &lt;b&gt;uni&lt;/b&gt;；云端 TP=2 或 DP=2 → &amp;gt;1 → &lt;b&gt;mp&lt;/b&gt;；没人用 ray。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="256" width="1200" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;b&gt;第二步：三种形态下的进程图（认清「一个方框 = 一个进程」）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="292" width="1000" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontStyle=1;opacity=45;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="324" width="470" height="232" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;b&gt;uni：全部塞在一个进程里&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="332" width="450" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;EngineCore 进程&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;调度 + 忙循环 + 模型前向 + 权重，都在这里&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="76" y="364" width="390" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;（同进程内）worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;没有独立进程，ps 看不到&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="76" y="454" width="390" height="60" as="geometry"/>
