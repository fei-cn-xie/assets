  <diagram id="pg10" name="⑪ Scheduler 是什么">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1332" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑪ Scheduler 是什么：一个「每一步挑一批请求去算」的决定器" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：调度器不碰 NPU、不搬 KV，它只做三件事——决定这一步&lt;b&gt;算哪些请求&lt;/b&gt;、每个请求&lt;b&gt;算几个 token&lt;/b&gt;、给它&lt;b&gt;分哪些 KV 块&lt;/b&gt;。它跑在 EngineCore 主线程的忙循环里（第 ④ 页）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：它只有四个容器（读代码时先认这四个）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1000" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;requests（字典）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;req_id → Request：&lt;b&gt;所有没完成的请求&lt;/b&gt;都在这里，不管它在哪个队列。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;scheduler.py:194&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="340" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;waiting（队列）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;还没开始算的请求。默认 FCFS（就是个 deque），换 priority 策略就变小顶堆。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;:203 · request_queue.py:75&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="398" y="150" width="340" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;skipped_waiting（队列）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;这一步被跳过的等待请求：等语法、等远端 KV、等流式输入。&lt;b&gt;它和 waiting 是两个队&lt;/b&gt;。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;:205 · :2367-2373&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="760" y="150" width="340" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;running（列表）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;正在跑的请求，&lt;b&gt;是 list 不是 queue&lt;/b&gt;——顺序就是调度顺序，抢占时从末尾挑。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;:206&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1122" y="150" width="338" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;第二步：调度器眼里一个请求有哪些关键数（决定「还能不能算」）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="294" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;字段&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="326" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;含义&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="286" y="326" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;锚点&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="906" y="326" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;num_tokens&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="360" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;这个请求现在总共有多少 token（prompt + 已生成）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="360" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;request.py:288&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="906" y="360" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;num_computed_tokens&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="394" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;已经算过多少个 token —— 与总数一减就是「还差多少」&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="394" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;request.py:182&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="906" y="394" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;status&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="428" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;WAITING / WAITING_FOR_REMOTE_KVS / RUNNING / PREEMPTED / FINISHED_*&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="428" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;request.py:364-380&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="906" y="428" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;block_hashes&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="462" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;前缀缓存用的块哈希（构造时算一次，每次生成再增量补）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="462" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;request.py:219,278&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="906" y="462" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;num_preemptions&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="496" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;被抢占过几次（诊断用）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="496" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;request.py:210&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="906" y="496" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;is_prefill_chunk&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="530" width="250" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;这一段是不是「非最后一块」的 prefill 分块&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="530" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;request.py:198&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="906" y="530" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="t30" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;注意：&lt;b&gt;Request 上没有 block_ids 字段&lt;/b&gt;——KV 块表存在 KVCacheManager 里（single_type_kv_cache_manager.py:127），调度器只在装配输出时把 block_ids 取出来。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="570" width="1424" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="t31" value="&lt;b&gt;第三步：请求的状态机（调度器就是在这几个状态之间搬它）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="590" width="1000" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;WAITING&lt;/b&gt;&lt;br&gt;排队中" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="622" width="260" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;RUNNING&lt;/b&gt;&lt;br&gt;正在算" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="416" y="622" width="260" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;FINISHED_*&lt;/b&gt;&lt;br&gt;结束（多种原因）" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="796" y="622" width="300" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="e35" value="分到 KV 块" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n32" target="n33">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e36" value="生成完 / 中止" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1" source="n33" target="n34">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="n37" value="&lt;b&gt;WAITING_FOR_REMOTE_KVS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;PD 场景：等远端的 KV 到齐&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="416" y="732" width="260" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;b&gt;PREEMPTED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;块不够被抢占 → 回 WAITING 队头重算&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="796" y="732" width="300" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="e39" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="546" y="684" as="sourcePoint"/>
            <mxPoint x="546" y="732" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e40" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#b85450;fillColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="946" y="684" as="sourcePoint"/>
            <mxPoint x="946" y="732" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t41" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;两个侧态都能回到主链：KV 到齐 → RUNNING；被抢占 → 回 WAITING 队头，下次重新 prefill（不是「换出到 CPU」，本版本没有 SWAP 模式）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="416" y="816" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="&lt;b&gt;它每步要回答的三个问题（整个 P 页的骨架）&lt;/b&gt;&lt;br&gt;① &lt;b&gt;算谁&lt;/b&gt;：先把 running 里的老请求排一遍，再把 waiting 里的新请求收进来（前提：这一步没发生抢占）。&lt;br&gt;② &lt;b&gt;算几个 token&lt;/b&gt;：两个预算——token 预算（这一步能发多少 token）与 input 预算（这一步能喂多少 input token）；超出就切块（chunked prefill）。&lt;br&gt;③ &lt;b&gt;分哪些块&lt;/b&gt;：问 KVCacheManager 要 KV 槽位；要不到就挑个倒霉蛋抢占。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="874" width="1424" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;四个容器与状态：vllm/v1/core/sched/scheduler.py:194-206；RequestStatus vllm/v1/request.py:364-380&lt;br&gt;请求关键字段：vllm/v1/request.py:182（num_computed_tokens）、:288（num_tokens）、:219（block_hashes）&lt;br&gt;KV 块表的真实位置：vllm/v1/core/single_type_kv_cache_manager.py:127；取块号 scheduler.py:1394&lt;br&gt;统计与日志出口：scheduler.py:2824-2860（make_stats）；vllm/v1/metrics/loggers.py:260-292（Running/Waiting 日志）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1014" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;调度器 = 四个容器（requests / waiting / skipped_waiting / running）+ 一个状态机；它每步只产出一份「执行计划」（SchedulerOutput），自己不碰模型也不碰 KV 数据。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1142" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t45" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1234" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1231" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1231" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1231" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1231" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1231" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1231" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1231" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e53" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1280" as="sourcePoint"/>
            <mxPoint x="204" y="1280" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t54" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1268" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e55" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1280" as="sourcePoint"/>
            <mxPoint x="454" y="1280" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t56" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1268" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e57" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1280" as="sourcePoint"/>
            <mxPoint x="704" y="1280" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t58" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1268" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg11" name="⑫ schedule 内部流程">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1648" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑫ 一次 schedule() 里到底发生了什么（五段流程）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：&lt;b&gt;先排老的（running）→ 要块 → 块不够就抢占 → 再收新的（waiting）→ 产出执行计划&lt;/b&gt;。顺序不能反：本步一旦抢占，就不再收新请求。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="156" width="1424" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="t4" value="&lt;b&gt;①　开场：数预算、开新的一步&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="164" width="1380" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;font style=&quot;font-size:10px&quot;&gt;token 预算 = max_num_scheduled_tokens（没配就回落到 max_num_batched_tokens）；input 预算 = max_num_batched_tokens。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;给 KV 块池发「新一步开始」的通知（new_step_starts），并算出这一步是否要&lt;b&gt;推迟 prefill&lt;/b&gt;（DP 波次节流）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;⚠ 两个预算同时存在：一个管「发多少 token」，一个管「喂多少 input token」。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="48" y="190" width="1400" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="292" width="1424" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="t7" value="&lt;b&gt;②　先排老的：running 里的请求挨个算「这一步给它几个 token」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="300" width="1380" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;font style=&quot;font-size:10px&quot;&gt;每个请求：还差多少 = num_tokens（含 spec）− num_computed_tokens；再被 long_prefill_token_threshold 截断、被剩余预算压小、再按 max_model_len / LWD 窗口 / MTP lookahead 收紧。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;算出来是 0 就&lt;b&gt;跳过这个、看下一个&lt;/b&gt;（continue，不是 break）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;拿到数字后立刻去要 KV 槽位（下一段）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="48" y="326" width="1400" height="98" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="448" width="1424" height="156" as="geometry"/>
        </mxCell>
        <mxCell id="t10" value="&lt;b&gt;③　要 KV：要不到就抢占（本版本只有「重算」一种）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="456" width="1380" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;font style=&quot;font-size:10px&quot;&gt;要块：allocate_slots(请求, num_new_tokens)。块不够返回 None。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;抢占谁：FCFS 直接挑 &lt;b&gt;running 队尾&lt;/b&gt;；priority 策略挑「优先级最低 / 最晚到」的那个。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;被抢占的代价：&lt;b&gt;释放它的 KV 块、num_computed_tokens 归零、插回 waiting 队头&lt;/b&gt;——下次重新 prefill（没有「换出到 CPU」这种模式）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;⚠ 一旦本步发生抢占，第 ④ 段直接跳过：这一步不再接新请求。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="48" y="482" width="1400" height="114" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="624" width="1424" height="178" as="geometry"/>
        </mxCell>
        <mxCell id="t13" value="&lt;b&gt;④　再收新的：从 waiting 里挑人，先查前缀缓存&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="632" width="1380" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;font style=&quot;font-size:10px&quot;&gt;准入条件：还有 token 预算、running 数没到 max_num_seqs、本步没抢占。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;先看 skipped_waiting（上一步被跳过的），再看 waiting。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;若请求 num_computed_tokens == 0：&lt;b&gt;查前缀缓存&lt;/b&gt;（按 block_hashes 找最长命中，最多命中到 num_tokens − 1，因为最后一个 token 必须重算才能出 logits）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本地命中 + 远端命中（connector）合并成 num_computed_tokens；本步只算剩下的。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PD 场景：若 connector 说「要异步拉 KV」，则&lt;b&gt;只分块不算 token&lt;/b&gt;，状态置 WAITING_FOR_REMOTE_KVS，放回 skipped_waiting。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="48" y="658" width="1400" height="136" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="824" width="1424" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;b&gt;⑤　收尾：产出执行计划，并推进「已算多少」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="832" width="1380" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;font style=&quot;font-size:10px&quot;&gt;组装 SchedulerOutput：每请求 num_scheduled_tokens + 新块的 block_ids（&lt;b&gt;注意 SchedulerOutput 里没有 slot_mapping&lt;/b&gt;，那是 worker 自己算的）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;把本步的 token 数累加进 num_computed_tokens（异步调度下还要维护 placeholder），清掉 finished / preempted 集合。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;这份计划通过消息队列广播给所有 TP worker —— &lt;b&gt;同一份对象、4 个 worker 各拿一份&lt;/b&gt;。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="48" y="858" width="1400" height="98" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;b&gt;抢占到底做了什么（顺序很重要，代码就是这么写的）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="954" width="1000" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:10px&quot;&gt;释放这个请求的 KV 块（含 encoder cache）→ 从 _inflight_prefills 移除 → status = PREEMPTED → &lt;b&gt;num_computed_tokens = 0&lt;/b&gt; → 清掉 spec draft token → 处理掉在飞的旧输出 → num_preemptions += 1 → &lt;b&gt;prepend 到 waiting 队头&lt;/b&gt;（下次最先被重新调度）。&lt;br&gt;所以「抢占」在 v1 里等于「这笔 prefill 白算，从头再来」——这也是为什么块不够时要先尽量别超发。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="986" width="1424" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;b&gt;三个上限各管一段（别混）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1080" width="1000" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;上限&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="1112" width="340" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;管什么&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="376" y="1112" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;b&gt;注意&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="796" y="1112" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;max_num_seqs&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1146" width="340" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;每个 EngineCore 同时 running 的请求数&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="376" y="1146" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;只在 waiting 准入时检查&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="796" y="1146" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;max_num_batched_tokens（input 预算）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1180" width="340" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;一步能喂多少 input token&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="376" y="1180" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;chunked prefill 就是被它切出来的&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
