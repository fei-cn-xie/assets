        <mxCell id="e58" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1398" as="sourcePoint"/>
            <mxPoint x="454" y="1398" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t59" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1386" width="190" height="24" as="geometry"/>
