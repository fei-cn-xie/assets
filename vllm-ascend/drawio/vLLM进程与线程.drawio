          <mxGeometry x="36" y="922" width="250" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="&lt;font style=&quot;font-size:11px&quot;&gt;launcher（ZMQ ROUTER）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="286" y="922" width="380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="&lt;font style=&quot;font-size:11px&quot;&gt;本机 EngineCore 子进程&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
