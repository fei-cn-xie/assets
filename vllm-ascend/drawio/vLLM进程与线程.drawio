        </mxCell>
        <mxCell id="t19" value="&lt;b&gt;P 合计 12 个进程&lt;/b&gt;（1 API + 1 协调 + 2 引擎 + 8 worker）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="536" y="528" width="700" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;b&gt;③ D 实例：与 P 完全同构（dp=2 × tp=4，12 个进程）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;区别只在角色：D 的每个 TP worker 各自去 &lt;b&gt;P 的对应 TP rank&lt;/b&gt; 拉自己那 1/4 份 KV（P/D 的 TP 相等时是一对一映射，不需要拼装）；拉齐后 num_computed_tokens 必须正好等于 r_pos 才允许算 tail。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="536" y="572" width="700" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;④ PD Proxy（1 个进程）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;uvicorn 单进程。用 &lt;b&gt;round-robin&lt;/b&gt; 从静态目标表里挑 P 的一个 DP 和 D 的一个 DP（两个独立计数器），再分别敲它们的 coord 端口。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="36" y="572" width="460" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;全链路合计 ≈ 27 个进程&lt;/b&gt;　·　edge 3　+　P 12　+　D 12　+　Proxy 1　+　每主机 1 个 ucx_daemon（若用 sidecar 形态）" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
