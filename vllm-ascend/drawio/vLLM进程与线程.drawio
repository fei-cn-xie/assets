  <diagram id="pg9" name="⑩ 排障地图">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1472" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑩ 排障地图：进程、线程、端口、日志各自该看什么" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="这一页是工具页：线上/本机出问题时，按「先看有几层进程 → 再看线程 → 再看端口 → 最后看日志」的顺序，能快速把问题定位到某一层。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：用四条命令把「进程树 / 线程 / 端口」看清&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="114" width="900" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;&lt;b&gt;# 1. 有几个进程（Linux）&lt;/b&gt;&lt;br&gt;ps -ef | grep -E &quot;vllm|EngineCore|WorkerProc&quot; | grep -v grep&lt;br&gt;&lt;b&gt;# 2. 进程树的父子关系（谁 spawn 了谁）&lt;/b&gt;&lt;br&gt;pstree -p &amp;lt;pid&amp;gt;　或　ps -o pid,ppid,cmd -e | grep vllm&lt;br&gt;&lt;b&gt;# 3. 这个进程里有几个线程&lt;/b&gt;&lt;br&gt;top -H -p &amp;lt;pid&amp;gt;　或　cat /proc/&amp;lt;pid&amp;gt;/status | grep Threads　或　py-spy dump --pid &amp;lt;pid&amp;gt;（看每个线程卡在哪个 Python 栈）&lt;br&gt;&lt;b&gt;# 4. 端口谁在听、谁在连&lt;/b&gt;&lt;br&gt;ss -lntp | grep -E &quot;8510|8600|8601|8102|14570|14580&quot;　（端口表见 ⑨ 页）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="146" width="1424" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;第二步：日志里对应的「阶段」关键词（按出现顺序）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="304" width="1000" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;阶段&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="336" width="260" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;日志里的样子（关键词）&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="296" y="336" width="620" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;font style=&quot;font-size:11px&quot;&gt;前端起来了&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="368" width="260" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;font style=&quot;font-size:11px&quot;&gt;Starting vLLM API server / uvicorn running&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="368" width="620" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;font style=&quot;font-size:11px&quot;&gt;EngineCore 进程起来了&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="400" width="260" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:11px&quot;&gt;Starting EngineCore / init engine&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="400" width="620" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;worker 进程起来了&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="432" width="260" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;WorkerProc / init_device / load_model&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="432" width="620" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;握手完成（三通道）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="464" width="260" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;handshake / HELLO / ready&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="464" width="620" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;KV cache 分配完成&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="496" width="260" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;KV cache usage / num_gpu_blocks&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="496" width="620" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;请求在跑&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="528" width="260" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;Running: N reqs / Engine 000: Avg prompt throughput&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="528" width="620" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;进程死了&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="560" width="260" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;EngineDeadError / Engine core proc died / WorkerProc 退出码 / was terminated&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="560" width="620" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;等太久超时&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="592" width="260" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;timeout / iteration timeout / Timeout waiting for&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="592" width="620" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="t24" value="&lt;b&gt;第三步：常见「死法」对照表（现象 → 先查哪一层）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="616" width="1000" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;前端报 EngineDeadError，进程还在&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;通常是：&lt;b&gt;EngineCore 进程死了&lt;/b&gt;　→　先做：先 ps 看 EngineCore 还在不在；再翻它退出前的日志（OOM / assert）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="648" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;卡在启动，永远不 ready&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;通常是：&lt;b&gt;worker 里有进程没起来或握手没完成&lt;/b&gt;　→　先做：看 worker 日志最后一行；ss 看端口有没有 listen；等的是哪个 ready&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="722" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;请求全部排队不动&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;通常是：&lt;b&gt;线程池/后台线程卡住或 ZMQ 队列堵了&lt;/b&gt;　→　先做：py-spy dump 看 frontend 与 EngineCore 主线程栈；看输出通道是否积压&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="796" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;b&gt;显存慢慢涨到 OOM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;通常是：&lt;b&gt;KV 块没释放（钉住没解）或进程泄漏&lt;/b&gt;　→　先做：看 KV cache usage 是否只涨不落；对端是否一直没回执&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="870" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;b&gt;吞吐突然掉一半&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;通常是：&lt;b&gt;某个 worker/DP 分片掉队&lt;/b&gt;　→　先做：top -H 看各进程 CPU；对比每个 worker 的日志时间戳&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="944" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;b&gt;速查：这些数对不上就是配置和实际不一致&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· worker 进程数（mp 模式）≈ tp × pp × （每个 EngineCore 的 DP 分片数）&lt;br&gt;· EngineCore 进程数 = DP 外部分片的数量（internal 模式由引擎自己起多份）&lt;br&gt;· 一个实例的通信端口数 ≈ 控制面 1 个基址 + 每 worker 1 个握手端口&lt;br&gt;· 线程数最多的进程通常是 worker（模型执行 + 通信库 + connector 后台线程）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1034" width="1424" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;进程/线程的钩子所在：vllm/v1/engine/core.py（EngineCoreProc / run_busy_loop）&lt;br&gt;三通道与 worker 名册：vllm/v1/engine/utils.py（CoreEngineProcManager / ZMQ 地址与端口分配）&lt;br&gt;worker 侧：vllm/v1/worker/worker_base.py、gpu_worker.py&lt;br&gt;前端：vllm/entrypoints/openai/api_server.py、vllm/v1/engine/async_llm.py&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1160" width="1424" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;先确认「有几层进程、各自活没活」，再看「线程卡在哪」，最后才看业务日志——顺序反了，就会在正确的日志里找错误的原因。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1282" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t33" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1374" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1371" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1371" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1371" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1371" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1371" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1371" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1371" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e41" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1420" as="sourcePoint"/>
            <mxPoint x="204" y="1420" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t42" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1408" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e43" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1420" as="sourcePoint"/>
            <mxPoint x="454" y="1420" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t44" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1408" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e45" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1420" as="sourcePoint"/>
            <mxPoint x="704" y="1420" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t46" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
