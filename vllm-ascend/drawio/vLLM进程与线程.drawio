        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;没配时 = max_num_batched_tokens&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="796" y="1214" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:11px&quot;&gt;max_num_queued_reqs（前端准入）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
