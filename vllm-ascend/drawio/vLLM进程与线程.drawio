          <mxGeometry x="36" y="1214" width="340" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;一步能发多少 token&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
