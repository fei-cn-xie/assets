        <mxCell id="n42" value="&lt;font color=&quot;#999999&quot;&gt;② Proxy：挑一个 P 的 DP、一个 D 的 DP&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;fillColor=#e7e0d4;strokeColor=#b3a89c;" vertex="1" parent="1">
