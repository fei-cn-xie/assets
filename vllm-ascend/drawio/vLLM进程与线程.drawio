          </mxGeometry>
        </mxCell>
        <mxCell id="n56" value="&lt;b&gt;4 个 worker 各算自己 1/4：QKV 列并行 → attention → o_proj 行并行&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;行并行末尾要 all_reduce —— 这就是 4 卡的锁步点&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;linear.py:1047-1053, 1775-1776&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1636" y="899" width="364" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="n57" value="&lt;b&gt;只有 TP rank0 回采样结果；lm_head 出 logits 时做 all_gather&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;其他 3 个 rank 仍然全程参与集合通信，只是不回话&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;multiproc_executor.py:542-556；logits_processor.py:124-133&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1636" y="974" width="364" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="n58" value="&lt;font color=&quot;#999999&quot;&gt;⑤ 交接单 + KV 一对一拉取（P/D 的 TP 相等 → 恒等映射）&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;fillColor=#e7e0d4;strokeColor=#b3a89c;" vertex="1" parent="1">
          <mxGeometry x="36" y="1041" width="2370" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="e59" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="36" y="1035" as="sourcePoint"/>
            <mxPoint x="2406" y="1035" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n60" value="&lt;b&gt;请求结束：连接器导出 remote_engine/host/port + 块号；引擎打 lwd_handoff&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;p_end / i_end / r_pos 都在交接单里（R = N-1）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;mooncake_connector.py:2016-2070；cloud_runtime.py:697-717&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1238" y="1063" width="364" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="e61" value="P 的 HTTP 返回 kv_transfer_params（含交接单）" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1420" y="1155" as="sourcePoint"/>
            <mxPoint x="1022" y="1155" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n62" value="&lt;b&gt;拿交接单去注册 D 的某个 DP（此处才确定 dp_D）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;proxy.py:201-217；cloud_runtime.py:310-343&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="840" y="1184" width="364" height="39" as="geometry"/>
        </mxCell>
        <mxCell id="e63" value="POST 到 D 的 coord（带 target_dp 与交接单）" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1022" y="1250" as="sourcePoint"/>
            <mxPoint x="2216" y="1250" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n64" value="&lt;b&gt;D 的调度器把请求置 WAITING_FOR_REMOTE_KVS，后台线程去拉&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;每个 TP worker 拉自己那 1/4 头（P worker r ⇄ D worker r）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;pd/cloud_scheduler.py:106-149&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="2034" y="1279" width="364" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="e65" value="块级 pull：4 条一对一通道各自搬 1/4 的 KV&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;mooncake_connector.py:4028-4029, 4078-4087&lt;/font&gt;" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1818" y="1357" as="sourcePoint"/>
            <mxPoint x="2216" y="1357" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n66" value="&lt;b&gt;到齐断言 num_computed_tokens == r_pos，然后算 tail 并开始逐字生成&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;pd/cloud_scheduler.py:127-130, 151-218&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="2034" y="1386" width="364" height="53" as="geometry"/>
        </mxCell>
        <mxCell id="n67" value="&lt;font color=&quot;#999999&quot;&gt;⑥ 结果回 edge → 客户端&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=0;fontSize=11;fontStyle=1;dashed=1;fillColor=#e7e0d4;strokeColor=#b3a89c;" vertex="1" parent="1">
          <mxGeometry x="36" y="1455" width="2370" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="e68" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="36" y="1449" as="sourcePoint"/>
            <mxPoint x="2406" y="1449" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e69" value="D 一边算一边把结果事件推回" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2216" y="1494" as="sourcePoint"/>
            <mxPoint x="1022" y="1494" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e70" value="Proxy 回放事件给 edge" style="endArrow=open;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1022" y="1540" as="sourcePoint"/>
            <mxPoint x="624" y="1540" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n71" value="&lt;b&gt;edge 做 UNEMBED(lm_head) + tick() 推进状态机&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;lwd_edge_down_receiver.py:40；lwd_edge_worker.py:157-166；edge_runtime.py:524-535&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="442" y="1569" width="364" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="n72" value="&lt;b&gt;前端 output_handler 反分词 → SSE 逐 token 吐给客户端&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;注意：分词/反分词一直在 edge 前端进程里，不在沿线的任何引擎里&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;async_llm.py:841-908&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="44" y="1630" width="364" height="51" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg14" name="⑮ 模型加载">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑮ 模型加载：从权重文件到 NPU 显存（8 步）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：&lt;b&gt;先读 config 知道模型长什么样 → 在 NPU 上搭一个空骨架 → 逐个张量从磁盘读出来、按 TP 切好、拷进对应的参数里 → 再做格式/量化后处理&lt;/b&gt;。加载完才轮到 profile 显存、切 KV 块池。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一排：先看清磁盘上有什么（不读权重也能知道很多）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="466" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;①　config.json：模型的结构与 dtype&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="158" width="446" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;层数、hidden、head 数、dtype、是否量化都在这里。&lt;br&gt;读不到会直接报 Invalid repository ID or local directory。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="182" width="446" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="526" y="150" width="466" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;②　权重分片：*.safetensors&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="536" y="158" width="446" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;大模型切成多个文件（shard）。每片里是一堆&lt;b&gt;名字 → 张量&lt;/b&gt;。&lt;br&gt;读盘用 &lt;font style=&quot;font-size:9px&quot;&gt;safe_open&lt;/font&gt;，拿到的是 &lt;b&gt;CPU 张量&lt;/b&gt;。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="536" y="182" width="446" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1016" y="150" width="444" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;③　index.json：名字 → 在哪个分片&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1026" y="158" width="424" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;有它在才能只读该读的片；&lt;br&gt;索引点名的文件缺失会报 Weight files referenced in index but missing。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1026" y="182" width="424" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="t13" value="&lt;b&gt;第二排：进 NPU 的三步（关键：参数是「先分配、后填充」）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="290" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="322" width="466" height="156" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;b&gt;④　在 NPU 上搭空骨架&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="330" width="446" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;在 device 上下文里建模型 → 每个 &lt;font style=&quot;font-size:9px&quot;&gt;nn.Parameter&lt;/font&gt; &lt;b&gt;一开始就分配在 NPU 上&lt;/b&gt;（还没填数）。&lt;br&gt;所以后面不是「把权重搬到 NPU」，而是「往 NPU 上已有的参数里写数」。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="354" width="446" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="526" y="322" width="466" height="156" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;b&gt;⑤　名字映射 + 选 weight_loader&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="536" y="330" width="446" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;checkpoint 的名字（q_proj/k_proj/v_proj）→ 拼成模型的 qkv_proj；&lt;br&gt;每个参数自己带一个 weight_loader，决定「怎么切、怎么拷」。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="536" y="354" width="446" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1016" y="322" width="444" height="156" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;b&gt;⑥　切片 + 拷进去（每张量一次）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1026" y="330" width="424" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t22" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;TP&amp;gt;1 时：从全量张量里 &lt;b&gt;narrow&lt;/b&gt; 出本 rank 的那一段，然后 &lt;font style=&quot;font-size:9px&quot;&gt;param.data.copy_(切片)&lt;/font&gt; —— 这一步才是真正的 &lt;b&gt;CPU→NPU 拷贝&lt;/b&gt;。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1026" y="354" width="424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;b&gt;第三排：加载完还要「改写格式」，然后才轮到 KV cache&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="486" width="1100" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="518" width="700" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t25" value="&lt;b&gt;⑦　后处理：量化 / 布局转换&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="526" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t26" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;process_weights_after_loading：&lt;br&gt;· 把 fp32 参数换成 fp16/bf16（如需要）&lt;br&gt;· 昇腾上做 &lt;b&gt;ND → NZ&lt;/b&gt; 布局重排（&lt;font style=&quot;font-size:9px&quot;&gt;npu_format_cast(..., ACL_FORMAT_FRACTAL_NZ)&lt;/font&gt;），让矩阵乘更快&lt;br&gt;· 权重绑定 / 融合&lt;br&gt;⚠ 这一步是「就地换掉 weight.data」，不是再拷一次。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="550" width="680" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="760" y="518" width="700" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;b&gt;⑧　此时才 profile 显存 → 切 KV 块池&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="526" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t29" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;顺序是硬性的：&lt;br&gt;权重先吃掉显存 → 跑一次 profile 量出激活峰值 → &lt;b&gt;剩余显存才切成 KV 块&lt;/b&gt;。&lt;br&gt;所以「权重变大 = KV 块变少 = 并发变低」，三者是一条链。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="770" y="550" width="680" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="t30" value="&lt;b&gt;加载期间的日志顺序（对着日志能判断卡在哪一步）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="694" width="1000" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;日志&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="726" width="700" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;说明&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="736" y="726" width="720" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:11px&quot;&gt;Starting to load model /path/to/weights...&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="758" width="700" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:11px&quot;&gt;开始加载（worker 里）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="736" y="758" width="720" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;font style=&quot;font-size:11px&quot;&gt;Loading safetensors checkpoint shards: 100%&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="790" width="700" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;font style=&quot;font-size:11px&quot;&gt;正在逐片读盘（有进度条）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="736" y="790" width="720" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;font style=&quot;font-size:11px&quot;&gt;Filesystem type for checkpoints: ...&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="822" width="700" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;font style=&quot;font-size:11px&quot;&gt;在探磁盘/网络盘速度&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="736" y="822" width="720" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;font style=&quot;font-size:11px&quot;&gt;Loading weights took 12.34 seconds&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="854" width="700" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;font style=&quot;font-size:11px&quot;&gt;读盘 + 拷贝完成&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="736" y="854" width="720" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;font style=&quot;font-size:11px&quot;&gt;Loading model weights took 53.4 GB&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="886" width="700" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="&lt;font style=&quot;font-size:11px&quot;&gt;权重实际占了显存&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="736" y="886" width="720" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="&lt;font style=&quot;font-size:11px&quot;&gt;Available KV cache memory: 18.2 GiB&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="918" width="700" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="&lt;font style=&quot;font-size:11px&quot;&gt;扣掉权重后剩下的 KV 预算&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="736" y="918" width="720" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="&lt;b&gt;常见失败与一句话定位&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;目录里没权重&lt;/b&gt;：Cannot find any model weights with ... → 路径或 shard 命名不对&lt;br&gt;② &lt;b&gt;形状不匹配&lt;/b&gt;：Attempted to load weight (…) into parameter (…) → 多为 TP 数与权重分片不匹配&lt;br&gt;③ &lt;b&gt;有参数没被赋值&lt;/b&gt;：Following weights were not initialized from checkpoint → 名字映射漏了&lt;br&gt;④ &lt;b&gt;显存不够&lt;/b&gt;：Free memory on device (…) is less than desired GPU memory utilization → 权重+KV 超预算，先降 gpu-memory-utilization 或换更小的权重&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="984" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;骨架与 target_device：vllm/model_executor/model_loader/base_loader.py:55-72&lt;br&gt;选 loader：vllm/config/load.py:30、model_loader/__init__.py:50-66、default_loader.py:163-256&lt;br&gt;逐张量读盘：model_loader/weight_utils.py:866-1009（safe_open:1002）&lt;br&gt;切片与拷贝：layers/linear.py:572-589（列并行）、:1730-1746（行并行）、weight_utils.py:1253-1271（default_weight_loader）&lt;br&gt;后处理：model_loader/utils.py:97-163；昇腾 NZ：vllm_ascend/ops/linear.py:107-123&lt;br&gt;显存顺序：vllm_ascend/worker/worker.py:601-634（profile→KV 预算）、vllm/v1/engine/core.py:354（切块池）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1114" width="1424" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;加载 = 读 config（结构）→ 在 NPU 上搭空骨架（参数先分配）→ 逐张量「读盘 → 按 TP 切片 → copy_ 进参数」→ 格式/量化后处理 → profile 出激活峰值 → 剩余显存切成 KV 块。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1260" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t48" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1352" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1349" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1349" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1349" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1349" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n53" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1349" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n54" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1349" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n55" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1349" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e56" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1398" as="sourcePoint"/>
            <mxPoint x="204" y="1398" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t57" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1386" width="190" height="24" as="geometry"/>
