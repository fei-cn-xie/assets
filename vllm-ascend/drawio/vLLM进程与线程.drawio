        <mxCell id="e64" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1204" as="sourcePoint"/>
            <mxPoint x="204" y="1204" as="targetPoint"/>
