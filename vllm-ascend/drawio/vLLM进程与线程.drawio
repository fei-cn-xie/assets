        <mxCell id="n53" value="&lt;font style=&quot;font-size:11px&quot;&gt;DP 引擎握手&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
