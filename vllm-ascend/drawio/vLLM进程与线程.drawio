  </diagram>
  <diagram id="pg15" name="⑯ 权重参与计算">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1398" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑯ 权重怎么参与计算：一次 forward 的调用链" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：&lt;b&gt;加载时写的是 layer.weight，计算时读的也是同一个 layer.weight&lt;/b&gt;——中间没有第二次搬运。所谓「参与计算」，就是把激活张量和这份权重做矩阵乘。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;一条调用链走到底（dense 模型，例如 Qwen/Llama 类）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="700" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;model.forward(input_ids)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;入口&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="700" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;embed_tokens(ids) → 查表拿词向量&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;用的是 embedding.weight（TP 时按词表切）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="216" width="700" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;× N 层：layernorm → attention → layernorm → MLP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;逐层重复&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="282" width="700" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;qkv_proj(hidden_states) → GEMM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;qkv_proj.weight（列并行，切输出维）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="348" width="700" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;attention(q,k,v) → 读写 KV cache&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;KV cache 不是权重，是运行期数据&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="414" width="700" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;o_proj → 行并行 GEMM + all_reduce&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;o_proj.weight（切输入维）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="480" width="700" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;gate_up_proj → SiLU → down_proj + all_reduce&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;MLP 权重（同样列/行并行）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="546" width="700" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;lm_head(hidden) → logits&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;lm_head.weight（按词表切）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="612" width="700" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;b&gt;右侧：三处细节（TP 时各自怎么切、谁做通信）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="796" y="118" width="700" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;① 列并行 Linear（qkv_proj / gate_up_proj）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;权重按&lt;b&gt;输出维&lt;/b&gt;切：每个 rank 只算自己那部分输出（比如自己那 1/4 个 head 或 1/4 的中间维）。&lt;br&gt;特点：forward 里&lt;b&gt;不需要通信&lt;/b&gt;——算完各 rank 手上是一段不同的特征。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="796" y="150" width="664" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;② 行并行 Linear（o_proj / down_proj）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;权重按&lt;b&gt;输入维&lt;/b&gt;切：每个 rank 都在自己那段输入上做乘加，得到的是&lt;b&gt;部分和&lt;/b&gt;。&lt;br&gt;特点：forward 末尾&lt;b&gt;必须 all_reduce&lt;/b&gt; 把 4 个 part 加起来——这是 TP 的通信成本来源。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="796" y="298" width="664" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;③ 并行 Embedding / LMHead&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;按&lt;b&gt;词表维&lt;/b&gt;切：每个 rank 只持有词表的一段（尾部要补零对齐）。&lt;br&gt;查表时先看这个 id 在不在自己那段，不在就返回 0，最后 all_reduce；lm_head 反过来按词表段算 logits。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="446" width="664" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;b&gt;最容易混的一件事：权重和 KV cache 都被「加载」，但不是一回事&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="676" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="708" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;权重（weights）&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="236" y="708" width="560" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;b&gt;KV cache&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="796" y="708" width="560" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;从哪里来&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="742" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;磁盘上的 safetensors 文件&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="742" width="560" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;运行时算出来的（没有文件）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="796" y="742" width="560" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;什么时候进显存&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="776" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;启动时（加载阶段）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="776" width="560" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;每次请求跑到时按块分配&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="796" y="776" width="560" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;大小由什么决定&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="810" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;模型结构与精度（固定）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="810" width="560" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;并发请求数 × 上下文长度（会变）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="796" y="810" width="560" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;会被写吗&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="844" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;加载后只读（除格式重排）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="844" width="560" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;每个 token 都在写新的块&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="796" y="844" width="560" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;不够了怎么办&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="878" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:11px&quot;&gt;起不来：降 gpu-memory-utilization / 换小模型&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="878" width="560" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:11px&quot;&gt;抢占（丢 KV 重算）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="796" y="878" width="560" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;b&gt;所以「加载完就能算」这句话的准确含义&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① 权重已经在 NPU 上（layer.weight 可以直接参与 GEMM）；② KV 块池也已切好（有地方放历史 K/V）；③ 两者的边界是 &lt;b&gt;profile&lt;/b&gt;：权重占多少 → 激活要多少 → 剩下的都给 KV。&lt;br&gt;这也解释了为什么「加大模型的上下文」不会变慢、却会&lt;b&gt;减少并发&lt;/b&gt;——上下文长了，同一个 KV 池能装下的请求数就少了。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="946" width="1424" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;forward 主干：vllm/model_executor/models/qwen3.py:318（LM）、qwen2.py:401（Model）、:226（DecoderLayer）、:153/158（Attention 的 qkv_proj）&lt;br&gt;Linear 落地：vllm/model_executor/layers/linear.py:408-414（LinearBase.forward）、:228-238（UnquantizedLinearMethod.apply）、vllm/model_executor/layers/utils.py:84-90（= F.linear）&lt;br&gt;列/行并行的切分与通信：linear.py:572-606（列）、:1730-1776（行 + all_reduce）&lt;br&gt;Embedding 查表：vllm/model_executor/layers/vocab_parallel_embedding.py:510-534&lt;br&gt;昇腾算子：vllm_ascend/ops/linear.py:133-139（unquantized_gemm）、vllm_ascend/attention/attention_v1.py:1248-1271（paged attention 入口）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1072" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;加载的终点就是计算的起点——`param.data.copy_` 写进去的 `layer.weight`，在 forward 里被 GEMM 直接读；TP 时「列并行不通信、行并行末尾 all_reduce」，这就是 4 张卡协同算一层的方式。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1208" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t38" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1300" width="104" height="20" as="geometry"/>
        </mxCell>
