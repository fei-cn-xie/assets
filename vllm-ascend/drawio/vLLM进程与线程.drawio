        <mxCell id="n62" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1155" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n63" value="数据面 / 跨机" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1155" width="240" height="26" as="geometry"/>
