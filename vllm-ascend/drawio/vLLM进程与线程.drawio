        <mxCell id="n39" value="&lt;b&gt;收 /v1/chat/completions，给这次尝试发一个 attempt 号&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;PD 场景必需：后续每一步都带 attempt 去重&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;pd/edge_runtime.py:97-99&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="44" y="202" width="364" height="51" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;b&gt;见 pd.enabled 就直接交给 PD runtime——不做 DP 打分&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#8a6d3b&quot;&gt;edge 只有 1 卡，它不算整模型，只做信封与汇聚&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;lwd_edge_engine.py:363-371&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="442" y="263" width="364" height="51" as="geometry"/>
        </mxCell>
