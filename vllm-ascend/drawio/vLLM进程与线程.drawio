        <mxCell id="t17" value="⑥ 启动时序：从 bash 到全部 ready，谁在等谁" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="18" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="四段：① 预检与算进程数　② 拉子进程　③ 引擎握手与 worker 起来　④ 就绪与开服。紫线＝控制/启动消息，黄线＝数据面。注意：&lt;b&gt;云端不等对端，边端才逐条等&lt;/b&gt;。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="46" width="1800" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontStyle=1;opacity=45;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
