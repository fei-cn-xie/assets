        <mxCell id="n18" value="" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontStyle=1;opacity=45;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="536" y="324" width="470" height="232" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;b&gt;mp：EngineCore + N 个 worker 进程&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="546" y="332" width="450" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;b&gt;EngineCore 进程&lt;/b&gt;（调度 + 下发）" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
