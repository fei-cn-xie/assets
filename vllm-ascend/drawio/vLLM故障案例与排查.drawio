<mxfile host="drawio" pages="10">
  <diagram id="pg0" name="① 排障方法论">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1366" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="① 排障方法论：先分诊，再定位到「哪一层」，最后用对照实验二分" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：本仓二十多份复盘文档反复用的其实是&lt;b&gt;同一套四步法&lt;/b&gt;——分诊（是崩/挂/慢/错）→ 定位层（前端/引擎/worker/数据面/代码）→ 二分对照 → 固化成断言。本页把这套方法显式画出来，后面九页都是它的实例。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：四步法（顺序不能乱，尤其第 1 步）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;① 分诊&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;先归类：崩 / 挂 / 慢 / 错&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="148" width="340" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;② 定位层&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;确定问题落在哪一层&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="397" y="148" width="340" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="378" y="190" as="sourcePoint"/>
            <mxPoint x="394" y="190" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;③ 二分&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;改一个变量做对照实验&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="758" y="148" width="340" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="739" y="190" as="sourcePoint"/>
            <mxPoint x="755" y="190" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;④ 固化&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;把结论变成断言或监控&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1119" y="148" width="340" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1100" y="190" as="sourcePoint"/>
            <mxPoint x="1116" y="190" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;第二步：分诊——先看「它怎么坏的」，四类走完全不同的路&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="240" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;类别&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="272" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;识别特征&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="236" y="272" width="340" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;第一动作&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="576" y="272" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;本仓实例&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="996" y="272" width="464" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;崩（进程退出）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="312" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;有报错栈 / 退出码非 0&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="312" width="340" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;读栈顶 → 找抛错点&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="576" y="312" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;案例：缺失 def、OOM&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="996" y="312" width="464" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;挂（不动了）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="352" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;无报错、无输出、超时&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="352" width="340" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;抓栈 / 看各进程状态&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="576" y="352" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;案例：边侧 decode 卡死&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="996" y="352" width="464" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;慢（性能劣化）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="392" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;能跑但指标变差&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="392" width="340" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;对比 baseline，找哪一项变了&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="576" y="392" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;案例：图掉出、TTFT/TPOT 劣化&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="996" y="392" width="464" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;错（结果不对）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="432" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;不崩但内容/精度不对&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="432" width="340" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;对拍、逐段二分&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="576" y="432" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;案例：精度 63.80&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="996" y="432" width="464" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="t32" value="&lt;b&gt;第三步：五条贯穿所有案例的原则（都是复盘里反复出现的话）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="480" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="512" width="274" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="t34" value="&lt;b&gt;证据优先于直觉&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="520" width="254" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t35" value="&lt;font style=&quot;font-size:9px&quot;&gt;先看日志/栈/指标，再猜原因；&lt;br&gt;每一次「我觉得是……」都被复盘推翻了。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="544" width="254" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="324" y="512" width="274" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="t37" value="&lt;b&gt;先建立 baseline&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="334" y="520" width="254" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t38" value="&lt;font style=&quot;font-size:9px&quot;&gt;「变差」必须有对照：同一配置、同一负载、&lt;br&gt;改前改后各一次。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="334" y="544" width="254" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="612" y="512" width="274" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="t40" value="&lt;b&gt;按侧/按层二分&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="622" y="520" width="254" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t41" value="&lt;font style=&quot;font-size:9px&quot;&gt;边 vs 云、P vs D、target vs draft、&lt;br&gt;图 vs eager——一次只动一侧。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="622" y="544" width="254" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="900" y="512" width="274" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="t43" value="&lt;b&gt;默认不相信「配置已生效」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="910" y="520" width="254" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t44" value="&lt;font style=&quot;font-size:9px&quot;&gt;开了一个开关，必须找到它生效的日志或指标；&lt;br&gt;找不到就当作没生效。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="910" y="544" width="254" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1188" y="512" width="274" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="t46" value="&lt;b&gt;把结论变断言&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1198" y="520" width="254" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t47" value="&lt;font style=&quot;font-size:9px&quot;&gt;修完要能在下次自动发现：&lt;br&gt;断言、校验、监控项，而不是记在脑子里。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1198" y="544" width="254" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="t48" value="&lt;b&gt;第四步：定位层——每层的「第一手证据」在哪&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="648" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="&lt;b&gt;层&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="680" width="260" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="&lt;b&gt;第一手证据&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="296" y="680" width="700" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="&lt;b&gt;去哪套图查机制&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="996" y="680" width="464" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="&lt;font style=&quot;font-size:11px&quot;&gt;前端（API server）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="714" width="260" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n53" value="&lt;font style=&quot;font-size:11px&quot;&gt;HTTP 状态码、SSE 是否断开、请求日志&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="714" width="700" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n54" value="&lt;font style=&quot;font-size:11px&quot;&gt;进程/线程 ④⑤&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="996" y="714" width="464" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n55" value="&lt;font style=&quot;font-size:11px&quot;&gt;EngineCore&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="748" width="260" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n56" value="&lt;font style=&quot;font-size:11px&quot;&gt;调度日志、engine 死亡帧、忙循环是否在转&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="748" width="700" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n57" value="&lt;font style=&quot;font-size:11px&quot;&gt;进程/线程 ④⑦&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="996" y="748" width="464" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n58" value="&lt;font style=&quot;font-size:11px&quot;&gt;worker（设备侧）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
