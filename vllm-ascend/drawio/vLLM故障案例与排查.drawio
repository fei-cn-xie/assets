  <diagram id="pg2" name="③ 案例：TTFT 拆解">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1542" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="③ 案例二：TTFT 47 秒，但只有 2% 是计算——先拆时间，再谈优化" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="现象：128 并发压测，TTFT p50 &lt;b&gt;47 s&lt;/b&gt;、p90 87 s；第一反应是「P 段算得太慢」。真相：&lt;b&gt;92% 的时间是「请求在等自己被派发」&lt;/b&gt;，P 段真实计算只要 1.4 s，瓶颈在 D 段的输出速度。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：把 47 秒拆成四段（这是本案例最值钱的一张表）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;时段&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="148" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;p50&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="336" y="148" width="220" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;占比&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="556" y="148" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;说明&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="736" y="148" width="724" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;font style=&quot;font-size:11px&quot;&gt;等待派发（排队）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="184" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;45 s&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="184" width="220" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;92%&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="556" y="184" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:11px&quot;&gt;系统整体服务率不足&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="736" y="184" width="724" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;P 段真实计算&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="220" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;1 s&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="220" width="220" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;2%&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="556" y="220" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;三个 chunk 各约 460 ms&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="736" y="220" width="724" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;KV 导出 + 导入&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="256" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;1 s&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="256" width="220" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;6%&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="556" y="256" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;跨机搬运&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="736" y="256" width="724" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;合计&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="292" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;47 s&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="292" width="220" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;100%&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="556" y="292" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;——&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="736" y="292" width="724" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;这个拆解直接推翻第一反应：&lt;/b&gt;如果「TTFT 大」就去找 P 段算力，最多只能优化那 2%（1 秒）。&lt;br&gt;真正的杠杆是&lt;b&gt;提高整条流水线的服务率&lt;/b&gt;——而服务率被 D 段的输出速度卡住了。所以先拆时间，再决定优化谁。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="344" width="1424" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="t25" value="&lt;b&gt;第二步：算系统的物理上限（这一步能判断「是 bug 还是容量不够」）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="446" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:10px&quot;&gt;· D 段单请求最少要 &lt;b&gt;1500 token × 18.5 ms ≈ 27.8 s&lt;/b&gt;；&lt;br&gt;· 能同时跑的请求数约 22 → 理论上限 &lt;b&gt;22 ÷ 27.8 ≈ 0.79 请求/秒&lt;/b&gt;；&lt;br&gt;· 所以 128 个请求至少需要 &lt;b&gt;128 ÷ 0.79 ≈ 162 s&lt;/b&gt; 才能排空——这是这套 1P(2卡)+1D(2卡) 对该负载的&lt;b&gt;物理上限&lt;/b&gt;；&lt;br&gt;· 而实测服务率只有 &lt;b&gt;0.30 请求/秒&lt;/b&gt;，&lt;b&gt;比上限低了 62%&lt;/b&gt;——这部分差距不是硬件问题，而是案例一那个「图掉出」白送的。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="476" width="1424" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="t27" value="&lt;b&gt;第三步：测量本身有三个坑（不校验会得出错 2~6 倍的数）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="606" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="636" width="460" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="t29" value="&lt;b&gt;坑一：用错了派生指标&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="644" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t30" value="&lt;font style=&quot;font-size:10px&quot;&gt;日志里的「每秒步数」是&lt;b&gt;含空排的平均步间隔&lt;/b&gt;；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;要算真实步时必须是 &lt;b&gt;10 秒 ÷ 该窗口内的步数&lt;/b&gt;。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;两者能差 2~6 倍——直接用前者会把步时算小。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="670" width="440" height="138" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="518" y="636" width="460" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="t32" value="&lt;b&gt;坑二：跨机时间戳不可信&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="644" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t33" value="&lt;font style=&quot;font-size:10px&quot;&gt;边端与云端时钟不同步（实测边端快约 110 秒）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以跨机拼接时间戳做端到端会直接错，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;只能用&lt;b&gt;同一台机器上的阶段边界&lt;/b&gt;做差。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="670" width="440" height="138" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1000" y="636" width="460" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="t35" value="&lt;b&gt;坑三：生存者偏差&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="644" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t36" value="&lt;font style=&quot;font-size:10px&quot;&gt;128 个请求里只有 74 个完成、106 个拿到过 token；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;剩下 54 个「连第一个 token 都没拿到」根本不在分位数里。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 真实 TTFT 分布被截断，&lt;b&gt;p50 是乐观值&lt;/b&gt;。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="670" width="440" height="138" as="geometry"/>
        </mxCell>
        <mxCell id="t37" value="&lt;b&gt;第四步：没有端到端打点时，怎么量（用四个阶段边界做差）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="826" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;font style=&quot;font-size:10px&quot;&gt;P 侧收到请求 → D 侧接纳 → D 侧就绪 → 完成，四个时刻各有一条日志；因为本负载所有请求的输出长度恒为 1500，所以 &lt;b&gt;TPOT = （完成 − 就绪）÷ 1499&lt;/b&gt; 就是干净的，不受 prompt 长度差异影响。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;前提：P/D 在同一台机器上（本案例确实如此）；跨机时必须先校准时钟，否则这个减法没有意义。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="856" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;b&gt;第五步：根因是「双重的」，必须分开说&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;TTFT 主因 = 容量不足&lt;/b&gt;（物理上限 0.79，实测 0.30）→ 优化方向是提服务率，不是加 P 算力；&lt;br&gt;② &lt;b&gt;TPOT 主因 = 配置 bug&lt;/b&gt;（案例一那个图掉出，把服务率从 0.79 打到 0.30）→ 改一个桶列表就能回收 62%；&lt;br&gt;③ 其余次要项：KV 导入排队、首 token 独占一个调度窗口、三个 chunk 三次跨机握手、空转抢 CPU。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;报告里必须这样分开写，否则「加机器」和「改配置」会被混为一谈。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="992" width="1424" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：本案例的结论依赖「图确实掉出了」这个推断。下一步（④）看一个「指标明明在、但全都是零」的案例——它教会我们「零有几种含义」。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1140" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;复盘原文：pds_comm_ww_TTFT_TPOT_劣化分析.md（四段拆解 :57-73、生存者偏差 :79-83、服务率与物理上限 :87-115、测量口径校验 :49-53、时钟不同步 :4、修复表 :249-266）&lt;br&gt;「每步只算 1+K 个 query」的背景：见 MTP 套 ⑦；图掉出机制见本套 ②&lt;br&gt;服务率与并发的关系：见「进程与线程」套 ⑪⑫（调度器每步挑一批）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1216" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="&lt;b&gt;一句话记住这个案例：&lt;/b&gt;面对「延迟大」，第一步永远是&lt;b&gt;把时间拆开&lt;/b&gt;——排队、计算、传输各占多少；第二步是&lt;b&gt;算物理上限&lt;/b&gt;，判断差距是「硬件不够」还是「配置白送」；&lt;b&gt;第三步才是优化。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1352" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t43" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1444" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1441" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1441" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1441" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1441" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1441" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1441" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1441" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e51" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1490" as="sourcePoint"/>
            <mxPoint x="204" y="1490" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t52" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1478" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e53" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1490" as="sourcePoint"/>
            <mxPoint x="454" y="1490" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t54" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1478" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e55" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1490" as="sourcePoint"/>
            <mxPoint x="704" y="1490" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t56" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1478" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg3" name="④ 案例：指标全零">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1540" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="④ 案例三：spec_decode 指标全是零，是接受率 0% 吗？" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="现象：&lt;code&gt;/metrics&lt;/code&gt; 里 spec decode 四个计数器全是 0，但位置标签 0/1/2 都在。第一反应：「MTP 挂了」。真相：&lt;b&gt;「计数器为 0」至少有四种含义&lt;/b&gt;，而其中一种是&lt;b&gt;正常态&lt;/b&gt;。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：「零」的四种含义（处置完全不同）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;含义&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="148" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;指标形态&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="296" y="148" width="400" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;解释&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="696" y="148" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;处置&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1116" y="148" width="344" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;font style=&quot;font-size:11px&quot;&gt;① 这个角色本来就不产生&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="188" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;font style=&quot;font-size:11px&quot;&gt;计数器注册了、永远为 0&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="188" width="400" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;正常态&lt;/b&gt;（P 侧只算 prefill，没有 decode 验证步）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="696" y="188" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:11px&quot;&gt;按角色排除告警&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1116" y="188" width="344" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;② 功能压根没启动&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="228" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;配置里没有投机，计数器&lt;b&gt;根本不注册&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="228" width="400" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;连标签都不会出现&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="696" y="228" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;查配置&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1116" y="228" width="344" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;③ 启动了但没走 draft&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="268" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;标签在、drafts 也是 0&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="268" width="400" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;调度器从不排 draft&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="696" y="268" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;查调度与日志三条证词&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1116" y="268" width="344" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;④ 走了但全被拒&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="308" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;drafts &amp;gt; 0，accepted == 0&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="308" width="400" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;接受率真的 0%（草案太差）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="696" y="308" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;换 draft 策略&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1116" y="308" width="344" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;本次实测的形态是第 ③ 种：&lt;/b&gt;标签在（说明配置里有 K=3），但 &lt;b&gt;drafts 和 draft_tokens 都是 0&lt;/b&gt;——说明计数链的&lt;b&gt;起点&lt;/b&gt;就从未成立，不是「全被拒」（那样 drafts 会大于 0）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="364" width="1424" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="t25" value="&lt;b&gt;第二步：一条五跳判定链（逐个排除，每跳都有检查动作）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="450" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;① 进程在吗&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;其它计数器在涨吗&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="480" width="270" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;② 角色是什么&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;P / D / edge&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="317" y="480" width="270" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e28" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="308" y="522" as="sourcePoint"/>
            <mxPoint x="316" y="522" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n29" value="&lt;b&gt;③ 配置有 K 吗&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;看标签是否存在&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="598" y="480" width="270" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e30" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="589" y="522" as="sourcePoint"/>
            <mxPoint x="597" y="522" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;④ 调度排 draft 了吗&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;看引擎内日志&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="879" y="480" width="270" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e32" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="870" y="522" as="sourcePoint"/>
            <mxPoint x="878" y="522" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;⑤ 统计送到了吗&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;看是否有丢弃/异常&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1160" y="480" width="270" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e34" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1151" y="522" as="sourcePoint"/>
            <mxPoint x="1159" y="522" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t35" value="&lt;b&gt;第三步：两个关键判据（学会就能省下大量时间）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="574" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="604" width="700" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t37" value="&lt;b&gt;判据一：「壳在」只证明构造函数跑过&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="612" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t38" value="&lt;font style=&quot;font-size:10px&quot;&gt;位置标签来自「按 K 生成 0…K-1」，`_created` 来自对象创建时刻——&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;两者都只依赖&lt;b&gt;配置&lt;/b&gt;，不依赖&lt;b&gt;数据流&lt;/b&gt;。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以「标签齐全」不能证明功能在跑。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;（顺带：那个 1.79e9 的大数是「创建时间戳」，不是次数——别把它读成 drafts 数。）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="638" width="680" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="604" width="664" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t40" value="&lt;b&gt;判据二：用不变量自检&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="612" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t41" value="&lt;font style=&quot;font-size:10px&quot;&gt;健康时三个数必须同时成立：&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① draft_tokens ÷ drafts ≈ K；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;② 逐位置接受数&lt;b&gt;单调递减&lt;/b&gt;（越往后越难中）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;③ 逐位置之和 = 接受总数。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;任何一条不成立，就说明统计链或功能链有问题。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="638" width="644" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="&lt;b&gt;第四步：为什么 P 侧恒零是正常的（这是最容易被误报的一条）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本仓的 P 侧与 D 侧&lt;b&gt;都带同样的投机配置&lt;/b&gt;（K=3），所以两侧都会注册这四族指标；但 P 侧只算 prefill、没有 decode 的验证步 → 「本步要验证的草案」集合长期为空 → 计数恒为 0。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;所以「指标名相同 + 两侧同配置」会天然制造假阳性：监控面板必须&lt;b&gt;按角色分实例抓取&lt;/b&gt;，否则 P 侧的恒零会污染 D 侧的接受率分母。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="820" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="&lt;b&gt;第五步：本案例的最终结论（如实标注：文档自身留了三个候选）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;文档给出三种可能：A 侧别正常态（P 侧）、B 前端统计链在某分支上不可靠（仓内注释自认这块薄弱）、C 进程刚起或窗口内没跑 decode 流量。并明确「数据本身定不了」，需再跑三条命令才能定案。&lt;br&gt;&lt;b&gt;这正是本案例最值得学的地方：&lt;u&gt;敢于把结论写成「待定」并给出定案命令&lt;/u&gt;，而不是硬编一个根因。&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="976" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：这是「静默失效」类故障。下一步（⑤）看最严重的一类——级联故障：一个请求放不下，最后整个集群挂住。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1120" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;复盘原文：pds_comm_spec_decode指标全零分析.md（四族指标 :4、_created 定性 :13-24、标签与配置 :27、三种解释 :35-38、判定链 :65-80、多条证词命令 :116-167、正常态对照 :181-198、恒等式自检 :194-198）&lt;br&gt;「没有配置就不注册计数器」：vllm/v1/spec_decode/metrics.py:150-152&lt;br&gt;位置标签按 K 生成：同文件 :181-198&lt;br&gt;指标丢弃与冻结：vllm/v1/engine/async_llm.py:761-775（record 无条件、异常后冻结）&lt;br&gt;前端统计链薄弱的自认注释：lwd_cloud_mixed_scheduler.py:107-115&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1196" width="1424" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="&lt;b&gt;一句话记住这个案例：&lt;/b&gt;看到「指标为零」先问三件事——&lt;b&gt;这个角色该不该产生它？壳在是否等于在跑？分子为 0 还是分母为 0？&lt;/b&gt;答案不同，处置完全相反。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1350" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t47" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1442" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1439" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1439" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1439" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1439" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1439" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n53" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1439" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n54" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1439" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n55" value="正常态，不要告警" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1439" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e56" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1488" as="sourcePoint"/>
            <mxPoint x="204" y="1488" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t57" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1476" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e58" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1488" as="sourcePoint"/>
            <mxPoint x="454" y="1488" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t59" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1476" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e60" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1488" as="sourcePoint"/>
            <mxPoint x="704" y="1488" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t61" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1476" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg4" name="⑤ 案例：级联故障">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑤ 案例四：从「一个请求放不下」到「整个集群挂住」的四级级联" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="现象：请求无限期挂起（ttl 1800 s），edge 与 prefill 都在空转、不报错。真相：&lt;b&gt;decode 引擎早就死了&lt;/b&gt;——第一个 fatal 发生在几分钟前；后面看到的「卡死」是三个独立缺陷串成的级联。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：四级级联（时间顺序从下往上读，但根因在最下面）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;④ 客户端全 500&lt;/b&gt;　&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;边侧 EngineCore 也终止，在飞请求全失败&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="96" y="146" width="1300" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;③ 边侧闸门死锁&lt;/b&gt;　&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;台账永不释放 → 闸门永久 HOLD → 请求不再派发&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="96" y="232" width="1300" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;② prefill 水位冻结&lt;/b&gt;　&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;收不完整 → 水位不推进 → prefill 停止发包&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="96" y="318" width="1300" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;① decode 引擎死亡&lt;/b&gt;　&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;KV 分配失败 → 抢占 → 硬编码 raise → 整个引擎退出&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="96" y="404" width="1300" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="736" y="218" as="sourcePoint"/>
            <mxPoint x="736" y="230" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="736" y="304" as="sourcePoint"/>
            <mxPoint x="736" y="316" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="736" y="390" as="sourcePoint"/>
            <mxPoint x="736" y="402" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;第二步：第一因是「准入判据不完备」（一个判断少写了一部分）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="484" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:10px&quot;&gt;准入时问的是：&lt;b&gt;「这一个请求，此刻放得下吗？」&lt;/b&gt;（单个请求 vs 当前空闲块）&lt;br&gt;但真正需要保证的是：&lt;b&gt;「所有已准入请求的需求总和，永远不超过总容量」&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;前者既不包含、也不蕴含后者。&lt;/font&gt;于是 32 个请求各自「此刻都放得下」，合起来却超过了块池——直到某一步分配失败，走到那条硬编码的「LWD 不允许抢占」断言上。&lt;br&gt;数量级验证：32 × 每请求块数 ≈ 块池总容量，而两侧的 &lt;font style=&quot;font-size:9px&quot;&gt;max-num-seqs&lt;/font&gt; 都写着 128——准入上限大约是实际可容纳并发的 &lt;b&gt;4 倍&lt;/b&gt;。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="514" width="1424" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t13" value="&lt;b&gt;第三步：三个「放大器」把一个可恢复的失败放大成集群级 hang&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="656" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="686" width="460" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;b&gt;① 失败粒度错了&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="694" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;font style=&quot;font-size:10px&quot;&gt;「一个请求放不下」被写成了「整个引擎退出」——&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;硬编码 raise 让调度器的单请求失败升级为进程级 fatal。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;正确形态：标记该请求失败 → 交给调度器正常终结 → 引擎活着。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="720" width="440" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="518" y="686" width="460" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;b&gt;② 台账没有租约&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="694" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;font style=&quot;font-size:10px&quot;&gt;边侧每条 chunk 都有一个「待释放」台账，只在两个时刻摘：&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;收到首 token / 请求结束。下游死了 → 两件事都不会发生。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 台账永久占着，闸门永久 HOLD。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="720" width="440" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1000" y="686" width="460" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;b&gt;③ 没有任何超时与死亡检测&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="694" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t22" value="&lt;font style=&quot;font-size:10px&quot;&gt;没有对端存活检测、没有请求级超时、数据面收包只能死等。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以「等一个永远不来的东西」可以无限持续下去，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;表现就是「空转 680 步/秒，什么都不推进」。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="720" width="440" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;b&gt;第四步：两个「看起来像正常，其实是故障指纹」的指标&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="886" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;指标形态&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="916" width="460" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;第一反应&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="496" y="916" width="420" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;真相&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="916" y="916" width="544" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;running 数单调爬升、一次都没回落&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="958" width="460" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;以为：吞吐在健康增长&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="496" y="958" width="420" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;真相：&lt;b&gt;背压没生效&lt;/b&gt;（只做了「单请求此刻够不够」的检查，没有全局账本）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="916" y="958" width="544" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;空转步数很高（edge 680、prefill 420 步/秒）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1000" width="460" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;以为：负载很高 / 在忙&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="496" y="1000" width="420" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;真相：在&lt;b&gt;等一个不会来的东西&lt;/b&gt;，空转不是干活&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="916" y="1000" width="544" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;第五步：修法是「让它结构上不可能发生」，而不是「让它变得可行」&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;把准入做成账本&lt;/b&gt;：admit 即预留，校验改成「本请求需求 + 已预留总和 ≤ 总容量」→ 那条抢占断言变成&lt;b&gt;结构上不可达&lt;/b&gt;。&lt;br&gt;② &lt;b&gt;把致命抢占降级为单请求失败&lt;/b&gt;（不再 raise）。&lt;br&gt;③ &lt;b&gt;给台账加租约&lt;/b&gt;（30 s 未释放 → 摘台账 + 请求失败）→ 任何上游单点故障都在 30 s 内变成「请求失败」而不是「集群挂住」。&lt;br&gt;④ &lt;b&gt;接上已有的恢复手段&lt;/b&gt;：仓里那个「跳过序号」的恢复函数&lt;b&gt;当时根本没有调用方&lt;/b&gt;，要接线 + 加接收超时。&lt;br&gt;⑤ 把并发上限由 KV 容量反推（本场景约 24~26，而不是 128）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1072" width="1424" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;第六步：回归怎么判「真的好了」（三条都能自动跑）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① 并发曲线&lt;b&gt;有升有降且有上限&lt;/b&gt;（不再单调爬），全程「导入被拒」为 0；&lt;br&gt;② &lt;font style=&quot;font-size:9px&quot;&gt;kill -9&lt;/font&gt; 掉 decode 进程，边侧应在 30 s 内把在飞请求判错，prefill 不出现无限「收不完整」；&lt;br&gt;③ 边侧日志里不再有「控制面投递停滞」的 fatal，只有 error + 丢弃。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="1244" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：这是最坏形态。下一步（⑥）看一个更隐蔽的：什么都不报错，只是显存一点点涨到 OOM。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1380" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;复盘原文：pds_comm_ww_边侧_decode_卡死_根因与修复.md（时序 :32-59、不变量论证 :93-102、指纹式证据 :127-130、数量级 :130、修复 P0-1…P0-5 :139-359、回归判据 :406-408）&lt;br&gt;抢占即抛异常：vllm/v1/lwd_control/control_scheduler/lwd_base_scheduler.py:106&lt;br&gt;准入只判「单请求 vs 当前空闲」：lwd_cloud_mixed_scheduler.py:373&lt;br&gt;台账释放只有两个时刻：lwd_edge_scheduler.py（释放点与闸门逻辑）&lt;br&gt;「跳过序号」恢复函数无调用方：pre_recv.py:230-236（docstring 自述）&lt;br&gt;时钟不同步（边侧快约 110 s）：必须先对齐再读时序&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1456" width="1424" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;b&gt;一句话记住这个案例：&lt;/b&gt;级联故障的根因往往只有一个「判断少写了一部分」，但被三个放大器放大成集群级事故：&lt;b&gt;失败粒度、台账租约、超时与死亡检测&lt;/b&gt;。修的时候要让它结构上不可能发生，而不是让它变得可行。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1610" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t38" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1702" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1699" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1699" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1699" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
