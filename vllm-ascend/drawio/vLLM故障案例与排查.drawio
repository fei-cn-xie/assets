  <diagram id="pg7" name="⑧ 案例：精度归因">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1590" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑧ 案例七：精度从 89 掉到 63.8，第一版归因是错的（而且分数能精确复现）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="现象：TextVQA 准确率 &lt;b&gt;63.80&lt;/b&gt;，全程不崩、无 500、无 OOM。第一版结论：「主因是思维链吃光了输出预算」。&lt;b&gt;这个结论能精确复现 63.80，但它是错的&lt;/b&gt;——真因是位置编码偏移。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：精度类故障的第一件事——分流「不会算」还是「不会说」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;口径&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="146" width="400" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;分数&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="436" y="146" width="220" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;它告诉你什么&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="656" y="146" width="804" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;font style=&quot;font-size:11px&quot;&gt;严格判据&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="184" width="400" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;font style=&quot;font-size:11px&quot;&gt;63.80&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="436" y="184" width="220" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;font style=&quot;font-size:11px&quot;&gt;官方口径：答案需精确匹配&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="184" width="804" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;font style=&quot;font-size:11px&quot;&gt;放宽判据（答案含标准答案即算对）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="222" width="400" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;89.00&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="436" y="222" width="220" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;说明&lt;b&gt;模型确实读到了图&lt;/b&gt;、内容没错&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="222" width="804" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;只看「没被截断」的那 80 条&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="260" width="400" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;80.00（放宽后 93.75）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="436" y="260" width="220" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;说明截断确实吃掉一部分分&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="260" width="804" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;分流结论：81% 的题其实答到了正确内容&lt;/b&gt; → 链路没有「算错」，于是第一版把损失全部归给「输出太长 / 被截断」。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;但这一步只解释了「丢分的形式」，没有解释「为什么会答偏」——这正是第一版结论错的地方。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="314" width="1424" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;b&gt;第二步：第一版结论错在哪（这是本案例最贵的教训）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="416" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="446" width="700" height="186" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;b&gt;第一版：主因 = 思维链 + 输出预算&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="454" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;font style=&quot;font-size:10px&quot;&gt;证据：20 条输出没有结束标记，长度≈2046 token，正好卡在 2048 上限；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;放宽判据后 89 分；关掉思考模式后分数回升。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;而且用官方评分器重放，能精确复现 63.80。&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 看起来「证据链完整」。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="480" width="680" height="144" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="796" y="446" width="664" height="186" as="geometry"/>
        </mxCell>
        <mxCell id="t22" value="&lt;b&gt;它错在：把「症状」当成了「原因」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="454" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;font style=&quot;font-size:10px&quot;&gt;复现分数只校验了&lt;b&gt;评分口径&lt;/b&gt;，没有校验&lt;b&gt;因果链&lt;/b&gt;。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;「关掉思考」只是&lt;b&gt;把症状藏起来&lt;/b&gt;：位置偏移让模型答非所问、思维链打转，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;关掉思考就不再打转，分数回升——但错位本身还在。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;所以那个「修复」后来被撤销了。&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="480" width="644" height="144" as="geometry"/>
        </mxCell>
        <mxCell id="t24" value="&lt;b&gt;第三步：真因怎么找到的——去查「两侧算出的位置」是否一致&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="642" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:10px&quot;&gt;同一批请求，P 侧与 D 侧各打一条「位置偏移」日志：P 侧是 &lt;b&gt;−640&lt;/b&gt;，D 侧是 &lt;b&gt;−1&lt;/b&gt;；100 条请求全都同型。&lt;br&gt;含义：&lt;b&gt;生成段每个 token 的绝对位置，与 prefill 写 KV 时用的位置相差 639&lt;/b&gt;。&lt;br&gt;于是模型在「位置对不上的上下文」上续写——&lt;b&gt;输出流畅、不报错，但系统性答非所问&lt;/b&gt;；并且容易打转、退化（出现过 7000 字符的循环、1941 个连续同字符），最后撞上输出上限被截断。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;这同时解释了第一版看到的全部现象：截断、冗长、以及「答案里的词明明对」。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="672" width="1424" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="844" width="1424" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="t27" value="&lt;b&gt;为什么会算出 −1（机理，一句话）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="852" width="1404" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;font style=&quot;font-size:10px&quot;&gt;D 侧的位置表初始是「按纯文本从 0 连续排」；PD 分离下 D 侧实际只收到「尾窗」那一小段，于是按「窗口最大值」反推偏移时，&lt;b&gt;那些没被覆盖的初始残值（约等于 prompt 长度）占了主导&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 偏移塌成 −1。修法是让 D 侧采用&lt;b&gt;边侧下发的整段位置最大值&lt;/b&gt;，并按接收端 prompt 长度裁剪，避免 P 侧偏差 1。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="878" width="1404" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="t29" value="&lt;b&gt;第四步：精度类还有一个必须知道的数字——单轮噪声底 ±10&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="984" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:10px&quot;&gt;同一批样本、温度 0、连跑 8 次：总分在 &lt;b&gt;46~74&lt;/b&gt; 之间波动；&lt;b&gt;100 条里有 52 条出现过「这轮对、那轮错」&lt;/b&gt;。&lt;br&gt;所以：① &lt;b&gt;单轮数字不足以判定回归&lt;/b&gt;，要跑 3 轮取均值；② 想压低噪声得固定批形（小并发）或让边侧直接采用云侧 token（协议上刻意不做）；③ 反例也很有用：&lt;b&gt;加大输出预算并没有提升精度&lt;/b&gt;——两次更大预算的运行里，截断数反而更多（25/29 条），严格精度只有 49.9/49.6。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="1014" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：精度类最难的是「输出流畅且不报错」。下一步（⑨）看最后一类——根因根本不在配置与数据面，而在代码本身被搬坏了。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1170" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;复盘原文：pds_mma_bugfix3_第三轮_精度63.80_归因与修复.md（三口径 :93-97、历史 8 次 :110-125、噪声底 :121-125、加大预算无效 :173-175、usage 兜底 :186-201）、pds_mma_bugfix3_第四轮_mrope_delta_根因更正与合并.md（更正判词 :26-27、:117、两侧 delta 对照 :35-39、机理 :56-58、对账指标 :97-101、修复提交 :70-81）&lt;br&gt;位置退让与位置表构造：vllm/v1/core/sched/scheduler.py:1275-1294&lt;br&gt;单轮噪声与固定批形的关系：见「组合配置」套 ⑤（调度平顺性）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1246" width="1424" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;一句话记住这个案例：&lt;/b&gt;「分数能复现」只证明评分口径对，&lt;b&gt;不证明归因对&lt;/b&gt;；精度问题要先分流「不会算 / 不会说」，再去对拍两侧的关键量（这里是位置偏移），并且永远用&lt;b&gt;多轮均值&lt;/b&gt;判断回归。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1400" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t34" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1492" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1489" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1489" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1489" width="120" height="26" as="geometry"/>
