          <mxGeometry x="836" y="316" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;关键特征：这是「拐点」，不是「斜率」。&lt;/b&gt;20→22 只有 3 ms 的平缓增长，25→26 却突然 +42%。算力随批量增长一定是平滑的，&lt;b&gt;不连续跳变说明某处发生了二值判定&lt;/b&gt;——这是本次定位的突破口。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="366" width="1424" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="t29" value="&lt;b&gt;第二步：把阈值算出来（三步，每步都能在代码里指到）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="452" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:10px&quot;&gt;① 开 MTP 后，每个请求一步要排 &lt;b&gt;1 + K = 4&lt;/b&gt; 个 token 位 → 每步 token 数 = &lt;b&gt;4 × 序列数&lt;/b&gt;。&lt;br&gt;② 图的上限是 &lt;b&gt;100&lt;/b&gt;（脚本里写死的 capture_sizes 最大值）。&lt;br&gt;③ 所以能命中图的并发上限 = &lt;b&gt;100 ÷ 4 = 25&lt;/b&gt;；第 26 个请求就让每步变成 104 个 token → &lt;b&gt;超过 100 → 判定 NONE → 退回 eager&lt;/b&gt;。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="482" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="t31" value="&lt;b&gt;第三步：为什么从来没人发现（这段配置「曾经是死的」）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="596" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="626" width="700" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="t33" value="&lt;b&gt;三个上游缺口，全都不告警&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="634" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t34" value="&lt;font style=&quot;font-size:10px&quot;&gt;① 框架会替你把上限「取整到 K+1 的倍数」，但&lt;b&gt;不会把上限本身放大&lt;/b&gt;；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;② 不命中就返回 NONE，&lt;b&gt;没有 warning&lt;/b&gt;；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;③ 唯一的不变量校验（上限 ≥ 序列数 ×(1+K)）被一个无关条件挡住，实际不生效。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="660" width="680" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="796" y="626" width="664" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="t36" value="&lt;b&gt;而且它长期是「死配置」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="634" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t37" value="&lt;font style=&quot;font-size:10px&quot;&gt;在 P 侧与 edge 开着全局 eager 的那段时间里，这串 capture_sizes 完全不生效，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以从未被验证过。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;它是在「同一次提交里既启用图、又开 MTP」的那一刻才变成活的&lt;/b&gt;——&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;一活就直接越界。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="660" width="644" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="t38" value="&lt;b&gt;第四步：修复的正确形态（不是「调大一个数」）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="796" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;要满足一条不变量：图的最大桶 ≥ 最大并发 × (1+K)&lt;/b&gt;，并让两个数互相兜底。&lt;br&gt;本案例的修法是：把并发压到 KV 撑得住的 &lt;b&gt;24&lt;/b&gt;，同时把桶扩到 &lt;b&gt;128&lt;/b&gt;（24 × 4 = 96 ≤ 128）→ 稳态全程命中图。&lt;br&gt;只扩桶不压并发：要么桶不够（继续掉出），要么 KV 撑不住（另一个坑）；只压并发不扩桶：并发上限被图卡死，与 KV 实际能力不匹配。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="826" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;b&gt;第五步：预防（这是本案例最值钱的部分）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;启动时就打一行「图的覆盖范围」&lt;/b&gt;：&lt;font style=&quot;font-size:9px&quot;&gt;graph covers up to N concurrent seqs (max_capture=100, query_len=4); max_num_seqs=128 → above 25 runs eager&lt;/font&gt; —— 有这一行，事故在拉起阶段就能发现。&lt;br&gt;② 把「静默回落」改成 &lt;b&gt;warning&lt;/b&gt;；③ 把「模式变化」从 DEBUG 提到 INFO（只在变化时打）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="982" width="1424" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：这是「配置单位算错」类故障的母本。下一步（③）看它引发的连锁后果——同样的图掉出，在压测报表上表现为「TTFT 47 秒」。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1130" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;复盘原文：pds_comm_ww_主因_ACL图掉出_根因与修复.md（现象 :4、步时表 :84-90、拐点论证 :92、阈值推导 :31-80、git 反查 :116-143、修复 :238-247、预防 :294-301）&lt;br&gt;查询长度 = 1+K：vllm/v1/cudagraph_dispatcher.py:37-41&lt;br&gt;超上限即返回 NONE（无日志）：vllm/v1/cudagraph_dispatcher.py:276-285&lt;br&gt;上限自动「取整到 K+1 倍数」但不放大：vllm/config/compilation.py:1473-1518&lt;br&gt;唯一可观测的模式日志：vllm-ascend/vllm_ascend/compilation/acl_graph.py:243（info_once）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1206" width="1424" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="&lt;b&gt;一句话记住这个案例：&lt;/b&gt;配置里的数字是&lt;b&gt;带单位&lt;/b&gt;的——「100」在「1 序列 = 1 token」的世界里是 100 并发，在 MTP×4 的世界里只剩 25；&lt;b&gt;凡是改了前端算法（K），必须同步换算后端容量（桶、预算、槽）。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1352" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t44" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1444" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1441" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1441" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1441" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1441" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1441" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1441" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1441" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="配置与容量相关" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1441" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e53" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1490" as="sourcePoint"/>
            <mxPoint x="204" y="1490" as="targetPoint"/>
