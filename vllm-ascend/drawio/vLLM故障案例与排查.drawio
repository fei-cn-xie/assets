  <diagram id="pg5" name="⑥ 案例：autograd 图泄漏">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1478" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑥ 案例五：边侧权重只有 5.6 GB，显存却涨到 59 GB" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="现象：边侧 Worker OOM（&lt;b&gt;已分配 59.05 GiB&lt;/b&gt;，而边侧权重只有 &lt;b&gt;5.6 GiB&lt;/b&gt;）。第一反应：「跑起来本来就吃满 / 碎片化」。真相：&lt;b&gt;整条边侧前向跑在「开梯度」状态下，计算图被缓存钉住&lt;/b&gt;——每张图约 1.4 GiB。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：先算三个数，判断「它该不该涨」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="148" width="460" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;权重 5.6 GiB&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="158" width="440" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;font style=&quot;font-size:10px&quot;&gt;卡总容量 60.96 GiB&lt;br&gt;起步应有 ~55 GiB 余量&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="184" width="440" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="508" y="148" width="460" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;已分配 59.05 GiB&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="518" y="158" width="440" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;font style=&quot;font-size:10px&quot;&gt;增长 53.4 GiB&lt;br&gt;38 张图 → &lt;b&gt;约 1.4 GiB/张&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="518" y="184" width="440" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="980" y="148" width="460" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;KV 预分配 0&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="990" y="158" width="440" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;font style=&quot;font-size:10px&quot;&gt;边侧零层拓扑&lt;br&gt;&lt;b&gt;没有 KV 可回收兜底&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="990" y="184" width="440" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="t13" value="&lt;b&gt;第二步：把「本来就该吃满」的四种解释逐条排除（这一步才省时间）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="274" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;假设&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="304" width="260" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;反证&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="296" y="304" width="720" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;结论&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1016" y="304" width="424" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;容量本来小&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="342" width="260" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;权重只 5.6 GiB、总容量 60.96 GiB&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="342" width="720" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;起步就有 55 GiB 余量&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1016" y="342" width="424" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;KV cache 涨的&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="380" width="260" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;边侧零层拓扑，KV 规格是空集，初始化只用了 0.03 s&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="380" width="720" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;根本没有 KV 预分配&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1016" y="380" width="424" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;数据载荷堆积&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="418" width="260" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;上行约 0.3 GiB、下行 183 批合计约 66 MiB&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="418" width="720" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;比泄漏量小两个数量级&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1016" y="418" width="424" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;碎片化 / 性能退化&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="456" width="260" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;每步耗时全程 75~85 ms，没有随运行时长恶化&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="456" width="720" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;不是打滑，是真占住了&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1016" y="456" width="424" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="t29" value="&lt;b&gt;第三步：机理链（四步，每步都能在代码里指到）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="500" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:10px&quot;&gt;① 边侧 Worker &lt;b&gt;覆写&lt;/b&gt;了框架的「执行一步」方法，直接调模型子模块——而&lt;b&gt;原方法上带着「不建计算图」的装饰器&lt;/b&gt;，覆写后就丢了；&lt;br&gt;② 于是整条边侧前向跑在&lt;b&gt;开梯度&lt;/b&gt;状态下：视觉塔每次前向都建一张计算图，输出张量带着「梯度追溯链」；&lt;br&gt;③ 这个输出被放进&lt;b&gt;请求级缓存&lt;/b&gt;，而 PD 场景下这份缓存&lt;b&gt;到请求结束才释放&lt;/b&gt;；&lt;br&gt;④ 于是&lt;b&gt;图 + 视觉塔全部层激活&lt;/b&gt;被一起钉住：一张图约 1.4 GiB，35 个在飞就是 50 GiB+ → 必撞顶。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="530" width="1424" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t31" value="&lt;b&gt;第四步：两个反直觉的观察（学会能少走很多弯路）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="672" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="702" width="700" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t33" value="&lt;b&gt;① OOM 报的位置不是元凶&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="710" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t34" value="&lt;font style=&quot;font-size:10px&quot;&gt;报错在视觉塔内部的 attention 算子（只差 78 MiB）、&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;两秒后又在排序算子（68 MiB）再炸一次。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;那是「卡已经满了、只差最后一个大分配」的&lt;b&gt;落点&lt;/b&gt;，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;不是「这个算子要得多」。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="736" width="680" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="796" y="702" width="664" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t36" value="&lt;b&gt;② 它是被「修好上一个 bug」暴露出来的&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="710" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t37" value="&lt;font style=&quot;font-size:10px&quot;&gt;更早的几轮里，同一个部署在 31 条请求时就先被另一个缺陷打死，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;来不及跑到 OOM。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;「上一轮的问题修好了」不等于「系统健康」——&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;它只是让下一层缺陷有机会显形&lt;/b&gt;。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="736" width="644" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;b&gt;第五步：修复三件套（根因 + 双保险 + 可观测性）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;给覆写的方法补上「无梯度」上下文&lt;/b&gt;（本案例用「不建图」而非更激进的模式，因为方法内要对锁页内存取 numpy 视图，受后者限制）；&lt;br&gt;② &lt;b&gt;写缓存前再 detach 一次&lt;/b&gt;（双保险：即使将来有人再绕过装饰器，也不会把图带进缓存）；&lt;br&gt;③ &lt;b&gt;把内存打出来&lt;/b&gt;：每步日志追加「已分配 / 峰值」与「缓存张量个数」——复盘里明说「这次是靠事后推算出来的，下次不该再这样」。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="910" width="1424" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：本案例是「覆写框架方法丢了隐含契约」。下一步（⑦）是同一个教训的另一种表现——覆写之后把「该归还的东西」忘了归还。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1050" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;复盘原文：pds_mma_bugfix3_第二轮_边侧NPU_OOM_根因与修复.md（OOM 头 :32-34、栈与落点 :36-42、权重与 KV :52-68、四条排除 :62-72、每图增长量 :76-79、代码链 :83-96、历史对照 :98-108、修复 :116-128、判定标准 :147-148）&lt;br&gt;被覆写的方法与原方法的装饰器：lwd_edge_worker.py:194（覆写）、model_runner_v1.py:1924（@torch.inference_mode()）&lt;br&gt;上游三处都没有梯度上下文：worker.py:613、worker_base.py:349、multiproc_executor.py:1214&lt;br&gt;缓存与常驻：_lwd_mm_embeds_dict（请求级缓存）、lwd_edge_scheduler.py:2644（retain_mm=True）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1126" width="1424" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;b&gt;一句话记住这个案例：&lt;/b&gt;覆写框架方法 = 连带丢掉它的&lt;b&gt;隐含契约&lt;/b&gt;（这里是「不建计算图」）；而「缓存 + 常驻」会把任何泄漏放大几十倍。&lt;b&gt;内存类问题先算「每单位增长量 × 单位数」，再去找是谁把它钉住了。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1288" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t42" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1380" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1377" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1377" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1377" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1377" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1377" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1377" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1377" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="常驻/无 KV 兜底" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1377" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e51" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1426" as="sourcePoint"/>
            <mxPoint x="204" y="1426" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t52" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1414" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e53" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1426" as="sourcePoint"/>
            <mxPoint x="454" y="1426" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t54" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1414" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e55" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1426" as="sourcePoint"/>
            <mxPoint x="704" y="1426" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t56" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
