  <diagram id="pg8" name="⑨ 案例：代码缺陷">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1534" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑨ 案例八：配置全对、脚本全对，但代码被搬坏了——「调用点还在，定义没了」" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="现象：decode 侧一起就崩。根因：&lt;b&gt;分支移植时丢了一行 &lt;code&gt;def&lt;/code&gt;，方法体被并进了相邻方法&lt;/b&gt;——调用点存在、定义不存在，一调就崩。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：这类缺陷长什么样（一行之差，形态很隐蔽）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;正常时&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;def 方法甲(self, ...):&lt;br&gt;　　……甲的语句……&lt;br&gt;　　return&lt;br&gt;&lt;br&gt;def 方法乙(self, ...):&lt;br&gt;　　……乙的语句……&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="146" width="690" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;搬坏之后（少了一行 def）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;def 方法甲(self, ...):&lt;br&gt;　　……甲的语句……&lt;br&gt;　　return&lt;br&gt;　　&lt;b&gt;……乙的语句……&lt;/b&gt;　← 被并进甲里了&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;调用方法乙的地方还在 → 一调就崩&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="766" y="146" width="694" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;b&gt;第二步：三条命令就能定性（不需要读完整个文件）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="306" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;找调用点&lt;/b&gt;：在出问题的分支上 grep「方法名（」→ 命中数应大于 0；&lt;br&gt;② &lt;b&gt;找定义&lt;/b&gt;：同一分支上 grep「def 方法名」→ &lt;b&gt;命中 0 就是它&lt;/b&gt;；&lt;br&gt;③ &lt;b&gt;对账移植前后&lt;/b&gt;：用只读方式看两个分支的同一文件（不要切别人的工作树），对比同名方法的 def 行数——少一行就是直接证据。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;结论要能写成一句可复核的布尔事实：「调用点存在但定义不存在」。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="336" width="1424" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;第三步：处置方式（这里有个「本仓不该做的事」的血泪教训）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="478" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="508" width="700" height="172" as="geometry"/>
        </mxCell>
        <mxCell id="t10" value="&lt;b&gt;错误做法（本仓历史上真实发生过）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="516" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;font style=&quot;font-size:10px&quot;&gt;把补丁放进&lt;b&gt;部署配置仓&lt;/b&gt;，并在 README 里写「必须先 git apply」。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;结果：被要求全部撤回。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;原因：一旦混入代码补丁，「跑起来的到底是哪份代码」就说不清了，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;而且会形成「第二份真相」被后人继续传播。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="542" width="680" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="508" width="664" height="172" as="geometry"/>
        </mxCell>
        <mxCell id="t13" value="&lt;b&gt;正确做法&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="516" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;font style=&quot;font-size:10px&quot;&gt;只&lt;b&gt;报告&lt;/b&gt;，不动手：给出六项——现象 / 根因（含归属）/ 证据（文件:行号）/&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;影响面 / 建议改法（描述性）/ 验证方式。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;由代码仓的分支与 PR 去落地。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;部署仓只做「能不能用配置绕开」的判断与规避。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="542" width="644" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;b&gt;第四步：六项报告模板（照着填，别人能复核）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="690" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;项&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="720" width="180" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;b&gt;写什么&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="216" y="720" width="1244" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;现象&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="754" width="180" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;用户看到的报错原文 + 触发条件&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="216" y="754" width="1244" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;根因&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="788" width="180" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;一句话结论 + &lt;b&gt;归属判断&lt;/b&gt;（脚本 / 配置 / 代码 / 环境）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="216" y="788" width="1244" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;证据&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="822" width="180" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;文件:行号；最好给出「调用点存在但定义不存在」这类布尔事实&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="216" y="822" width="1244" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;影响面&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="856" width="180" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;谁会挂、是否必现、有没有绕开办法&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="216" y="856" width="1244" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;建议改法&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="890" width="180" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;描述性（例如「恢复该方法的 def 行」），&lt;b&gt;不附可执行补丁&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="216" y="890" width="1244" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;验证方式&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="924" width="180" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;改完怎么确认（拉起、对账、跑通哪条链）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="216" y="924" width="1244" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;b&gt;第五步：怎么判断「这是代码问题还是配置问题」&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① 把配置回退到已知可用的版本，问题还在 → 大概率不是配置；② 换一个分支/构建，问题消失 → 代码差异（这时用上面的三条命令去对账）；③ 问题只在某个具体输入上出现，且能用一个「不该发生」的数字复现 → 逻辑缺陷；④ &lt;b&gt;如果配置里有能绕开的项，就先绕开并记录&lt;/b&gt;——但要说清「这只是规避，不是修复」。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="992" width="1424" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：8 个案例到这里。最后一步（⑩）把它们压成一张速查表 + 十条误导线索。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1132" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;本案例与处置规范：assets/AGENTS.md:19-33（唯一例外与同意流程）、:43-51（真实案例）、:53-66（六项报告模板）、:86-87（跨支只读比对）&lt;br&gt;同一反模式的历史：曾在部署仓提交补丁目录，已 reset 撤销（AGENTS.md:48-49）&lt;br&gt;「不改他人工作树」的只读手法：git show &lt;branch&gt;:&lt;path&gt; / git grep &lt;branch&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1208" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;一句话记住这个案例：&lt;/b&gt;代码缺陷的识别只要三条命令（调用点 / 定义 / 对账），但&lt;b&gt;处置边界比识别更重要&lt;/b&gt;——部署仓只报告不落补丁，否则「跑的是哪份代码」就再也说不清了。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1344" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t34" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1436" width="104" height="20" as="geometry"/>
        </mxCell>
