          <mxGeometry x="916" y="1405" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n66" value="通信/搬运流" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1405" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e67" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1454" as="sourcePoint"/>
            <mxPoint x="204" y="1454" as="targetPoint"/>
          </mxGeometry>
