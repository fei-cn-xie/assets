  <diagram id="pg6" name="⑦ 六层闸门">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1340" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑦ 六层闸门：融合算子是怎么被一层层关掉的" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：本仓的算子路径不是「写成什么样就跑成什么样」，而是&lt;b&gt;六道闸门逐级判断&lt;/b&gt;——每一道不过，就降一档实现。所以「同一份代码在不同机器上性能差很多」通常是&lt;b&gt;闸门关的位置不同&lt;/b&gt;。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：六道闸门（从上到下判，任一不过就降档）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;① 自定义算子库&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333333&quot;&gt;能不能加载（版本/编译不匹配就整体禁用）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="146" width="224" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;② 硬件能力&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333333&quot;&gt;这台机器的芯片代次支持这个能力吗&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="272" y="146" width="224" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="262" y="194" as="sourcePoint"/>
            <mxPoint x="270" y="194" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;③ 运行时开关&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333333&quot;&gt;用户/环境变量允许吗（有些默认关）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="508" y="146" width="224" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="498" y="194" as="sourcePoint"/>
            <mxPoint x="506" y="194" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;④ 形状与 dtype&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333333&quot;&gt;头数、维度、dtype 组合符合吗&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="744" y="146" width="224" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="734" y="194" as="sourcePoint"/>
            <mxPoint x="742" y="194" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;⑤ 布局与并行&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333333&quot;&gt;NZ 布局、TP 规模、CP 开关符合吗&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="980" y="146" width="224" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="970" y="194" as="sourcePoint"/>
            <mxPoint x="978" y="194" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;⑥ 走融合路径&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#333333&quot;&gt;全部通过 → 用融合算子&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1216" y="146" width="224" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="e14" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1206" y="194" as="sourcePoint"/>
            <mxPoint x="1214" y="194" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t15" value="&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;任一道不过 → 降一档：融合版 → 厂商版 → 基础版；功能不变，只是慢。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="250" width="1424" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;b&gt;第二步：同一件事的三档实现（以「相加 + 归一化」为例）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="262" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="292" width="1424" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;b&gt;A 档：图级再融合&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="298" width="220" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;font style=&quot;font-size:10px&quot;&gt;编译期把「相加 + 归一化 + 量化」合成一个算子&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="276" y="298" width="700" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;font style=&quot;font-size:9px;color:#333333&quot;&gt;需要：特定 dtype + 特定形状 + 融合 pass 开启&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="996" y="298" width="452" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="374" width="1424" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="t22" value="&lt;b&gt;B 档：厂商融合算子&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="380" width="220" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;font style=&quot;font-size:10px&quot;&gt;「相加 + 归一化 + bias」一次完成&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="276" y="380" width="700" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="t24" value="&lt;font style=&quot;font-size:9px;color:#333333&quot;&gt;需要：芯片支持 + 自定义算子库加载成功&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="996" y="380" width="452" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="456" width="1424" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="t26" value="&lt;b&gt;C 档：分步基础算子&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="462" width="220" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t27" value="&lt;font style=&quot;font-size:10px&quot;&gt;相加一个算子、归一化一个算子&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="276" y="462" width="700" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;font style=&quot;font-size:9px;color:#333333&quot;&gt;总能跑（这是保底档）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="996" y="462" width="452" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="t29" value="&lt;b&gt;第三步：怎么发现「我到底在哪一档」（排障关键）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="522" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;看启动日志&lt;/b&gt;：自定义算子库加载失败会有一条明确的 warning（大意是「自定义算子注册失败，全部禁用」）——这是最硬的一条。&lt;br&gt;② &lt;b&gt;看融合 pass 的日志&lt;/b&gt;：图级融合被关掉时通常有 INFO/debug 说明原因（例如「head_dim 不是 128，QKNorm+RoPE 融合不启用」）。&lt;br&gt;③ &lt;b&gt;看代码里的前置条件函数&lt;/b&gt;：融合路径前的检查函数会把「为什么不行」逐条列出来（TP 规模、dtype、bias、K 范围等）。&lt;br&gt;④ &lt;b&gt;对比相同配置的两台机器&lt;/b&gt;：如果一台快一台慢，先比「芯片代次 + 算子库版本」，再比形状（seq len、头数、batch）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="552" width="1424" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;第四步：一个容易被忽略的「为兼容而故意不融合」&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;某些平台上有一种反向保护：当矩阵退化成「1×1」这种极小形状时，代码会&lt;b&gt;故意保持普通布局&lt;/b&gt;，因为分形布局的矩阵算子在这种形状上会被直接拒绝。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;所以「为什么这里没转成最优布局」的答案可能是：&lt;b&gt;转了反而跑不起来&lt;/b&gt;。这类保护在代码里通常有注释，读一眼能省很多时间。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="724" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：回退机制清楚了。下一步（⑧）把本仓用到的算子&lt;b&gt;列成一张表&lt;/b&gt;——这张表是这套图最实用的部分。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="880" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;闸门①：vllm-ascend/vllm_ascend/utils.py:544-603（enable_custom_op）；失败日志 :590/:597&lt;br&gt;闸门②：device/hardware_profile.py（能力枚举）；使用示例 ops/rotary_embedding.py:712-719、sample/sampler.py:163-167&lt;br&gt;闸门③：配置开关示例 vllm-ascend/vllm_ascend/ascend_config.py:575（multistream_overlap_shared_expert 默认关）、:615（weight_nz_mode 默认 1）&lt;br&gt;闸门④⑤：ops/linear_op.py:164-181（unsupported_reason 逐条）、:229-260（_can_fuse）&lt;br&gt;闸门⑥ 的反面：ops/linear.py:74-79（_should_keep_nd_for_compatibility_weight，极小形状保持普通布局）、:118-121（原因注释）&lt;br&gt;三档归一化的具体位置：ops/layernorm.py:92（自研融合）、:118（厂商融合）、:97（基础）；图级 compilation/passes/norm_quant_fusion_pass.py:385-393&lt;br&gt;回退相关日志：utils.py:590/597、qknorm_rope_fusion_pass.py:304/310/315/334/341/365、norm_quant_fusion_pass.py:371/375/398&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="956" width="1424" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;融合算子要过六道闸门（算子库 / 硬件 / 开关 / 形状 / 布局 / 路径），任一不过就降档；&lt;b&gt;排障时先找「哪道闸门关了」——日志里 usually 有痕迹，而「为兼容故意不融合」是最容易被误判成 bug 的一类。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
