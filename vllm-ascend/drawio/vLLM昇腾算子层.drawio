  <diagram id="pg3" name="④ 小算子家族">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1470" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="④ 归一化、激活、位置编码：三个「每层都要跑好几遍」的小算子" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：它们单次计算量小，但**每层要跑好几次**，所以是融合收益最高的一族；而它们的实现按「模型族」分叉——同一件事（例如位置编码）在不同模型上落到了不同算子。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：归一化是「三层融合」的典型（同一件事有三档实现）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="146" width="1424" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;第三档：图级再融合&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="152" width="260" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;font style=&quot;font-size:10px&quot;&gt;在编译 pass 里把「相加+归一化+量化」合成一个算子　&lt;font color=&quot;#666666&quot;&gt;最快，但只在特定 dtype/形状下启用&lt;/font&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="316" y="154" width="1140" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="230" width="1424" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;第二档：厂商融合算子&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="236" width="260" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;font style=&quot;font-size:10px&quot;&gt;「相加 + 归一化 + bias」一次完成　&lt;font color=&quot;#666666&quot;&gt;通用性好&lt;/font&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="316" y="238" width="1140" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="314" width="1424" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;第一档：基础归一化&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="320" width="260" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;font style=&quot;font-size:10px&quot;&gt;只有归一化本身　&lt;font color=&quot;#666666&quot;&gt;最保险，最慢&lt;/font&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="316" y="322" width="1140" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="t13" value="&lt;b&gt;第二步：激活函数的「变体爆炸」（看起来都叫 SwiGLU，算子却不止一个）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="380" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;算子形态&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="410" width="460" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;它在算什么&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="496" y="410" width="560" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;用在哪&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1056" y="410" width="404" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;普通 SwiGLU&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="442" width="460" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;门控激活（SiLU × 另一路）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="496" y="442" width="560" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;dense MLP 与 MoE 都用&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1056" y="442" width="404" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;带 clamp 的 SwiGLU&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="474" width="460" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;激活前先截断，防溢出&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="496" y="474" width="560" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;某些模型/量化方案需要&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1056" y="474" width="404" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;激活 + 反量化 + 再量化&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="506" width="460" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;激活完直接产出量化张量，省一次往返&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="496" y="506" width="560" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;量化 MLP 主用&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1056" y="506" width="404" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;分组激活 + 量化&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="538" width="460" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;MoE 里每组专家一段&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="496" y="538" width="560" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;MoE 量化路径&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1056" y="538" width="404" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;GELU 变体&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="570" width="460" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;另一种激活（BERT 系）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="496" y="570" width="560" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;少量模型&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1056" y="570" width="404" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;门控 + 其它（SiTU 等）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="602" width="460" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:11px&quot;&gt;不同模型族的门控写法&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="496" y="602" width="560" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:11px&quot;&gt;按模型选&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1056" y="602" width="404" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="t35" value="&lt;b&gt;第三步：位置编码最「按模型分叉」——四个模型族四种落点&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="634" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;普通 GQA 模型&lt;/b&gt;：一个通用的旋转位置编码算子（内部已处理「全旋」与「部分旋」），prefill 与 decode &lt;b&gt;同一个算子&lt;/b&gt;。&lt;br&gt;② &lt;b&gt;MLA 类（DeepSeek 系）&lt;/b&gt;：prefill 与 decode &lt;b&gt;不是一个&lt;/b&gt;——decode 走「归一化 + 旋转 + 写 KV 缓存」&lt;b&gt;三合一的融合算子&lt;/b&gt;，prefill 走交错旋转。&lt;br&gt;③ &lt;b&gt;稀疏 MLA（带 indexer）&lt;/b&gt;：用「原地部分旋转」，只转一部分维度，省一次数据拷贝。&lt;br&gt;④ &lt;b&gt;老硬件（310P）&lt;/b&gt;：走一个只支持「头维 64 或 128」的算子，所以老平台上换模型容易踩限制。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;读法：想知道某个模型的位置编码落到哪个算子，先看它是 GQA 还是 MLA、有没有稀疏/索引器，再看硬件代次。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="664" width="1424" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;b&gt;第四步：一个容易忽略的隐藏前提——「cos/sin 缓存」要预处理&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;框架里位置编码的表是一整块「cos 与 sin 交错」的缓存，但算子通常要&lt;b&gt;两份分离的 cos、sin&lt;/b&gt;，且要求它们&lt;b&gt;不参与梯度追踪&lt;/b&gt;。&lt;br&gt;所以本仓在加载后会把这块缓存&lt;b&gt;切分并重新登记&lt;/b&gt;（拆成交错的 cos/sin），还特意把它注册成「非持久缓冲」——原因是唤醒/重建后指针会失效。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;这就是为什么「换一个位置编码实现」不是改一行的事：缓存的布局、生命周期、地址稳定性都要跟着改。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="854" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：小算子家族讲完。下一步（⑤）看一个反直觉的取舍——采样那一步&lt;b&gt;主动不用&lt;/b&gt;硬件提供的融合算子。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1010" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;归一化三档：ops/layernorm.py:92（自研「相加+归一化+bias」）、:97（基础归一化）、:118（回退到厂商「相加+归一化」）；图级融合 compilation/passes/norm_quant_fusion_pass.py:385-393&lt;br&gt;归一化 + 动态量化融合：attention/dsa_v1.py:1956（自研融合）；图级 norm_quant_fusion_pass.py:328&lt;br&gt;激活变体：ops/activation.py:37（SwiGLU）、:47（clamp 版）、:31（GELU 变体）；激活+反量化+量化 w8a8/w8a8_dynamic.py:474；分组激活+量化 shared_experts.py:607、:651&lt;br&gt;位置编码：ops/rotary_embedding.py:244（通用旋转，内部处理全旋/部分旋）、:736（旋转乘）；MLA decode 三合一 attention/mla_v1.py:1865、prefill attention/mla_v1.py:2800；原地部分旋转 attention/dsa_v1.py:1915；老硬件 _310p/ops/rotary_embedding.py:146、:223（只支持 rotary 64/128）&lt;br&gt;cos/sin 缓存预处理：ops/rotary_embedding.py:47-64（注释为什么要预处理）、:141-171（切分与「非持久缓冲」的原因）、:67-91（预分配固定地址缓冲）&lt;br&gt;QKNorm + RoPE 图级融合（head_dim 必须 128）：compilation/passes/qknorm_rope_fusion_pass.py:67-96、:315&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1086" width="1424" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;归一化/激活/位置编码单次很便宜但每层跑好几遍，所以融合收益最高；&lt;b&gt;而它们全都按「模型族 + 硬件代次」分叉&lt;/b&gt;——想知道某个模型落到哪个算子，先看模型类型（GQA/MLA/稀疏）再看硬件。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1280" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t41" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1372" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1369" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1369" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1369" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1369" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1369" width="120" height="26" as="geometry"/>
