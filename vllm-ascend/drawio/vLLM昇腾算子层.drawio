        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;KV 换入换出、边云 H2D/D2H&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="368" width="800" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;PD 场景&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1136" y="368" width="324" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;b&gt;第二步：三处最典型的「重叠」（以及它们各自为什么要事件对齐）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="398" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="426" width="460" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t30" value="&lt;b&gt;① 共享专家 × 路由专家&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="434" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t31" value="&lt;font style=&quot;font-size:10px&quot;&gt;两者互不依赖 → 放两条流并发。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;但「共享专家的激活」必须等「路由的第一段 GEMM」开始后才能插进去，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以代码里用了一串&lt;b&gt;里程碑事件&lt;/b&gt;（准备/路由完成/dispatch 开始/激活可插/combine 开始/收尾）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;来精确控制「谁能先跑」。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="460" width="440" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="518" y="426" width="460" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t33" value="&lt;b&gt;② 通信 × 计算（MC2）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="434" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t34" value="&lt;font style=&quot;font-size:10px&quot;&gt;最彻底的做法：把「GEMM + reduce-scatter」做成一个算子，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;重叠发生在算子内部，Python 侧只看到一次调用。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以这条路径&lt;b&gt;不需要&lt;/b&gt;多流——这正是「融合 MC2 与多流共享专家互斥」的原因。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="460" width="440" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="426" width="460" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t36" value="&lt;b&gt;③ 主机面/KV 搬运 × 计算&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="434" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t37" value="&lt;font style=&quot;font-size:10px&quot;&gt;边云的 H2D/D2H、KV 换入换出都放旁路流，与 forward 重叠。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;关键技巧：用&lt;b&gt;流级同步&lt;/b&gt;而不是设备级同步——&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;代码注释明确说「设备级同步会把引擎线程挡在所有无关流后面，且没有正确性收益」。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="460" width="440" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="t38" value="&lt;b&gt;第三步：四个必须真同步的地方（延迟热点，排障要盯这里）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="628" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;b&gt;同步点&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="656" width="300" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;b&gt;为什么必须&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="336" y="656" width="560" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;b&gt;代价&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="896" y="656" width="564" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="&lt;font style=&quot;font-size:11px&quot;&gt;图重放前&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="688" width="300" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="&lt;font style=&quot;font-size:11px&quot;&gt;上次重放的 CPU 侧参数更新必须先完成&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="688" width="560" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="&lt;font style=&quot;font-size:11px&quot;&gt;每步一次，可用「流等待」替代&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="896" y="688" width="564" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="&lt;font style=&quot;font-size:11px&quot;&gt;取「已算 token 数」回主机&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="720" width="300" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="&lt;font style=&quot;font-size:11px&quot;&gt;调度器需要精确值&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="720" width="560" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="&lt;font style=&quot;font-size:11px&quot;&gt;会阻塞提交流水线&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="896" y="720" width="564" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="&lt;font style=&quot;font-size:11px&quot;&gt;分层 KV 传输的每层&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="752" width="300" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="&lt;font style=&quot;font-size:11px&quot;&gt;每层都要等搬运完成才能继续&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="752" width="560" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="&lt;font style=&quot;font-size:11px&quot;&gt;PD 的固有代价&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="896" y="752" width="564" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="&lt;font style=&quot;font-size:11px&quot;&gt;主机面拷贝校验&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="784" width="300" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="&lt;font style=&quot;font-size:11px&quot;&gt;校验首窗拷贝正确性&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="784" width="560" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n53" value="&lt;font style=&quot;font-size:11px&quot;&gt;仅首窗&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="896" y="784" width="564" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n54" value="&lt;b&gt;第四步：workspace ——「算子要的临时空间」怎么进入显存账&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;有些算子需要一块临时空间（例如 chunked prefill 读历史 K/V、MoE 的分组计算中间结果）。本仓统一由一个&lt;b&gt;全局 workspace 管理器&lt;/b&gt;分配：&lt;br&gt;· 一次分配、切成多份给不同用途（256 字节对齐）；容量不够时&lt;b&gt;惰性扩容&lt;/b&gt;；&lt;br&gt;· &lt;b&gt;图捕获之后会「上锁」&lt;/b&gt;，之后不许再扩（否则图里的地址失效）；&lt;br&gt;· 它的占用被算进「激活峰值」，所以&lt;b&gt;它变大 = 可用 KV 变小&lt;/b&gt;（入门套 ⑦）。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;有一个平台的极端做法：直接把可用显存对半砍，日志里写「留给算子 workspace 与其它缓存」——这是显存档里最容易被忽略的一项。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="842" width="1424" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n55" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：整套讲完。回到 `学习地图.md`——这一套（站 11）应插在「进程与线程 ⑯（权重怎么参与计算）」之后读，它是「计算」这件事的最底层。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1014" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n56" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;流清单与用途：vllm-ascend/vllm_ascend/utils.py:644-680（全局流/共享专家流/CP 流等工厂）；采样流 :31-42（sample/sampler.py）；MoE 通信流 moe_utils.py:63-99；图更新流 compilation/acl_graph.py:127、:309-319&lt;br&gt;共享专家重叠的里程碑事件：ops/fused_moe/dataclass/shared_experts.py:23-69（六个事件及语义）；编排 ops/fused_moe/fused_moe.py:438-553；「为什么必须用事件而不只是顺序」的注释 shared_experts.py:406-417、:474-480&lt;br&gt;MC2 与多流互斥：vllm-ascend/vllm_ascend/ascend_config.py:850-855（原文）&lt;br&gt;流级 vs 设备级同步的取舍（原文）：vllm-ascend/vllm_ascend/worker/lwd_cloud_model/lwd_cloud_model_runner.py:1126-1134&lt;br&gt;图重放前的同步与其替代（流等待）：compilation/acl_graph.py:284-296（原文说明为什么必须 sync）&lt;br&gt;workspace 管理器：vllm/vllm/v1/worker/workspace.py:47-223（get_simultaneous :116、惰性扩容 :143-223、上锁 :78-93）&lt;br&gt;workspace 计入激活峰值：vllm-ascend/vllm_ascend/worker/worker.py:599-637&lt;br&gt;对半砍显存的极端做法：vllm-ascend/vllm_ascend/_310p/worker_310p.py:130-154（日志原文）&lt;br&gt;下发开销的量化注释（每个 F.pad 两次 kernel，约 44 µs/层）：vllm-ascend/vllm_ascend/ops/fused_moe/moe_utils.py:389-397&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1090" width="1424" height="192" as="geometry"/>
        </mxCell>
        <mxCell id="n57" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;算子被分到「一条主流 + 十几条旁路流」上并发，重叠靠&lt;b&gt;事件&lt;/b&gt;对齐；而少数&lt;b&gt;真同步&lt;/b&gt;点（图重放前、取计数回主机、分层 KV、首窗校验）就是延迟热点。&lt;b&gt;workspace 是临时空间，会从 KV 预算里扣掉。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1316" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t58" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1408" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n59" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1405" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n60" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1405" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n61" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1405" width="120" height="26" as="geometry"/>
