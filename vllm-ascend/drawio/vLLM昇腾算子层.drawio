  </diagram>
  <diagram id="pg5" name="⑥ 通信算子">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1516" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑥ 通信算子：并行之后，卡与卡之间要交换什么" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：本仓的 TP 路径&lt;b&gt;不是「GEMM 后 all_reduce」&lt;/b&gt;，而是「&lt;b&gt;先 all-gather → GEMM → reduce-scatter&lt;/b&gt;」；真正的 all_reduce 只剩三处。而 MoE 的 EP 路径是另一套（dispatch/combine）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：TP 的两条路径（列并行 → 行并行），对比「教科书写法」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;教科书：GEMM + all_reduce&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;列并行 GEMM（各卡算一部分）→ 各卡得到「部分输出」&lt;br&gt;→ &lt;b&gt;all_reduce&lt;/b&gt; 求和 → 完整输出&lt;br&gt;&lt;br&gt;通信量 ≈ 输出张量大小 × 卡数相关系数&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="146" width="690" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;本仓：先 gather、再算、再 reduce-scatter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;all_gather&lt;/b&gt; 输入（让每卡拿到全部输入行）&lt;br&gt;② GEMM（每卡只算自己那段输出，不再需要跨卡求和）&lt;br&gt;③ &lt;b&gt;reduce_scatter&lt;/b&gt; 输出（把结果按行切片分给各卡）&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1c7c54&quot;&gt;好处：与「序列并行」天然兼容，且把一次大通信拆成两段可重叠的通信&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="766" y="146" width="694" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;b&gt;第二步：那「真正的 all_reduce」还剩在哪（就三处）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="332" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;位置&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="362" width="380" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;为什么需要&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="416" y="362" width="720" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;备注&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1136" y="362" width="324" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;font style=&quot;font-size:11px&quot;&gt;① 输出头（lm_head）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="400" width="380" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:11px&quot;&gt;词表维并行 → 各卡算一部分词表 → 需要求和得到完整 logits&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="416" y="400" width="720" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;整条链里最贵的一次&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1136" y="400" width="324" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;② 共享专家输出&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="438" width="380" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;MoE 里共享专家按 TP 切分，算完要归约&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="416" y="438" width="720" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;每层一次&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1136" y="438" width="324" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;③ 归一化的统计量&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="476" width="380" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;在某个融合 kernel &lt;b&gt;内部&lt;/b&gt;顺手做一次小 all_reduce&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="416" y="476" width="720" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;省一次独立通信&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1136" y="476" width="324" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="544" width="700" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;b&gt;all_to_all：output 投影的写法&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="552" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;font style=&quot;font-size:10px&quot;&gt;某些配置下 o_proj 用「按头分给各卡」再「按 token 分回」的写法，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;于是出现 &lt;b&gt;all_to_all&lt;/b&gt;：每卡把自己该算的头送出去、把别人算好的收回来。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;这与 MoE 的 dispatch 用的是同一个 primitive，但意图不同（一个是切头、一个是切专家）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="578" width="680" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="796" y="544" width="664" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;b&gt;MoE / EP：dispatch 与 combine&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="552" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t24" value="&lt;font style=&quot;font-size:10px&quot;&gt;EP 下「token 去找专家」= dispatch，「结果送回」= combine，前后各一次。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;实现有三档（all-gather+reduce-scatter / MC2 融合 / 真 all-to-all）——见 MoE 套 ⑥。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以「MoE 的通信」与「TP 的通信」是两套独立的东西，排障时要分清是哪一套。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="578" width="644" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;第三步：通信与计算融合（MC2）有个明确的规模门槛&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本仓把「GEMM + reduce-scatter」做成了&lt;b&gt;一个融合算子&lt;/b&gt;（通信与计算在算子内部重叠），但代码里有一道门：&lt;b&gt;只在 TP 规模 ≤ 8 时启用&lt;/b&gt;，注释写的是「等底层的 mm_reduce_scatter 支持 tp ≥ 16 再去掉这个限制」。&lt;br&gt;MoE 侧更激进：把「dispatch + 专家计算 + combine」融成&lt;b&gt;单个算子&lt;/b&gt;（那样的路径就&lt;b&gt;不需要多流重叠&lt;/b&gt;了）。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;这也解释了一条互斥规则：「融合 MC2」与「多流重叠共享专家」&lt;b&gt;不能同时开&lt;/b&gt;——前者已经把重叠做进算子里了。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="752" width="1424" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;第四步：一句话把「谁和谁通信」记住&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TP：&lt;b&gt;每层&lt;/b&gt;「gather 输入 → 算 → scatter 输出」；块与块之间还会额外做一次 o_proj 的 all_to_all。&lt;br&gt;EP（MoE）：&lt;b&gt;每层&lt;/b&gt;「dispatch → 算 → combine」，且只有 MoE 才有。&lt;br&gt;DP：推理时几乎不通信（但 MoE 的 DP 例外——它要 wave 同步，见 MoE 套 ⑩）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="924" width="1424" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：通信讲完，算子层的三大块（矩阵乘、小算子、通信）都齐了。下一步（⑦）看「回退」是怎么一层层设计的——这决定了你在某台机器上能拿到多少性能。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1064" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;TP 的 gather→GEMM→reduce-scatter：vllm-ascend/vllm_ascend/ops/linear_op.py:278（all_gather）、:299（reduce_scatter）、:374（o_proj 的 reduce_scatter）、:365（o_proj 的 all_to_all）&lt;br&gt;真正的 all_reduce 三处：ops/vocab_parallel_embedding.py:426（logits）、:456；ops/fused_moe/fused_moe.py:330（共享专家）、:454-538（多流编排）&lt;br&gt;归一化融合 kernel 内的小 all_reduce：ops/triton/linearnorm/split_qkv_tp_rmsnorm_rope.py:305&lt;br&gt;MC2 融合（GEMM+reduce-scatter）：ops/linear_op.py:211（npu_quant_mm_reduce_scatter）；门槛注释 ascend_forward_context.py:182-185（tp_size ≤ 8）；能力检查 :164-181&lt;br&gt;MC2 base 接口：device/device_op.py:287-313、:1243-1265&lt;br&gt;MoE 的 dispatch/combine（MC2）：ops/fused_moe/token_dispatcher.py:109、:232、:331；单算子融合 moe_comm_method.py:591；与多流互斥 ascend_config.py:850-855&lt;br&gt;异步 all_to_all + 独立通信流：ops/fused_moe/moe_utils.py:63-99&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1140" width="1424" height="152" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;本仓 TP 是「gather → GEMM → reduce-scatter」而不是「GEMM → all_reduce」，真正的 all_reduce 只剩输出头/共享专家/融合归一化三处；&lt;b&gt;MoE 的 dispatch/combine 是另一套，别和 TP 的通信混在一起排障。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1326" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t30" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1418" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1415" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1415" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1415" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1415" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1415" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1415" width="120" height="26" as="geometry"/>
