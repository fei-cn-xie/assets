        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;专用归一化算子（也可与残差相加融合）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="514" width="700" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;一层里出现两次&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1036" y="514" width="424" height="38" as="geometry"/>
