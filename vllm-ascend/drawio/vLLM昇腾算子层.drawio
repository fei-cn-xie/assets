  <diagram id="pg4" name="⑤ 采样的取舍">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1354" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑤ 采样：为什么「硬件有融合算子」却主动不用它" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：本仓采样路径里有两处**刻意的反向选择**——① top-k/top-p 不走硬件的融合算子，改走排序+掩码；② 不用现成的多项式采样，改用自己的「指数噪声 + 取最大」。两处都是为了避开&lt;b&gt;跨设备同步&lt;/b&gt;与&lt;b&gt;固定延迟&lt;/b&gt;。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：反直觉之一——top-k/top-p 主动放弃硬件算子&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;font style=&quot;font-size:10px&quot;&gt;硬件其实提供了「top-k/top-p」的融合算子，但本仓的代码注释把它&lt;b&gt;否掉了&lt;/b&gt;，原文大意：&lt;br&gt;「用基于排序的 PyTorch 实现。&lt;b&gt;硬件的 top-k/top-p 在 k 较大、或批内 k 混杂时会严重劣化（5~28 ms）&lt;/b&gt;，而排序 + 掩码稳定在 ~1 ms。」&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;这是个非常典型的取舍：&lt;b&gt;融合算子不一定更快&lt;/b&gt;——它的性能对「形状是否规整」极其敏感，而采样的 batch 恰恰最不规整。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="148" width="1424" height="124" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;第二步：反直觉之二——不用现成的多项式采样&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="282" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;font style=&quot;font-size:10px&quot;&gt;现成的「按概率抽一个」的算子会在内部&lt;b&gt;把结果读回 CPU&lt;/b&gt;（或触发同步）才能继续，而采样这一步的延迟极度敏感（它在每个 decode step 的尾巴上）。&lt;br&gt;本仓的做法是：在一张&lt;b&gt;旁路流&lt;/b&gt;上生成一组指数分布随机数 → 与概率相除 → 取最大值。数学上等价于「按概率采样」，但&lt;b&gt;全程留在设备上&lt;/b&gt;，不需要把结果读回来。&lt;br&gt;&lt;font color=&quot;#1c7c54&quot;&gt;最后再把这条旁路流与主流对齐（wait_stream），并用 record_stream 告诉分配器这块张量还在被用。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="312" width="1424" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t7" value="&lt;b&gt;第三步：采样前后其实是一串加工（这串里既有融合算子也有通用算子）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="454" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;步骤&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="484" width="320" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;落到什么算子&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="356" y="484" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;备注&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="976" y="484" width="484" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:11px&quot;&gt;① logits 提到 fp32&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="518" width="320" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;元素级通用算子&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="356" y="518" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;为了数值稳定&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="976" y="518" width="484" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;② 罚分（重复/存在/频率）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="552" width="320" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;Triton 实现的小 kernel&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="356" y="552" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;有 Triton 才用&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="976" y="552" width="484" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;③ top-k / top-p 截断&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="586" width="320" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;排序 + 掩码（&lt;b&gt;不用&lt;/b&gt;硬件融合版）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="356" y="586" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;见第一步&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="976" y="586" width="484" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;④ 温度缩放 / softmax&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="620" width="320" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;元素级算子&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="356" y="620" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;得到概率&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="976" y="620" width="484" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;⑤ 采样（随机或贪心）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="654" width="320" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;贪心 = 取最大；随机 = 指数噪声法&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="356" y="654" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;见第二步&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="976" y="654" width="484" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;⑥ logprobs（可选）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="688" width="320" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;取 top-k 的通用算子&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="356" y="688" width="620" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;返回给调用方&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="976" y="688" width="484" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;b&gt;第四步：由这两处取舍可以抽出一条通用规律&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;「融合算子」适合形状规整、批大、计算密的场景（prefill / MLP / 矩阵乘）；&lt;/b&gt;&lt;br&gt;&lt;b&gt;「通用算子 + 旁路流」适合形状不规整、批小、且处在关键延迟路径上的场景（采样、小算子拼装）。&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;所以「为什么不用那个更快的专用算子」这类问题，答案往往不是「没做」，而是「做了但在这个形状下更慢」——本仓至少有两处注释明确这么写。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="754" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：采样是「尾部」。下一步（⑥）看「腰部」——并行带来的通信算子，以及它怎么和计算重叠。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="910" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;top-k/top-p 的两条实现与「主动不用硬件」的注释原文：vllm-ascend/vllm_ascend/sample/sampler.py:150-160（注释：npu_top_k_top_p degrades severely (5-28ms) … sort+mask is consistently ~1ms）；门控点 :163-167（HardwareCapability）；能力定义 device/hardware_profile.py:140-141&lt;br&gt;不用现成多项式采样的理由（会引起 CPU-NPU 同步）：sample/sampler.py:24-26&lt;br&gt;旁路流采样实现：sample/sampler.py:31-42（npu_stream_switch → exponential_ → div → argmax，wait_stream :40、record_stream :41）&lt;br&gt;贪心 = 取最大：sample/sampler.py:83-84&lt;br&gt;罚分走 Triton：sample/sampler.py:52-58（penalties）；logprobs 用 topk：worker/v2/sample/logprob.py:136&lt;br&gt;MoE 路由里同类注释（torch.topk 在 bf16 图模式下不支持）：ops/fused_moe/router/grouped_topk_router.py:104-107&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="986" width="1424" height="144" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;采样路径有两处「反向选择」——放弃硬件 top-k/top-p（形状不规整时慢 5~28 ms）、放弃现成多项式采样（会引起跨设备同步）；&lt;b&gt;规律是：融合算子吃「规整与大批」，通用算子吃「不规整与小批、且延迟敏感」。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1164" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t33" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1256" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1253" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1253" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1253" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1253" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1253" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1253" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1253" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e41" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1302" as="sourcePoint"/>
            <mxPoint x="204" y="1302" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t42" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1290" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e43" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1302" as="sourcePoint"/>
            <mxPoint x="454" y="1302" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t44" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1290" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e45" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1302" as="sourcePoint"/>
            <mxPoint x="704" y="1302" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t46" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1290" width="190" height="24" as="geometry"/>
