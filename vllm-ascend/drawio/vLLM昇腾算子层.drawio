        <mxCell id="n96" value="&lt;font style=&quot;font-size:11px&quot;&gt;⑥ 页&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1256" y="1078" width="164" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n97" value="&lt;font style=&quot;font-size:11px&quot;&gt;格式转换（ND ↔ NZ）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1108" width="520" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n98" value="&lt;font style=&quot;font-size:11px&quot;&gt;加载时把权重转成分形布局&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="556" y="1108" width="700" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n99" value="&lt;font style=&quot;font-size:11px&quot;&gt;③ 页&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1256" y="1108" width="164" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n100" value="&lt;b&gt;怎么用这张表&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① 看到日志里的算子名 → 回到表里查「它属于哪一组」，就知道该去看哪一页；&lt;br&gt;② 想优化某个环节 → 先确认这一步是「一个融合算子」还是「好几个基础算子拼的」；&lt;br&gt;③ 想换硬件 → 对照表里的算子逐条确认新平台是否都有，缺哪条就是性能缺口。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="1162" width="1424" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n101" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;算子统一封装入口（`torch_npu.*` 与自研 `_C_ascend.*` 都在这里包了一层）：vllm-ascend/vllm_ascend/device/device_op.py（按用途分段，便于查）&lt;br&gt;自研算子的 C++ 注册与 kernel 目录：vllm-ascend/csrc/torch_binding.cpp（`TORCH_LIBRARY_EXPAND`）、vllm-ascend/csrc/（各 kernel 子目录）&lt;br&gt;算子不可用时的占位实现：vllm-ascend/vllm_ascend/ops/__init__.py:37-52（register_dummy_fusion_op）&lt;br&gt;各组的详细锚点：本套 ③④⑥⑨ 页 + MoE 套 ⑥⑧ 页的页面锚点块&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1302" width="1424" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="n102" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;本仓的算子可以归成四组——矩阵乘、小算子（归一化/激活/位置编码）、attention 与 KV、路由与通信；&lt;b&gt;排查性能时先判断「这一步是融合的还是拼的」。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1448" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t103" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1540" width="104" height="20" as="geometry"/>
        </mxCell>
