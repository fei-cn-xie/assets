  <diagram id="pg1" name="② 算子与下发">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1334" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="② 一个算子 ≠ 一次下发：融合省的是「中间结果落显存再读回来」" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：数学上写成三步（比如「残差相加 → 归一化 → 量化」），如果不融合，设备上就是&lt;b&gt;三次 kernel 下发 + 两次中间结果落显存&lt;/b&gt;；融合成一个算子后只剩&lt;b&gt;一次下发&lt;/b&gt;——省的是带宽和启动开销，不是算力。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：同一个语义，两种落地（对比「三次下发」与「一次下发」）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;不融合（三个算子）&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① 读 x、读残差 → 算加法 → &lt;b&gt;写回显存&lt;/b&gt;（中间结果 A）&lt;br&gt;② 读 A → 算归一化 → &lt;b&gt;写回显存&lt;/b&gt;（中间结果 B）&lt;br&gt;③ 读 B → 算量化 → 写入目标&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;3 次下发 + 2 次「写回再读出」= 3 倍启动开销 + 2 倍额外带宽&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="148" width="690" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;融合（一个算子）&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① 读 x、读残差 → 加法 → 归一化 → 量化 → &lt;b&gt;一次写出&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1c7c54&quot;&gt;1 次下发 + 0 次额外读写&lt;br&gt;中间结果留在片上（寄存器/片上缓存），不落显存&lt;/font&gt;&lt;br&gt;&lt;br&gt;代价：这种算子是&lt;b&gt;专门写的&lt;/b&gt;，对形状/dtype/头数有要求，不满足就得回退。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="766" y="148" width="694" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;b&gt;第二步：融合到底省了什么（三条，按收益排）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="348" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="378" width="460" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;① 省带宽（decode 时最值钱）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="386" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;font style=&quot;font-size:10px&quot;&gt;中间结果不用写回显存再读出来。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;decode 本来就卡在带宽上（入门套 ⑤），&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以「少读写一次」直接换成速度。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="412" width="440" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="518" y="378" width="460" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;② 省下发开销&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="386" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;font style=&quot;font-size:10px&quot;&gt;每次 kernel 下发都有固定成本（提交、校验、排队）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;算子越碎，固定成本占比越高——小 batch 时尤其明显。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;这也是图捕获（站 6）要解决的同一个问题。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="412" width="440" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="378" width="460" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;b&gt;③ 省片上内存搬运&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="386" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;font style=&quot;font-size:10px&quot;&gt;部分融合算子还能把「读一次、多处用」的中间量留在片上&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;（例如归一化里的方差，既要做除法又要做缩放）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;这类优化纯靠手写 kernel 才能做到。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="412" width="440" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;第三步：融合的代价（这就是为什么本仓到处是「回退」代码）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;一个融合算子要固定死很多东西：&lt;b&gt;dtype 组合、形状约束、头数、布局、硬件代次&lt;/b&gt;。任何一条不满足，就只能走分步实现。&lt;br&gt;所以本仓的代码里你会看到&lt;b&gt;一层套一层的开关&lt;/b&gt;：先看自定义算子库加载成功没，再看这个硬件有没有这个能力，再看本次的形状/dtype 是否符合，最后才决定用融合还是分步。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;理解这一点，就能解释「为什么同一份代码在不同机器上性能差很多」——不是配置差异，是&lt;b&gt;融合路径被逐级关掉了&lt;/b&gt;。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="594" width="1424" height="124" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;b&gt;第四步：一次算子调用的决策顺序（六道闸门，任一不过就降级）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="728" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:10px&quot;&gt;自定义算子库&lt;br&gt;加载成功？&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="758" width="224" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:10px&quot;&gt;硬件支持&lt;br&gt;这个能力？&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="272" y="758" width="224" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e20" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="262" y="800" as="sourcePoint"/>
            <mxPoint x="270" y="800" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:10px&quot;&gt;dtype/形状&lt;br&gt;符合？&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="508" y="758" width="224" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e22" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="498" y="800" as="sourcePoint"/>
            <mxPoint x="506" y="800" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:10px&quot;&gt;布局符合？&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="744" y="758" width="224" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e24" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="734" y="800" as="sourcePoint"/>
            <mxPoint x="742" y="800" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:10px&quot;&gt;融合路径&lt;br&gt;可用？&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="980" y="758" width="224" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e26" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="970" y="800" as="sourcePoint"/>
            <mxPoint x="978" y="800" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:10px&quot;&gt;用融合算子&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1216" y="758" width="224" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e28" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1206" y="800" as="sourcePoint"/>
            <mxPoint x="1214" y="800" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t29" value="&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;任一闸门不过 → 走「分步实现」：功能一样、就是慢。所以「结果对但慢」十有八九是这条链上某一环被关掉了。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="850" width="1424" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：融合的价值说清了。下一步（③）看最大的一类算子——矩阵乘（linear / GEMM），它占了绝大部分计算量。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="906" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;自定义算子库加载开关（失败则全部禁用并告警）：vllm-ascend/vllm_ascend/utils.py:544-603（enable_custom_op）；日志 &quot;Failed to register custom ops, all custom ops will be disabled.&quot; :590/:597&lt;br&gt;单点回退示例（融合版 vs 基础版）：ops/layernorm.py:92（融合 add+rmsnorm+bias）→ :118（回退）&lt;br&gt;硬件能力门控：device/hardware_profile.py（能力枚举），调用示例 ops/rotary_embedding.py:712-719、sample/sampler.py:163-167&lt;br&gt;融合路径前置条件检查：ops/linear_op.py:164-181（unsupported_reason）、:229-260（_can_fuse）&lt;br&gt;图级融合 pass（在图捕获前面再融一次）：compilation/passes/norm_quant_fusion_pass.py:385-393、qknorm_rope_fusion_pass.py:91&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="982" width="1424" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;融合算子省的是&lt;b&gt;下发次数与中间结果的读写&lt;/b&gt;，不是算力；而它挑形状/ dtype/硬件，所以本仓到处是「能融就融、不能融就分步」的六道闸门——&lt;b&gt;「结果对但慢」通常是闸门被关掉了。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1144" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t33" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1236" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1233" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1233" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1233" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1233" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1233" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1233" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1233" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e41" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1282" as="sourcePoint"/>
            <mxPoint x="204" y="1282" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t42" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1270" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e43" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1282" as="sourcePoint"/>
            <mxPoint x="454" y="1282" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t44" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1270" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e45" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1282" as="sourcePoint"/>
            <mxPoint x="704" y="1282" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t46" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
