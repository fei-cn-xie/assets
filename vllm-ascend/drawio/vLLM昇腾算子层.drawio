        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;量化/非量化 GEMM 算子&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="552" width="700" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;列并行，不通信&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1036" y="552" width="424" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;attention&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="590" width="300" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;prefill 与 decode 是两个不同算子&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="590" width="700" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;布局不同，见 ③④&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1036" y="590" width="424" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;o_proj&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="628" width="300" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;GEMM + 行并行 all-reduce&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="628" width="700" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:11px&quot;&gt;每层一次通信&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1036" y="628" width="424" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:11px&quot;&gt;gate/up + SiLU + down&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="666" width="300" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;font style=&quot;font-size:11px&quot;&gt;可融合的向量/矩阵算子；MoE 则是分组矩阵乘&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="666" width="700" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;font style=&quot;font-size:11px&quot;&gt;MLP 主力&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1036" y="666" width="424" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;font style=&quot;font-size:11px&quot;&gt;lm_head&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="704" width="300" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;font style=&quot;font-size:11px&quot;&gt;GEMM（词表维度很大）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="704" width="700" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;font style=&quot;font-size:11px&quot;&gt;只对需要判 token 的位置算&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1036" y="704" width="424" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;font style=&quot;font-size:11px&quot;&gt;采样&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="742" width="300" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;font style=&quot;font-size:11px&quot;&gt;通用算子（排序/累加）+ 少量专用算子&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="742" width="700" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="&lt;font style=&quot;font-size:11px&quot;&gt;越往后越吃延迟&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1036" y="742" width="424" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="&lt;b&gt;第三步：为什么「算子层」值得单独一套图（三个理由）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;它决定了性能上限&lt;/b&gt;：同一份模型，融合算子用上与否能差出一大截——因为省掉的是「中间结果落显存再读回来」。&lt;br&gt;② &lt;b&gt;它决定了限制条件&lt;/b&gt;：很多「必须满足 X 才能跑」的要求（布局、头数、dtype、形状）不是框架规定的，而是&lt;b&gt;算子本身只支持这些&lt;/b&gt;。&lt;br&gt;③ &lt;b&gt;它解释了跨平台差异&lt;/b&gt;：vLLM 在 GPU 上的一套写法，到昇腾上要换成专用算子，所以本仓与上游的差异大量集中在这一层。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="812" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t44" value="&lt;b&gt;第四步：这一套的阅读顺序（与前面几站的接口）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="938" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="&lt;font style=&quot;font-size:10px&quot;&gt;站 1（Transformer 数学：每个算子算什么）× 站 4 ⑯（权重怎么参与计算）→ &lt;b&gt;本套（这些计算落到哪个 kernel）&lt;/b&gt; → 站 6（图捕获：怎么把一串 kernel 录成图）→ 站 8（参数：哪些开关决定用哪个 kernel）。&lt;br&gt;所以本套适合在「已经懂模型怎么算、也懂进程结构」之后读；反之，如果一上来就读算子名，会不知道它在算哪一步。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="968" width="1424" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：总览有了。下一步（②）先讲清一件最容易混的事——「一个算子」和「一次 kernel 下发」不是一回事。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1116" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;昇腾算子的统一封装入口：vllm-ascend/vllm_ascend/device/device_op.py（`torch_npu.*` 与 `torch.ops._C_ascend.*` 的集中封装，见 ⑧ 页的算子总表）&lt;br&gt;linear 与融合算子的实现：vllm-ascend/vllm_ascend/ops/（linear / layernorm / rotary_embedding 等）&lt;br&gt;attention 的落点见 ③④ 页；MoE 的落点见「MoE 套」⑧ 页&lt;br&gt;权重如何参与计算（GEMM 读的那份张量从哪来）：见「进程与线程」套 ⑯ 页&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1192" width="1424" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;模型图上的每一步，在昇腾上都要落到&lt;b&gt;一个具体的 kernel&lt;/b&gt;；融合算子省的是「落显存再读回来」；&lt;b&gt;而所有「必须满足 X 才能跑」的限制，绝大多数来自「算子只支持这些」。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1338" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t49" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1430" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1427" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1427" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1427" width="120" height="26" as="geometry"/>
