<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" pages="10">
  <diagram id="pg0" name="① draft 与 MTP 是什么">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1268" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="① 什么是 draft（草案）/ MTP：先猜几个，再一次验证" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：&lt;b&gt;用小代价先猜出接下来的 N 个 token（draft），再让大模型一次前向把这 N 个一起验证&lt;/b&gt;；猜对的直接白拿，猜错就从错的地方截断。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：没有 draft 时，每生成一个字都要跑一次完整前向&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;font style=&quot;font-size:10px&quot;&gt;生成 4 个字 = &lt;b&gt;4 次完整前向&lt;/b&gt;，每次前向都要把全部权重从显存读一遍（这就是「decode 是带宽瓶颈」的直接后果）。&lt;br&gt;注意：每次前向其实&lt;b&gt;只看 1 个新 token&lt;/b&gt;，却要付整份权重的访存成本——这就是为什么 decode 的算术强度只有 ~2 FLOP/字节（见入门套 ⑤）。&lt;br&gt;于是问题变成：&lt;b&gt;能不能让一次前向多干点活？&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="1424" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;第二步：加一个「便宜的起草者」之后&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="266" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="300" width="690" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t7" value="&lt;b&gt;① 起草（draft）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="308" width="670" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;font style=&quot;font-size:10px&quot;&gt;用一个便宜的来源先猜出接下来的 N 个 token：&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 同模型的额外小头（MTP 层）、· 独立小模型、· 直接查 n-gram。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;成本远低于「让大模型跑 N 次」——因为只跑一次小东西（或干脆不跑模型）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;得到 N 个候选 token，例如 [北京, 是, 中国, 的]。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="334" width="670" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="766" y="300" width="694" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t10" value="&lt;b&gt;② 验证（verify）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="776" y="308" width="674" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;font style=&quot;font-size:10px&quot;&gt;把 N 个候选&lt;b&gt;拼在输入里&lt;/b&gt;，让大模型&lt;b&gt;一次前向&lt;/b&gt;算出这 N 个位置的 logits。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;然后逐位置比对：这个位置上，大模型自己会选哪个 token？&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 一致 → 接受（白拿一个字）；· 不一致 → 从这里截断，用它自己的结果。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以「一次前向」最多能产出 N+1 个 token（N 个接受 + 1 个 bonus）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="776" y="334" width="674" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;为什么这不改变「输出分布」（这是投机解码的立身之本）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;直觉上的担心：草案是便宜模型猜的，接受它会不会让结果变差？&lt;br&gt;答案：&lt;b&gt;不会&lt;/b&gt;——因为接受与否由&lt;b&gt;大模型自己的概率&lt;/b&gt;决定：只有当大模型「也认为这个 token 够合理」时才接受，否则就按大模型的分布重新采样一个补上。&lt;br&gt;严格版本叫&lt;b&gt;拒绝采样（rejection sampling）&lt;/b&gt;，保证最终输出的分布与「老老实实逐字生成」完全一致（本仓代码注释直接引用了论文 arXiv:2211.17192）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="516" width="1424" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="t13" value="&lt;b&gt;第三步：「MTP」这个词在两种语境下出现，别混&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="642" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="676" width="690" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;b&gt;训练期的 MTP（多 token 预测辅助头）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="684" width="670" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;font style=&quot;font-size:10px&quot;&gt;在训练时额外挂几个「预测未来第 2、3 个 token」的头，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;让模型学到「往后看几步」的能力（DeepSeek-V3 风格）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;好处：训练信号更密；同时给推理期留下了一个可用的草稿头。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="710" width="670" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="766" y="676" width="694" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;b&gt;推理期的 MTP（= 用这个头来起草）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="776" y="684" width="674" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;font style=&quot;font-size:10px&quot;&gt;推理时把上面那个头当作 &lt;b&gt;draft 层&lt;/b&gt;：吃 target 的隐状态，自回归猜 N 个。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本仓代码里 &lt;font style=&quot;font-size:9px&quot;&gt;method='mtp'&lt;/font&gt; 会被当成 &lt;font style=&quot;font-size:9px&quot;&gt;eagle&lt;/font&gt; 一类处理（共享同一套 proposer）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以「MTP 加速」= 「用 MTP 头起草 + 大模型验证」= 投机解码的一种特例。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="776" y="710" width="674" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：这一页只说了「能白拿」。下一步（②）把「为什么划算」算成数：一次前向算 1+N 个位置，比算 1 个贵多少？&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="866" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;「一次前向处理 1+N 个 query」：vllm/config/vllm.py:660-679（uniform_decode_query_len = 1 + num_speculative_tokens）&lt;br&gt;草稿 N 的配置入口：vllm/config/speculative.py:381（num_speculative_tokens）&lt;br&gt;验证与拒绝采样：vllm/v1/sample/rejection_sampler.py:45-65（术语表与论文引用）、:188-200（入口）&lt;br&gt;本步要验证的草稿集合：vllm/v1/core/sched/output.py:334-337（scheduled_spec_decode_tokens）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="942" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;投机解码 = &lt;b&gt;先猜（draft）+ 一次前向验证&lt;/b&gt;；猜对的直接白拿、猜错从错处截断；因为接受规则由大模型自己的概率决定，&lt;b&gt;输出分布不变&lt;/b&gt;——这就是它敢上线的原因。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1078" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1170" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1167" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1167" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1167" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1167" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1167" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1167" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1167" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e31" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1216" as="sourcePoint"/>
            <mxPoint x="204" y="1216" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t32" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1204" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e33" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1216" as="sourcePoint"/>
            <mxPoint x="454" y="1216" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t34" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1204" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e35" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1216" as="sourcePoint"/>
            <mxPoint x="704" y="1216" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t36" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1204" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg1" name="② 为什么划算">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1312" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="② 为什么划算：把「1 次前向」的边际成本算清楚" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：decode 每步的&lt;b&gt;大头是搬权重&lt;/b&gt;（与 query 数几乎无关），所以把 1+N 个位置塞进同一次前向，权重的搬运费只付一遍——这就是投机解码的经济学基础。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：一次 decode 前向的成本，分两块看&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;成本项&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;是什么&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="236" y="152" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;随 1+N 怎么变&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="656" y="152" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;结论&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1076" y="152" width="380" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;font style=&quot;font-size:11px&quot;&gt;搬权重&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="192" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;font style=&quot;font-size:11px&quot;&gt;把全部参数从显存读一遍&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="192" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;font style=&quot;font-size:11px&quot;&gt;与 query 数&lt;b&gt;无关&lt;/b&gt;（只读一次）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="192" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:11px&quot;&gt;每步都要付，且是主要开销&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="192" width="380" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;搬 KV&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="232" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;读历史 KV 参与 attention&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="232" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;随 query 数线性增长&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="232" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;N 个位置就要读 N 份&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="232" width="380" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;算矩阵&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="272" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;GEMM 的浮点运算&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="236" y="272" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;随 query 数线性增长&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="272" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;算力本来就闲着（带宽瓶颈）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="272" width="380" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;b&gt;第二步：于是「多算几个位置」的边际成本很低&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="318" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="352" width="460" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t22" value="&lt;b&gt;只算 1 个（普通 decode）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="360" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;font style=&quot;font-size:10px&quot;&gt;搬权重：1 份（大头）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;搬 KV：1 份&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;算矩阵：1 份&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;产出：1 个 token&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 每 token 都要付一整份权重搬运费&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="386" width="440" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="518" y="352" width="460" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t25" value="&lt;b&gt;算 1+N 个（验证阶段）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="360" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t26" value="&lt;font style=&quot;font-size:10px&quot;&gt;搬权重：&lt;b&gt;仍是 1 份&lt;/b&gt;（同一批 GEMM）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;搬 KV：1+N 份（线性涨）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;算矩阵：1+N 份（算力本来闲着）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;最好情况产出：N+1 个 token（全中 + bonus）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="386" width="440" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1000" y="352" width="460" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;b&gt;所以算术强度被拉起来了&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="360" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t29" value="&lt;font style=&quot;font-size:10px&quot;&gt;算术强度 = 运算量 ÷ 访存量：&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 1 个位置：≈ 2 FLOP/字节（带宽死锁）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 1+N 个位置：约 (1+N)×2（权重那部分被摊薄）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 这正是 ①「一次前向多干活」的意义，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;也是 batching 的同一个道理（入门套 ⑤⑥）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="386" width="440" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="t30" value="&lt;b&gt;第三步：加速比怎么估（通用公式，仓内只给各分量）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="534" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:10px&quot;&gt;设第 i 个位置的&lt;b&gt;条件接受率&lt;/b&gt;为 αᵢ（越往后越低），draft 长度 K，则&lt;br&gt;&lt;b&gt;期望产出长度 E[L] = 1 + α₁ + α₁α₂ + … + α₁α₂…α_K&lt;/b&gt;（含最后那个 bonus token）&lt;br&gt;&lt;b&gt;加速比 ≈ E[L] ÷ (1 + 验证额外开销比)&lt;/b&gt;　—— 注意分母：draft 自己也要花时间，K 越大验证越贵。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;所以「K 越大越好」是错的：E[L] 增长会饱和，而开销线性涨。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="568" width="1424" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="710" width="700" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="t33" value="&lt;b&gt;理想情况：草案很准（α 都接近 1）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="718" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t34" value="&lt;font style=&quot;font-size:10px&quot;&gt;一次前向产出接近 1+K 个 token，加速比接近 K+1（再扣掉 draft 开销）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;什么时候准：文本有强规律（代码、格式化输出、RAG 里大量原文引用、n-gram 重复）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="744" width="680" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="796" y="710" width="664" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="t36" value="&lt;b&gt;糟糕情况：草案不准（α 很快衰减）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="718" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t37" value="&lt;font style=&quot;font-size:10px&quot;&gt;第一个位置就被拒 → 白算了一遍 draft，还多读了 KV，纯亏。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;什么时候不准：开放式创作、长上下文后期（接受率会明显下降）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;这就是为什么需要「按位置统计接受率」并用它来调 K（见 ⑧ 的指标）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="744" width="644" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：既然「草案准不准」决定一切，那草案从哪来就成了关键问题。下一步（③）看 draft 的四种来源，以及 vLLM 里各自的实现类。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="900" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;「一次 decode 提交 1 + N 个 query」：vllm/config/vllm.py:661-679；vllm/v1/worker/gpu_model_runner.py:905&lt;br&gt;memory-bound 与「闲着算力」的本仓原文：vllm/docs/features/speculative_decoding/README.md:3、adaptive_verification.md:3（the extra draft tokens are close to free）&lt;br&gt;验证成本随 K 增长的说明：vllm/docs/features/speculative_decoding/adaptive_verification.md:3；vllm-ascend/docs/.../speculative_decoding.md:785&lt;br&gt;逐位接受率衰减：adaptive_verification.md:5；指标定义 vllm/v1/spec_decode/metrics.py:107-118&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="976" width="1424" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;投机的收益来自「权重只搬一次」，上限是 1+K 个 token；实际加速 ≈ 期望接受长度 ÷ 额外开销。&lt;b&gt;K 不是越大越好，接受率决定一切。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1122" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t41" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1214" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1211" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1211" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1211" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1211" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1211" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1211" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1211" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e49" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1260" as="sourcePoint"/>
            <mxPoint x="204" y="1260" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t50" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1248" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e51" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1260" as="sourcePoint"/>
            <mxPoint x="454" y="1260" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t52" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1248" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e53" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1260" as="sourcePoint"/>
            <mxPoint x="704" y="1260" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t54" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1248" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg2" name="③ 草案的来源">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1334" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="③ 草案从哪来：四种来源，各有各的代价" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：draft 可以来自&lt;b&gt;同模型的额外头（MTP/EAGLE）、独立小模型、n-gram 查表、或并行多头（Medusa）&lt;/b&gt;；选哪种决定了「省不省显存」与「准不准」。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：四种来源（按「要不要额外权重」排序）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;来源&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="260" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;怎么出草案&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="296" y="152" width="420" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;优缺点&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="716" y="152" width="560" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;配置里的 method&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1276" y="152" width="180" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;font style=&quot;font-size:11px&quot;&gt;① 同模型自带 MTP 头&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="198" width="260" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;font style=&quot;font-size:11px&quot;&gt;target 里已经有 nextn 层（权重和模型一起下载）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="198" width="420" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;font style=&quot;font-size:11px&quot;&gt;不需要额外权重；复用 target 的 embedding/lm_head/KV&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="716" y="198" width="560" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:11px&quot;&gt;method=mtp&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1276" y="198" width="180" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;② EAGLE 类小头&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="244" width="260" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;吃 target 的隐状态，自回归猜 N 步&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="244" width="420" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;准；但仍需一份小头权重&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="716" y="244" width="560" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;method=eagle / eagle3&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1276" y="244" width="180" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;③ 独立小模型&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="290" width="260" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;另起一个小模型自回归起草&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="290" width="420" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;可插拔、泛化好；但要另占显存与一份 KV&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="716" y="290" width="560" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;method=draft_model&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1276" y="290" width="180" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;④ n-gram / suffix 查表&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="336" width="260" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;在同段文本里找重复片段，直接把后面抄过来&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="336" width="420" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;零模型零显存；文本有重复时极准，否则几乎无效&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="716" y="336" width="560" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;method=ngram / suffix&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1276" y="336" width="180" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="t24" value="&lt;b&gt;第二步：vLLM 里「选谁当起草者」就是一个 if/elif（没有 ProposerManager）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="388" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:10px&quot;&gt;在 model runner 初始化时按 method 直接构造：&lt;font style=&quot;font-size:9px&quot;&gt;EagleProposer / MedusaProposer / DraftModelProposer / NgramProposer / SuffixDecodingProposer …&lt;/font&gt;&lt;br&gt;同一个地方还构造 &lt;font style=&quot;font-size:9px&quot;&gt;rejection_sampler&lt;/font&gt;（验证器）。所以「起草」与「验证」是&lt;b&gt;成对&lt;/b&gt;装配的。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;注意：&lt;font style=&quot;font-size:9px&quot;&gt;method='mtp'&lt;/font&gt; 与他人共用 EAGLE 那条实现路径（代码里 mtp 被归到 eagle 一类）。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="422" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="t26" value="&lt;b&gt;第三步：怎么选（两把尺子：显存 vs 接受率）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="532" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="566" width="700" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;b&gt;省显存优先 → MTP / EAGLE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="574" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t29" value="&lt;font style=&quot;font-size:10px&quot;&gt;复用 target 的 embedding、lm_head，甚至共享同一份 KV cache；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以额外显存开销很小，而且接受率通常最高（因为它的隐藏状态与 target 同源）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;代价：只有「模型自带这个头」或「能找到配套小头」时才能用。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="600" width="680" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="796" y="566" width="664" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t31" value="&lt;b&gt;零成本优先 → n-gram / suffix&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="574" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t32" value="&lt;font style=&quot;font-size:10px&quot;&gt;完全不用模型，纯字符串匹配；对「代码补全 / 大段引用 / 格式化输出」特别有效。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;但遇到开放式生成几乎全被拒——被拒也要付验证成本，所以可能是负收益。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;适合做「能省则省」的兜底策略，而不是主策略。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="600" width="644" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="774" width="1424" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="t34" value="&lt;b&gt;独立小模型（draft_model）：为什么它反而少见&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="782" width="1404" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t35" value="&lt;font style=&quot;font-size:10px&quot;&gt;要另带一份权重 + 一份 KV（显存直接变贵），而且小模型的分布与大模型差得远、接受率偏低；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;但它有两个不可替代的场景：&lt;b&gt;① 大模型族没有自带 MTP 头&lt;/b&gt;；&lt;b&gt;② 需要「跨模型复用」同一个 drafter&lt;/b&gt;（一个 drafter 服务多种 target）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本仓部署里用的是 MTP（见 ⑨），不是这个。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="808" width="1404" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：知道草案从哪来之后，就该看「它怎么被验证」——这是整套机制的数学核心。下一步（④）走一遍完整的 10 步流程。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="922" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;proposer 的构造（if/elif 装配 + rejection_sampler）：vllm/v1/worker/gpu_model_runner.py:629-704&lt;br&gt;method 判定谓词（use_eagle / uses_draft_model 等）：vllm/config/speculative.py:1909-1942&lt;br&gt;各实现类：vllm/v1/spec_decode/eagle.py:10、medusa.py:18、draft_model.py:19、ngram_proposer.py:12、suffix_decoding.py:9&lt;br&gt;MTP 被归入 eagle 一类：vllm/config/speculative.py:1909-1913&lt;br&gt;MTP 层复用 target 权重（共享 embedding/lm_head）：vllm/v1/spec_decode/llm_base_proposer.py:1406、:1517&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="998" width="1424" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;draft 的四种来源本质是「用多少额外资源换多高的接受率」：MTP/EAGLE 最省也最准（复用 target），独立小模型最通用但最贵，n-gram 零成本但只在有重复时有效。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1144" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t39" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1236" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1233" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1233" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1233" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1233" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1233" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1233" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1233" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e47" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1282" as="sourcePoint"/>
            <mxPoint x="204" y="1282" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t48" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1270" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e49" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1282" as="sourcePoint"/>
            <mxPoint x="454" y="1282" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t50" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1270" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e51" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1282" as="sourcePoint"/>
            <mxPoint x="704" y="1282" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t52" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1270" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg3" name="④ draft step 十步">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1290" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="④ 一次带 draft 的 step：十步走完（按代码顺序）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：&lt;b&gt;调度器一次排 1+N 个位置 → 一次前向算出这 N 行验证 logits + 1 行 bonus → 拒绝采样逐位判 → 回退 KV → 用本步隐状态起草下一步&lt;/b&gt;。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;上：调度器与 worker（1-5）　　下：验证与回写（6-10）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;①　调度器一次排 1+N 个位置&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;num_new_tokens 一般就是 1+N（N = num_speculative_tokens），再被「剩余上下文长度」收紧。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;②　按 1+N 分配 KV，并给 drafter 多留 N 个槽&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;allocate_slots(..., num_lookahead_tokens=N)：因为 drafter 会往 target 之后写 KV，必须多预留（否则越界）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="220" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;③　把草案写进本步输出，并清空请求侧缓存&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;scheduled_spec_decode_tokens[req] = 草案；request.spec_token_ids 清空；padding 的位置填 -1（表示「这些位置没有草案」）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="290" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;④　worker 把草案灌进输入批（含 positions / slot_mapping）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;positions = 已算 token 数 + 位置偏移；一次前向就要覆盖这 1+N 行。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="360" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;⑤　算 logits 行索引：每请求 N 行验证 + 1 行 bonus&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;logits_indices / target_logits_indices / bonus_logits_indices 三组索引，把「哪一行是哪个请求的哪个位置」映射清楚。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="430" width="1424" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;⑥　一次前向：target 算出 1+N 行 logits&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;这一步就是「一次前向多干活」的实体：权重读一遍，算出所有候选位置的分布。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="506" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;⑦　先采 bonus（最后一行）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;bonus 只用 target 分布采（可带 temperature/top-p），是「全中时白送」的那个 token。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="576" width="1424" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;⑧　拒绝采样逐位判：贪心 or 随机&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;随机：u &lt; p_target/p_draft 才接受；贪心：与 target 的 argmax 相等才接受。一旦某位被拒，后面全部作废。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="646" width="1424" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;⑨　被拒位置补一个 token（recovered），输出定长 [B, N+1]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;recovered 从残差分布 max(p_target − p_draft, 0) 归一化后采样；输出数组空位填 -1，同步路径再把 -1 截掉。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="722" width="1424" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;⑩　回退 KV，并用本步隐状态起草下一步&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#333333&quot;&gt;num_computed_tokens -= 被拒个数；草案由 drafter.propose() 用本步 hidden states 生成，异步拷回后交给 scheduler 缓存成 spec_token_ids。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="798" width="1424" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：第 ⑧ 步「拒绝采样」是整套机制的数学核心——下一步（⑤）把贪心与随机两条分支讲透，包括为什么它不改变输出分布。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="878" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;①②③ 调度侧：vllm/v1/core/sched/scheduler.py:663-681（1+N 宽度）、:741-745（lookahead 槽）、:823-839（写 draft 并清缓存）、:1330-1334（-1 填充）&lt;br&gt;④⑤ 灌输入与索引：vllm/v1/worker/gpu_model_runner.py:1521-1533、:2245-2280、:2833-2906&lt;br&gt;⑥ 一次前向：同文件 :4188-4271&lt;br&gt;⑦⑧⑨ 验证：vllm/v1/sample/rejection_sampler.py:140-162（bonus）、:188-200（入口）、:719-773（贪心）、:822-893（随机）、:1043-1077（recovered）&lt;br&gt;⑩ 回退与起草：scheduler.py:2041-2059、gpu_model_runner.py:4625-4639、:5020-5297&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="954" width="1424" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;一次带 draft 的 step = 「排 1+N 个位置 → 一次前向 → 逐位判 + 补位 → 回退被拒的 KV → 起草下一步」；&lt;b&gt;N 个草案里能被接受的个数，决定了这一步实际白赚几个 token。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1100" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1192" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1189" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1189" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1189" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1189" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1189" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1189" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1189" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="起草（draft）相关" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1189" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e26" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1238" as="sourcePoint"/>
            <mxPoint x="204" y="1238" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t27" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1226" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e28" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1238" as="sourcePoint"/>
            <mxPoint x="454" y="1238" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t29" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1226" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e30" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1238" as="sourcePoint"/>
            <mxPoint x="704" y="1238" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t31" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1226" width="190" height="24" as="geometry"/>
