  <diagram id="pg8" name="⑨ LWD 下的 MTP">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1418" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑨ LWD 边云 PD 下的 MTP：draft 在云侧，edge 只按接受数出 token" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：&lt;b&gt;MTP 只在云端 P/D 两个实例上跑，edge 不跑&lt;/b&gt;；而 PD 交接用 &lt;font style=&quot;font-size:9px&quot;&gt;(p_end, i_end, r_pos)&lt;/font&gt; 三元组定边界，D 从 &lt;font style=&quot;font-size:9px&quot;&gt;r_pos&lt;/font&gt; 起的「尾」才是它自己的。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：三个角色里只有两个跑 MTP&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;edge（1 卡）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;没有 --speculative-config；模块归属表把 MTP 划给 cloud，edge 侧裁掉。&lt;br&gt;它只做：算 prompt embedding（UP 前）、按接受数做 UNEMBED（DOWN 后）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="460" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;P（prefill）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;配置里同样带 MTP，但 P 被压成 max_tokens=1、不产出用户可见输出；draft 在这里的实际收益有限（代码里没看到按角色跳过 draft 的守卫）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="518" y="152" width="460" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;D（decode）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MTP 的主战场：每一步都起草 K 个、验证、把&lt;b&gt;真实接受行数&lt;/b&gt;回传给 edge，由 edge 决定这次吐几个 token。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="152" width="460" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="t7" value="&lt;b&gt;第二步：PD 交接的三元组（MTP 让「边界」这件事更精确）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="308" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;p_end&lt;/b&gt; = P 真正算到的位置（只跑到 p_end+1）　·　&lt;b&gt;i_end&lt;/b&gt; = KV 导入边界（D 只拉到这里）　·　&lt;b&gt;r_pos&lt;/b&gt; = D 开始「拥有自己尾巴」的位置&lt;br&gt;代码里只允许两种合法形态（例如 truncate 与否），D 侧会&lt;b&gt;强校验&lt;/b&gt;「P 导出的三元组」与本地算出的一致，不一致直接失败。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;有了 MTP，D 从 r_pos 起要「一次算 1+K 个位置」，所以 tail 的长度必须对得上 1+K 的节奏——这就是三元组必须精确的原因。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="342" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;b&gt;第三步：接受数如何穿过边云链路（最容易出错的一环）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="464" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="498" width="700" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;云侧：把「物理行」改写成「真实提交行数」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="506" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;font style=&quot;font-size:10px&quot;&gt;D 的一次前向输出是 1+K 行的数组（空位 -1）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;回传给 edge 之前，云侧调度器把 num_accepted_tokens 从物理行数改写为&lt;b&gt;真实提交的行数&lt;/b&gt;。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;否则 edge 会按 1+K 去取 hidden，取到 padding 的垃圾。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="532" width="680" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="498" width="664" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;b&gt;edge 侧：按接受数校验后 UNEMBED&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="506" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;font style=&quot;font-size:10px&quot;&gt;edge 收到 DOWN 的 hidden 与接受数，强校验 end − start == num_accepted，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;再用 lm_head 做 UNEMBED，产出这次要吐给用户的 token。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;日志里能直接看到 accepted 数（[Lwd][edge-worker] UNEMBED … accepted=…）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="532" width="644" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;b&gt;第四步：LWD 特有的两处改动（只改 embedding 来源，不改起草逻辑）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="680" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;首步 embedding 来源&lt;/b&gt;：正常路径靠 token id 查表；LWD 里云端已收到 edge 上传的 prompt embedding，所以 draft 首步直接复用那份张量（充填 &lt;font style=&quot;font-size:9px&quot;&gt;inputs_embeds&lt;/font&gt;）。&lt;br&gt;② &lt;b&gt;SP 下的切片&lt;/b&gt;：外部 embedding 在序列并行下要按 TP 重新切一遍。&lt;br&gt;此外还有一条 guard：continued prefill 场景不允许回退成 token id 查表，缺权威 embedding 直接报错。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="714" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;实测代价：开 MTP 会让并发变小&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本仓 TP=1 且开 MTP 的部署包里，KV 只剩几十个块（32~63 个 GDN 块），max_num_seqs 只能设到 32；关掉 MTP 后可用 KV 明显回升。&lt;br&gt;原因就是 ⑦ 讲的两块开销：draft 自己的权重/缓冲 + lookahead 槽。&lt;b&gt;所以「开 MTP」不是无条件更快，要按接受率与并发一起权衡。&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="858" width="1424" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：整套讲完——概念（①②）、机制（③④⑤⑥）、约束（⑦）、落地（⑧⑨）。下一步（⑩）给指标、日志与排障顺序。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="998" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;三元组计算与校验：vllm/v1/lwd_control/pd/envelope.py:215-227；vllm/v1/lwd_control/pd/cloud_runtime.py:226-227、:318-343、:356-357&lt;br&gt;接受数改写：vllm/v1/lwd_control/control_cloud_scheduler/lwd_cloud_scheduler.py:534-546；edge 校验 vllm/v1/lwd_control/pd/edge_runtime.py:352-359&lt;br&gt;LWD draft 改动：vllm-ascend/worker/lwd_cloud_model/lwd_mtp_proposer.py:28-59（首步 embedding）、:61-102（SP 切片）、:105（多 KV 组变体）&lt;br&gt;谁来换 proposer：lwd_cloud_model_runner.py:284-300（条件：lwd_config 且 method=mtp）&lt;br&gt;MTP 层 KV 单独编号：vllm-ascend/.../kv_p2p/mooncake_connector.py:2391-2403&lt;br&gt;edge 不配 MTP：assets/c_home/bash/pds/30rc_1124/*/edge.sh（无 --speculative-config）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1074" width="1424" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;LWD 下 MTP 只在云侧跑；元组 (p_end, i_end, r_pos) 划清「P 算到哪、KV 拉到哪、D 从哪开始算」；接受数必须被改写成「真实提交行数」再回传，edge 才能正确 UNEMBED。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1228" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t22" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1320" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1317" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1317" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1317" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1317" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1317" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1317" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1317" width="120" height="26" as="geometry"/>
        </mxCell>
