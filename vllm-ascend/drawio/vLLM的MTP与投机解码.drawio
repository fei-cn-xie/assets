  </diagram>
  <diagram id="pg7" name="⑧ 昇腾侧 MTP">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1460" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑧ 昇腾侧：MTP 层排在 backbone 之后，draft 默认跑 eager" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：昇腾的 MTP 走 eagle 外壳（&lt;font style=&quot;font-size:9px&quot;&gt;AscendEagleProposer&lt;/font&gt;），MTP 层是 backbone 之后的额外层、&lt;b&gt;有自己独立的 KV&lt;/b&gt;；而部署里 draft 侧一律 &lt;font style=&quot;font-size:9px&quot;&gt;enforce_eager: true&lt;/font&gt;。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：MTP 层在哪、和 target 共享什么&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;backbone（0 … N-1 层）&lt;/b&gt;：target 主体，产出 hidden states&lt;br&gt;　　　↓&lt;br&gt;&lt;b&gt;MTP 层（第 N 层起）&lt;/b&gt;：吃 hidden + 下一 token 的 embedding，猜第 K 步&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;共享：embedding 与 lm_head（省显存）&lt;br&gt;不共享：KV cache —— MTP 层有自己的层号与槽位&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="690" height="172" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="766" y="152" width="694" height="172" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;b&gt;为什么要记「共享权重但不共享 KV」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="776" y="160" width="674" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t7" value="&lt;font style=&quot;font-size:10px&quot;&gt;共享权重 → 不用再下一份 embedding/lm_head，显存增量小；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;不共享 KV → 草案的 KV 要单独占位（PD 传输时也作为额外层单独编号，但 MTP 多层共用同一份层，所以只传一次）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;搞混这两件事，就会误以为「MTP 不占显存」或「KV 也能共享」。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="776" y="186" width="674" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;第二步：一次起草的内部（MTP 复用同一层 K 次）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="330" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;font style=&quot;font-size:10px&quot;&gt;① target 前向 → 得到本步 logits 与 hidden states；同一函数体里立刻接着起草。&lt;br&gt;② 第 0 步：用 target 的 hidden + 下一 token 的 embedding 跑一次 MTP 层 → 得到第 1 个草案。&lt;br&gt;③ 之后串行 K−1 次，&lt;b&gt;复用同一个 MTP 层&lt;/b&gt;（层选择 &lt;font style=&quot;font-size:9px&quot;&gt;spec_step_idx % num_mtp_layers&lt;/font&gt;）→ 得到第 2 … K 个草案。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;所以「MTP 只有一层权重也能猜 K 个」——靠的是反复跑同一层；这也是官方建议 K=1~3 的原因（越往后越不准）。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="364" width="1424" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="t10" value="&lt;b&gt;第三步：昇腾侧的三道硬上限（都会直接报错，不是警告）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="498" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="532" width="460" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;b&gt;① TND 布局：K+1 ≤ 16&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="540" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t13" value="&lt;font style=&quot;font-size:10px&quot;&gt;昇腾 fused attention 的 TND 布局对 query 长度有上限，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;代码里断言 decode_threshold ≤ 16（即 K ≤ 15）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;部署里用 K=3（个别包 K=1），离上限很远。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="566" width="440" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="518" y="532" width="460" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;b&gt;② padded drafter 与整图互斥&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="540" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;font style=&quot;font-size:10px&quot;&gt;「整图 + 变长 draft 批」这个组合不支持：&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;代码直接 NotImplementedError，提示去掉 disable_padded_drafter_batch。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以要么 batch 补齐、要么别用整图。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="566" width="440" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1000" y="532" width="460" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;b&gt;③ draft 与某些图/并行特性互斥&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="540" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;font style=&quot;font-size:10px&quot;&gt;draft 只有在「target 开了整图 + draft 自己没 enforce_eager」时才包 ACLGraphWrapper；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;此外 lmhead TP 与 draft 的几种采样方式互斥（4 条 NotImplementedError）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MLA/MTP 的整图与 CP 不兼容。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="566" width="440" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;b&gt;第四步：本仓部署脚本里实际怎么配（12 处实测）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="728" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;配置项&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="762" width="260" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;本仓实测取值与含义&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="296" y="762" width="1160" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;method&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="798" width="260" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;一律 mtp（个别写 qwen3_5_mtp，会被归一成 mtp 并打 deprecation 警告）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="798" width="1160" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;num_speculative_tokens&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="834" width="260" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;3（fix_1120 那套是 1）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="834" width="1160" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;enforce_eager&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="870" width="260" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;true —— &lt;b&gt;只作用于 draft&lt;/b&gt;，target 仍然走图&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="870" width="1160" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;model（draft 路径）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="906" width="260" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;不给：默认取 target 的权重目录，MTP 权重就是同目录里的 mtp.* 张量&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="906" width="1160" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;target 的图模式&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="942" width="260" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;P/edge 用 --enforce-eager；D 用 FULL_DECODE_ONLY&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="942" width="1160" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="t33" value="&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;关键理解：&lt;b&gt;speculative-config 里的 enforce_eager 只关 draft 的图&lt;/b&gt;，与 target 的 --enforce-eager 是两件事——所以「target 跑图 + draft 跑 eager」是合法且常见的组合。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="984" width="1424" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：昇腾侧讲完，最后一块是本仓特有的「LWD 边云 PD」下 MTP 怎么与 KV 交接共存。下一步（⑨）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1032" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;MTP 走 eagle 外壳：vllm-ascend/vllm_ascend/spec_decode/__init__.py:54-60、eagle_proposer.py:10&lt;br&gt;draft 主体与起草：vllm-ascend/vllm_ascend/spec_decode/llm_base_proposer.py:1042（_propose）、:1517-1535（首步）、:1716（串行复用）&lt;br&gt;MTP 层与共享权重：vllm/model_executor/models/deepseek_mtp.py:142-147、:212-219；vllm/v1/spec_decode/llm_base_proposer.py:1406、:1517&lt;br&gt;TND ≤16 断言：vllm-ascend/.../attention/attention_v1.py:273-277（及 mla/sfa/dsa 同构处）&lt;br&gt;padded drafter × 整图互斥：vllm-ascend/.../spec_decode/llm_base_proposer.py:346-356&lt;br&gt;draft 是否跑图：同文件 :271、:670-684&lt;br&gt;部署配置：assets/c_home/bash/pds/30rc_1124/*/cloud_{p,d}.sh（--speculative-config）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1108" width="1424" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;昇腾 MTP = 「backbone 之后的一层，反复跑 K 次」；共享权重、不共享 KV；部署里 draft 走 eager、target 走图；三道硬上限（TND≤16、padded×整图、draft×部分特性）踩到就直接报错。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1270" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t37" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1362" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1359" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
