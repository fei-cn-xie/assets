    </mxGraphModel>
  </diagram>
  <diagram id="pg4" name="⑤ 验证规则">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1336" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑤ 验证规则：贪心看 argmax、随机比 p/q —— 为什么这样就不改变分布" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：验证不是「草案看着像就收」，而是&lt;b&gt;用 target 自己的概率做裁判&lt;/b&gt;：贪心模式下比 argmax 是否一致；随机模式下按 min(1, p_target/p_draft) 的概率接受。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：两条分支（同一个 sampler 里按 temperature 是否 0 分开）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="700" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;贪心模式（temperature = 0）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="160" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;font style=&quot;font-size:10px&quot;&gt;对每个候选位置：target 的 argmax 是多少？&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 草案 token == target 的 argmax → 接受，继续看下一位&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 不相等 → 拒绝，并把 target 的 argmax 作为这一位的输出，后面全作废&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;全中 → 额外给 1 个 bonus token（也从 target 采）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本质：等价于「取草案与真实输出的最长公共前缀」。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="186" width="680" height="158" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="796" y="152" width="664" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;随机模式（temperature &gt; 0）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="160" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;font style=&quot;font-size:10px&quot;&gt;对每个候选位置，取一个均匀随机数 u ∈ [0,1)：&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 若 &lt;b&gt;u &lt; p_target(token) / p_draft(token)&lt;/b&gt; → 接受&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 否则拒绝；被拒的这位不是「丢掉」，而是从&lt;b&gt;残差分布&lt;/b&gt;里重新采一个：&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;　 p_residual ∝ max(p_target − p_draft, 0)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本质：接受 + 补位的组合，使最终分布严格等于 target 的分布（论文 arXiv:2211.17192）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="186" width="644" height="158" as="geometry"/>
        </mxCell>
        <mxCell id="t10" value="&lt;b&gt;第二步：为什么这套规则是「无损」的（只需三层直觉）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="358" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;草案只是「提议」&lt;/b&gt;：它不决定输出，只决定「我们多看几个位置」。&lt;br&gt;② &lt;b&gt;接受有概率上限&lt;/b&gt;：p_target/p_draft 比值小的地方（= target 不喜欢的 token）就难被接受；比值 ≥1 的地方（target 也喜欢）必然接受。&lt;br&gt;③ &lt;b&gt;拒绝处补位&lt;/b&gt;：被拒的位置用 max(p_t − p_d, 0) 归一化后重采，正好补上「草案少给的那部分概率质量」。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;接受 + 补位合起来，恰好等于「直接用 target 分布采样」——所以输出分布不变，只是变快了。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="392" width="1424" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;b&gt;第三步：三个必须知道的边界（代码里都有专门处理）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="526" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="560" width="460" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;b&gt;① 没有概率的草案（n-gram）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="568" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;font style=&quot;font-size:10px&quot;&gt;查表出来的草案没有 q 可算，于是代码里令 p_draft = 1，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;接受条件退化成 &lt;b&gt;u &lt; p_target(token)&lt;/b&gt;——「target 觉得够可能就收」。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="594" width="440" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="518" y="560" width="460" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;b&gt;② 草案概率为 0&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="568" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;font style=&quot;font-size:10px&quot;&gt;若 p_draft == 0，比值会变成 inf/NaN。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;代码里显式判为「拒绝」，避免除零带来的数值问题。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="594" width="440" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1000" y="560" width="460" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;b&gt;③ padding 的位置&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="568" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;font style=&quot;font-size:10px&quot;&gt;为了凑形状，scheduler 会填 -1 占位；验证时这些位置一律按「拒绝」处理，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;不会污染结果（同时保证图捕获要求的固定形状）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="594" width="440" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;bonus token：为什么全中时要多送一个&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;一次前向算了 N+1 行（N 个草案位置 + 1 个「下一位置」）。如果 N 个草案全被接受，那么第 N+1 行 logits 本来就摆在手上——直接用它采一个 token 是&lt;b&gt;免费的&lt;/b&gt;。&lt;br&gt;所以「全中」的产出是 N+1 个 token。也正因如此，平均接受长度（mean acceptance length）的统计口径是 &lt;b&gt;1 + 接受数/草案数&lt;/b&gt;。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="776" width="1424" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：被拒的那些位置，KV 已经写进去了——怎么处理？下一步（⑥）就是这套机制最容易被误解的一环。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="916" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;两条分支与入口：vllm/v1/sample/rejection_sampler.py:188-200（入口）、:719-773（贪心 kernel，:761 比较 argmax）、:822-893（随机 kernel）&lt;br&gt;接受条件与除零保护：rejection_sampler.py:864-877（accepted = draft_prob &gt; 0 and target_prob/draft_prob &gt;= uniform_prob）&lt;br&gt;无概率草案 p_draft=1：rejection_sampler.py:864-865&lt;br&gt;残差补位：rejection_sampler.py:1043-1077（prob = max(target_prob - draft_prob, 0)）&lt;br&gt;bonus token：rejection_sampler.py:55-65、:887-893&lt;br&gt;pad 位置按 -1 拒绝：rejection_sampler.py:856-859；scheduler.py:1330-1334&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="992" width="1424" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;验证的裁判是 target 自己的概率——贪心比 argmax、随机比 p/q 并按时被拒后从残差补位；&lt;b&gt;因此投机解码不改变输出分布，只改变「一次前向能推进几个 token」。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1146" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t26" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1238" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1235" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1235" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1235" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1235" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1235" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1235" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1235" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e34" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1284" as="sourcePoint"/>
            <mxPoint x="204" y="1284" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t35" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1272" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e36" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1284" as="sourcePoint"/>
            <mxPoint x="454" y="1284" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t37" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1272" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e38" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1284" as="sourcePoint"/>
            <mxPoint x="704" y="1284" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t39" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1272" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg5" name="⑥ KV 回退">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1322" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑥ 被拒的 KV 怎么办：不回滚数据，只回退「算到哪了」" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：验证前向会把 1+N 行 KV &lt;b&gt;全部写进去&lt;/b&gt;（包括后来被拒的位置）；被拒时不擦数据，而是把 num_computed_tokens 退回去 —— 下一轮从同一批槽位重新覆盖。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：三个事实（顺序很重要）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="460" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;① 验证前向「全都写」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="160" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;font style=&quot;font-size:10px&quot;&gt;slot_mapping 是按 positions 全量算出来的，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以 1+N 行都会写进 KV cache，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;包括那些后来被拒的位置。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 也就是说：被拒的 KV 确实存在过。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="186" width="440" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="518" y="152" width="460" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;② 回退的是「计数」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="160" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;font style=&quot;font-size:10px&quot;&gt;num_rejected = 草案数 − 接受数；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;num_computed_tokens -= num_rejected；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 「这个请求算到第几个 token」被退回到被拒位置。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;（注意：这一步在调度器侧做，不在 worker）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="186" width="440" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="152" width="460" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;③ 不擦数据，靠「同槽覆盖」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="160" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;font style=&quot;font-size:10px&quot;&gt;下一轮 positions 从回退后的位置重新算，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;compute_slot_mapping 会算出&lt;b&gt;同一批槽位&lt;/b&gt;，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;于是新数据直接覆盖掉旧的（脏数据自愈）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 所以没有「擦除」操作，也不需要额外开销。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="186" width="440" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="t13" value="&lt;b&gt;第二步：一轮的时间线（第 2、3 个草案被拒的情形）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="348" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:10px&quot;&gt;上一轮末尾：算出 4 行（1 个新 token + 3 个草案）→ 全部写入 KV 槽位 #a #b #c #d&lt;br&gt;验证：第 1 个接受、第 2 个被拒 → 接受数 = 1&lt;br&gt;回退：num_rejected = 3 − 1 = 2 → num_computed_tokens 退回 2 个位置&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;下一轮：positions 从 #c 重新开始，#c #d … 被新数据覆盖（不需要任何擦除/释放操作）&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="382" width="1424" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;b&gt;第三步：异步调度（async scheduling）还要多一层「乐观账」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="496" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="530" width="700" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;b&gt;问题&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="538" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;font style=&quot;font-size:10px&quot;&gt;异步模式下，调度器不等 worker 回报就先把「已算 token 数」按乐观值推进&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;（假设全接受，因为多数情况确实接受）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;但实际可能少接受几个 → 必须事后校正。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="564" width="680" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="530" width="664" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;b&gt;做法&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="538" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;font style=&quot;font-size:10px&quot;&gt;worker 回传「本步真实接受数」（valid_sampled_token_count），&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;调度器算 correction = 乐观值 − 实际值，再把 num_computed_tokens 扣回来；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;同时同步 num_output_placeholders（占位计数）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="564" width="644" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;顺带解释一个容易困惑的点：为什么「给 drafter 多留 N 个 KV 槽」&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;草案阶段要往 target 之外的位置写 KV（例如第 N+1 个草案位置），所以分配时除了给 1+N 个 query 的槽，还要额外预留 N 个 lookahead 槽。&lt;br&gt;如果不预留 → 写越界 / 需要临时扩容 → 既慢又可能碎。这也是「开投机解码会让可用 KV 变少」的直接原因之一（见 ⑦ 与 ⑨ 的实测）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="746" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：KV 的账（回退 + lookahead）就是投机解码与「显存」这条约束的接口。下一步（⑦）把三条系统约束（形状/显存/调度）一次性摊开。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="902" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;全量写 KV：slot_mapping 由 positions 算出 vllm/v1/worker/gpu_model_runner.py:2196-2209&lt;br&gt;回退计数：vllm/v1/core/sched/scheduler.py:2041-2059（num_rejected 与 num_computed_tokens 扣减）&lt;br&gt;同槽覆盖：下一轮 positions/slot 重算同文件 :2196-2209&lt;br&gt;异步乐观/校正：gpu_model_runner.py:1383-1408（乐观）、:1554-1584（校正）、vllm/v1/spec_decode/utils.py:822-851&lt;br&gt;lookahead 预留：vllm/config/vllm.py:633-658；scheduler.py:741-745&lt;br&gt;hybrid/Mamba 只保留末位 state：gpu_model_runner.py:1588-1644&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="978" width="1424" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;被拒的 KV 不擦、不释放，只把「算到哪了」的计数退回去，下一轮覆盖同一批槽位；异步调度还要再补一层乐观校正。&lt;b&gt;代价是：为了给 drafter 留槽，可用 KV 会变少。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1132" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t26" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1224" width="104" height="20" as="geometry"/>
