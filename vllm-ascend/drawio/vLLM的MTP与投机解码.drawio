  </diagram>
  <diagram id="pg6" name="⑦ 三条系统约束">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1422" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑦ 投机解码踩到的三条系统约束（与前面几套图接上）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：decode 的 query 长度从 1 变成 1+K，&lt;b&gt;形状变了（图捕获要补桶）、显存变了（要多留 lookahead 槽）、调度变了（要求 uniform decode）&lt;/b&gt;。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;约束一：形状 —— decode 的 query 长度 = 1 + K&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="700" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;发生了什么&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="160" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;font style=&quot;font-size:10px&quot;&gt;普通 decode：每个请求这一步只有 1 个 query 位置；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;投机 decode：每个请求有 1+K 个位置（K 个草案 + 1 个 new）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以「一次前向的 token 数」= 请求数 × (1+K)。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;代码里这个名字叫 uniform_decode_query_len。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="186" width="680" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="796" y="152" width="664" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;连带后果：图捕获的桶必须按 (K+1) 的倍数&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="160" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;font style=&quot;font-size:10px&quot;&gt;图捕获要求固定形状 → 桶列表必须能被 K+1 整除，否则运行时会报错；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;vLLM 会把 capture size 向上取整到 K+1 的倍数；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;运行时还有断言：padded num_tokens % (K+1) == 0。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 详见「vLLM图捕获」套 ⑥（桶与 dispatch）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="186" width="644" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="t10" value="&lt;b&gt;约束二：显存 —— draft 自己占一份，KV 还要多留&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="334" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="368" width="700" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;b&gt;两块额外开销&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="376" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t13" value="&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;draft 权重&lt;/b&gt;：MTP/EAGLE 复用 target 的 embedding 与 lm_head，增量小；独立小模型则要整份新权重。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;② &lt;b&gt;lookahead 槽&lt;/b&gt;：草案会往 target 之外写 KV，分配时必须多预留 K 个槽。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;③ 另外还有与 1+K 成正比的缓冲区（例如 topk buffer 按 (1+K) 放大）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="402" width="680" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="796" y="368" width="664" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;b&gt;本仓实测：开 MTP 后 KV 明显变少&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="376" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;font style=&quot;font-size:10px&quot;&gt;在 TP=1 + MTP 的包里，KV 块只剩几十个（32~63 个 GDN/Mamba 块），&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;于是 max_num_seqs 被压到 32；关掉 MTP 时可用的 KV 会明显回升。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 这就是「投机解码不是免费的」的现实版：它拿并发换单请求速度。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="402" width="644" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;b&gt;约束三：调度 —— 为了保住整图，必须让批「整齐」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="564" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="598" width="1424" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;b&gt;为什么调度器要把「长度为 1 的 decode 请求」也 pad 成 1+K&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="606" width="1404" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;font style=&quot;font-size:10px&quot;&gt;如果一批里有的请求是 1 个 query、有的是 1+K 个，形状就不 uniform → 整图（FULL cudagraph）用不了，只能退回分段图或 eager。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以调度器在「本步要出 token」时，会把纯 decode 请求也补齐到 1+K（缺的位置填 -1 占位），宁可多算几个空位，也要保住整图。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;代价：padding 是白算的算力；但如果丢了整图，损失更大。这就是「uniform decode」这个词的来源。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="632" width="1404" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;b&gt;把三条约束与前面的图对接&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="752" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;约束&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="786" width="320" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;b&gt;在代码/部署里的表现&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="356" y="786" width="700" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;去哪看细节&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1056" y="786" width="380" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;形状 1+K&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="822" width="320" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;图捕获的桶按 K+1 对齐；运行时整除断言&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="356" y="822" width="700" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;图捕获 ⑥&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1056" y="822" width="380" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;显存：draft + lookahead&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="858" width="320" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;可用 KV 变少 → 并发下降；需按实测调 max_num_seqs&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="356" y="858" width="700" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;入门套 ⑦ &amp; 本套 ⑥&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1056" y="858" width="380" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;调度：uniform decode&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="894" width="320" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;scheduler 把纯 decode pad 成 1+K&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="356" y="894" width="700" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:11px&quot;&gt;进程/线程 ⑫&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1056" y="894" width="380" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:11px&quot;&gt;MTP 层独立 KV&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="930" width="320" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;font style=&quot;font-size:11px&quot;&gt;PD 传输时 MTP 层的 KV 作为额外层单独编号（只传一次）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="356" y="930" width="700" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;font style=&quot;font-size:11px&quot;&gt;Mooncake ③ &amp; 本套 ⑨&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1056" y="930" width="380" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：这三条约束在昇腾上有更硬的上限（例如 TND 布局要求 K+1 ≤ 16）。下一步（⑧）专门讲昇腾侧的落地。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1002" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;1+K 的定义：vllm/config/vllm.py:679；vllm/v1/worker/gpu_model_runner.py:905&lt;br&gt;图桶按 K+1 对齐：vllm/config/compilation.py:1503-1518、:1547-1592；运行时断言 vllm/v1/cudagraph_dispatcher.py:144-145&lt;br&gt;lookahead 预留：vllm/config/vllm.py:633-658；scheduler.py:741-745&lt;br&gt;纯 decode pad 成 1+K：vllm/v1/core/sched/scheduler.py:1063-1073、:1330-1334&lt;br&gt;MTP 层 KV 单独编号（PD 传输只传一次）：vllm-ascend/.../kv_p2p/mooncake_connector.py:2391-2403&lt;br&gt;本仓 KV 变少的部署注释：assets/c_home/bash/pds/30rc_1124/dp2_tp1_194_195/cloud_p.sh:12-16&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1078" width="1424" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;投机解码不是「只在模型里加个头」——它把 decode 的形状改成 1+K、把显存切走一块给 draft 与 lookahead、还要求调度器把批次凑整齐；&lt;b&gt;这三条是它与图捕获/显存账/连续批处理三套图的接口&lt;/b&gt;。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1232" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t40" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1324" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1321" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1321" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1321" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1321" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1321" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1321" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1321" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="显存/数据面相关" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1321" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e49" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1370" as="sourcePoint"/>
            <mxPoint x="204" y="1370" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t50" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1358" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e51" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1370" as="sourcePoint"/>
            <mxPoint x="454" y="1370" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t52" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1358" width="190" height="24" as="geometry"/>
