        <mxCell id="n53" value="&lt;font style=&quot;font-size:11px&quot;&gt;Mamba 类模型 seqs &gt; 块数&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="806" width="620" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n54" value="&lt;font style=&quot;font-size:11px&quot;&gt;每序列要一个 state 块&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="806" width="804" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n55" value="&lt;font style=&quot;font-size:11px&quot;&gt;PD 两侧块大小不一致&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="838" width="620" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n56" value="&lt;font style=&quot;font-size:11px&quot;&gt;KV 无法按同一粒度对齐&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="838" width="804" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n57" value="&lt;font style=&quot;font-size:11px&quot;&gt;K &gt; MTP 层数且不整除&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
