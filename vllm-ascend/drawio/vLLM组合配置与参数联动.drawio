        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;显存水位&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="270" width="180" height="40" as="geometry"/>
