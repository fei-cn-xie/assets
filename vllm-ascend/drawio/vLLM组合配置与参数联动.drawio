  </diagram>
  <diagram id="pg5" name="⑥ PD 硬约束">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1458" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑥ 联动四：开了 PD 之后，一批参数从「建议」变成「必须」" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：PD 要求 P 与 D 在&lt;b&gt;块大小、并行度、拓扑&lt;/b&gt;上对齐，否则连不上或算错；而且 P 侧收到的请求会被引擎&lt;b&gt;强制改写&lt;/b&gt;（max_tokens=1 等）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：五条「两侧必须一致」（不一致会在启动或首个请求时报错）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;项&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;要求&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="296" y="150" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;踩中时的表现&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="916" y="150" width="540" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;font style=&quot;font-size:11px&quot;&gt;块大小（hash 粒度）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="190" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;font style=&quot;font-size:11px&quot;&gt;两侧 block_size × DCP 必须相等&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="190" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;font style=&quot;font-size:11px&quot;&gt;「PD manifest and cloud hash block sizes differ」&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="916" y="190" width="540" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;font style=&quot;font-size:11px&quot;&gt;P/D 的 TP&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="230" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:11px&quot;&gt;要么相等，要么满足「P ≥ D 且能整除」（否则切片优化静默关闭）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="230" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;kv_connector_extra_config 里的 dp_size/tp_size 要写部署级真实值&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="916" y="230" width="540" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;拓扑规模&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="270" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;edge 必须 DP=1；cloud 的 DP 必须等于拓扑里写的 DP 数&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="270" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;引擎启动时校验，不符直接 ValueError&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="916" y="270" width="540" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;LWD 并行白名单&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="310" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;不支持 PP / PCP / DCP / 弹性 EP /跨 DP 的 embedding&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="310" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;配置期就 fail-fast&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="916" y="310" width="540" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;KV 端口与 rank&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="350" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;每个 DP/TP 组合的 kv_port 不能撞&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="296" y="350" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;用 data_parallel_index 派生，不是 data_parallel_rank&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="916" y="350" width="540" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="t22" value="&lt;b&gt;第二步：PD 会&lt;b&gt;强制改写&lt;/b&gt;请求字段（用户传的会被覆盖）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="398" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:10px&quot;&gt;P 侧（prefill 实例）收到请求后，引擎会把它改成：&lt;b&gt;max_tokens=1、min_tokens=1、ignore_eos=True、抑制用户可见输出&lt;/b&gt;，并设置 KV 传输标记（远端 prefill/decode 各一套）。&lt;br&gt;D 侧相反：打开「远端 prefill」并&lt;b&gt;跳过本地前缀缓存读取&lt;/b&gt;（因为 KV 是别人给的，读本地缓存会错）。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;含义：P 实例不产出用户可见 token，它只负责把 KV 算出来交出去。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="430" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="574" width="700" height="152" as="geometry"/>
        </mxCell>
        <mxCell id="t25" value="&lt;b&gt;长度预算：PD 各段必须装得下&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="582" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t26" value="&lt;font style=&quot;font-size:10px&quot;&gt;P 需要 required = 交接点 + 1 个位置；D 需要 n + m（输入 + 输出）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;超过 max_model_len 直接报「PD stage input/output length exceeds the model budget」。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;这就是为什么 PD 包里 max_model_len 要从「最长 prompt + 生成长度」反推。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="608" width="680" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="574" width="664" height="152" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;b&gt;与 MTP 的叠加（本仓真实约束）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="582" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t29" value="&lt;font style=&quot;font-size:10px&quot;&gt;D 侧一次要算 1+K 个位置 → 尾段长度必须能对齐 1+K；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MTP 层还有自己独立的 KV（作为额外层单独编号，只传一次）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以「开 PD」和「开 MTP」各自都要求对齐，两者叠加时对齐点更多。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="608" width="644" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="t30" value="&lt;b&gt;第三步：本仓三种 PD 包的差异（同一个模型，参数差很多）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="734" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;包&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="766" width="340" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;关键参数&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="376" y="766" width="620" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;为什么这么配&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="996" y="766" width="460" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:11px&quot;&gt;sidecar / in_process&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="804" width="340" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;font style=&quot;font-size:11px&quot;&gt;TP=2，mml 65536，seqs 128&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="376" y="804" width="620" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;font style=&quot;font-size:11px&quot;&gt;TP=2 放得下模型 → 敢报长上下文&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="996" y="804" width="460" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;font style=&quot;font-size:11px&quot;&gt;dp2_tp1_194_195&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="842" width="340" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;font style=&quot;font-size:11px&quot;&gt;TP=1 + DP=2，mml 32768，seqs 32&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="376" y="842" width="620" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;font style=&quot;font-size:11px&quot;&gt;一卡一副本 → 上下文与并发都得压&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="996" y="842" width="460" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;font style=&quot;font-size:11px&quot;&gt;mooncake_pd2_tp1_195&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="880" width="340" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;font style=&quot;font-size:11px&quot;&gt;TP=1 + DP=2，&lt;b&gt;mml 512&lt;/b&gt;，seqs 32，gpu 0.98&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="376" y="880" width="620" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="&lt;font style=&quot;font-size:11px&quot;&gt;为了「一卡塞下模型 + 开 MTP」把上下文压到极小&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="996" y="880" width="460" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="&lt;font style=&quot;font-size:11px&quot;&gt;mooncake_pd_195&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="918" width="340" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="&lt;font style=&quot;font-size:11px&quot;&gt;TP=2，seqs 128，D 侧手写 25 个 capture_sizes&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="376" y="918" width="620" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="&lt;font style=&quot;font-size:11px&quot;&gt;保留了参考实现的手工桶（都是 4 的倍数，对齐 K+1）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="996" y="918" width="460" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="&lt;font style=&quot;font-size:11px&quot;&gt;fix_1120&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="956" width="340" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="&lt;font style=&quot;font-size:11px&quot;&gt;TP=8 + 专家并行 + 量化 + block 128，K=1&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="376" y="956" width="620" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="&lt;font style=&quot;font-size:11px&quot;&gt;DeepSeek 大模型必须切 8 卡；只抽 1 个 draft&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="996" y="956" width="460" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：PD 的硬约束讲完。下一步（⑦）把最容易混淆的一件事说清——「enforce-eager」其实有两个作用域。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="1030" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;块大小必须相等：vllm/v1/lwd_control/pd/cloud_runtime.py:219-221；vllm/v1/core/kv_cache_utils.py:717-741（hash_block_size = block_size × DCP）&lt;br&gt;P/D TP 关系与切片：vllm-ascend/.../kv_pool/ascend_store/metadata.py:80-113；sfa_pd_rd2h/worker.py:743-756&lt;br&gt;LWD 并行白名单与 DP 校验：vllm/distributed/lwd/lwd_parallel_groups.py:216-261；vllm/v1/engine/core.py:1336-1350&lt;br&gt;P 侧请求改写：vllm/v1/lwd_control/pd/cloud_runtime.py:358-383&lt;br&gt;长度预算：cloud_runtime.py:210-229&lt;br&gt;拓扑必填项：vllm/config/lwd/topology.py:426-458&lt;br&gt;本仓参数：各包 cloud_{p,d}.sh / decode.sh（见 ⑨ 页汇总）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1106" width="1424" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;PD 把「块大小、并行度、拓扑规模、端口」从建议变成硬约束，并强制改写 P 侧请求；&lt;b&gt;本仓三种 PD 包参数差得多，差别全在「一卡能不能放下整模型」。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1268" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t52" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
