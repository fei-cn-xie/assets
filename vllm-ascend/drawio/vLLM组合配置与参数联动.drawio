  <diagram id="pg6" name="⑦ 两个 enforce-eager">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1326" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑦ 联动五：两个 enforce-eager，一个管 target 一个管 draft" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：命令行 &lt;font style=&quot;font-size:9px&quot;&gt;--enforce-eager&lt;/font&gt; 关的是&lt;b&gt;整个 target 模型的编译与图&lt;/b&gt;；投机配置里的 &lt;font style=&quot;font-size:9px&quot;&gt;enforce_eager&lt;/font&gt; 关的是&lt;b&gt;只有 draft 那个小头&lt;/b&gt;——两者互不校验，也互不告警。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：逐项对照（看这三行就够）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;--enforce-eager&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="256" y="150" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;spec.enforce_eager&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="876" y="150" width="580" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;font style=&quot;font-size:11px&quot;&gt;写在哪&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="190" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;font style=&quot;font-size:11px&quot;&gt;--enforce-eager（命令行）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="190" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;font style=&quot;font-size:11px&quot;&gt;speculative-config 的 enforce_eager 字段&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="876" y="190" width="580" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;font style=&quot;font-size:11px&quot;&gt;影响谁&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="230" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:11px&quot;&gt;target：编译模式与图模式全置 NONE，capture sizes 清空&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="230" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;只影响 draft：drafter 不用图，走 eager&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="876" y="230" width="580" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;会不会传给对方&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="270" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;会——构造 draft 时继承 target 的 enforce_eager&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="270" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;不会回传给 target&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="876" y="270" width="580" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;同时给的后果&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="310" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;target 已全局 NONE → draft 的这个字段变成&lt;b&gt;冗余无效&lt;/b&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="310" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;无校验、无告警，静默生效&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="876" y="310" width="580" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;b&gt;第二步：四种组合的实际效果（本仓用的是第 4 种）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="358" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;b&gt;target eager + draft eager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;全 eager：启动最快、稳态最慢&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;调试用&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="390" width="340" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;target eager + draft 不 eager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;实际仍是全 eager（target 已全局 NONE）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;无意义组合&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="388" y="390" width="340" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;target 用图 + draft 用图&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;最快，但形状/后端限制多&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;保守场景可用&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="740" y="390" width="340" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;b&gt;target 用图 + draft eager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;decode 侧推荐：图赢了提交开销，draft 反正很小&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;本仓 D 侧&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1092" y="390" width="340" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;第三步：本仓的实例（一眼看懂「为什么会这么配」）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· &lt;b&gt;D 侧&lt;/b&gt;：不加 &lt;font style=&quot;font-size:9px&quot;&gt;--enforce-eager&lt;/font&gt;，并给 &lt;font style=&quot;font-size:9px&quot;&gt;FULL_DECODE_ONLY&lt;/font&gt;；同时 speculative-config 里写 &lt;font style=&quot;font-size:9px&quot;&gt;enforce_eager: true&lt;/font&gt; → &lt;b&gt;target 跑图、draft 跑 eager&lt;/b&gt;。&lt;br&gt;· &lt;b&gt;P 侧与 edge&lt;/b&gt;：直接加 &lt;font style=&quot;font-size:9px&quot;&gt;--enforce-eager&lt;/font&gt;（P 只跑一次就交接，省启动时间更划算；edge 的 forward 本来就被劫持）。&lt;br&gt;· 有一个包（mooncake_pd_195）的 decode 侧&lt;b&gt;没有&lt;/b&gt; enforce-eager，还手写了 capture_sizes。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="562" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="718" width="1424" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="t26" value="&lt;b&gt;一个容易踩的坑：以为「draft eager」就不影响 target 的图&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="726" width="1404" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t27" value="&lt;font style=&quot;font-size:10px&quot;&gt;反过来的方向才会互相牵连：target 一旦 eager，全局图模式就是 NONE，draft 想用图也用不了。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;而 draft eager 只是「draft 自己不用图」，target 的图照常工作——这正是本仓 D 侧的选择。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;另外：某些模型族（例如 GLM 系列）会被平台&lt;b&gt;强制&lt;/b&gt;把 draft 切成 eager 并打 warning，那时你的配置会被覆盖，别以为是自己的参数写错了。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="752" width="1404" height="98" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：两个 eager 分清了。下一步（⑧）看「引擎在什么情况下会主动给你降级」——降级链是这条联动脉络里唯一会打日志的部分。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="898" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;target 侧：vllm/config/model.py:242-249；生效点 vllm/config/vllm.py:1591-1597、:1823-1829（capture sizes 清零）&lt;br&gt;draft 侧字段：vllm/config/speculative.py:378-379；只有三处读它：vllm/v1/worker/gpu_model_runner.py:6214、vllm/v1/spec_decode/llm_base_proposer.py:430-439、extract_hidden_states.py:249&lt;br&gt;target → draft 的继承：vllm/config/speculative.py:1289&lt;br&gt;昇腾 xlite 回填差异：vllm-ascend/vllm_ascend/platform.py:1208-1211&lt;br&gt;GLM 强制 draft eager：vllm-ascend/.../spec_decode/llm_base_proposer.py:271-290&lt;br&gt;本仓实例：assets/c_home/bash/pds/30rc_1124/sidecar/cloud_d.sh:30-31（spec enforce_eager + FULL_DECODE_ONLY）与 cloud_p.sh:26（--enforce-eager）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="974" width="1424" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;命令行那个管整个 target，JSON 里那个只管 draft；「target 用图 + draft eager」是 D 侧的常规选择，&lt;b&gt;但 target 一旦 eager，draft 想用图也用不了。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1136" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t31" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1228" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
