  <diagram id="pg7" name="⑧ 降级链与决策">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1238" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑧ 降级链：引擎会「悄悄退一步」，但这次它会打日志" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：当 attention 后端撑不住你要的图模式时，引擎按 &lt;b&gt;FULL → FULL_AND_PIECEWISE / FULL_DECODE_ONLY → PIECEWISE → NONE&lt;/b&gt; 逐级降，并在日志里说一句；只有「连降级都救不了」才拒绝启动。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：五级降级（每级的触发条件与结果）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;触发&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="520" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;引擎怎么改&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="556" y="150" width="520" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;表现&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1076" y="150" width="380" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;font style=&quot;font-size:11px&quot;&gt;你要 FULL，后端完全不支持（NEVER）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="190" width="520" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;font style=&quot;font-size:11px&quot;&gt;直接报错，让你改 PIECEWISE&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="556" y="190" width="520" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;font style=&quot;font-size:11px&quot;&gt;拒绝启动&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="190" width="380" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;font style=&quot;font-size:11px&quot;&gt;你要 FULL，后端只支持部分形状&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="230" width="520" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:11px&quot;&gt;降成 FULL_AND_PIECEWISE 或 FULL_DECODE_ONLY&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="556" y="230" width="520" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;warning&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="230" width="380" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;decode 要 FULL，后端 NEVER&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="270" width="520" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;降成 PIECEWISE 或 NONE&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="556" y="270" width="520" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;warning&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="270" width="380" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;decode 要 FULL + K&gt;1，后端只支持更弱档&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="310" width="520" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;降成 PIECEWISE 或 NONE&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="556" y="310" width="520" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;warning（点名 spec-decode）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="310" width="380" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;PIECEWISE 也不可用&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="350" width="520" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;去掉 piecewise（→ NONE 或 FULL）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="556" y="350" width="520" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;warning once&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="350" width="380" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="t22" value="&lt;b&gt;第二步：三条「拒绝启动」（降级也救不了）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="398" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="430" width="460" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="t24" value="&lt;b&gt;① 后端 NEVER + 你非要 FULL&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="438" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t25" value="&lt;font style=&quot;font-size:10px&quot;&gt;连降级后的结果里仍带 FULL → 直接 ValueError。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;处置：换 attention 后端，或改用 PIECEWISE。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="464" width="440" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="518" y="430" width="460" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="t27" value="&lt;b&gt;② SP 的 TP 与 K+1 互不整除&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="438" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;font style=&quot;font-size:10px&quot;&gt;序列并行下桶要取 LCM(K+1, TP)，凑不出来就报错。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;处置：调 K、关 SP、或改 TP。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="464" width="440" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1000" y="430" width="460" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="t30" value="&lt;b&gt;③ Mamba 类模型 max_num_seqs &gt; 块数&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="438" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t31" value="&lt;font style=&quot;font-size:10px&quot;&gt;线性注意力需要每序列一个 state 块，块不够直接报错。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;处置：降 max_num_seqs 或提 gpu_memory_utilization。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="464" width="440" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="t32" value="&lt;b&gt;第三步：反过来——遇到症状时该先动哪个参数（决策树）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="598" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;症状 A：启动就 OOM / 报 KV 不够&lt;/b&gt; → ① 降 max_model_len 或 max_num_seqs；② 抬 gpu_memory_utilization（0.90→0.95→0.98）；③ 关掉一项大头（MTP 或图）。&lt;br&gt;&lt;b&gt;症状 B：单请求很慢（TPOT 高）&lt;/b&gt; → ① 确认 D 侧图真的在跑（看 journal 有无 replay 日志）；② 确认 MTP 接受率（&lt;1.3 就关）；③ 再看是不是桶太小。&lt;br&gt;&lt;b&gt;症状 C：吞吐上不去&lt;/b&gt; → ① 看并发是否被 seqs/KV 卡住；② 看 chunked prefill 是否在切长 prefill；③ 看是否因形状不整齐掉回 eager。&lt;br&gt;&lt;b&gt;症状 D：延迟抖动&lt;/b&gt; → ① 长 prefill 挤占 decode（调小 batched 或开分块阈值）；② 图桶不命中造成的偶发回退。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="630" width="1424" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：决策树是基于前七页的因果。下一步（⑨）用本仓三套真实部署包，把「为什么它这么配」逐条对上。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="818" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;降级实现：vllm/config/compilation.py:1382-1545（五级：:1402-1417、:1419-1426、:1429-1453、:1455-1473、:1475-1487、:1489-1501）&lt;br&gt;后端支持度枚举：vllm/v1/attention/backend.py:559-573&lt;br&gt;SP × K+1 的 LCM 与硬错：vllm/config/compilation.py:1551-1564&lt;br&gt;Mamba 块数硬错：vllm/config/compilation.py:1527-1542&lt;br&gt;昇腾侧再降级：vllm-ascend/vllm_ascend/platform.py:1231-1246、:1346-1352&lt;br&gt;软件兜底（connector/pooling/encoder-decoder 各自改成 PIECEWISE）：vllm/config/vllm.py:1796-1821、:1773-1781、:1782-1794&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="894" width="1424" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;降级链是这条联动脉络里&lt;b&gt;唯一会主动说话&lt;/b&gt;的部分——看到「falling back / not supported with … backend」就说明你的图被降了；而「静默掉出」（形状不命中桶）永远不会有日志。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1048" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t37" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1140" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1137" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1137" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1137" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1137" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1137" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1137" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1137" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e45" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1186" as="sourcePoint"/>
            <mxPoint x="204" y="1186" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t46" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
