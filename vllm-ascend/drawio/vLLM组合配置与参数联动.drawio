          </mxGeometry>
        </mxCell>
        <mxCell id="t55" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1318" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg2" name="③ K 改写桶">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1298" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="③ 联动一：开了 MTP，图捕获的「桶」必须整批重算" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：投机解码把 decode 的 query 长度从 1 变成 1+K；而图捕获的桶是一份&lt;b&gt;硬编码的尺寸列表&lt;/b&gt;——两者必须对上，对不上要么被自动取整、要么直接报错起不来。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：一条四步因果链（每一步都能在代码里指到）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;① 你设 K=3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;speculative-config 的 num_speculative_tokens&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="340" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;② decode 的 query 长度&lt;br&gt;变成 1+K = 4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;uniform_decode_query_len&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="397" y="152" width="340" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="378" y="211" as="sourcePoint"/>
            <mxPoint x="394" y="211" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;③ 图桶必须是 4 的倍数&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;capture size = n×(K+1)&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="758" y="152" width="340" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="739" y="211" as="sourcePoint"/>
            <mxPoint x="755" y="211" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;④ 运行时断言&lt;br&gt;padded % 4 == 0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;否则回不到这张图&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1119" y="152" width="340" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1100" y="211" as="sourcePoint"/>
            <mxPoint x="1116" y="211" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;第二步：同一组「最大 512」，开/不开 MTP 的桶不一样&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="276" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="310" width="700" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t13" value="&lt;b&gt;不开投机（K=0，query 长度 = 1）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="318" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;font style=&quot;font-size:10px&quot;&gt;桶可以是任意尺寸：1, 2, 4, 8, 16, 32, …, 512&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;因为 query 长度恒为 1，padded token 数就等于请求数。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以「几个请求 → 落到哪个桶」很直观。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="344" width="680" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="310" width="664" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;b&gt;开 MTP（K=3，query 长度 = 4）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="318" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;font style=&quot;font-size:10px&quot;&gt;桶必须是 4 的倍数：4, 8, 12, …, 512（实际由代码取整得到）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;因为一个请求就要占 4 个位置 → padded token 数 = 请求数 × 4。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;font color=&quot;#c0392b&quot;&gt;于是「能同时跑几个请求」= 桶大小 ÷ 4——最大的桶 512 只能装 128 个请求。&lt;/font&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="344" width="644" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;b&gt;第三步：对不上会怎样（三种结果，都不太直观）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="492" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;b&gt;情形&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="526" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;b&gt;结果&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="656" y="526" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;你能看到什么&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1076" y="526" width="380" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;你显式给了 capture_sizes 且不是 K+1 的倍数&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="566" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;引擎帮你向上取整到倍数&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="566" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;启动会看到「尺寸被改写」的日志&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="566" width="380" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;取整后超过 max_cudagraph_capture_size&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="606" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;直接报错，起不来&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="606" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;报错文案会点名「spec-decode 要求的 K+1」&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="606" width="380" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;运行时批大小没对上倍数&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="646" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;那一张图用不了 → 回落到 eager&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="656" y="646" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;没有日志&lt;/b&gt;，只表现为变慢&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1076" y="646" width="380" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;本仓的真实组合（可以直接对照）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 绝大多数包：K=3 + &lt;font style=&quot;font-size:9px&quot;&gt;FULL_DECODE_ONLY&lt;/font&gt; → 桶由引擎自动取整成 4 的倍数；&lt;br&gt;· 有一个包（mooncake_pd_195 的 decode）&lt;b&gt;手工写了 25 个 capture_sizes&lt;/b&gt;（4, 8, …, 100）——这些数正好都是 4 的倍数，说明写它的人已经按 K+1 对齐过；&lt;br&gt;· 另一个包 K=1（DeepSeek-V4 只抽 1 个 draft）→ query 长度 2 → 桶是 2 的倍数。&lt;font color=&quot;#c0392b&quot;&gt;所以「抄参数」时最容易错的就是只抄 K 不抄桶。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="722" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：K 还牵动另外两样东西——每个请求的 token 预算、以及 KV 的 lookahead 槽。下一步（④）把「显存的三条链」画出来：权重、图池、MTP 各自怎么吃掉 KV。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="878" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;K → query 长度：vllm/config/vllm.py:679；vllm/v1/worker/gpu_model_runner.py:905&lt;br&gt;桶按 K+1 对齐（自动取整 + 报错文案）：vllm/config/compilation.py:1503-1518、:1547-1592&lt;br&gt;运行时整除断言：vllm/v1/cudagraph_dispatcher.py:144-145&lt;br&gt;昇腾侧同款要求：vllm-ascend/docs/.../speculative_decoding.md:155-158、:222；vllm-ascend/vllm_ascend/compilation/compiler_interface.py:73-74&lt;br&gt;每个请求的 batched-token 预算：vllm/v1/core/sched/scheduler.py:820、:1327&lt;br&gt;本仓手工 capture_sizes：assets/c_home/bash/pds/30rc_1124/mooncake_pd_195/decode.sh:34&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="954" width="1424" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;K 不只影响「猜几个」——它把 decode 的形状改成 1+K，于是图桶、每请求 token 预算、KV lookahead 三样都要跟着改；&lt;b&gt;只改 K 不改桶，是最常见的配置错。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1108" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t35" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1200" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1197" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1197" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1197" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1197" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1197" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1197" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1197" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e43" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1246" as="sourcePoint"/>
            <mxPoint x="204" y="1246" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t44" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1234" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e45" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1246" as="sourcePoint"/>
            <mxPoint x="454" y="1246" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t46" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1234" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e47" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1246" as="sourcePoint"/>
            <mxPoint x="704" y="1246" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t48" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1234" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg3" name="④ 显存三条链">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1276" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="④ 联动二：想给 KV 多留一点，先搞清楚是谁在吃它" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：可用 KV = &lt;b&gt;上限 − 权重 − 激活峰值 − 图池 − 碎片&lt;/b&gt;；所以「权重变大」「开图捕获」「开 MTP」都会让并发变小——只是路径不同。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;可用 KV = gpu_memory_utilization × 卡总显存 − 非 KV 部分&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;其中「非 KV 部分」= 权重 + 激活峰值（profile 量出）+ 图池估算（可选计入）+ 碎片；剩下的全部被切成块 → 块数 ÷ 每请求块数 = 能开多少并发。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="1424" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="t4" value="&lt;b&gt;第一步：三条「减少 KV」的路径（本仓都能找到实例）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="246" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="280" width="460" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="t6" value="&lt;b&gt;链一：权重变大 → KV 变少&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="288" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t7" value="&lt;font style=&quot;font-size:10px&quot;&gt;TP=1 时整模型都压在一张卡上：&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;权重占比越高 → 剩余越少 → 块数越少 → 并发越低。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本仓表现：TP=1 + MTP 的包只能报 max_num_seqs=32，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;甚至把 max_model_len 压到 512 才起得来。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;（TP=2 的包就能报 65536 / 128）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="314" width="440" height="158" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="518" y="280" width="460" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;b&gt;链二：开图捕获 → KV 变少&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="288" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t10" value="&lt;font style=&quot;font-size:10px&quot;&gt;图池是一整块进程级内存（≈各桶峰值取 max），&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;估算时会被从可用显存里扣掉（可开关）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本仓表现：P 与 edge 用 --enforce-eager 正是为了省这块；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;D 侧要 decode 吞吐，所以接受这块开销。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="528" y="314" width="440" height="158" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1000" y="280" width="460" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="t12" value="&lt;b&gt;链三：开 MTP → KV 变少&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="288" width="440" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t13" value="&lt;font style=&quot;font-size:10px&quot;&gt;两块开销：&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① draft 权重与缓冲（MTP 复用 embedding/lm_head，增量小）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;② &lt;b&gt;每请求多留 K 个 lookahead 槽&lt;/b&gt;（草案要往 target 之外写 KV）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本仓注释明说：MTP 把 KV 吃到只剩几十个块。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="314" width="440" height="158" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;b&gt;第二步：两个「覆盖」关系（设了就生效，别指望叠加）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="486" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="520" width="700" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;b&gt;kv_cache_memory_bytes 会无视 gpu_memory_utilization&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="528" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;font style=&quot;font-size:10px&quot;&gt;一旦直接给 KV 分配字节数，引擎会跳过 memory profiling，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;完全按你给的数切块（日志里会明说「不遵守 gpu_memory_utilization」）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ 想精确控制就给它；想省心就用百分比。二者只信一个。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="554" width="680" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="796" y="520" width="664" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;b&gt;max_model_len 放不下 KV 直接起不来&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="528" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;font style=&quot;font-size:10px&quot;&gt;报错会告诉你「KV 需要多少、可用多少」，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;并给出二分搜索出来的「本卡最多能支持多长」。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本仓有一个包正是靠这一条把 max_model_len 压到 512 才起得来。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="554" width="644" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;第三步：三个「同时开就互相拆台」的组合&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;TP=1 + MTP + 大 max_model_len&lt;/b&gt;：权重 + MTP 开销已经吃满，KV 只剩零头 → 起不来。本仓解法是把 mml 压到 512 或干脆不开 MTP。&lt;br&gt;② &lt;b&gt;FULL_DECODE_ONLY + 小 max_num_seqs&lt;/b&gt;：图池按最大桶抓，桶又由 seqs×(1+K)×2 决定 → seqs 太小会让桶太小、图收益变小。&lt;br&gt;③ &lt;b&gt;高 gpu_memory_utilization + 图捕获&lt;/b&gt;：水位拉到 0.98 时，图池与碎片没有余量 → 捕获阶段容易 OOM（而捕获段没有回退）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="708" width="1424" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：显存的三条链讲完。下一步（⑤）转到调度参数——那里有一整条「你没设，引擎替你算」的推导链。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="856" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;可用 KV 的计算：vllm/v1/worker/gpu_worker.py:619-625；图池估算开关 :588-592&lt;br&gt;kv_cache_memory_bytes 覆盖：vllm/config/cache.py:228-235；vllm/v1/worker/gpu_worker.py:542-564&lt;br&gt;max_model_len 放不下的报错与拟合：vllm/v1/core/kv_cache_utils.py:872-909、:921-972（auto fit）&lt;br&gt;lookahead 槽：vllm/config/vllm.py:633-658；scheduler.py:744&lt;br&gt;块数随 block_size 反比：vllm/v1/core/kv_cache_utils.py:1747-1751&lt;br&gt;本仓取值：assets/c_home/bash/pds/30rc_1124/dp2_tp1_194_195/cloud_p.sh:40-41（seqs 32 / gpu 0.95）、mooncake_pd2_tp1_195/env.sh:61-64（mml 512 / gpu 0.98）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="932" width="1424" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;想让并发变大，只有三条路——减少权重占用（加 TP）、别开图池（eager）、别开 MTP；&lt;b&gt;而「提高 gpu_memory_utilization」只是把水位线抬高，代价是离 OOM 更近。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1086" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t25" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1178" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1175" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1175" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1175" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1175" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1175" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1175" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1175" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="权重/显存压力" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1175" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e34" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1224" as="sourcePoint"/>
            <mxPoint x="204" y="1224" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t35" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1212" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e36" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1224" as="sourcePoint"/>
            <mxPoint x="454" y="1224" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t37" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1212" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e38" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1224" as="sourcePoint"/>
            <mxPoint x="704" y="1224" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t39" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1212" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg4" name="⑤ 调度推导链">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1326" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑤ 联动三：max_num_batched_tokens 不是你设的，是引擎算出来的" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：如果你不设它，引擎会按&lt;b&gt;显存大小 → 用途 → 性能模式 → 是否分块 → 最大长度&lt;/b&gt;依次推导；而它又会反过来决定图桶、每步能装多少 token、甚至 max_num_seqs。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：七步推导（只看「用户没显式设」的情形）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;① 按显存选默认&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;大显存 16384 / 中等 8192 / 小 2048&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="150" width="196" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;② 按用途选默认&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;纯 LLM 与 API server 取值不同&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="240" y="150" width="196" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="233" y="202" as="sourcePoint"/>
            <mxPoint x="239" y="202" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;③ 性能模式翻倍&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;throughput 模式下默认值 ×2&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="444" y="150" width="196" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="437" y="202" as="sourcePoint"/>
            <mxPoint x="443" y="202" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;④ 关分块则抬高下限&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;不分块时一步要能装下整条序列&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="648" y="150" width="196" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="641" y="202" as="sourcePoint"/>
            <mxPoint x="647" y="202" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;⑤ 多模态再抬&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;至少能装下一个样本的 token&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="852" y="150" width="196" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="845" y="202" as="sourcePoint"/>
            <mxPoint x="851" y="202" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;⑥ 按上限截断&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;不超过 seqs × max_model_len&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1056" y="150" width="196" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="e14" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1049" y="202" as="sourcePoint"/>
            <mxPoint x="1055" y="202" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;⑦ 反推 max_num_seqs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;取默认值与 batched 的较小者&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1260" y="150" width="196" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="e16" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1253" y="202" as="sourcePoint"/>
            <mxPoint x="1259" y="202" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t17" value="&lt;b&gt;第二步：推导完还有四条硬校验（前两条直接拒绝启动）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="262" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;条件&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="294" width="560" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;b&gt;结果&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="596" y="294" width="260" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;b&gt;为什么&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="856" y="294" width="600" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;batched &lt; max_model_len 且关了分块&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="330" width="560" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;ValueError&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="596" y="330" width="260" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;不分块就必须一步装下整条序列&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="856" y="330" width="600" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;batched &lt; max_num_seqs&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="366" width="560" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;ValueError&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="596" y="366" width="260" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;一步连一个请求一个 token 都装不下&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="856" y="366" width="600" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;batched &gt; seqs × max_model_len&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="402" width="560" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;只警告&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="596" y="402" width="260" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;配置过松，不会炸&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="856" y="402" width="600" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;long_prefill_token_threshold &gt; max_model_len&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="438" width="560" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;ValueError&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="596" y="438" width="260" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:11px&quot;&gt;阈值比模型长度还大没意义&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="856" y="438" width="600" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="t33" value="&lt;b&gt;第三步：这个参数反过来决定四样东西（联动闭环）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="478" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="510" width="700" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t35" value="&lt;b&gt;① 图桶的上限&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="518" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t36" value="&lt;font style=&quot;font-size:10px&quot;&gt;capture size 的候选先生成、再被 max_num_batched_tokens 截断；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;你把这个数调小 → 桶的上限跟着变小 → 大 batch 就落回 eager。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本仓实例：一个包把 batched 设成 4096（TP=8 的 DeepSeek），桶上限自然更小。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="544" width="680" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="796" y="510" width="664" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="t38" value="&lt;b&gt;② 每步能装多少 token&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="518" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t39" value="&lt;font style=&quot;font-size:10px&quot;&gt;这就是「一步的 token 预算」——chunked prefill 切块、投机验证占 1+K，都从这里扣。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;调小 → 延迟更平滑但吞吐降；调大 → 吞吐高但长 prefill 会让 decode 卡顿。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="544" width="644" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="718" width="700" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="t41" value="&lt;b&gt;③ max_num_seqs（当它没被显式设时）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="726" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t42" value="&lt;font style=&quot;font-size:10px&quot;&gt;取「默认值」与 max_num_batched_tokens 的较小者；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以你把 batched 压小，seqs 会跟着被压小——两个一起变，容易误判是谁的原因。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="752" width="680" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="796" y="718" width="664" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="t44" value="&lt;b&gt;④ 投机解码的预算&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="726" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t45" value="&lt;font style=&quot;font-size:10px&quot;&gt;开了 MTP 后每个请求要占 1+K 个位置，还要扣 draft 的额外槽，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以「同一份 batched 预算能装几个请求」会明显变少。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="752" width="644" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：调度参数是一条完整的推导链。下一步（⑥）走到边云 PD 那边——那里有一批更硬的约束（两侧块大小必须相等、P 侧请求被强制改写）。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="906" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;七步推导：vllm/engine/arg_utils.py:2948-2957（入口）、:2730-2788（按显存/用途）、:2966-2970（throughput ×2）、:2976-2981（关分块抬高）、:2983-2998（多模态）、:3000-3006（截断）、:3014-3016（反推 seqs）&lt;br&gt;四条硬校验：vllm/config/scheduler.py:296-307、:309-314、:316-322、:324-329&lt;br&gt;桶被 batched 截断：vllm/config/vllm.py:2348-2349、:2364-2366&lt;br&gt;每步 token 预算：vllm/v1/core/sched/scheduler.py:588-591、:670-672&lt;br&gt;本仓实例：assets/c_home/bash/pds/fix_1120/prefill.sh:108（batched 4096）、其余包 8192&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="982" width="1424" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;max_num_batched_tokens 是「一步的 token 预算」，默认值由引擎按显存/用途/模式/分块依次推导，推导完还会反推 max_num_seqs、截断图桶、扣掉投机占位——&lt;b&gt;看清它，才能解释「为什么我没改却变了」。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1136" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t49" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1228" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n53" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n54" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n55" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n56" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e57" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1274" as="sourcePoint"/>
            <mxPoint x="204" y="1274" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t58" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1262" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e59" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1274" as="sourcePoint"/>
            <mxPoint x="454" y="1274" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t60" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1262" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e61" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1274" as="sourcePoint"/>
            <mxPoint x="704" y="1274" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t62" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1262" width="190" height="24" as="geometry"/>
