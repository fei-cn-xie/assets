        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;0.90 / 0.95 / 0.98&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="636" y="270" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;越高越能挤 KV，但留给图池与碎片的余量越少&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1056" y="270" width="400" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;投机&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="310" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;speculative-config&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="216" y="310" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;mtp，K=3（有一个包 K=1）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="636" y="310" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;形状变 1+K、多占 lookahead 槽&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1056" y="310" width="400" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;图&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="350" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;enforce-eager / compilation-config&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="216" y="350" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;P 与 edge: eager；D: FULL_DECODE_ONLY&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="636" y="350" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;决定有没有图池与启动时间&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1056" y="350" width="400" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;PD/KV&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="390" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;kv-transfer-config / additional-config&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="216" y="390" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;producer/consumer + kv_port&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="636" y="390" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;决定 KV 往哪送、端口怎么派生&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1056" y="390" width="400" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="t32" value="&lt;b&gt;第二步：六个「13 个 launcher 里零命中」的参数——别以为它们被调过&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="438" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;--kv-cache-memory / --swap-space / --enable-chunked-prefill / --long-prefill-token-threshold / --scheduling-policy&lt;/b&gt;：全部走默认；&lt;b&gt;--enable-expert-parallel&lt;/b&gt; 只有 f12（TP=8 的 DeepSeek 包）显式开。&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;这意味着：本仓的 chunked prefill 是默认开启的（当前版本默认 True），没有做任何阈值调整；显存分配也完全交给 gpu-memory-utilization 一个旋钮。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="470" width="1424" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="t34" value="&lt;b&gt;第三步：三个最典型的取舍（同一个参数，不同包取值差 100 倍）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="586" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;b&gt;max-model-len：65536 / 32768 / &lt;font color=&quot;#c0392b&quot;&gt;512&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TP=2 的包敢报 65536；TP=1 + DP=2 的包退到 32768；而 TP=1 还要开 MTP 的包索性压到 &lt;b&gt;512&lt;/b&gt;。&lt;br&gt;原因：单卡放完整模型后 KV 只剩零头，不压低上下文就起不来。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="618" width="460" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;b&gt;max-num-seqs：128 vs 32&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TP=2 的包可以 128；TP=1 + MTP 的包只能 32（MTP 把 KV 吃到只剩几十个块，一个序列一块）。&lt;br&gt;这是本仓注释里明说的：「64 会在启动时被拒」。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="518" y="618" width="460" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;b&gt;gpu-memory-utilization：0.90 / 0.95 / 0.98&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LWD 边云包留 0.90（要给主机面与图池留余量）；PD 包用 0.95；DP=2 单卡塞整模型的包拉到 0.98。&lt;br&gt;越高越省事，但离 OOM 越近。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1000" y="618" width="460" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;b&gt;把参数映射到 ① 的四格资源&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;显存 ← gpu-memory-utilization / max-model-len / max-num-seqs / block-size / speculative-config / compilation-config；算力 ← max-num-batched-tokens / chunked prefill；带宽 ← tp（并行度越高通信越多）/ kv-transfer；形状自由度 ← chunked prefill × 投机 K × 图模式。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="826" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交底：真正被改的只有十来个参数。下一步（③）从最硬的一条联动开始——投机解码的 K 会直接改写「图捕获的桶」。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="962" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;并行与长度参数（本仓取值）：assets/c_home/bash/pds/30rc_1124/sidecar/cloud_p.sh:22-31、**cloud_d.sh:22-31**&lt;br&gt;TP=1 + MTP 的压缩取值：assets/c_home/bash/pds/30rc_1124/dp2_tp1_194_195/cloud_p.sh:40-41、**mooncake_pd2_tp1_195/env.sh:61-64**&lt;br&gt;TP=8 / EP / 量化 / block-size：assets/c_home/bash/pds/fix_1120/prefill.sh:102-116&lt;br&gt;显式 cudagraph_capture_sizes 的包：assets/c_home/bash/pds/30rc_1124/mooncake_pd_195/decode.sh:34&lt;br&gt;零命中的默认参数：vllm/config/scheduler.py:116（enable_chunked_prefill 默认 True）、vllm/config/cache.py:71（block_size 默认 16，本仓 f12 显式 128）&lt;br&gt;全部 launcher 都开 async scheduling：各脚本的 --async-scheduling&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1038" width="1424" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;本仓只改十来个参数，核心是「并行 × 长度/批量 × 显存水位 × 是否 MTP × 是否图」；&lt;b&gt;同一参数在不同包差 100 倍，差别全来自「一卡放得下多少」这个物理约束。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1192" width="1424" height="58" as="geometry"/>
        </mxCell>
