        <mxCell id="n36" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="442.9" y="348" width="99.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="544.6" y="348" width="99.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="646.3" y="348" width="99.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="748" y="348" width="99.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="849.7" y="348" width="99.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="951.4" y="348" width="99.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1053.1" y="348" width="99.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1154.9" y="348" width="99.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1256.6" y="348" width="99.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1358.3" y="348" width="99.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="t46" value="&lt;b&gt;第二步：四个维度对比（记住这张表，后面全靠它）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="372" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="406" width="700" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t48" value="&lt;b&gt;prefill：宽矩阵，算力是瓶颈&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="414" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t49" value="&lt;font style=&quot;font-size:10px&quot;&gt;· 一次处理的 token 数 = prompt 长度（几十到几万）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 每算一个 token，都要做 O(n) 次乘加（n = 长度）→ 总计算量 O(n²)；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 计算量 / 访存量 比例高 → &lt;b&gt;compute-bound&lt;/b&gt;（算力吃满）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 只发生一次，所以「把 prompt 算完」的延迟叫 TTFT。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="440" width="680" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="406" width="664" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t51" value="&lt;b&gt;decode：窄矩阵，显存带宽是瓶颈&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="414" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t52" value="&lt;font style=&quot;font-size:10px&quot;&gt;· 一次只算 1 个 token（spec decode 时 1+N）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 但每步都要把&lt;b&gt;全部权重&lt;/b&gt;从显存读一遍，还要读历史 KV；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 计算量 / 访存量 比例极低 → &lt;b&gt;memory-bound&lt;/b&gt;（带宽吃满、算力闲着）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 每生成一个 token 都要一轮，所以它的速度叫 TPOT。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="440" width="644" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n53" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="622" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t54" value="&lt;b&gt;为什么这两个名字值得单独记：它们的所有优化手段都不一样&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="630" width="1404" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t55" value="&lt;font style=&quot;font-size:10px&quot;&gt;· prefill 想的是「怎么把宽矩阵喂满」→ 分块（chunked prefill）、大 batch 的 prefill、甚至和 decode 拼一批；&lt;br&gt;· decode 想的是「怎么少读一点、少等一点」→ KV 复用（前缀缓存）、量化、把多个请求捆一起（batching）、把下发次数压掉（图捕获）、甚至把 KV 搬到别的机器（PD 分离）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="656" width="1404" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n56" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：「算力 vs 带宽」这句话需要一点更硬的解释，否则容易变成口号。下一步（⑤）用「算术强度」把它讲成可以自己算的数。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="778" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n57" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;「每步给每个请求补 1 个 token」：vllm/config/vllm.py:661-679（decode 提交 1 个 query，spec 时 1+N）&lt;br&gt;uniform decode 判定：vllm/v1/worker/gpu_model_runner.py:3888-3907&lt;br&gt;分块 prefill 的开关：vllm/config/scheduler.py:116（enable_chunked_prefill 默认 True）、:70（long_prefill_token_threshold）、:49（max_num_batched_tokens）&lt;br&gt;两个阶段共用一个调度入口：vllm/v1/core/sched/scheduler.py:568&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="854" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n58" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;prefill 是「一次算一大段」的算力密集型，decode 是「每步算 1 个但要把全部权重读一遍」的带宽密集型；两个阶段的问题不同，所以要分开优化，甚至分到不同机器上（PD 分离）。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="990" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t59" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1082" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n60" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1079" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n61" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1079" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n62" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1079" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n63" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1079" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n64" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1079" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n65" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1079" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n66" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1079" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n67" value="本步新算的 token" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1079" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e68" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1128" as="sourcePoint"/>
            <mxPoint x="204" y="1128" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t69" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1116" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e70" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1128" as="sourcePoint"/>
            <mxPoint x="454" y="1128" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t71" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1116" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e72" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1128" as="sourcePoint"/>
            <mxPoint x="704" y="1128" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t73" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
