          <mxGeometry x="146" y="380" width="420" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;① 为什么 KV 要跨机  ② D 拉还是 P 推  ③ 什么时候算「成功」&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="566" y="380" width="620" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;Mooncake 全套&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1186" y="380" width="260" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;font style=&quot;font-size:11px&quot;&gt;第 6 站&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="426" width="110" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;font style=&quot;font-size:11px&quot;&gt;图捕获（10 页）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="146" y="426" width="420" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;font style=&quot;font-size:11px&quot;&gt;① 图省的是什么  ② 三个硬约束  ③ 为什么并发一高就变慢&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="566" y="426" width="620" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;font style=&quot;font-size:11px&quot;&gt;图捕获 全套&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1186" y="426" width="260" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="t32" value="&lt;b&gt;第二步：为什么这个顺序不能换（每条都是「前置 → 依赖」）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="474" width="1400" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:10px&quot;&gt;· 不会算 attention 的矩阵 → 看不懂「KV cache 存的是什么」；&lt;br&gt;· 不懂「decode 是带宽瓶颈」→ 会觉得 batching / 量化 / 图捕获都是「玄学优化」；&lt;br&gt;· 不懂「每步重组批」→ 读调度器代码只看到两个 while 循环，看不到设计意图；&lt;br&gt;· 不懂「KV 按块借还」→ 会觉得 Mooncake 的块级 pull 是随便选的颗粒度；&lt;br&gt;· 不懂「形状必须固定」→ 会觉得图捕获的桶、padding、静默掉出都是 bug。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="506" width="1424" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="t34" value="&lt;b&gt;第三步：时间不够时的三条快车道&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="626" width="1400" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;b&gt;只想搞懂「为什么」&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Transformer ①⑦⑧⑨⑩⑬ →&lt;br&gt;本套 ④⑤⑥⑦ → 结束。&lt;br&gt;&lt;br&gt;（约 10 页，能讲清推理系统的全部设计动机）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="658" width="466" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;b&gt;要改代码 / 排障&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本套 ⑨ → 进程/线程 ①②④⑤⑦⑩⑪⑫ →&lt;br&gt;生命周期 ②⑤⑦ → Mooncake ⑦⑧ → 图捕获 ⑨⑩&lt;br&gt;&lt;br&gt;（按「现象 → 组件 → 代码路径」走）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="526" y="658" width="466" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;b&gt;要调性能&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;本套 ⑤⑥⑦⑧ → 图捕获 ①⑥⑦⑩ →&lt;br&gt;生命周期 ⑤（KV 账）→ 进程/线程 ⑬&lt;br&gt;&lt;br&gt;（先算清瓶颈是带宽还是算力）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1016" y="658" width="444" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="t38" value="&lt;b&gt;第四步：如果这 8 个问题你能答上来，说明这套材料真的读通了&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="816" width="1400" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;font style=&quot;font-size:10px&quot;&gt;① 为什么 decode 阶段每步都要把全部权重读一遍，而 prefill 不用？&lt;br&gt;② 把 8 个请求的 decode 合批，运算量和访存量分别变成几倍？为什么这能提速？&lt;br&gt;③ 为什么 KV cache 要按块管理，而不是给每个请求预留一整段？&lt;br&gt;④ 一次推理的显存里，哪一项会随「上下文变长」变大，哪一项不会？&lt;br&gt;⑤ 调度器为什么「先排 running 再收 waiting」，反过来会怎样？&lt;br&gt;⑥ PD 分离里为什么是 D 去拉 KV，而不是 P 推过来？&lt;br&gt;⑦ 图捕获为什么必须「固定形状 + 固定地址」，破一条会有什么现象？&lt;br&gt;⑧ 并发一高就变慢、但没有报错，最可能是什么（图捕获 / 显存 / 调度）？&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="848" width="1424" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;b&gt;读法建议&lt;/b&gt;：&lt;font style=&quot;font-size:10px&quot;&gt;每套图都配了「读图指南」（同目录的 `*-读图指南.md`），先读指南的表格（1 分钟），再挑 2~3 页看，最后用上面的自测题检查；不要从第一页顺序读到最后一页。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="1014" width="1424" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;顺序是「模型怎么算 → 系统为什么这么设计 → 代码细节」，六套图各管一层；每站读完先答自测题，答不上就回退一站——&lt;b&gt;跳站是唯一会让人「看得懂每行、说不清为什么」的原因。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1124" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t42" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1216" width="104" height="20" as="geometry"/>
        </mxCell>
