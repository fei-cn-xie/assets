        <mxCell id="t31" value="&lt;b&gt;第二步：把它们拼成一张图（这就是 vLLM 的骨架）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
