          <mxGeometry x="276" y="1093" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1093" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1093" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1093" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1093" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1093" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e48" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1142" as="sourcePoint"/>
            <mxPoint x="204" y="1142" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t49" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1130" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e50" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1142" as="sourcePoint"/>
            <mxPoint x="454" y="1142" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t51" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1130" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e52" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1142" as="sourcePoint"/>
            <mxPoint x="704" y="1142" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t53" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1130" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg6" name="⑦ 显存账">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1278" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="⑦ 显存去哪了：五个抽屉 + 一个上限旋钮" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：推理的显存 = &lt;b&gt;权重 + KV cache + 激活峰值 + 图池 + 碎片&lt;/b&gt;；其中只有 KV 会随「并发 × 上下文」长大，所以它是主要变量。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：把这五个抽屉摆出来（每个都有「谁决定它多大」）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;权重&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;模型结构与精度决定；加载后只读&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;固定，加载时一次占定&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="274" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;KV cache&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;并发数 × 上下文长度 × 每 token 大小&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;唯一会持续变化的&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="152" width="274" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;激活峰值&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;一步里最大那批的中间张量&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;由 profile 量出来，短暂占用&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="604" y="152" width="274" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;图池&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;抓了多少桶、桶多大（进程级共用）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;进程级一块，≈各桶峰值取 max&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="888" y="152" width="274" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;碎片&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;分配器行为、块大小、反复增删&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;可优化但消不掉&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1172" y="152" width="274" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="t9" value="&lt;b&gt;第二步：一个旋钮决定「总量」，剩下的是分配问题&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="286" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;gpu_memory_utilization&lt;/b&gt;（本仓部署常用 0.90~0.98）：告诉引擎「我最多用这张卡多少比例」。&lt;br&gt;引擎按这个上限做三件事：&lt;b&gt;① 装权重&lt;/b&gt; → &lt;b&gt;② 跑 profile 量激活峰值&lt;/b&gt; → &lt;b&gt;③ 把剩下的全切成 KV 块&lt;/b&gt;。&lt;br&gt;所以日志里那句 &lt;font style=&quot;font-size:9px&quot;&gt;Available KV cache memory: X GiB&lt;/font&gt; 就是「扣完前三项之后还能给 KV 多少」，它直接决定&lt;b&gt;能同时服务多少请求&lt;/b&gt;。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="320" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="t11" value="&lt;b&gt;第三步：KV cache 的账怎么算（会算这个就能预估并发）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="430" width="1300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;要算的量&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="464" width="300" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;公式&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="336" y="464" width="620" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;举例（按上面假设）&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="956" y="464" width="480" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;每 token 的 KV 大小&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="502" width="300" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;层数 × 2（K 和 V）× KV 头数 × 每头维度 × 每元素字节&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="502" width="620" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;32 层、8 KV 头、128 维、bf16 → 约 128 KB/token&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="956" y="502" width="480" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;一条请求的 KV&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="540" width="300" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;每 token 大小 × 上下文长度&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="540" width="620" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;4K → 约 512 MB&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="956" y="540" width="480" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;总需求&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="578" width="300" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;并发请求数 × 每请求 KV&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="578" width="620" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;16 条 4K 请求 → 约 8 GB&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="956" y="578" width="480" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;能开多少并发&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="616" width="300" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;可用 KV 显存 ÷ 每请求 KV&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="336" y="616" width="620" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;可用 8 GB 时 ≈ 16 条 4K 请求&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="956" y="616" width="480" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="688" width="700" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;b&gt;为什么 KV 要「分块管理」而不是整段预留&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="696" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t29" value="&lt;font style=&quot;font-size:10px&quot;&gt;整段预留：长度未知 → 只能按最大长度占，浪费巨大；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;分块：按需分配、前缀可共享、结束后立刻还回池子。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;这就是 block_size（默认 16 token 一块）与块表存在的原因。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="722" width="680" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="796" y="688" width="664" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="t31" value="&lt;b&gt;为什么 KV 还要「跨机搬」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="696" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t32" value="&lt;font style=&quot;font-size:10px&quot;&gt;当「一台机器的显存」已经装不下「想要的并发 × 上下文」时，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;剩下的选择只有两个：降并发（掉吞吐）或把 KV 放到别的机器上（PD 分离 / KV 池）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;这就是 Mooncake 那套图存在的前提。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="722" width="644" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：显存这本账解释了「为什么要有 KV 管理和 PD 分离」。还有另一条路——把一张卡变成多张卡。下一步（⑧）讲并行的四种切法。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="876" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;上限旋钮：vllm/config/cache.py:103（gpu_memory_utilization 默认 0.92）、:71（block_size 默认 16）&lt;br&gt;三步定容量：vllm/v1/worker/gpu_worker.py:528-642（determine_available_memory）、vllm/v1/engine/core.py:354（按剩余显存切块池）&lt;br&gt;块池与块表：vllm/v1/core/block_pool.py:143、vllm/v1/core/kv_cache_manager.py:402&lt;br&gt;图池占用也会被扣掉：vllm/v1/worker/gpu_worker.py:613-624、:850-854&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="952" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;显存 = 权重 + KV + 激活峰值 + 图池 + 碎片；上限由 gpu_memory_utilization 定，KV 拿走剩下的全部；所以「权重/图池变大 → KV 变少 → 并发变低」，三者是一条链。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1088" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t36" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1180" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1177" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1177" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1177" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1177" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1177" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1177" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1177" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="会持续变化的那个抽屉" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1044" y="1177" width="240" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e45" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1226" as="sourcePoint"/>
            <mxPoint x="204" y="1226" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t46" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1214" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e47" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1226" as="sourcePoint"/>
            <mxPoint x="454" y="1226" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t48" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1214" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e49" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1226" as="sourcePoint"/>
