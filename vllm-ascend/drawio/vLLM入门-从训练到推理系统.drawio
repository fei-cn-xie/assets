        <mxCell id="n30" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1350.5" y="264" width="107.5" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="t31" value="&lt;b&gt;decode 第 2 步：第 14 个位置是新的（同样只算 1 个）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="324" width="1424" height="20" as="geometry"/>
