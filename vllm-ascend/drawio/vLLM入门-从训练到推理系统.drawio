<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" pages="10">
  <diagram id="pg0" name="① 训练在做什么">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1136" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="① 训练在做什么：权重是怎么「学」出来的" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：训练 = &lt;b&gt;前向算一个预测 → 用损失函数给它的错打分 → 反向传播算出「每个参数往哪边调」→ 优化器真的调一下&lt;/b&gt;，重复几百万次。推理只是把这条链的第一段单独拿出来用。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：训练的四步循环（每步都对应代码里真实存在的东西）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;① 前向 forward&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;输入一批文本 → 逐层算 → 输出每个位置的 logits&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;前向与推理时完全一样&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="340" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;② 损失 loss&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;拿 logits 和「正确下一个词」比 → 一个标量（越小越准）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;交叉熵&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="397" y="152" width="340" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="378" y="211" as="sourcePoint"/>
            <mxPoint x="394" y="211" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;③ 反向 backward&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;从 loss 往回求梯度：&lt;b&gt;每个参数该往哪边调、调多少&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;只有训练才有&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="758" y="152" width="340" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="739" y="211" as="sourcePoint"/>
            <mxPoint x="755" y="211" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;④ 更新 optimizer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;按梯度把参数推开一小步（学习率决定步子大小）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;AdamW 等&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1119" y="152" width="340" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1100" y="211" as="sourcePoint"/>
            <mxPoint x="1116" y="211" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" value="重复上百万次" style="endArrow=block;html=1;rounded=0;dashed=1;fontSize=10;strokeColor=#9673a6;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1289" y="270" as="sourcePoint"/>
            <mxPoint x="206" y="290" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t12" value="&lt;b&gt;第二步：为什么「训练完」的权重，在推理时是只读的常量&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="304" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="338" width="700" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t14" value="&lt;b&gt;训练时：权重是「变量」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="346" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;font style=&quot;font-size:10px&quot;&gt;· 每个参数都有两份内存开销：值 + 梯度（还有优化器的动量等状态）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 前向要保留中间激活，供反向链式求导用（显存大户）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· batch 越大越好：梯度更稳、算力利用率更高；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 精度常常混合：fp16/bf16 算、fp32 存主权重。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="372" width="680" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="796" y="338" width="664" height="176" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;b&gt;推理时：权重是「常量」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="346" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;font style=&quot;font-size:10px&quot;&gt;· 只要值，不要梯度、不要优化器状态、不保留反向用的激活；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 权重加载进显存后&lt;b&gt;只读&lt;/b&gt;（唯一的例外是图捕获时的格式重排）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· batch 不再是「越大越好」：它换的是吞吐，牺牲的是单请求延迟；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;· 显存主要被「权重 + KV cache」占掉，而不是激活。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="372" width="644" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="554" width="700" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="t20" value="&lt;b&gt;一句话把两者接起来&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="562" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;font style=&quot;font-size:10px&quot;&gt;训练产出的是&lt;b&gt;一份权重文件&lt;/b&gt;（如 safetensors）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;推理系统的第一件事就是&lt;b&gt;把这份文件读进显存&lt;/b&gt;；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;之后所有权重的计算都是「同一份常量张量」参与矩阵乘。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="588" width="680" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="796" y="554" width="664" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="t23" value="&lt;b&gt;所以 vLLM 里没有的东西（别去找）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="562" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t24" value="&lt;font style=&quot;font-size:10px&quot;&gt;没有 backward、没有 optimizer、没有 loss（它不做训练）；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;没有梯度的显存开销 → 同样一张卡，推理能放下比训练大得多的并发；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;但它多了训练时不存在的东西：&lt;b&gt;KV cache&lt;/b&gt;（见 ⑦）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="588" width="644" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：训练那四步里，&lt;b&gt;只有第 ① 步（前向）会出现在推理里&lt;/b&gt;；下一步（②）看这份权重从文件变成显存里的常量的完整路径。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="742" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vLLM 的自我定位是推理服务：vllm/README.md:1（Easy, fast, and cheap LLM serving）&lt;br&gt;推理侧「加载完就只读」的证据：加载写入 layer.weight 后由 forward 直接读 —— 参见 tools/proc/t16.py 与 vllm/model_executor/layers/utils.py:84-90&lt;br&gt;权重与激活/梯度的取舍在推理侧只剩权重：vllm_ascend/worker/worker.py:601-634（profile 时只算权重 + 激活峰值，不含梯度/优化器）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="818" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;训练 = 前向 + 损失 + 反向 + 更新，循环到收敛，产出权重文件；推理 = 只用前向，且权重是只读常量。&lt;b&gt;这条差别决定了后面所有推理优化的方向。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="946" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1038" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1035" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1035" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1035" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1035" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1035" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1035" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1035" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e36" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1084" as="sourcePoint"/>
            <mxPoint x="204" y="1084" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t37" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1072" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e38" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1084" as="sourcePoint"/>
            <mxPoint x="454" y="1084" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t39" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1072" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e40" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1084" as="sourcePoint"/>
            <mxPoint x="704" y="1084" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t41" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1072" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg1" name="② 训练 vs 推理">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1326" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="② 训练 vs 推理：五个差别，每一个都解释了一条推理优化" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：训练关心「算得准不准」，推理关心「答得快不快、便宜不便宜」。五个差别各自都会逼出 vLLM 里的一个设计。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：一张对照表（左列是训练的习惯，右列是推理的现实）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;维度&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;训练时&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="256" y="152" width="460" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;推理时&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="716" y="152" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;逼出的 vLLM 设计&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1136" y="152" width="320" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;font style=&quot;font-size:11px&quot;&gt;要不要梯度&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="192" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;font style=&quot;font-size:11px&quot;&gt;要（存激活 + 反向传播）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="192" width="460" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;font style=&quot;font-size:11px&quot;&gt;不要（算完就丢）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="716" y="192" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;font style=&quot;font-size:11px&quot;&gt;推理显存只剩权重 + KV&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1136" y="192" width="320" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:11px&quot;&gt;权重角色&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="232" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;font style=&quot;font-size:11px&quot;&gt;变量，每步都在变&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="232" width="460" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;font style=&quot;font-size:11px&quot;&gt;常量，加载后只读&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="716" y="232" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;font style=&quot;font-size:11px&quot;&gt;可以放心地做「格式重排」「图捕获」&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1136" y="232" width="320" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;font style=&quot;font-size:11px&quot;&gt;batch 的意义&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="272" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;font style=&quot;font-size:11px&quot;&gt;越大越好：梯度更稳、算力更满&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="272" width="460" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;font style=&quot;font-size:11px&quot;&gt;是吞吐与延迟的权衡&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="716" y="272" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;font style=&quot;font-size:11px&quot;&gt;连续批处理 / 调度器（⑨ ⑯ 页）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1136" y="272" width="320" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;font style=&quot;font-size:11px&quot;&gt;精度&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="312" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;font style=&quot;font-size:11px&quot;&gt;混合精度 + fp32 主权重&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="312" width="460" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:11px&quot;&gt;常常整份 bf16/fp16（甚至量化）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="716" y="312" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:11px&quot;&gt;量化、GGUF（Transformer ⑳）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1136" y="312" width="320" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;font style=&quot;font-size:11px&quot;&gt;显存构成&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="352" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;font style=&quot;font-size:11px&quot;&gt;权重 + 梯度 + 优化器 + 激活&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="256" y="352" width="460" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;font style=&quot;font-size:11px&quot;&gt;权重 + KV cache + 激活峰值 + 图池&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="716" y="352" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;font style=&quot;font-size:11px&quot;&gt;显存账（⑦）与 KV 管理（生命周期 ⑤）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1136" y="352" width="320" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="t28" value="&lt;b&gt;第二步：五条后果，逐条说清「所以在推理里能做什么」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="398" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="432" width="700" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t30" value="&lt;b&gt;① 没有反向 → 显存全给「并存」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="440" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t31" value="&lt;font style=&quot;font-size:10px&quot;&gt;训练时 batch 大到放不下就 OOM；推理时省下的那份显存直接变成「能同时服务多少请求」。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以推理系统的核心指标之一是&lt;b&gt;并发&lt;/b&gt;，而不是 batch 大小。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="466" width="680" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="796" y="432" width="664" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t33" value="&lt;b&gt;② 权重只读 → 可以做「静态优化」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="440" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t34" value="&lt;font style=&quot;font-size:10px&quot;&gt;既然是常量，就能提前把布局换好（如昇腾的 ND→NZ）、把前向录成图（图捕获那套）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;训练时权重每步都变，这些优化全都不成立。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="466" width="644" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="604" width="700" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t36" value="&lt;b&gt;③ batch 变成权衡 → 需要调度器&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="612" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t37" value="&lt;font style=&quot;font-size:10px&quot;&gt;把多个请求「拼成一批」能提高吞吐，但会让某些请求等更久。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;于是必须有人决定「这一步算谁、算几个 token」——这就是 Scheduler。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="638" width="680" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="796" y="604" width="664" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="t39" value="&lt;b&gt;④ 精度可以降 → 省钱但可能掉点&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="612" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t40" value="&lt;font style=&quot;font-size:10px&quot;&gt;bf16/fp16 是常态；fp8/int8 量化能把权重和 KV 都压小，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;代价是精度损失与额外的反量化开销——要不要用是个工程权衡。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="638" width="644" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="36" y="776" width="1424" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="t42" value="&lt;b&gt;⑤ 显存构成变了 → KV cache 成为主角&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="784" width="1404" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t43" value="&lt;font style=&quot;font-size:10px&quot;&gt;训练时激活是显存大户；推理时激活只需「一步的峰值」，而 &lt;b&gt;KV cache 会随「并发数 × 上下文长度」线性增长&lt;/b&gt;，成为主要变量。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以推理系统的显存管理几乎都在管 KV：分块、复用前缀、跨机搬运、超时释放（分别对应生命周期 ⑤、Mooncake、PD 分离）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="810" width="1404" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：这张表解释了「为什么要有一套推理系统」。下一步（③）先把权重从文件搬进显存——这是 vLLM 启动时做的第一件大事。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="932" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;KV 块默认 16 token 一块：vllm/config/cache.py:71（DEFAULT_BLOCK_SIZE）&lt;br&gt;显存利用率上限（推理专用旋钮）：vllm/config/cache.py:103（gpu_memory_utilization 默认 0.92）&lt;br&gt;「只有权重+激活峰值，没有梯度」的代码证据：vllm/v1/worker/gpu_worker.py:528-642（determine_available_memory 只扣权重与激活）&lt;br&gt;调度器存在的原因：vllm/v1/core/sched/scheduler.py:568（每步挑一批）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1008" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;训练的取舍围着「准」转，推理的取舍围着「快和便宜」转；五个差别（梯度 / 权重角色 / batch 意义 / 精度 / 显存构成）分别逼出了调度、KV 管理、量化、图捕获这些机制。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1136" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t47" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1228" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n51" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n53" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n54" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="1225" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e55" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1274" as="sourcePoint"/>
            <mxPoint x="204" y="1274" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t56" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1262" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e57" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1274" as="sourcePoint"/>
            <mxPoint x="454" y="1274" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t58" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1262" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e59" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1274" as="sourcePoint"/>
            <mxPoint x="704" y="1274" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t60" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="1262" width="190" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg2" name="③ 权重到显存">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1068" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="③ 权重从文件到显存：三个坑与前置页的接口" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：&lt;b&gt;磁盘上的 safetensors → 读成 CPU 张量 → 按 TP 切片 → 拷进 NPU 上已分配的参数&lt;/b&gt;。细节在另外两套图里；本页只标出「在哪一步最容易错」，并说明为什么要先看那两套。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：五步（每步都指向已有图页，不在这里重复展开）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="118" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;① 看目录与 config.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;知道模型有几个参数、多深、多宽&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;详见：Transformer ⑮&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="274" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;② 读分片与 index.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;只读该读的文件；名字→文件靠索引&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;详见：Transformer ⑰&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="324" y="152" width="274" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="312" y="210" as="sourcePoint"/>
            <mxPoint x="322" y="210" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;③ 名字映射 + 选 weight_loader&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;q_proj/k_proj/v_proj 合成 qkv_proj&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;详见：Transformer ⑱&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="612" y="152" width="274" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="210" as="sourcePoint"/>
            <mxPoint x="610" y="210" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;④ 按 TP 切片 + copy_ 进 NPU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;narrow 出本 rank 那段，写入参数&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;详见：进程/线程 ⑮&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="900" y="152" width="274" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="888" y="210" as="sourcePoint"/>
            <mxPoint x="898" y="210" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;⑤ 格式后处理 + profile + 切 KV&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;NZ 重排；然后才轮到 KV 块池&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666666&quot;&gt;详见：进程/线程 ⑮⑯&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="1188" y="152" width="274" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1176" y="210" as="sourcePoint"/>
            <mxPoint x="1186" y="210" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t13" value="&lt;b&gt;第二步：三个坑（都能用一句话解释为什么）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="274" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="36" y="308" width="700" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="t15" value="&lt;b&gt;坑一：把「分片」当成「张量并行」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="316" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t16" value="&lt;font style=&quot;font-size:10px&quot;&gt;分片（shard）＝训练/发布时把权重切成几个文件；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;张量并行（TP）＝运行时把一层矩阵横着/竖着切到几张卡上。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;两者毫无关系：TP=4 也可以只有一个权重文件（读进来再切）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="342" width="680" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="796" y="308" width="664" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="t18" value="&lt;b&gt;坑二：忘了「[out, in] 的转置」&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="316" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t19" value="&lt;font style=&quot;font-size:10px&quot;&gt;权重文件里的 Linear 通常是 [out_features, in_features]，&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;而很多公式写成 y = xW 时 W 是 [in, out]。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;报错形态就是形状不匹配（Attempted to load weight (…) into parameter (…)）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="342" width="644" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="498" width="1424" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="t21" value="&lt;b&gt;坑三：先权重、后 KV —— 顺序不能反&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="46" y="506" width="1404" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t22" value="&lt;font style=&quot;font-size:10px&quot;&gt;加载权重 → 跑一次 profile 量出激活峰值 → &lt;b&gt;剩余显存才切成 KV 块&lt;/b&gt;。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;如果反过来（先切 KV）会导致 KV 预算算错、甚至启动 OOM；这也是为什么日志里 Available KV cache memory 出现在加载权重之后。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;副作用（很重要）：&lt;b&gt;权重变大 = KV 块变少 = 能同时服务的请求变少&lt;/b&gt;。这就是 ⑦ 那张显存账的起点。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="532" width="1404" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：权重就位后，模型就能「算」了。但推理不是「算一次」，而是&lt;b&gt;先算一大段、再一个字一个字算&lt;/b&gt;——下一步（④）讲这两个阶段。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="666" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;读盘与切片的实现：vllm/model_executor/model_loader/weight_utils.py:1002（safe_open）、:1253-1271（default_weight_loader）&lt;br&gt;TP 切片落地：vllm/model_executor/layers/linear.py:572-589（列并行）、:1730-1746（行并行）&lt;br&gt;先权重后 KV 的顺序：vllm/v1/worker/gpu_worker.py:528-642（profile→KV 预算）、vllm/v1/engine/core.py:354（切块池）&lt;br&gt;默认块大小与显存上限：vllm/config/cache.py:71（block_size=16）、:103（gpu_memory_utilization=0.92）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="742" width="1424" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;加载只有五步，坑只有三个——分片≠TP、转置、以及「先权重再 profile 再 KV」这个不可换的顺序；顺序决定了后面所有显存档。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="878" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t26" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="970" width="104" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="客户端" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="148" y="967" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="边端 edge" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="276" y="967" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="云 P (prefill)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="404" y="967" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="云 D (decode)" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="532" y="967" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="PD Proxy" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="660" y="967" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="中立/通用" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="788" y="967" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="失败/取消" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="916" y="967" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e34" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#9673a6;fillColor=#9673a6;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="148" y="1016" as="sourcePoint"/>
            <mxPoint x="204" y="1016" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t35" value="控制面 ZMQ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="1004" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e36" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#d6b656;fillColor=#d6b656;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="398" y="1016" as="sourcePoint"/>
            <mxPoint x="454" y="1016" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t37" value="数据面 UCX·Mooncake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1004" width="190" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e38" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;strokeColor=#666666;fillColor=#666666;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="648" y="1016" as="sourcePoint"/>
            <mxPoint x="704" y="1016" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t39" value="HTTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
