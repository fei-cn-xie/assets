          <mxGeometry x="46" y="688" width="680" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t54" value="&lt;font style=&quot;font-size:10px&quot;&gt;① &lt;b&gt;一层都放不下？&lt;/b&gt; → 只能 TP（切层内的矩阵）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;② &lt;b&gt;放得下但想要更高吞吐？&lt;/b&gt; → DP（复制几份，各跑各的请求）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;③ &lt;b&gt;层太多、单机放不下整模型？&lt;/b&gt; → PP（或者 TP+PP 组合）。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MoE 模型额外问一句：专家总数是否超过单卡显存 → EP。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="46" y="714" width="680" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="n55" value="" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="796" y="680" width="664" height="152" as="geometry"/>
        </mxCell>
        <mxCell id="t56" value="&lt;b&gt;为什么本仓 PD 场景是「TP 或 DP」而不是 PP&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="806" y="688" width="644" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t57" value="&lt;font style=&quot;font-size:10px&quot;&gt;PD 分离把 prefill 与 decode 拆到不同实例，每个实例只需要「跑得动一层 + 有足够 KV」；&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;而 decode 阶段最怕的是&lt;b&gt;每层都要通信&lt;/b&gt;（TP 的 all_reduce 在带宽瓶颈下更贵），&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;所以本仓 decode 侧更偏好 DP（多份独立引擎、互不通信）。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="806" y="714" width="644" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="n58" value="&lt;font style=&quot;font-size:10px&quot;&gt;本页交接：到这里，推理系统的四大需求（算力、并发、显存、多卡）都讲齐了。下一步（⑨）把它们一次性映射到 vLLM 的组件上。&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="36" y="872" width="1424" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n59" value="&lt;b&gt;代码锚点（想自己去翻的时候用）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;并行字段定义：vllm/config/parallel.py:122（pipeline）、:124（tensor）、:129（data）、:167（enable_expert_parallel）&lt;br&gt;world_size 与后端选择：vllm/config/parallel.py:887-895、:982-1027&lt;br&gt;TP 的通信位置（行并行末尾 all_reduce）：vllm/model_executor/layers/linear.py:1775-1776&lt;br&gt;进程数与并行的关系：见「vLLM进程与线程」套页 ②③&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="948" width="1424" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n60" value="&lt;b&gt;一句话记住这一页：&lt;/b&gt;TP 切矩阵（每层通信）、PP 切层（段间通信、有气泡）、DP 复制（几乎不通信但吃显存）、EP 切专家（all-to-all）；&lt;b&gt;切哪种取决于「你缺的是显存、算力还是通信预算」。&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="1076" width="1424" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="t61" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="1168" width="104" height="20" as="geometry"/>
        </mxCell>
