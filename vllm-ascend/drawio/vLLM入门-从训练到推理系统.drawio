        <mxCell id="n32" value="&lt;b&gt;前端（API server）&lt;/b&gt;：收 HTTP / 流式返回 / 分词反分词" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=5;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="416" y="552" width="660" height="56" as="geometry"/>
