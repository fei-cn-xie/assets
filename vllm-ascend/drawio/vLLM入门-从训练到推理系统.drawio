        <mxCell id="n35" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="341.1" y="348" width="99.7" height="30" as="geometry"/>
