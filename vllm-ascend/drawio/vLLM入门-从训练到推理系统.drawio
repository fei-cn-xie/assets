  </diagram>
  <diagram id="pg3" name="④ prefill 与 decode">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1576" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="④ 推理的两个阶段：prefill 一次算一大段，decode 每步只算一个字" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="20" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="一句话：&lt;b&gt;prefill&lt;/b&gt; 把整段 prompt 一次算完（矩阵很宽、算力吃满）；&lt;b&gt;decode&lt;/b&gt; 每步给每个请求只补 1 个 token（矩阵很窄、算力闲着）。这一个差别能解释后面 80% 的优化。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="36" y="48" width="1500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;第一步：同一句话，两种阶段的「矩阵形状」完全不同&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="122" width="1200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="t4" value="&lt;b&gt;prompt 有 12 个 token：prefill 一次把 12 个位置全算了（新算 12）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="156" width="1424" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="36" y="180" width="116.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="154.7" y="180" width="116.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="273.3" y="180" width="116.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="392" y="180" width="116.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="510.7" y="180" width="116.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="629.3" y="180" width="116.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="748" y="180" width="116.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="866.7" y="180" width="116.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="985.3" y="180" width="116.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1104" y="180" width="116.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1222.7" y="180" width="116.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1341.3" y="180" width="116.7" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="t17" value="&lt;b&gt;decode 第 1 步：只有第 13 个位置是新的（新算 1，但要读全部 12 个的历史 KV）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="240" width="1424" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
          <mxGeometry x="36" y="264" width="107.5" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fillColor=#efe9dd;strokeColor=#a1887f;" vertex="1" parent="1">
